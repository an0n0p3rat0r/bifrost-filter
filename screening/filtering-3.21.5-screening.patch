+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.Header().Set("Retry-After", ra.Load().(string))
+		w.WriteHeader(http.StatusTooManyRequests)
+	}))
+	defer srv.Close()
+	clk := &clock{t: time.Unix(1_800_000_000, 0)}
+	q := newQuery(t, srv, config.BifrostAddressFilterSource{Listed: ".listed"}, QuerySourceOptions{Now: clk.now})
+	a := q.Check(context.Background(), common.BTCChain, []ItemDTO{{Address: "x"}})[0]
+	if a.State != Unknown || !strings.HasPrefix(a.Reason, KindRateLimited) {
+		t.Fatalf("%+v", a)
+	}
+	if got := q.BackedOffUntil().Sub(clk.now()); got != 30*time.Second {
+		t.Fatalf("back-off %v", got)
+	}
+	if a := q.Check(context.Background(), common.BTCChain, []ItemDTO{{Address: "y"}})[0]; !strings.HasPrefix(a.Reason, KindBackoff) {
+		t.Fatalf("during back-off: %+v", a)
+	}
+	clk.add(time.Minute)
+	ra.Store("99999")
+	q.Check(context.Background(), common.BTCChain, []ItemDTO{{Address: "z"}})
+	if got := q.BackedOffUntil().Sub(clk.now()); got != MaxRetryAfter {
+		t.Fatalf("clamped back-off %v", got)
+	}
