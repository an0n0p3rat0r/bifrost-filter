+package addressfilter
+
+import (
+	"context"
+	"time"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+)
+
+// State is the tri-state answer a source gives for one item.
+type State uint8
+
+const (
+	// Unknown means the source could not answer (timeout, error, stale, budget,
+	// unsupported chain, explicit "unknown" selector). Unknown never skips and is
+	// never cached.
+	Unknown State = iota
+	// Clean means the source answered and the address is not listed.
+	Clean
+	// Listed means the source answered and the address is listed.
+	Listed
+)
+
+func (s State) String() string {
+	switch s {
+	case Listed:
+		return "listed"
+	case Clean:
+		return "clean"
+	default:
+		return "unknown"
+	}
+}
+
+// Answer is one source's answer for one item.
+type Answer struct {
+	State State
+	// Reason is a short, redacted, non-secret explanation (<= 256 bytes).
+	Reason string
+	// RetryAfter is an item-scoped hint for the recheck scheduler (0 = none).
+	RetryAfter time.Duration
+}
+
+// Verdict is the screening outcome for one inbound item.
+type Verdict struct {
+	Skip bool
+	// Answers holds each covering source's answer, by source name.
+	Answers map[string]Answer
+	// Combine is the combine mode that produced Skip ("any" or "all").
+	Combine string
+	// Fingerprint is the list fingerprint union in force when the verdict was made.
+	Fingerprint string
+	// GuardEpoch is the vault-guard epoch observed when the verdict was made.
+	GuardEpoch uint64
+}
+
+// Source answers screening questions for a batch of items of one chain.
+// Implementations must never block past ctx's deadline and must return one
+// Answer per input item (Unknown when they cannot answer).
+type Source interface {
+	Name() string
+	// Covers reports whether the source screens chain at all.
+	Covers(chain common.Chain) bool
+	Check(ctx context.Context, chain common.Chain, items []ItemDTO) []Answer
+}
+
+// GuardView is the read side of the durable vault guard.
+type GuardView interface {
+	// Ready is false until one reconciliation pass has succeeded.
+	Ready() bool
+	// Epoch bumps on every addition (and revoke), so async work can be fenced.
+	Epoch() uint64
+	// Contains reports whether (chain, address) is a protocol vault, router or
+	// module address (any alias, any EVM ticker for EVM keys).
+	Contains(chain common.Chain, address string) bool
+}
+
+// DecisionCache caches Listed/Clean answers for address-only sources.
+type DecisionCache interface {
+	Get(chain common.Chain, address string, guardEpoch uint64) (Answer, bool)
+	Put(chain common.Chain, address string, a Answer, guardEpoch uint64)
+	Invalidate(chain common.Chain, address string)
+}
+
+// BudgetStore persists per-credential, per-chain, per-UTC-day call counters.
+type BudgetStore interface {
+	// Reserve atomically adds n to the counter if the result stays <= limit.
+	Reserve(credential string, chain common.Chain, day string, n, limit uint64) (ok bool, err error)
+	// Release gives back n reserved calls that were never sent.
+	Release(credential string, chain common.Chain, day string, n uint64) error
+	Used(credential string, chain common.Chain, day string) (uint64, error)
+}
+
+// GuardStore persists the append-only vault registry and its tombstones.
+type GuardStore interface {
+	AddKeys(rows []GuardRow) error
+	LoadKeys() ([]GuardRow, error)
+	AddTombstone(t GuardTombstone) error
+	DeleteTombstone(chain common.Chain, address string) error
+	LoadTombstones() ([]GuardTombstone, error)
+}
+
+// GuardRow is one persisted vault-registry entry.
+type GuardRow struct {
+	Kind    string // vault | router | module | seed
+	Chain   string
+	Address string
+	PubKey  string
+}
+
+// GuardTombstone is a manual, audited revoke.
+type GuardTombstone struct {
+	Chain   string
+	Address string
+	Who     string
+	Why     string
+	At      time.Time
+}
+
+// LedgerStore persists skip envelopes (write-before-drop).
+type LedgerStore interface {
+	PutEnvelope(key string, env []byte, nextCheck time.Time) error
+	GetEnvelope(key string) ([]byte, bool, error)
+	DeleteEnvelope(key string) error
+	// ArchiveEnvelope moves a record out of the live ledger into the archive
+	// bucket (unresolved past retention); archived records are never deleted.
+	ArchiveEnvelope(key string, env []byte) error
+	// Due returns up to limit envelope keys whose next check is <= now, oldest
+	// next check first (round-robin: a rescheduled record goes to the back).
+	Due(now time.Time, limit int) ([]string, error)
+	// Count is the number of live (pending) records.
+	Count() (int, error)
+	// CountChain is the number of live records of one chain (the chain
+	// ticker the key starts with). Both counts must be cheap: they run on
+	// every skip write.
+	CountChain(chain string) (int, error)
+	// CountSender is the number of live records of one sender on one chain
+	// (case-insensitive). Cheap, like CountChain.
+	CountSender(chain, sender string) (int, error)
+}
