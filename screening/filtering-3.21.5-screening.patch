+package addressfilter
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"sync"
+	"time"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+)
+
+// DefaultBreakerWindow is the window the per-chain screening-time breaker
+// measures (R3-A1: 5 minutes of wall time).
+const DefaultBreakerWindow = 5 * time.Minute
+
+const breakerSlots = 30
+
+// ItemKey is the identity the observer uses to look up an item's verdict.
+func ItemKey(d ItemDTO) string {
+	tx := ""
+	if d.TxID != nil {
+		tx = *d.TxID
+	}
+	return d.Chain + "|" + tx + "|" + d.Address
+}
+
+// inMemory is implemented by sources that answer without external I/O
+// (static, list). Only these run while a chain's breaker is open.
+type inMemory interface{ InMemory() bool }
+
+func isInMemory(s Source) bool {
+	m, ok := s.(inMemory)
+	return ok && m.InMemory()
+}
+
+// ScreenerOptions configure a Screener.
+type ScreenerOptions struct {
+	Sources []Source
+	Guard   GuardView
+	// Combine is "any" (default) or "all".
+	Combine string
+	// Deadline is screen_deadline: one absolute deadline per TxIn. 0 means the
+	// largest source timeout in SourceTimeouts, capped at MaxScreenDeadline.
+	Deadline       time.Duration
+	SourceTimeouts []time.Duration
+	// ChainBudgetPct trips a chain's breaker when screening took more than this
+	// share of the chain's wall time over BreakerWindow (default 20 %).
+	ChainBudgetPct int
+	BreakerWindow  time.Duration
+	// Fingerprint returns the list fingerprint union in force (optional).
+	Fingerprint func() string
+	Metrics     *Metrics
+	Warn        *WarnLimiter
+	Now         func() time.Time
+}
+
+// Screener is the batch screening stage (R3-A1). It never returns an error:
+// any failure means observe.
+type Screener struct {
+	sources     []Source
+	guard       GuardView
+	combine     string
+	deadline    time.Duration
+	pct         int
+	window      time.Duration
+	fingerprint func() string
+	metrics     *Metrics
+	warn        *WarnLimiter
+	now         func() time.Time
+
+	mu       sync.Mutex
+	breakers map[common.Chain]*chainBreaker
+}
+
+// NewScreener builds the stage.
+func NewScreener(o ScreenerOptions) *Screener {
+	s := &Screener{
+		sources: o.Sources, guard: o.Guard, combine: o.Combine, deadline: o.Deadline,
+		pct: o.ChainBudgetPct, window: o.BreakerWindow, fingerprint: o.Fingerprint,
+		metrics: o.Metrics, warn: o.Warn, now: o.Now,
+		breakers: map[common.Chain]*chainBreaker{},
+	}
+	if s.combine != CombineAll {
+		s.combine = CombineAny
+	}
+	if s.deadline <= 0 {
+		for _, t := range o.SourceTimeouts {
+			if t > s.deadline {
+				s.deadline = t
+			}
+		}
+		if s.deadline <= 0 {
+			s.deadline = DefaultSourceTimeout
+		}
+	}
+	if s.deadline > MaxScreenDeadline {
+		s.deadline = MaxScreenDeadline
+	}
+	if s.pct <= 0 {
+		s.pct = DefaultChainBudgetPct
+	}
+	if s.window <= 0 {
+		s.window = DefaultBreakerWindow
+	}
+	if s.now == nil {
+		s.now = time.Now
+	}
+	return s
+}
+
+// Deadline is the effective screen_deadline.
+func (s *Screener) Deadline() time.Duration { return s.deadline }
+
+// BreakerOpen reports whether chain is currently limited to in-memory sources.
+func (s *Screener) BreakerOpen(chain common.Chain) bool {
+	return s.breaker(chain).open(s.now(), s.window, s.pct)
+}
+
+func (s *Screener) breaker(chain common.Chain) *chainBreaker {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	b := s.breakers[chain]
+	if b == nil {
+		b = &chainBreaker{}
+		s.breakers[chain] = b
+	}
+	return b
+}
+
+type sourceResult struct {
+	idx     int
+	answers []Answer
+}
+
+// ScreenTxIn screens one TxIn's eligible items of one chain and returns a
+// verdict per ItemKey. Every input item gets a verdict; Skip is true only when
+// the guard is ready, the sender is not a vault, the combine table says skip,
+// and the guard still doesn't contain the sender right before returning.
+func (s *Screener) ScreenTxIn(ctx context.Context, chain common.Chain, items []ItemDTO) map[string]Verdict {
+	out := make(map[string]Verdict, len(items))
+	observeAll := func() map[string]Verdict {
+		for _, it := range items {
+			out[ItemKey(it)] = Verdict{Combine: s.combine}
+		}
+		return out
+	}
+	if len(items) == 0 {
+		return out
+	}
+	// Readiness: until the guard has reconciled, no external request and no
+	// positive skip, not even from static/list sources.
+	if s.guard == nil || !s.guard.Ready() {
+		s.metrics.setGuardReady(false)
+		return observeAll()
+	}
+	s.metrics.setGuardReady(true)
+	start := s.now()
+	epoch := s.guard.Epoch()
+
+	// Guarded senders (vaults, routers, modules) are never screened.
+	var eligible []ItemDTO
+	for _, it := range items {
+		if s.guard.Contains(chain, it.Address) {
+			out[ItemKey(it)] = Verdict{Combine: s.combine, GuardEpoch: epoch}
+			continue
+		}
+		eligible = append(eligible, it)
+	}
+	if len(eligible) == 0 {
+		return out
+	}
+
+	brk := s.breaker(chain)
+	breakerOpen := brk.open(start, s.window, s.pct)
+	s.metrics.setBreaker(chain.String(), breakerOpen)
+	if breakerOpen {
+		s.warn.Warn("chain_breaker", chain.String(), fmt.Sprintf("screening for %s exceeded %d%% of wall time; using in-memory sources only", chain, s.pct))
+	}
+	// Every source covering the chain takes part in the combine. One that is
+	// not asked (breaker open) is a non-answer, never absent: under
+	// combine: all, dropping it would let the remaining sources skip alone.
+	var covering []Source
+	for _, src := range s.sources {
+		if src.Covers(chain) {
+			covering = append(covering, src)
+		}
+	}
+	names := make([]string, len(covering))
+	for i, src := range covering {
+		names[i] = src.Name()
+	}
+
+	answers := make([][]Answer, len(covering))
+	notAsked := make([]string, len(covering)) // reason a source was not asked
+	asked := 0
+	for i, src := range covering {
+		if breakerOpen && !isInMemory(src) {
+			notAsked[i] = KindBreaker
+			continue
+		}
+		asked++
+	}
+	if asked > 0 {
+		dctx, cancel := context.WithDeadline(ctx, start.Add(s.deadline))
+		results := make(chan sourceResult, asked)
+		for i, src := range covering {
+			if notAsked[i] != "" {
+				continue
+			}
+			go func(i int, src Source) {
+				var a []Answer
+				defer func() {
+					if r := recover(); r != nil {
+						s.warn.Warn("source_panic", src.Name(), "screening source panicked; observing")
+						a = nil
+					}
+					results <- sourceResult{idx: i, answers: a}
+				}()
+				a = src.Check(dctx, chain, eligible)
+			}(i, src)
+		}
+		pending := asked
+	collect:
+		for pending > 0 {
+			select {
+			case r := <-results:
+				pending--
+				if len(r.answers) == len(eligible) {
+					answers[r.idx] = r.answers
+				} else if r.answers != nil {
+					s.warn.Warn("source_contract", names[r.idx], "source returned a wrong number of answers; treated as unknown")
+				}
+			case <-dctx.Done():
+				// Late sources are non-answers: observe.
+				break collect
+			}
+		}
+		cancel()
+	}
+
+	fp := ""
+	if s.fingerprint != nil {
+		fp = s.fingerprint()
+	}
+	nonAnswers := make([]map[string]int, len(covering)) // per source: kind -> items
+	for j, it := range eligible {
+		m := make(map[string]Answer, len(covering))
+		for i, name := range names {
+			var a Answer
+			switch {
+			case notAsked[i] != "":
+				a = Answer{State: Unknown, Reason: notAsked[i]}
+			case answers[i] == nil:
+				a = Answer{State: Unknown, Reason: KindTimeout}
+			default:
+				a = answers[i][j]
+			}
+			if a.State == Unknown {
+				if nonAnswers[i] == nil {
+					nonAnswers[i] = map[string]int{}
+				}
+				nonAnswers[i][ReasonKind(a.Reason)]++
+			}
+			m[name] = a
+		}
+		skip := Combine(s.combine, m, names)
+		// Epoch fence: a sender whitelisted while its request was in flight
+		// is observed, never skipped.
+		if skip && (!s.guard.Ready() || s.guard.Contains(chain, it.Address)) {
+			skip = false
+		}
+		out[ItemKey(it)] = Verdict{Skip: skip, Answers: m, Combine: s.combine, Fingerprint: fp, GuardEpoch: s.guard.Epoch()}
+	}
+	took := s.now().Sub(start)
+	brk.record(s.now(), took, s.window)
+	s.metrics.observeScreen(chain.String(), took)
+	s.reportNonAnswers(chain, names, nonAnswers)
+	return out
+}
+
+// reportNonAnswers counts every non-answer by source and kind and logs one
+// rate-limited warning per (source, kind): a failing source is never silent.
+func (s *Screener) reportNonAnswers(chain common.Chain, names []string, nonAnswers []map[string]int) {
+	for i, kinds := range nonAnswers {
+		for kind, n := range kinds {
+			s.metrics.sourceErrors(names[i], kind, n)
+			s.warn.Warn("source_"+kind, names[i], fmt.Sprintf("source %s gave no answer for %d %s item(s): %s", names[i], n, chain, kind))
+		}
+	}
+}
+
+// ReasonKind is the non-answer kind of an Unknown answer's reason (the text
+// before ": "), or "unknown" when the reason is empty.
+func ReasonKind(reason string) string {
+	if reason == "" {
+		return "unknown"
+	}
+	if i := strings.Index(reason, ":"); i > 0 {
+		return reason[:i]
+	}
+	return reason
+}
+
+// chainBreaker accumulates screening time per slot over a sliding window.
+type chainBreaker struct {
+	mu    sync.Mutex
+	slots [breakerSlots]time.Duration
+	ids   [breakerSlots]int64
+}
+
+func slotID(t time.Time, window time.Duration) int64 {
+	w := int64(window) / breakerSlots
+	if w <= 0 {
+		w = 1
+	}
+	return t.UnixNano() / w
+}
+
+func (b *chainBreaker) record(now time.Time, d time.Duration, window time.Duration) {
+	id := slotID(now, window)
+	i := int(((id % breakerSlots) + breakerSlots) % breakerSlots)
+	b.mu.Lock()
+	if b.ids[i] != id {
+		b.ids[i] = id
+		b.slots[i] = 0
+	}
+	b.slots[i] += d
+	b.mu.Unlock()
+}
+
+func (b *chainBreaker) busy(now time.Time, window time.Duration) time.Duration {
+	id := slotID(now, window)
+	var sum time.Duration
+	b.mu.Lock()
+	for i := 0; i < breakerSlots; i++ {
+		if b.ids[i] > id-breakerSlots && b.ids[i] <= id {
+			sum += b.slots[i]
+		}
+	}
+	b.mu.Unlock()
+	return sum
+}
+
+func (b *chainBreaker) open(now time.Time, window time.Duration, pct int) bool {
+	return b.busy(now, window)*100 > window*time.Duration(pct)
+}
diff --git a/bifrost/pkg/addressfilter/screen_test.go b/bifrost/pkg/addressfilter/screen_test.go
