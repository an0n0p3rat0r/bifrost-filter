+func migrateItem(tx, from, to string) *types.TxInItem {
+	return &types.TxInItem{Tx: tx, Sender: from, To: to, Memo: "MIGRATE:100", BlockHeight: 100,
+		Coins: common.NewCoins(common.NewCoin(common.BTCAsset, cosmos.NewUint(5)))}
+}
+
+// Finding 2, static-only: a vault on the legacy list never has its migration
+// inbound dropped.
+func TestStaticPathNeverDropsVaultSender(t *testing.T) {
+	vault1, vault2 := stypes.GetRandomPubKey(), stypes.GetRandomPubKey()
+	pkm, err := pubkeymanager.NewPubKeyManager(nil, nil)
+	require.NoError(t, err)
+	pkm.AddPubKey(vault1, false, common.SigningAlgoSecp256k1)
+	pkm.AddPubKey(vault2, false, common.SigningAlgoSecp256k1)
+	cache, err := lru.New(100)
+	require.NoError(t, err)
+	from, err := vault1.GetAddress(common.BTCChain)
+	require.NoError(t, err)
+	to, err := vault2.GetAddress(common.BTCChain)
+	require.NoError(t, err)
+	o := &Observer{logger: log.Logger, pubkeyMgr: pkm, signedTxOutCache: cache,
+		addressFilter: addressfilter.New(from.String() + "," + reviewListed)}
+	got := o.filterObservations(common.BTCChain, []*types.TxInItem{migrateItem("m1", from.String(), to.String())}, false)
+	require.Len(t, got, 2, "outbound + inbound of a migration from a listed vault")
+	// A listed non-vault sender is still dropped.
+	got = o.filterObservations(common.BTCChain, []*types.TxInItem{migrateItem("m2", reviewListed, to.String())}, false)
+	require.Empty(t, got)
+}
+
+// Finding 2, adapter mode: a guarded sender (here a router) on the legacy
+// list is never dropped by the static pre-filter.
+func TestAdapterModeStaticPathNeverDropsGuardedSender(t *testing.T) {
+	in := newInteg(t, addressfilter.Validated{}, []common.Chain{common.BTCChain}, &switchSource{})
+	in.o.addressFilter = addressfilter.New(reviewListed)
+	require.NoError(t, in.o.afAdapter.Guard.AddAddress("router", common.BTCChain, reviewListed))
+	got := in.o.filterObservationsScreened(common.BTCChain,
+		[]*types.TxInItem{inItem("r1", reviewListed, in.addr[common.BTCChain])}, false, nil)
+	require.Len(t, got, 1, "a guarded sender is observed even when the static list names it")
+}
+
+func newUnreadyAdapterObserver(t *testing.T) (*Observer, *pubkeymanager.PubKeyManager) {
+	t.Helper()
+	o, _ := newErrataOrderingObserver(t)
+	pkm, err := pubkeymanager.NewPubKeyManager(nil, nil)
+	require.NoError(t, err)
+	pkm.AddPubKey(stypes.GetRandomPubKey(), false, common.SigningAlgoSecp256k1)
+	cache, err := lru.New(100)
+	require.NoError(t, err)
+	o.pubkeyMgr, o.signedTxOutCache, o.wg = pkm, cache, &sync.WaitGroup{}
+	o.chains = map[common.Chain]chainclients.ChainClient{common.BTCChain: nil}
+	a, err := addressfilter.NewAdapter(addressfilter.Validated{Enabled: true, Combine: "any"},
+		addressfilter.AdapterOptions{Chains: []common.Chain{common.BTCChain}, Stores: o.storage, Sources: []addressfilter.Source{&switchSource{}}})
+	require.NoError(t, err)
+	o.afAdapter = a
+	return o, pkm
+}
+
+// Finding 3: the guard is not ready until the vault set was fetched from
+// THORChain, however the reconcile otherwise went.
+func TestGuardNotReadyUntilVaultsFetched(t *testing.T) {
+	o, _ := newUnreadyAdapterObserver(t)
+	var loaded atomic.Bool
+	o.afVaultsLoaded = loaded.Load
+	o.startAddressFilter(context.Background())
+	t.Cleanup(o.stopAddressFilter)
+	require.False(t, o.afAdapter.Guard.Ready(), "no vault fetch yet: not ready")
+	loaded.Store(true)
+	o.reconcileAddressFilterGuard()
+	require.True(t, o.afAdapter.Guard.Ready())
+}
+
+// Finding 3: a vault the pubkey manager adds is guarded right away, not at the
+// next periodic reconcile.
+func TestNewVaultGuardedImmediately(t *testing.T) {
+	o, pkm := newUnreadyAdapterObserver(t)
+	o.afVaultsLoaded = func() bool { return true }
+	o.startAddressFilter(context.Background())
+	t.Cleanup(o.stopAddressFilter)
+	pk := stypes.GetRandomPubKey()
+	addr, err := pk.GetAddress(common.BTCChain)
+	require.NoError(t, err)
+	pkm.AddPubKey(pk, false, common.SigningAlgoSecp256k1)
+	require.Eventually(t, func() bool { return o.afAdapter.Guard.Contains(common.BTCChain, addr.String()) },
+		2*time.Second, 10*time.Millisecond, "new vault guarded without waiting a minute")
+}
+
+func loopbackListCfg(seed, sha string) config.BifrostAddressFilterConfiguration {
+	return config.BifrostAddressFilterConfiguration{Enabled: true, Seed: seed, SeedSHA256: sha,
+		Sources: []config.BifrostAddressFilterSource{{Name: "lst", Mode: "list", Chains: []string{"BTC"},
+			URL: "http://127.0.0.1:1/list", Listed: "."}}}
+}
+
+// Finding 3: a configured seed is loaded and verified; a refused seed keeps
+// the guard unready (nothing skipped, nothing asked).
+func TestGuardSeedLoadedAndVerified(t *testing.T) {
+	o, _ := newErrataOrderingObserver(t)
+	o.chains = map[common.Chain]chainclients.ChainClient{common.BTCChain: nil}
+	// A seed entry must be a vault address with the pubkey it derives from
+	// (round 3, NEW-6): never an arbitrary address.
+	seedPK := stypes.GetRandomPubKey()
+	seedAddr, err := seedPK.GetAddress(common.BTCChain)
+	require.NoError(t, err)
+	seed := []byte(`{"version":1,"built_at_height":1,"entries":[{"pubkey":"` + seedPK.String() + `","chain":"BTC","address":"` + seedAddr.String() + `"}]}`)
+	p := filepath.Join(t.TempDir(), "seed.json")
+	require.NoError(t, os.WriteFile(p, seed, 0o600))
+	sum := sha256.Sum256(seed)
+
+	bad := o.newAddressFilterAdapter(loopbackListCfg(p, "00"), t.TempDir())
+	require.NotNil(t, bad)
+	bad.Guard.MarkReconciled(true)
+	require.False(t, bad.Guard.Ready(), "a refused seed keeps the guard unready")
+
+	o2, _ := newErrataOrderingObserver(t)
+	o2.chains = o.chains
+	good := o2.newAddressFilterAdapter(loopbackListCfg(p, hex.EncodeToString(sum[:])), t.TempDir())
+	require.NotNil(t, good)
+	good.Guard.MarkReconciled(true)
+	require.True(t, good.Guard.Ready())
+	require.True(t, good.Guard.Contains(common.BTCChain, seedAddr.String()), "seed entries are guarded")
+}
+
+// Findings 9: an invalid config or a quarantined source sets the gauges, which
+// are registered whether or not an adapter is built.
+func TestInvalidConfigAndQuarantineGauges(t *testing.T) {
+	o, _ := newErrataOrderingObserver(t)
+	o.chains = map[common.Chain]chainclients.ChainClient{common.BTCChain: nil}
+	o.afMetrics = addressfilter.NewMetrics()
+	dup := config.BifrostAddressFilterConfiguration{Enabled: true, Sources: []config.BifrostAddressFilterSource{
+		{Name: "dup", Mode: "list"}, {Name: "dup", Mode: "list"},
+	}}
+	require.Nil(t, o.newAddressFilterAdapter(dup, t.TempDir()))
+	require.Equal(t, 1.0, testutil.ToFloat64(o.afMetrics.ConfigInvalid))
+
+	cfg := loopbackListCfg("", "")
+	cfg.Sources = append(cfg.Sources, config.BifrostAddressFilterSource{Name: "broken", Mode: "query", Chains: []string{"BTC"}})
+	a := o.newAddressFilterAdapter(cfg, t.TempDir())
+	require.NotNil(t, a)
+	require.Equal(t, 0.0, testutil.ToFloat64(o.afMetrics.ConfigInvalid))
+	require.Equal(t, 1.0, testutil.ToFloat64(o.afMetrics.SourceQuarantined.WithLabelValues("broken")))
+	require.Same(t, o.afMetrics, a.Metrics, "the adapter reports on the registered metrics")
+}
+
+// Finding 13: a screening skip is counted once.
+func TestScreeningSkipCountedOnce(t *testing.T) {
+	var deckLocked atomic.Bool
+	src := &fakeListSource{listed: reviewListed, deckLocked: &deckLocked}
+	o, vaultAddr := newScreeningObserver(t, 0, src)
+	it := &types.TxInItem{Tx: "cc01", Sender: reviewListed, To: vaultAddr, Memo: "SWAP:ETH.ETH", BlockHeight: 100,
+		Coins: common.NewCoins(common.NewCoin(common.BTCAsset, cosmos.NewUint(5)))}
+	require.NoError(t, o.processObservedTx(types.TxIn{Chain: common.BTCChain, TxArray: []*types.TxInItem{it}}))
+	require.Equal(t, 1.0, testutil.ToFloat64(o.afAdapter.Metrics.Skipped.WithLabelValues("BTC")))
+}
+
+// Finding 7: the ledger drains only when the operator turned the adapter off;
+// an invalid config keeps it, and a sender the static list still lists is
+// kept, not replayed.
+func TestDrainOnlyWhenOperatorTurnedAdapterOff(t *testing.T) {
+	var deckLocked atomic.Bool
+	src := &fakeListSource{listed: reviewListed, deckLocked: &deckLocked}
+	o, vaultAddr := newScreeningObserver(t, 0, src)
+	mk := func(tx, sender string) *types.TxInItem {
+		return &types.TxInItem{Tx: tx, Sender: sender, To: vaultAddr, Memo: "SWAP:ETH.ETH", BlockHeight: 100,
+			Coins: common.NewCoins(common.NewCoin(common.BTCAsset, cosmos.NewUint(5)))}
+	}
+	require.NoError(t, o.processObservedTx(types.TxIn{Chain: common.BTCChain, TxArray: []*types.TxInItem{mk("dd01", reviewListed)}}))
+	o.stopAddressFilter()
+	count := func() int {
+		n, err := addressfilter.NewSkipLedger(o.storage, 0, nil, nil).Count()
+		require.NoError(t, err)
+		return n
+	}
+	require.Equal(t, 1, count())
+
+	// Invalid config (not the operator's choice): kept.
+	invalid := config.BifrostAddressFilterConfiguration{Enabled: true, ReplayEnabled: true, Sources: []config.BifrostAddressFilterSource{
+		{Name: "dup", Mode: "list"}, {Name: "dup", Mode: "list"},
+	}}
+	o.afAdapter = o.newAddressFilterAdapter(invalid, t.TempDir())
+	o.drainSkipLedger(invalid)
+	require.Equal(t, 1, count(), "an invalid config must not drain the ledger")
+	require.Empty(t, deckJSON(t, o))
+
+	// Static-only, and the static list still lists the sender: kept.
+	staticOnly := config.BifrostAddressFilterConfiguration{Enabled: true, ReplayEnabled: true, Addresses: reviewListed}
+	o.addressFilter = addressfilter.New(reviewListed)
+	o.afAdapter = o.newAddressFilterAdapter(staticOnly, t.TempDir())
+	require.Equal(t, "static_only", o.afDisabled)
+	o.drainSkipLedger(staticOnly)
+	require.Equal(t, 1, count(), "a sender the static list still lists stays recorded")
+
+	// The operator disabled the filter: drained through admission.
+	o.addressFilter = nil
+	disabled := config.BifrostAddressFilterConfiguration{Enabled: false, ReplayEnabled: true}
+	o.afAdapter = o.newAddressFilterAdapter(disabled, t.TempDir())
+	o.drainSkipLedger(disabled)
+	require.Zero(t, count())
+	require.Len(t, deckJSON(t, o), 1)
+}
+
+// Finding 8: the per-chain counts stay right across writes, releases,
+// archives and an errata cleanup, without rescanning on each write.
+func TestSkipLedgerCountsCached(t *testing.T) {
+	o, storage := newErrataOrderingObserver(t)
+	_ = o
+	put := func(key string) {
+		require.NoError(t, storage.PutEnvelope(key, []byte(`{}`), time.Unix(100, 0)))
+	}
+	put("BTC|t1|1|h|s")
+	put("BTC|t2|1|h|s")
+	put("DOGE|t3|1|h|s")
+	put("BTC|t1|1|h|s") // rewrite, not a new record
+	n, err := storage.Count()
+	require.NoError(t, err)
+	require.Equal(t, 3, n)
+	nb, err := storage.CountChain("BTC")
+	require.NoError(t, err)
+	require.Equal(t, 2, nb)
+	require.NoError(t, storage.DeleteEnvelope("BTC|t2|1|h|s"))
+	require.NoError(t, storage.ArchiveEnvelope("DOGE|t3|1|h|s", []byte(`{}`)))
+	n, err = storage.Count()
+	require.NoError(t, err)
+	require.Equal(t, 1, n)
+	nd, err := storage.CountChain("DOGE")
+	require.NoError(t, err)
+	require.Zero(t, nd)
+	// The cache is what answers: a row written behind its back isn't seen
+	// until an invalidation (errata) forces one rescan.
+	row := make([]byte, 8)
+	require.NoError(t, storage.db.Put(afEnvKey("ETH|x|1|h|s"), append(row, []byte(`{}`)...), nil))
+	ne, _ := storage.CountChain("ETH")
+	require.Zero(t, ne, "no rescan on read")
+	storage.afMu.Lock()
+	storage.afCountsOK = false
+	storage.afMu.Unlock()
+	ne, _ = storage.CountChain("ETH")
+	require.Equal(t, 1, ne)
+}
diff --git a/bifrost/observer/addressfilter_stage.go b/bifrost/observer/addressfilter_stage.go
new file mode 100644
index 00000000000..a4d98eb0c08
--- /dev/null
+++ b/bifrost/observer/addressfilter_stage.go
@@ -0,0 +1,494 @@
+package observer
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"sort"
+	"strings"
+	"time"
+
+	"gitlab.com/thorchain/thornode/v3/bifrost/pkg/addressfilter"
+	"gitlab.com/thorchain/thornode/v3/bifrost/thorclient/types"
+	"gitlab.com/thorchain/thornode/v3/common"
+	"gitlab.com/thorchain/thornode/v3/config"
+)
+
+// guardReconcileInterval is how often the vault guard is refreshed from the
+// pubkey manager (keygen/rotate add vaults; the registry is append-only).
+const guardReconcileInterval = time.Minute
+
+// afExtraAllowFuture records TxIn.AllowFutureObservation in the envelope.
+const afExtraAllowFuture = "allow_future_observation"
+
+// afScreen carries one TxIn's screening verdicts into filterObservations,
+// which only reads the map (no adapter I/O there).
+type afScreen struct {
+	verdicts map[string]addressfilter.Verdict
+	txIn     *types.TxIn
+}
+
+// newAddressFilterAdapter builds the screening adapter when the config uses
+// list or query sources. A legacy config (static addresses only) returns nil
+// and the observer keeps its static path unchanged. Any build error disables
+// the adapter (logged, config_invalid = 1); the static list still applies.
+// o.afDisabled records why there is no adapter.
+func (o *Observer) newAddressFilterAdapter(cfg config.BifrostAddressFilterConfiguration, ackDir string) *addressfilter.Adapter {
+	if !cfg.Enabled {
+		o.afDisabled = "disabled"
+		return nil
+	}
+	m := o.afMetrics
+	m.SetConfigInvalid(false)
+	chains := make([]common.Chain, 0, len(o.chains))
+	for ch := range o.chains {
+		chains = append(chains, ch)
+	}
+	sort.Slice(chains, func(i, j int) bool { return chains[i].String() < chains[j].String() })
+	v, err := addressfilter.Validate(cfg, chains, os.ReadFile)
+	if err != nil {
+		o.afDisabled = "invalid"
+		m.SetConfigInvalid(true)
+		o.logger.Error().Err(err).Msg("address_filter adapter config invalid; adapter disabled; the legacy address list and every valid named static source still apply")
+		// The named static sources (e.g. an OFAC list under sources:) still
+		// apply on inbound and outbound, each with its chains.
+		salvaged := addressfilter.SalvageStatic(cfg, chains, os.ReadFile)
+		for name, qerr := range salvaged.Quarantined {
+			m.SetQuarantined(name, true)
+			o.logger.Error().Err(qerr).Str("source", name).Msg("address_filter static source quarantined")
+		}
+		o.applyNamedStatic(salvaged, cfg)
+		return nil
+	}
+	for _, w := range v.Warnings {
+		o.logger.Warn().Msg("address_filter config: " + w)
+	}
+	for name, qerr := range v.Quarantined {
+		m.SetQuarantined(name, true)
+		o.logger.Error().Err(qerr).Str("source", name).Msg("address_filter source quarantined")
+	}
+	if !addressfilter.NeedsAdapter(v) {
+		if len(v.Quarantined) > 0 {
+			// Every list/query source is quarantined: not the operator's
+			// choice of a static-only filter, so the ledger is kept.
+			o.afDisabled = "invalid"
+			m.SetConfigInvalid(true)
+		} else {
+			o.afDisabled = "static_only"
+		}
+		o.applyNamedStatic(v, cfg)
+		return nil
+	}
+	a, err := addressfilter.NewAdapter(v, addressfilter.AdapterOptions{
+		Chains: chains, Stores: o.storage, StaticAddresses: cfg.Addresses,
+		AckDir:  ackDir,
+		Metrics: m,
+		// Replay (A5) is off unless replay_enabled; record-only otherwise.
+		OnRelease: o.addressFilterOnRelease(v.ReplayEnabled),
+		Warn: func(class, source, msg string) {
+			o.logger.Warn().Str("class", class).Str("source", source).Msg(msg)
+		},
+	})
+	if err != nil {
+		o.afDisabled = "build_failed"
+		m.SetConfigInvalid(true)
+		o.logger.Error().Err(err).Msg("address_filter adapter build failed; adapter disabled; the legacy address list and named static sources still apply")
+		o.applyNamedStatic(v, cfg)
+		return nil
+	}
+	// Named static sources drop on inbound exactly like the legacy list:
+	// before screening, whatever the guard readiness or the combine rule. Only
+	// vault, router and pool senders are exempt (filterObservations).
+	o.afNamedStatic = addressfilter.NamedStaticSet(v)
+	o.afSeedPath, o.afSeedSHA256 = cfg.Seed, cfg.SeedSHA256
+	o.loadAddressFilterSeed(a)
+	o.afDisabled = ""
+	o.logger.Info().Int("sources", len(v.Sources)).Str("combine", v.Combine).Msg("address_filter adapter enabled")
+	return a
+}
+
+// applyNamedStatic puts the config's named static sources on the static path
+// when no adapter runs, so they still apply on inbound (and outbound, through
+// AddressFilterOutboundSet) with their own chains.
+func (o *Observer) applyNamedStatic(v addressfilter.Validated, cfg config.BifrostAddressFilterConfiguration) {
+	named := addressfilter.NamedStaticSet(v)
+	if named == nil {
+		return
+	}
+	o.afNamedStatic = named
+	out := addressfilter.NewStaticSet()
+	out.Add(addressfilter.New(cfg.Addresses), nil)
+	for _, spec := range v.Sources {
+		if spec.Mode == "static" && spec.Raw.Addresses != "" {
+			out.Add(addressfilter.New(spec.Raw.Addresses), spec.Chains)
+		}
+	}
+	o.afStaticOutbound = addressfilter.NewOutboundSetFromStatic(out, nil)
+	o.logger.Info().Int("sources", named.Len()).Int("loaded", named.Loaded()).Str("reason", o.afDisabled).
+		Msg("address_filter: no screening adapter; named static sources applied on the static path")
+}
+
+// loadAddressFilterSeed loads the configured guard seed. A seed that can't be
+// read or doesn't verify keeps the guard unready (nothing is skipped and no
+// source is asked: fail-open, logged); it is retried on every reconcile.
+func (o *Observer) loadAddressFilterSeed(a *addressfilter.Adapter) {
+	if a == nil || o.afSeedPath == "" {
+		return
+	}
+	raw, rerr := os.ReadFile(o.afSeedPath)
+	if rerr != nil {
+		a.Guard.RefuseSeed()
+		o.logger.Error().Err(rerr).Msg("address_filter guard seed unreadable; screening stays off, retried every reconcile")
+		return
+	}
+	if serr := a.Guard.LoadSeed(raw, o.afSeedSHA256); serr != nil {
+		o.logger.Error().Err(serr).Msg("address_filter guard seed refused; screening stays off, retried every reconcile")
+	}
+}
+
+// AddressFilterOutboundSet is the synchronous outbound set: the screening
+// adapter's, or (no adapter) the legacy list plus named static sources. nil
+// when there is neither: the signer then keeps its legacy filter.
+func (o *Observer) AddressFilterOutboundSet() *addressfilter.OutboundSet {
+	if o == nil {
+		return nil
+	}
+	if o.afAdapter != nil {
+		return o.afAdapter.Outbound
+	}
+	return o.afStaticOutbound
+}
+
+// afNewVaultBuffer bounds the pubkey-manager -> guard hand-off; a full buffer
+// only delays a vault to the next periodic reconcile.
+const afNewVaultBuffer = 64
+
+// startAddressFilter starts the adapter workers and the guard reconciler.
+func (o *Observer) startAddressFilter(ctx context.Context) {
+	if o.afAdapter == nil {
+		return
+	}
+	actx, cancel := context.WithCancel(ctx)
+	o.afCancel = cancel
+	o.afCtx = actx
+	if o.afNewVault == nil {
+		o.afNewVault = make(chan common.PubKey, afNewVaultBuffer)
+		if o.pubkeyMgr != nil {
+			// Runs under the pubkey manager's lock: hand off, never block.
+			newVault := o.afNewVault
+			o.pubkeyMgr.RegisterCallback(func(pk common.PubKey) error {
+				select {
+				case newVault <- pk:
+				default:
+				}
+				return nil
+			})
+		}
+	}
+	o.reconcileAddressFilterGuard()
+	o.afAdapter.Start(actx)
+	o.afWG.Add(1)
+	go func() {
+		defer o.afWG.Done()
+		t := time.NewTicker(guardReconcileInterval)
+		defer t.Stop()
+		for {
+			select {
+			case <-actx.Done():
+				return
+			case pk := <-o.afNewVault:
+				o.addVaultToGuard(pk)
+			case <-t.C:
+				o.reconcileAddressFilterGuard()
+			}
+		}
+	}()
+}
+
+// stopAddressFilter cancels and joins every adapter worker. It runs before the
+// observer storage closes.
+func (o *Observer) stopAddressFilter() {
+	if o.afAdapter == nil {
+		return
+	}
+	if o.afCancel != nil {
+		o.afCancel()
+	}
+	o.afAdapter.Stop()
+	o.afWG.Wait()
+}
+
+func (o *Observer) afChains() []common.Chain {
+	chains := make([]common.Chain, 0, len(o.chains))
+	for ch := range o.chains {
+		chains = append(chains, ch)
+	}
+	return chains
+}
+
+// addVaultToGuard guards one new vault pubkey right away.
+func (o *Observer) addVaultToGuard(pk common.PubKey) {
+	if a := o.afAdapter; a != nil {
+		if err := a.Guard.AddPubKey(pk, o.afChains()); err != nil {
+			o.logger.Error().Err(err).Msg("address_filter guard: add new vault pubkey")
+		}
+	}
+}
+
+// vaultsLoaded reports whether the vault set is known (see afVaultsLoaded).
+func (o *Observer) vaultsLoaded() bool {
+	if o.afVaultsLoaded != nil {
+		return o.afVaultsLoaded()
+	}
+	return o.pubkeyMgr != nil && o.pubkeyMgr.VaultsFetched()
+}
+
+// reconcileAddressFilterGuard feeds every vault pubkey (all known, including
+// retiring) and every router contract into the append-only guard. The guard
+// is marked ready only once the vault set has really been fetched from
+// THORChain: until then no source is asked and nothing is skipped.
+func (o *Observer) reconcileAddressFilterGuard() {
+	a := o.afAdapter
+	if a == nil || o.pubkeyMgr == nil {
+		return
+	}
+	if !a.Guard.Seeded() {
+		o.loadAddressFilterSeed(a)
+	}
+	chains := o.afChains()
+	ok := true
+	for _, pk := range o.pubkeyMgr.GetPubKeys() {
+		if err := a.Guard.AddPubKey(pk, chains); err != nil {
+			ok = false
+			o.logger.Error().Err(err).Msg("address_filter guard: add vault pubkey")
+		}
+	}
+	for _, ch := range chains {
+		for _, addr := range o.pubkeyMgr.GetContracts(ch, true) {
+			if addr.IsEmpty() {
+				continue
+			}
+			if err := a.Guard.AddAddress("router", ch, addr.String()); err != nil {
+				ok = false
+				o.logger.Error().Err(err).Msg("address_filter guard: add router")
+			}
+		}
+	}
+	if !o.vaultsLoaded() {
+		if ok {
+			o.logger.Warn().Msg("address_filter guard: vault set not fetched from THORChain yet; screening stays off")
+		}
+		ok = false
+	}
+	a.Guard.MarkReconciled(ok)
+}
+
+// addressFilterProtectedSender reports whether sender is a guarded address
+// (vault, router, module or seed entry, when the adapter runs) or a router
+// contract on chain. Pool addresses are checked by the caller (isInternal).
+func (o *Observer) addressFilterProtectedSender(chain common.Chain, sender string) bool {
+	if sender == "" {
+		return false
+	}
+	if a := o.afAdapter; a != nil && a.Guard.Contains(chain, sender) {
+		return true
+	}
+	if o.pubkeyMgr == nil {
+		return false
+	}
+	for _, addr := range o.pubkeyMgr.GetContracts(chain, true) {
+		if !addr.IsEmpty() && strings.EqualFold(addr.String(), sender) {
+			return true
+		}
+	}
+	return false
+}
+
+// screenTxIn screens every eligible inbound of txIn once, before the deck
+// lock. It returns nil when there is no adapter or nothing to screen.
+// Eligibility mirrors filterObservations' inbound branch: the destination is
+// a pool address, not a cancel, not a mempool non-internal item. Pre-attributed
+// XMR inbounds are exempt (their vault is already fixed by the client).
+func (o *Observer) screenTxIn(txIn *types.TxIn) *afScreen {
+	a := o.afAdapter
+	if a == nil || txIn == nil || len(txIn.TxArray) == 0 {
+		return nil
+	}
+	var eligible []*types.TxInItem
+	for _, it := range txIn.TxArray {
+		if it == nil || it.IsEmpty() {
+			continue
+		}
+		if txIn.Chain.Equals(common.XMRChain) && !it.ObservedVaultPubKey.IsEmpty() {
+			if a.Metrics != nil && a.Metrics.Exempt != nil {
+				a.Metrics.Exempt.WithLabelValues(txIn.Chain.String(), "xmr_pre_attributed").Inc()
+			}
+			continue
+		}
+		if it.Sender == it.To && it.Memo == "" {
+			continue
+		}
+		if o.pubkeyMgr == nil {
+			continue
+		}
+		toPool, _ := o.pubkeyMgr.IsValidPoolAddress(it.To, txIn.Chain)
+		if !toPool && !it.RecoveryOwned {
+			continue
+		}
+		if txIn.MemPool {
+			if fromPool, _ := o.pubkeyMgr.IsValidPoolAddress(it.Sender, txIn.Chain); !fromPool {
+				continue
+			}
+		}
+		eligible = append(eligible, it)
+	}
+	if len(eligible) == 0 {
+		return nil
+	}
+	ctx := o.afCtx
+	if ctx == nil {
+		ctx = context.Background()
+	}
+	return &afScreen{verdicts: a.Screen(ctx, txIn.Chain, eligible, 0), txIn: txIn}
+}
+
+// afSkip reports whether the screened inbound item must be dropped. It records
+// the replayable envelope first; a failed record keeps the item (observe).
+func (o *Observer) afSkip(chain common.Chain, item *types.TxInItem, cpi common.ChainPoolInfo, memPool bool, sc *afScreen) bool {
+	a := o.afAdapter
+	if a == nil || sc == nil {
+		return false
+	}
+	v, ok := sc.verdicts[a.Key(chain, item, 0)]
+	if !ok || !v.Skip {
+		return false
+	}
+	txCtx := addressfilter.TxInContext{
+		ObservedVaultPubKey: cpi.PubKey.String(),
+		Mempool:             memPool,
+	}
+	if sc.txIn != nil {
+		txCtx.ConfirmationRequired = sc.txIn.ConfirmationRequired
+		if sc.txIn.AllowFutureObservation {
+			txCtx.Extra = map[string]string{afExtraAllowFuture: "true"}
+		}
+	}
+	if err := a.RecordSkip(chain, item, 0, txCtx, v); err != nil {
+		o.logger.Error().Err(err).
+			Str("tx", item.Tx).Str("chain", chain.String()).
+			Msg("address_filter skip not recorded; observing instead")
+		return false
+	}
+	if o.addressFilterDropped != nil {
+		o.addressFilterDropped.WithLabelValues(chain.String()).Inc()
+	}
+	a.Metrics.CountSkip(chain.String())
+	o.logger.Warn().
+		Str("tx", item.Tx).Str("chain", chain.String()).Str("sender", item.Sender).
+		Msg("address_filter skipped (screening)")
+	return true
+}
+
+// addressFilterOnRelease returns the recheck release hook: replay (A5) when
+// replay_enabled, else nil (record-only: the record is released, nothing is
+// re-observed).
+func (o *Observer) addressFilterOnRelease(replay bool) func(*addressfilter.SkipEnvelope) error {
+	if !replay {
+		return nil
+	}
+	return o.replaySkipped
+}
+
+// replayTxIn rebuilds the TxIn the observer would have admitted at first sight
+// for a skipped occurrence (Filtered=true, vault attribution as recorded).
+func (o *Observer) replayTxIn(env *addressfilter.SkipEnvelope) (types.TxIn, error) {
+	chain, err := common.NewChain(env.Occurrence.Chain)
+	if err != nil {
+		return types.TxIn{}, fmt.Errorf("replay: chain %q: %w", env.Occurrence.Chain, err)
+	}
+	it := env.Item.Copy()
+	if env.Context.ObservedVaultPubKey != "" {
+		pk, err := common.NewPubKey(env.Context.ObservedVaultPubKey)
+		if err != nil {
+			return types.TxIn{}, fmt.Errorf("replay: vault pubkey: %w", err)
+		}
+		it.ObservedVaultPubKey = pk
+	}
+	txIn := types.TxIn{
+		Chain:                  chain,
+		TxArray:                []*types.TxInItem{it},
+		Filtered:               true,
+		MemPool:                env.Context.Mempool,
+		ConfirmationRequired:   env.Context.ConfirmationRequired,
+		AllowFutureObservation: env.Context.Extra[afExtraAllowFuture] == "true",
+	}
+	// The first-sight path computes confirmations after filtering, so the
+	// recorded value is usually 0: recompute it exactly as admission would.
+	if txIn.ConfirmationRequired == 0 {
+		if cc, err := o.getChain(chain); err == nil {
+			n, err := observationConfirmationCount(cc, txIn)
+			if err != nil {
+				return types.TxIn{}, fmt.Errorf("replay: confirmations: %w", err)
+			}
+			txIn.ConfirmationRequired = n
+		}
+	}
+	return txIn, nil
+}
+
+// replaySkipped re-observes a released skip through the normal admission
+// path (errata tombstones, dedup, deck). An occurrence that errata removed is
+// rejected there by the tombstone barrier and never re-observed.
+func (o *Observer) replaySkipped(env *addressfilter.SkipEnvelope) error {
+	txIn, err := o.replayTxIn(env)
+	if err != nil {
+		return err
+	}
+	return o.processObservedTx(txIn)
+}
+
+// drainSkipLedger replays every pending skip when the operator turned the
+// screening adapter off (filter disabled, or a static-only config) with
+// replay_enabled set (S-A2). It never drains because the adapter failed to
+// build (invalid config, build error, every source quarantined): those
+// records stay pending for when screening is back. A record whose sender the
+// static list still lists is kept, not replayed.
+func (o *Observer) drainSkipLedger(cfg config.BifrostAddressFilterConfiguration) {
+	if o.afAdapter != nil || !cfg.ReplayEnabled || o.storage == nil {
+		return
+	}
+	switch o.afDisabled {
+	case "disabled", "static_only":
+	default:
+		n, err := addressfilter.NewSkipLedger(o.storage, 0, nil, nil).Count()
+		if err == nil && n > 0 {
+			o.logger.Warn().Int("records", n).Str("reason", o.afDisabled).
+				Msg("address_filter adapter not running (not by choice): skip ledger kept, not drained")
+		}
+		return
+	}
+	ledger := addressfilter.NewSkipLedger(o.storage, 0, nil, nil)
+	n, err := ledger.Count()
+	if err != nil || n == 0 {
+		return
+	}
+	o.logger.Warn().Int("records", n).Msg("address_filter adapter off with replay_enabled: draining the skip ledger")
+	err = ledger.Drain(0, func(env *addressfilter.SkipEnvelope) error {
+		chain, cerr := common.NewChain(env.Occurrence.Chain)
+		if cerr == nil && !o.addressFilterProtectedSender(chain, env.Item.Sender) &&
+			(o.addressFilter.Listed(chain, env.Item.Sender) || o.afNamedStatic.Listed(chain, env.Item.Sender)) {
+			return addressfilter.ErrKeepRecord
+		}
+		return o.replaySkipped(env)
+	})
+	if err != nil {
+		o.logger.Error().Err(err).Msg("address_filter drain stopped; remaining records stay pending")
+	}
+}
+
+// AddressFilterAckDir is the list-ack marker directory for an observer data
+// path: a sibling of the observer database, never inside it.
+func AddressFilterAckDir(dataPath string) string {
+	return filepath.Join(filepath.Dir(filepath.Clean(dataPath)), "address_filter_ack")
+}
