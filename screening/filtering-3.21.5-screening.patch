+package config
+
+import (
+	"strings"
+	"testing"
+	"time"
+
+	"github.com/spf13/viper"
+)
+
+// unmarshalBifrost loads yaml into a viper and unmarshals bifrost with the
+// global config load's decode hook (as Init does).
+func unmarshalBifrost(t *testing.T, y string) (Bifrost, error) {
+	t.Helper()
+	vp := viper.New()
+	vp.SetConfigType("yaml")
+	if err := vp.ReadConfig(strings.NewReader(y)); err != nil {
+		t.Fatal(err)
+	}
+	var out struct {
+		Bifrost Bifrost `mapstructure:"bifrost"`
+	}
+	err := vp.Unmarshal(&out, configDecodeHook())
+	return out.Bifrost, err
+}
+
+// R3-A14: screening-adapter mistakes never fail the config load. The ADR's
+// auth map form decodes; type errors and unknown keys disable the adapter;
+// a bad source is quarantined; legacy keys still work.
+func TestAddressFilterDecodeNeverFailsLoad(t *testing.T) {
+	b, err := unmarshalBifrost(t, `
+bifrost:
+  address_filter:
+    enabled: true
+    addresses: "bc1qjwdw6vrzq4vf6hckutvx4ucj86awwv99mxnz7w"
+    screen_deadline: 2s
+    sources:
+      - name: elliptic
+        mode: query
+        chains: [BTC]
+        url: https://aml-api.elliptic.co/v2/wallet/synchronous
+        auth: {signer: elliptic-hmac, key_file: /secrets/elliptic.key, secret_file: /secrets/elliptic.secret}
+        threshold: 9
+        listed: '.risk_score >= $threshold'
+      - name: misttrack
+        mode: query
+        chains: [BTC]
+        url: https://openapi.misttrack.io/v3/risk_score
+        auth: {query: api_key, secret_file: /secrets/misttrack.key}
+        listed: '.success'
+      - name: typo
+        mode: query
+        chainz: [BTC]
+`)
+	if err != nil {
+		t.Fatalf("the load must not fail: %v", err)
+	}
+	af := b.AddressFilter
+	if !af.Enabled || af.Addresses == "" || af.ScreenDeadline != 2*time.Second || af.AdapterErr != nil {
+		t.Fatalf("decoded: %+v", af)
+	}
+	if len(af.Sources) != 3 {
+		t.Fatalf("sources: %d", len(af.Sources))
+	}
+	el, mt, typo := af.Sources[0], af.Sources[1], af.Sources[2]
+	if el.DecodeErr != nil || el.Auth != "signer:elliptic-hmac" || el.KeyFile != "/secrets/elliptic.key" ||
+		el.SecretFile != "/secrets/elliptic.secret" || el.Threshold == nil || *el.Threshold != 9 {
+		t.Fatalf("elliptic: %+v", el)
+	}
+	if mt.DecodeErr != nil || mt.Auth != "query" || mt.QueryParam != "api_key" || mt.SecretFile != "/secrets/misttrack.key" {
+		t.Fatalf("misttrack: %+v", mt)
+	}
+	if typo.DecodeErr == nil || typo.Name != "typo" || typo.Mode != "query" {
+		t.Fatalf("an unknown source key must quarantine that source by name: %+v", typo)
+	}
+
+	b, err = unmarshalBifrost(t, `
+bifrost:
+  address_filter:
+    enabled: true
+    addresses: "bc1qjwdw6vrzq4vf6hckutvx4ucj86awwv99mxnz7w"
+    screen_deadline: soon
+`)
+	if err != nil {
+		t.Fatalf("an adapter type error must not fail the load: %v", err)
+	}
+	if b.AddressFilter.AdapterErr == nil || !b.AddressFilter.Enabled || b.AddressFilter.Addresses == "" {
+		t.Fatalf("adapter disabled, legacy kept: %+v", b.AddressFilter)
+	}
+
+	b, err = unmarshalBifrost(t, `
+bifrost:
+  address_filter:
+    enabled: true
+    combin: all
+`)
+	if err != nil || b.AddressFilter.AdapterErr == nil {
+		t.Fatalf("an unknown top-level key disables the adapter: err=%v adapterErr=%v", err, b.AddressFilter.AdapterErr)
+	}
+}
+
+// The environment form: sources as a JSON string.
+func TestAddressFilterSourcesFromJSONString(t *testing.T) {
+	c, err := DecodeAddressFilter(map[string]any{
+		"enabled": true,
+		"sources": `[{"name":"lst","mode":"list","chains":["ETH"],"url":"http://127.0.0.1:1/l","listed":"."}]`,
+	})
+	if err != nil || c.AdapterErr != nil || len(c.Sources) != 1 || c.Sources[0].Name != "lst" || c.Sources[0].DecodeErr != nil {
+		t.Fatalf("decoded: %+v %v", c, err)
+	}
+	c, _ = DecodeAddressFilter(map[string]any{"enabled": true, "sources": "{not a list"})
+	if c.AdapterErr == nil {
+		t.Fatal("an unparseable sources string disables the adapter")
+	}
+}
+
+// N9: an address_filter value that is not a map fails the load, as before the
+// screening adapter; it never silently zeroes the filter (legacy list off).
+func TestAddressFilterNonMapFailsLoad(t *testing.T) {
+	for _, y := range []string{
+		"bifrost:\n  address_filter: \"bc1qjwdw6vrzq4vf6hckutvx4ucj86awwv99mxnz7w\"\n",
+		"bifrost:\n  address_filter: [1, 2]\n",
+		"bifrost:\n  address_filter: true\n",
+	} {
+		if _, err := unmarshalBifrost(t, y); err == nil {
+			t.Fatalf("a non-map address_filter must fail the load:\n%s", y)
+		}
+	}
+	// An absent value still loads (filter off).
+	b, err := unmarshalBifrost(t, "bifrost:\n  signer:\n    auto_observe: false\n")
+	if err != nil || b.AddressFilter.Enabled {
+		t.Fatalf("absent address_filter: err=%v enabled=%v", err, b.AddressFilter.Enabled)
+	}
+}
