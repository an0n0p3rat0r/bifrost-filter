diff --git a/bifrost/pkg/addressfilter/addressfilter.go b/bifrost/pkg/addressfilter/addressfilter.go
new file mode 100644
index 000000000..eafae0cc7
--- /dev/null
+++ b/bifrost/pkg/addressfilter/addressfilter.go
@@ -0,0 +1,268 @@
+// Package addressfilter implements the opt-in static inbound address filter.
+//
+// Operators configure a comma-separated list of sanctioned addresses; the
+// observer drops any inbound observation whose sender is in the set, before
+// the observation is signed or broadcast. The filter only ever drops inbounds
+// — it never fabricates or rewrites observations — so a bad entry can
+// over-block but never corrupt state.
+//
+// The chain is inferred only from unambiguous shapes; base58 and BTC bech32
+// entries must also pass their checksum and carry the chain's mainnet version
+// byte or HRP:
+//
+//	0x + 40 hex        -> all EVM chains (the same key controls a 0x address on
+//	                      every EVM chain, so one entry filters them all)
+//	bc1...             -> BTC segwit/taproot (valid mainnet bech32/bech32m,
+//	                      case-insensitive)
+//	thor1...           -> THOR (bech32, case-insensitive)
+//	kujira1...         -> KUJI (bech32, case-insensitive)
+//	maya1...           -> MAYA (bech32, case-insensitive)
+//	account_rdx1...    -> XRD (bech32m, case-insensitive; full account address)
+//	addr1...           -> ADA (Shelley bech32, case-insensitive)
+//	t1... / t3...      -> ZEC transparent (valid base58check, exact match)
+//	X... / 7...        -> DASH (valid base58check, exact match)
+//	1... / 3...        -> BTC legacy (valid base58check, exact match)
+//
+// Everything else needs an explicit "CHAIN:address" entry. An unprefixed
+// entry that matches none of the shapes above, or fails its checksum or
+// version check, is skipped and counted in Skipped, never guessed onto a
+// chain. Entries for chains MAYAChain does not support (e.g. SOL, TRON) are
+// skipped too. ADA Byron (base58) addresses and ZEC unified, shielded or TEX
+// addresses need an explicit "ADA:" / "ZEC:" prefix.
+package addressfilter
+
+import (
+	"strings"
+
+	"github.com/btcsuite/btcd/chaincfg"
+	"github.com/btcsuite/btcutil"
+	"github.com/btcsuite/btcutil/base58"
+
+	"gitlab.com/mayachain/mayanode/common"
+)
+
+// evmBucket is the set shared by all EVM chains.
+const evmBucket = "EVM"
+
+// Filter is a static set of listed addresses. It is read-only after New and
+// safe for concurrent use. A nil *Filter is valid and matches nothing, which
+// keeps the feature fully inert when disabled.
+type Filter struct {
+	sets    map[string]map[string]struct{}
+	loaded  int
+	skipped int
+}
+
+// New parses a comma-separated address list. Unparseable entries are skipped
+// (and counted) rather than failing startup: a typo must not take down the
+// observer, only narrow the filter.
+func New(addresses string) *Filter {
+	f := &Filter{sets: map[string]map[string]struct{}{}}
+	for _, entry := range strings.Split(addresses, ",") {
+		entry = strings.TrimSpace(entry)
+		if entry == "" {
+			continue
+		}
+		bucket, addr, ok := classify(entry)
+		if !ok {
+			f.skipped++
+			continue
+		}
+		set := f.sets[bucket]
+		if set == nil {
+			set = map[string]struct{}{}
+			f.sets[bucket] = set
+		}
+		if _, dup := set[addr]; !dup {
+			set[addr] = struct{}{}
+			f.loaded++
+		}
+	}
+	return f
+}
+
+// knownChains is the set of chain tickers accepted in explicit "CHAIN:"
+// prefixes; a typo'd ticker (e.g. ETC for ETH) is skipped rather than
+// silently creating an inert bucket.
+var knownChains = func() map[string]bool {
+	m := make(map[string]bool, len(common.AllChains))
+	for _, c := range common.AllChains {
+		m[c.String()] = true
+	}
+	return m
+}()
+
+// bech32Prefixes maps a lowercase human-readable prefix (including the
+// separator) to the chain it infers.
+var bech32Prefixes = []struct {
+	prefix string
+	chain  common.Chain
+}{
+	{"bc1", common.BTCChain},
+	{"thor1", common.THORChain},
+	{"kujira1", common.KUJIChain},
+	{"maya1", common.BASEChain},
+	{common.RadixAccountAddressPrefix, common.XRDChain},
+	{"addr1", common.ADAChain},
+}
+
+// classify returns the set bucket and normalized form for one config entry.
+func classify(entry string) (bucket, addr string, ok bool) {
+	// explicit "CHAIN:address" override
+	if ticker, rest, found := strings.Cut(entry, ":"); found && ticker != "" {
+		chain, err := common.NewChain(strings.ToUpper(ticker))
+		if err != nil || rest == "" || !knownChains[chain.String()] {
+			return "", "", false
+		}
+		return bucketForChain(chain), normalize(chain, rest), true
+	}
+	lower := strings.ToLower(entry)
+	switch {
+	case len(entry) == 42 && strings.HasPrefix(entry, "0x") && isHex(entry[2:]):
+		return evmBucket, lower, true
+	}
+	for _, p := range bech32Prefixes {
+		if len(lower) > len(p.prefix) && strings.HasPrefix(lower, p.prefix) {
+			if p.chain.Equals(common.BTCChain) && !isBTCSegwit(lower) {
+				return "", "", false
+			}
+			return p.chain.String(), lower, true
+		}
+	}
+	switch {
+	case len(entry) == 35 && (strings.HasPrefix(entry, "t1") || strings.HasPrefix(entry, "t3")) && isZECTransparent(entry):
+		return common.ZECChain.String(), entry, true
+	case len(entry) == 34 && (entry[0] == 'X' || entry[0] == '7') && isDASH(entry):
+		return common.DASHChain.String(), entry, true
+	case len(entry) >= 26 && len(entry) <= 35 && (entry[0] == '1' || entry[0] == '3') && isBTCLegacy(entry):
+		return common.BTCChain.String(), entry, true
+	}
+	// anything else is ambiguous across chains and needs a "CHAIN:" prefix
+	return "", "", false
+}
+
+// isBTCSegwit reports whether s (lowercase) is a valid BTC mainnet segwit or
+// taproot address: correct "bc" HRP, bech32/bech32m checksum and witness
+// program. A typo fails the checksum and is skipped instead of loading an
+// entry that can never match.
+func isBTCSegwit(s string) bool {
+	addr, err := btcutil.DecodeAddress(s, &chaincfg.MainNetParams)
+	if err != nil || !addr.IsForNet(&chaincfg.MainNetParams) {
+		return false
+	}
+	switch addr.(type) {
+	case *btcutil.AddressWitnessPubKeyHash, *btcutil.AddressWitnessScriptHash, *btcutil.AddressTaproot:
+		return true
+	}
+	return false
+}
+
+// isBTCLegacy reports whether s is a valid base58check BTC mainnet P2PKH or
+// P2SH address. Other chains' base58 addresses fail the version-byte or
+// checksum check.
+func isBTCLegacy(s string) bool {
+	payload, version, err := base58.CheckDecode(s)
+	return err == nil && len(payload) == 20 &&
+		(version == chaincfg.MainNetParams.PubKeyHashAddrID || version == chaincfg.MainNetParams.ScriptHashAddrID)
+}
+
+// DASH mainnet base58check version bytes (P2PKH "X...", P2SH "7...").
+const (
+	dashPubKeyHashAddrID = 0x4c
+	dashScriptHashAddrID = 0x10
+)
+
+// isDASH reports whether s is a valid base58check DASH mainnet address.
+func isDASH(s string) bool {
+	payload, version, err := base58.CheckDecode(s)
+	return err == nil && len(payload) == 20 &&
+		(version == dashPubKeyHashAddrID || version == dashScriptHashAddrID)
+}
+
+// isZECTransparent reports whether s is a valid base58check ZEC mainnet
+// transparent address. ZEC uses a two-byte prefix: 0x1cb8 (t1, P2PKH) and
+// 0x1cbd (t3, P2SH); CheckDecode returns the first byte as the version.
+func isZECTransparent(s string) bool {
+	payload, version, err := base58.CheckDecode(s)
+	return err == nil && version == 0x1c && len(payload) == 21 &&
+		(payload[0] == 0xb8 || payload[0] == 0xbd)
+}
+
+// bucketForChain maps an explicit chain to its set, sharing one set across
+// EVM chains just like shape inference does.
+func bucketForChain(chain common.Chain) string {
+	if chain.IsEVM() {
+		return evmBucket
+	}
+	return chain.String()
+}
+
+// normalize applies the per-chain comparison form: EVM and bech32/bech32m
+// encodings match case-insensitively (checksummed / mixed-case encodings),
+// base58 encodings are exact.
+func normalize(chain common.Chain, addr string) string {
+	if chain.IsEVM() {
+		return strings.ToLower(addr)
+	}
+	lower := strings.ToLower(addr)
+	switch {
+	case chain.Equals(common.THORChain), chain.Equals(common.KUJIChain),
+		chain.Equals(common.BASEChain), chain.Equals(common.XRDChain):
+		// bech32/bech32m only
+		return lower
+	case chain.Equals(common.BTCChain):
+		if strings.HasPrefix(lower, "bc1") {
+			return lower
+		}
+	case chain.Equals(common.ADAChain):
+		if strings.HasPrefix(lower, "addr1") {
+			return lower
+		}
+	case chain.Equals(common.ZECChain):
+		// unified / sapling / TEX encodings are bech32(m); t-addrs are base58
+		if strings.HasPrefix(lower, "u1") || strings.HasPrefix(lower, "zs1") || strings.HasPrefix(lower, "tex1") {
+			return lower
+		}
+	}
+	return addr
+}
+
+// Listed reports whether address on chain is in the filter set.
+func (f *Filter) Listed(chain common.Chain, address string) bool {
+	if f == nil {
+		return false
+	}
+	set := f.sets[bucketForChain(chain)]
+	if set == nil {
+		return false
+	}
+	_, ok := set[normalize(chain, address)]
+	return ok
+}
+
+// Loaded returns the number of deduplicated entries in the set.
+func (f *Filter) Loaded() int {
+	if f == nil {
+		return 0
+	}
+	return f.loaded
+}
+
+// Skipped returns the number of config entries dropped as unparseable or for
+// chains MAYAChain does not support.
+func (f *Filter) Skipped() int {
+	if f == nil {
+		return 0
+	}
+	return f.skipped
+}
+
+func isHex(s string) bool {
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if (c < '0' || c > '9') && (c < 'a' || c > 'f') && (c < 'A' || c > 'F') {
+			return false
+		}
+	}
+	return len(s) > 0
+}
