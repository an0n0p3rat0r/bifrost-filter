+// Finding 8: one chain can't fill the ledger for the others.
+func TestSkipLedgerPerChainCap(t *testing.T) {
+	store := NewMemLedgerStore()
+	l := NewSkipLedger(store, 8, nil, nil) // per-chain cap 8/4 = 2
+	rec := func(chain, tx string) error {
+		e := testEnvelope(t, fillTxInItem(t))
+		e.Occurrence.Chain, e.Occurrence.TxID = chain, tx
+		return l.Record(e)
+	}
+	for i := 0; i < 2; i++ {
+		if err := rec("DOGE", fmt.Sprintf("d%d", i)); err != nil {
+			t.Fatal(err)
+		}
+	}
+	if err := rec("DOGE", "d-over"); !errors.Is(err, ErrLedgerFull) {
+		t.Fatalf("DOGE past its share: %v, want ErrLedgerFull", err)
+	}
+	if err := rec("BTC", "b0"); err != nil {
+		t.Fatalf("BTC must still record: %v", err)
+	}
+}
