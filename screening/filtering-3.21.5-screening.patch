+// Finding 14: record-only mode keeps the evidence: a released record moves to
+// the archive as released, it is not deleted.
+func TestRecordOnlyReleaseKeepsEvidence(t *testing.T) {
+	f := newRecheckFixture(t)
+	env := f.record(t, "bc1qnolongerlisted", "tx1")
+	src := &fnSource{name: "gj", answer: func(context.Context, ItemDTO) Answer { return Answer{State: Clean} }}
+	r := NewRechecker(RecheckerOptions{Ledger: f.l, Sources: []Source{src}, Guard: f.g, Now: f.clk.now})
+	if st := r.Tick(context.Background()); st.Released != 1 {
+		t.Fatalf("released=%d", st.Released)
+	}
+	if n, _ := f.l.Count(); n != 0 {
+		t.Fatal("the record must leave the live ledger")
+	}
+	b, ok := f.store.Archived(env.Key())
+	if !ok {
+		t.Fatal("record-only release deleted the evidence")
+	}
+	var back SkipEnvelope
+	if err := json.Unmarshal(b, &back); err != nil || back.State != SkipReleased || back.Item.Sender != "bc1qnolongerlisted" {
+		t.Fatalf("archived record: %+v %v", back, err)
+	}
+}
