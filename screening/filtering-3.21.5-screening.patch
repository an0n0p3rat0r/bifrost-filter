+func TestSkipEnvelopeRoundTripsEveryTxInItemField(t *testing.T) {
+	it := fillTxInItem(t)
+	env := testEnvelope(t, it)
+	b, err := json.Marshal(env)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var back SkipEnvelope
+	if err := json.Unmarshal(b, &back); err != nil {
+		t.Fatal(err)
+	}
+	v, w := reflect.ValueOf(it), reflect.ValueOf(back.Item)
+	for i := 0; i < v.NumField(); i++ {
+		f := v.Type().Field(i)
+		if f.Tag.Get("json") == "-" {
+			continue
+		}
+		a, _ := json.Marshal(v.Field(i).Interface())
+		c, _ := json.Marshal(w.Field(i).Interface())
+		if string(a) != string(c) {
+			t.Fatalf("TxInItem.%s lost in the envelope: %s != %s", f.Name, a, c)
+		}
+		if w.Field(i).IsZero() {
+			t.Fatalf("TxInItem.%s came back zero", f.Name)
+		}
+	}
+	if !reflect.DeepEqual(env.Screening.Answers, back.Screening.Answers) || back.Occurrence != env.Occurrence {
+		t.Fatal("screening/occurrence lost")
+	}
+}
