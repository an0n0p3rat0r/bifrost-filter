diff --git a/bifrost/pkg/addressfilter/transport.go b/bifrost/pkg/addressfilter/transport.go
new file mode 100644
index 00000000000..0eec71c49cd
--- /dev/null
+++ b/bifrost/pkg/addressfilter/transport.go
@@ -0,0 +1,209 @@
+package addressfilter
+
+import (
+	"context"
+	"crypto/tls"
+	"errors"
+	"fmt"
+	"io"
+	"net"
+	"net/http"
+	"net/url"
+	"syscall"
+	"time"
+)
+
+// ErrRedirectRefused is returned when a source answers with a redirect the
+// policy does not allow (any redirect on an authenticated request; any
+// redirect unless follow_redirects: same-origin-https).
+var ErrRedirectRefused = errors.New("redirect refused")
+
+// ErrDestinationRefused is returned when a resolved IP is not allowed.
+var ErrDestinationRefused = errors.New("destination address refused")
+
+// ErrResponseTooLarge is returned when a body exceeds the source's max_bytes.
+var ErrResponseTooLarge = errors.New("response exceeds max_bytes")
+
+const maxRedirects = 3
+
+var blockedNets = func() []*net.IPNet {
+	var out []*net.IPNet
+	for _, c := range []string{
+		"0.0.0.0/8", "100.64.0.0/10", "192.0.0.0/24", "198.18.0.0/15", "240.0.0.0/4",
+		"64:ff9b::/96", "2001:db8::/32",
+	} {
+		_, n, _ := net.ParseCIDR(c)
+		out = append(out, n)
+	}
+	return out
+}()
+
+// publicIP reports whether ip is a routable public address.
+func publicIP(ip net.IP) bool {
+	if ip.IsPrivate() || ip.IsLoopback() || ip.IsLinkLocalUnicast() || ip.IsLinkLocalMulticast() ||
+		ip.IsInterfaceLocalMulticast() || ip.IsMulticast() || ip.IsUnspecified() {
+		return false
+	}
+	for _, n := range blockedNets {
+		if n.Contains(ip) {
+			return false
+		}
+	}
+	return true
+}
+
+// TransportPolicy is the egress policy of one source.
+type TransportPolicy struct {
+	// Proxy is the HTTP CONNECT egress (nil = direct, only if allowed).
+	Proxy *url.URL
+	// AllowPrivate permits private/link-local destinations.
+	AllowPrivate bool
+	// Loopback is true when the source URL host is loopback; loopback IPs
+	// are then allowed.
+	Loopback bool
+	// FollowSameOriginHTTPS enables the same-origin-https redirect opt-in.
+	FollowSameOriginHTTPS bool
+	// Signed is true when requests carry auth; redirects are then refused.
+	Signed bool
+	// TLS overrides the TLS config (tests); nil = system roots, TLS 1.2+.
+	TLS *tls.Config
+}
+
+// PolicyFor derives a source's transport policy from its validated spec.
+func PolicyFor(spec SourceSpec, signed bool) (TransportPolicy, error) {
+	p := TransportPolicy{
+		AllowPrivate:          spec.Raw.AllowPrivate,
+		FollowSameOriginHTTPS: spec.Raw.FollowRedirects == "same-origin-https",
+		Signed:                signed,
+	}
+	u, err := url.Parse(spec.Raw.URL)
+	if err != nil {
+		return p, err
+	}
+	p.Loopback = isLoopbackHost(u.Hostname())
+	if spec.Raw.ProxyURL != "" {
+		pu, err := url.Parse(spec.Raw.ProxyURL)
+		if err != nil || pu.Host == "" || (pu.Scheme != "http" && pu.Scheme != "https") {
+			return p, fmt.Errorf("bad proxy_url")
+		}
+		p.Proxy = pu
+	}
+	return p, nil
+}
+
+// allowIP applies the destination rule to one resolved IP.
+func (p TransportPolicy) allowIP(ip net.IP) bool {
+	if p.AllowPrivate || publicIP(ip) {
+		return true
+	}
+	return p.Loopback && ip.IsLoopback()
+}
+
+// NewHTTPClient builds the client for a source. Environment proxies are never
+// used; the only proxy is the configured one. Resolved IPs are checked at
+// connect time for direct connections (the configured proxy itself is the
+// operator's choice and exempt).
+func NewHTTPClient(p TransportPolicy) *http.Client {
+	proxyAddr := ""
+	if p.Proxy != nil {
+		proxyAddr = p.Proxy.Host
+		if p.Proxy.Port() == "" {
+			if p.Proxy.Scheme == "https" {
+				proxyAddr = net.JoinHostPort(p.Proxy.Hostname(), "443")
+			} else {
+				proxyAddr = net.JoinHostPort(p.Proxy.Hostname(), "80")
+			}
+		}
+	}
+	guarded := &net.Dialer{
+		Timeout: 5 * time.Second,
+		Control: func(_, address string, _ syscall.RawConn) error {
+			host, _, err := net.SplitHostPort(address)
+			if err != nil {
+				return err
+			}
+			ip := net.ParseIP(host)
+			if ip == nil || !p.allowIP(ip) {
+				return ErrDestinationRefused
+			}
+			return nil
+		},
+	}
+	plain := &net.Dialer{Timeout: 5 * time.Second}
+	tlsCfg := p.TLS
+	if tlsCfg == nil {
+		tlsCfg = &tls.Config{MinVersion: tls.VersionTLS12}
+	}
+	tr := &http.Transport{
+		Proxy: nil,
+		DialContext: func(ctx context.Context, network, addr string) (net.Conn, error) {
+			if proxyAddr != "" && addr == proxyAddr {
+				return plain.DialContext(ctx, network, addr)
+			}
+			return guarded.DialContext(ctx, network, addr)
+		},
+		TLSClientConfig:       tlsCfg,
+		TLSHandshakeTimeout:   5 * time.Second,
+		ResponseHeaderTimeout: 10 * time.Second,
+		MaxIdleConnsPerHost:   8,
+		IdleConnTimeout:       90 * time.Second,
+		ForceAttemptHTTP2:     true,
+	}
+	if p.Proxy != nil {
+		tr.Proxy = http.ProxyURL(p.Proxy)
+	}
+	return &http.Client{
+		Transport: tr,
+		CheckRedirect: func(req *http.Request, via []*http.Request) error {
+			if p.Signed || !p.FollowSameOriginHTTPS || len(via) >= maxRedirects {
+				return ErrRedirectRefused
+			}
+			orig := via[0].URL
+			if req.URL.Scheme != "https" || req.URL.Host != orig.Host {
+				return ErrRedirectRefused
+			}
+			return nil
+		},
+	}
+}
+
+// ReadCapped reads at most max bytes; more is ErrResponseTooLarge.
+func ReadCapped(r io.Reader, max int64) ([]byte, error) {
+	if max <= 0 {
+		max = DefaultMaxBytes
+	}
+	b, err := io.ReadAll(io.LimitReader(r, max+1))
+	if err != nil {
+		return nil, err
+	}
+	if int64(len(b)) > max {
+		return nil, ErrResponseTooLarge
+	}
+	return b, nil
+}
+
+// Send performs a built request and reads the body under maxBytes. Every
+// error (transport, status, size) is scrubbed by the request's redactor; a
+// non-2xx status carries at most 256 bytes of the (scrubbed) body.
+func Send(client *http.Client, br *BuiltRequest, maxBytes int64) (status int, header http.Header, body []byte, err error) {
+	resp, err := client.Do(br.Req)
+	if err != nil {
+		return 0, nil, nil, br.Redactor.Error(err)
+	}
+	defer resp.Body.Close()
+	body, err = ReadCapped(resp.Body, maxBytes)
+	if err != nil {
+		return resp.StatusCode, resp.Header, nil, br.Redactor.Error(err)
+	}
+	if resp.StatusCode == http.StatusNotModified {
+		return resp.StatusCode, resp.Header, nil, nil
+	}
+	if resp.StatusCode < 200 || resp.StatusCode > 299 {
+		snip := body
+		if len(snip) > 256 {
+			snip = snip[:256]
+		}
+		return resp.StatusCode, resp.Header, nil, br.Redactor.Error(fmt.Errorf("status %d: %s", resp.StatusCode, snip))
+	}
+	return resp.StatusCode, resp.Header, body, nil
+}
