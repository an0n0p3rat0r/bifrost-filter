+
+func TestReplayIsByteIdenticalToFirstSight(t *testing.T) {
+	const listed = "bc1qjwdw6vrzq4vf6hckutvx4ucj86awwv99mxnz7w"
+	var deckLocked atomic.Bool
+	src := &fakeListSource{listed: listed, deckLocked: &deckLocked}
+	screened, vaultAddr := newScreeningObserver(t, 0, src)
+	mk := func() *types.TxInItem {
+		return &types.TxInItem{Tx: "cc01", Sender: listed, To: vaultAddr, Memo: "SWAP:ETH.ETH", BlockHeight: 100,
+			Coins: common.NewCoins(common.NewCoin(common.BTCAsset, cosmos.NewUint(7)))}
+	}
+	// First sight without screening: the reference observation.
+	plain, _ := newErrataOrderingObserver(t)
+	plain.pubkeyMgr, plain.signedTxOutCache = screened.pubkeyMgr, screened.signedTxOutCache
+	require.NoError(t, plain.processObservedTx(types.TxIn{Chain: common.BTCChain, TxArray: []*types.TxInItem{mk()}}))
+	want := deckJSON(t, plain)
+	require.Len(t, want, 1)
+
+	require.NoError(t, screened.processObservedTx(types.TxIn{Chain: common.BTCChain, TxArray: []*types.TxInItem{mk()}}))
+	require.Empty(t, screened.onDeck, "skipped at first sight")
+	envs := pendingEnvelopes(t, screened.afAdapter, screened.storage)
+	require.Len(t, envs, 1)
+	require.NoError(t, screened.replaySkipped(envs[0]))
+	require.Equal(t, want, deckJSON(t, screened), "replay builds the first-sight observation")
+}
+
+func TestReplayOfErrataRemovedOccurrenceIsDropped(t *testing.T) {
+	const listed = "bc1qjwdw6vrzq4vf6hckutvx4ucj86awwv99mxnz7w"
+	var deckLocked atomic.Bool
+	src := &fakeListSource{listed: listed, deckLocked: &deckLocked}
+	o, vaultAddr := newScreeningObserver(t, 0, src)
+	item := &types.TxInItem{Tx: "dd01", Sender: listed, To: vaultAddr, Memo: "SWAP:ETH.ETH", BlockHeight: 100,
+		Coins: common.NewCoins(common.NewCoin(common.BTCAsset, cosmos.NewUint(7)))}
+	require.NoError(t, o.processObservedTx(types.TxIn{Chain: common.BTCChain, TxArray: []*types.TxInItem{item}}))
+	envs := pendingEnvelopes(t, o.afAdapter, o.storage)
+	require.Len(t, envs, 1) // loaded by a recheck before the errata lands
+	require.NoError(t, o.filterErrataTx(types.ErrataBlock{Height: 100, Txs: []types.ErrataTx{{Chain: common.BTCChain, TxID: "dd01"}}}))
+	n, err := o.afAdapter.Ledger.Count()
+	require.NoError(t, err)
+	require.Zero(t, n, "errata removed the envelope")
+	_ = o.replaySkipped(envs[0])
+	require.Empty(t, o.onDeck, "the errata tombstone stops the stale replay")
+}
+
+func TestDrainOnDisableReplaysOnlyWhenEnabled(t *testing.T) {
+	const listed = "bc1qjwdw6vrzq4vf6hckutvx4ucj86awwv99mxnz7w"
+	var deckLocked atomic.Bool
+	src := &fakeListSource{listed: listed, deckLocked: &deckLocked}
+	o, vaultAddr := newScreeningObserver(t, 0, src)
+	item := &types.TxInItem{Tx: "ee01", Sender: listed, To: vaultAddr, Memo: "SWAP:ETH.ETH", BlockHeight: 100,
+		Coins: common.NewCoins(common.NewCoin(common.BTCAsset, cosmos.NewUint(7)))}
+	require.NoError(t, o.processObservedTx(types.TxIn{Chain: common.BTCChain, TxArray: []*types.TxInItem{item}}))
+	// The operator now disables the filter: no adapter on this observer.
+	o.stopAddressFilter()
+	o.afAdapter = o.newAddressFilterAdapter(config.BifrostAddressFilterConfiguration{Enabled: false}, t.TempDir())
+	require.Nil(t, o.afAdapter)
+
+	o.drainSkipLedger(config.BifrostAddressFilterConfiguration{ReplayEnabled: false})
+	require.Empty(t, o.onDeck, "replay off: records stay, nothing re-observed")
+	n, err := addressfilter.NewSkipLedger(o.storage, 0, nil, nil).Count()
+	require.NoError(t, err)
+	require.Equal(t, 1, n)
+
+	o.drainSkipLedger(config.BifrostAddressFilterConfiguration{ReplayEnabled: true})
+	require.Len(t, deckJSON(t, o), 1, "drain replays through admission")
+	n, err = addressfilter.NewSkipLedger(o.storage, 0, nil, nil).Count()
+	require.NoError(t, err)
+	require.Zero(t, n, "drained records are released")
+}
diff --git a/bifrost/observer/addressfilter_storage.go b/bifrost/observer/addressfilter_storage.go
new file mode 100644
index 00000000000..aa2ab21afe7
--- /dev/null
+++ b/bifrost/observer/addressfilter_storage.go
@@ -0,0 +1,415 @@
+package observer
+
+import (
+	"encoding/binary"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"strconv"
+	"strings"
+	"time"
+
+	"github.com/syndtr/goleveldb/leveldb"
+	"github.com/syndtr/goleveldb/leveldb/opt"
+	"github.com/syndtr/goleveldb/leveldb/util"
+
+	"gitlab.com/thorchain/thornode/v3/bifrost/pkg/addressfilter"
+	"gitlab.com/thorchain/thornode/v3/bifrost/thorclient/types"
+	"gitlab.com/thorchain/thornode/v3/common"
+)
+
+// Address-filter buckets in the observer store (A4.2). Distinct top-level
+// prefixes, so no existing scan (deck, errata, receipts) can read them.
+const (
+	afSkipEnvPrefix  = "af-skip-env-v1:"   // key -> 8-byte next_check nanos + envelope JSON
+	afSkipDuePrefix  = "af-skip-due-v1:"   // %020d next_check nanos | key -> empty
+	afSkipArchPrefix = "af-skip-arch-v1:"  // key -> archived envelope JSON (never deleted)
+	afBudgetPrefix   = "af-budget-v1:"     // credential|chain|day -> 8-byte count
+	afGuardKeyPrefix = "af-guard-key-v1:"  // kind|chain|address|pubkey -> GuardRow JSON
+	afGuardTombPrefx = "af-guard-tomb-v1:" // chain|address -> GuardTombstone JSON
+)
+
+var (
+	_ addressfilter.LedgerStore = (*ObserverStorage)(nil)
+	_ addressfilter.BudgetStore = (*ObserverStorage)(nil)
+	_ addressfilter.GuardStore  = (*ObserverStorage)(nil)
+)
+
+// afMaxDue is the latest instant representable in UnixNano; later times
+// (e.g. the ledger's drain sentinel) clamp to it instead of overflowing.
+var afMaxDue = time.Unix(0, math.MaxInt64)
+
+func afDueKey(next time.Time, key string) []byte {
+	var n int64
+	switch {
+	case !next.Before(afMaxDue):
+		n = math.MaxInt64
+	case next.Before(time.Unix(0, 0)):
+		n = 0
+	default:
+		n = next.UnixNano()
+	}
+	return []byte(fmt.Sprintf("%s%020d|%s", afSkipDuePrefix, n, key))
+}
+
+func afEnvKey(key string) []byte { return []byte(afSkipEnvPrefix + key) }
+
+// readEnvRow returns the stored next_check and envelope bytes.
+func (s *ObserverStorage) readEnvRow(key string) (time.Time, []byte, bool, error) {
+	v, err := s.db.Get(afEnvKey(key), nil)
+	if errors.Is(err, leveldb.ErrNotFound) {
+		return time.Time{}, nil, false, nil
+	}
+	if err != nil {
+		return time.Time{}, nil, false, err
+	}
+	if len(v) < 8 {
+		return time.Time{}, nil, false, fmt.Errorf("skip ledger row %q is corrupt", key)
+	}
+	next := time.Unix(0, int64(binary.BigEndian.Uint64(v[:8])))
+	return next, v[8:], true, nil
+}
+
+// PutEnvelope writes (or rewrites) a pending envelope and its due index.
+func (s *ObserverStorage) PutEnvelope(key string, env []byte, next time.Time) error {
+	s.afMu.Lock()
+	defer s.afMu.Unlock()
+	batch := new(leveldb.Batch)
+	old, _, existed, err := s.readEnvRow(key)
+	if err != nil {
+		return err
+	}
+	if existed {
+		batch.Delete(afDueKey(old, key))
+	}
+	row := make([]byte, 8+len(env))
+	n := next.UnixNano()
+	if n < 0 {
+		n = 0
+	}
+	binary.BigEndian.PutUint64(row[:8], uint64(n))
+	copy(row[8:], env)
+	batch.Put(afEnvKey(key), row)
+	batch.Put(afDueKey(next, key), nil)
+	if err := s.db.Write(batch, &opt.WriteOptions{Sync: true}); err != nil {
+		return err
+	}
+	if !existed {
+		s.afCountAddLocked(key, 1)
+	}
+	return nil
+}
+
+// afCountAddLocked adjusts the cached per-chain count (no-op until loaded).
+// Caller holds afMu.
+func (s *ObserverStorage) afCountAddLocked(key string, d int) {
+	if !s.afCountsOK {
+		return
+	}
+	c := addressfilter.LedgerKeyChain(key)
+	s.afCounts[c] += d
+	if s.afCounts[c] <= 0 {
+		delete(s.afCounts, c)
+	}
+	sk := addressfilter.LedgerKeySenderKey(key)
+	s.afSenderCounts[sk] += d
+	if s.afSenderCounts[sk] <= 0 {
+		delete(s.afSenderCounts, sk)
+	}
+}
+
+// afLoadCountsLocked scans the live records once. Caller holds afMu.
+func (s *ObserverStorage) afLoadCountsLocked() error {
+	if s.afCountsOK {
+		return nil
+	}
+	counts := map[string]int{}
+	senders := map[string]int{}
+	iter := s.db.NewIterator(util.BytesPrefix([]byte(afSkipEnvPrefix)), nil)
+	defer iter.Release()
+	for iter.Next() {
+		key := string(iter.Key())[len(afSkipEnvPrefix):]
+		counts[addressfilter.LedgerKeyChain(key)]++
+		senders[addressfilter.LedgerKeySenderKey(key)]++
+	}
+	if err := iter.Error(); err != nil {
+		return err
+	}
+	s.afCounts, s.afSenderCounts, s.afCountsOK = counts, senders, true
+	return nil
+}
+
+// GetEnvelope reads a pending envelope.
+func (s *ObserverStorage) GetEnvelope(key string) ([]byte, bool, error) {
+	_, env, ok, err := s.readEnvRow(key)
+	return env, ok, err
+}
+
+func (s *ObserverStorage) deleteEnvelopeInBatch(batch *leveldb.Batch, key string) (bool, error) {
+	old, _, ok, err := s.readEnvRow(key)
+	if err != nil || !ok {
+		return false, err
+	}
+	batch.Delete(afEnvKey(key))
+	batch.Delete(afDueKey(old, key))
+	return true, nil
+}
+
+// DeleteEnvelope removes a released envelope.
+func (s *ObserverStorage) DeleteEnvelope(key string) error {
+	s.afMu.Lock()
+	defer s.afMu.Unlock()
+	batch := new(leveldb.Batch)
+	if ok, err := s.deleteEnvelopeInBatch(batch, key); err != nil || !ok {
+		return err
+	}
+	if err := s.db.Write(batch, &opt.WriteOptions{Sync: true}); err != nil {
+		return err
+	}
+	s.afCountAddLocked(key, -1)
+	return nil
+}
+
+// ArchiveEnvelope moves an envelope to the archive bucket atomically.
+func (s *ObserverStorage) ArchiveEnvelope(key string, env []byte) error {
+	s.afMu.Lock()
+	defer s.afMu.Unlock()
+	batch := new(leveldb.Batch)
+	live, err := s.deleteEnvelopeInBatch(batch, key)
+	if err != nil {
+		return err
+	}
+	batch.Put([]byte(afSkipArchPrefix+key), env)
+	if err := s.db.Write(batch, &opt.WriteOptions{Sync: true}); err != nil {
+		return err
+	}
+	if live {
+		s.afCountAddLocked(key, -1)
+	}
+	return nil
+}
+
+// ArchivedEnvelope reads an archived envelope (operators, tests).
+func (s *ObserverStorage) ArchivedEnvelope(key string) ([]byte, bool, error) {
+	v, err := s.db.Get([]byte(afSkipArchPrefix+key), nil)
+	if errors.Is(err, leveldb.ErrNotFound) {
+		return nil, false, nil
+	}
+	return v, err == nil, err
+}
+
+// Due lists up to limit keys due at or before now, oldest next_check first.
+func (s *ObserverStorage) Due(now time.Time, limit int) ([]string, error) {
+	var end []byte
+	if now.Before(afMaxDue) {
+		end = afDueKey(now.Add(time.Nanosecond), "")
+	} else {
+		// Past the representable range: every row is due.
+		end = []byte(afSkipDuePrefix + "~")
+	}
+	iter := s.db.NewIterator(&util.Range{Start: []byte(afSkipDuePrefix), Limit: end}, nil)
+	defer iter.Release()
+	var out []string
+	for iter.Next() {
+		k := string(iter.Key())[len(afSkipDuePrefix):]
+		i := strings.IndexByte(k, '|')
+		if i < 0 {
+			continue
+		}
+		out = append(out, k[i+1:])
+		if limit > 0 && len(out) >= limit {
+			break
+		}
+	}
+	return out, iter.Error()
+}
+
+// Count is the number of pending envelopes (cached; see afCounts).
+func (s *ObserverStorage) Count() (int, error) {
+	s.afMu.Lock()
+	defer s.afMu.Unlock()
+	if err := s.afLoadCountsLocked(); err != nil {
+		return 0, err
+	}
+	n := 0
+	for _, c := range s.afCounts {
+		n += c
+	}
+	return n, nil
+}
+
+// CountChain is the number of pending envelopes of one chain (cached).
+func (s *ObserverStorage) CountChain(chain string) (int, error) {
+	s.afMu.Lock()
+	defer s.afMu.Unlock()
+	if err := s.afLoadCountsLocked(); err != nil {
+		return 0, err
+	}
+	return s.afCounts[chain], nil
+}
+
+// CountSender is the number of pending envelopes of one sender on one chain
+// (cached, case-insensitive).
+func (s *ObserverStorage) CountSender(chain, sender string) (int, error) {
+	s.afMu.Lock()
+	defer s.afMu.Unlock()
+	if err := s.afLoadCountsLocked(); err != nil {
+		return 0, err
+	}
+	return s.afSenderCounts[addressfilter.LedgerSenderKey(chain, sender)], nil
+}
+
+// appendSkipErrataCleanup deletes, in the errata batch, every pending
+// envelope of an errata'd (chain, tx) occurrence at the errata height (all
+// heights when the block height is unknown). Caller holds afMu.
+func (s *ObserverStorage) appendSkipErrataCleanup(batch *leveldb.Batch, block types.ErrataBlock) error {
+	for _, tx := range block.Txs {
+		prefix := afSkipEnvPrefix + tx.Chain.String() + "|"
+		iter := s.db.NewIterator(util.BytesPrefix([]byte(prefix)), nil)
+		for iter.Next() {
+			key := string(iter.Key())[len(afSkipEnvPrefix):]
+			parts := strings.SplitN(key, "|", 4) // chain|txid|height|rest
+			if len(parts) < 4 || !strings.EqualFold(parts[1], tx.TxID.String()) {
+				continue
+			}
+			if block.Height > 0 && parts[2] != strconv.FormatInt(block.Height, 10) {
+				continue
+			}
+			v := iter.Value()
+			if len(v) < 8 {
+				continue
+			}
+			batch.Delete([]byte(afSkipEnvPrefix + key))
+			batch.Delete(afDueKey(time.Unix(0, int64(binary.BigEndian.Uint64(v[:8]))), key))
+		}
+		err := iter.Error()
+		iter.Release()
+		if err != nil {
+			return fmt.Errorf("scan skip ledger for errata: %w", err)
+		}
+	}
+	return nil
+}
+
+// ---- BudgetStore ----
+
+func afBudgetKey(cred string, chain common.Chain, day string) []byte {
+	return []byte(afBudgetPrefix + cred + "|" + chain.String() + "|" + day)
+}
+
+func (s *ObserverStorage) budgetGet(k []byte) (uint64, error) {
+	v, err := s.db.Get(k, nil)
+	if errors.Is(err, leveldb.ErrNotFound) {
+		return 0, nil
+	}
+	if err != nil {
+		return 0, err
+	}
+	if len(v) != 8 {
+		return 0, fmt.Errorf("budget counter %q is corrupt", k)
+	}
+	return binary.BigEndian.Uint64(v), nil
+}
+
+func (s *ObserverStorage) budgetPut(k []byte, n uint64) error {
+	var b [8]byte
+	binary.BigEndian.PutUint64(b[:], n)
+	return s.db.Put(k, b[:], &opt.WriteOptions{Sync: true})
+}
+
+// Reserve atomically adds n to the counter if the result stays <= limit.
+func (s *ObserverStorage) Reserve(cred string, chain common.Chain, day string, n, limit uint64) (bool, error) {
+	s.afMu.Lock()
+	defer s.afMu.Unlock()
+	k := afBudgetKey(cred, chain, day)
+	cur, err := s.budgetGet(k)
+	if err != nil {
+		return false, err
+	}
+	if cur+n > limit {
+		return false, nil
+	}
+	return true, s.budgetPut(k, cur+n)
+}
+
+// Release gives back n reserved calls.
+func (s *ObserverStorage) Release(cred string, chain common.Chain, day string, n uint64) error {
+	s.afMu.Lock()
+	defer s.afMu.Unlock()
+	k := afBudgetKey(cred, chain, day)
+	cur, err := s.budgetGet(k)
+	if err != nil {
+		return err
+	}
+	if n > cur {
+		n = cur
+	}
+	return s.budgetPut(k, cur-n)
+}
+
+// Used reads the counter.
+func (s *ObserverStorage) Used(cred string, chain common.Chain, day string) (uint64, error) {
+	return s.budgetGet(afBudgetKey(cred, chain, day))
+}
+
+// ---- GuardStore ----
+
+// AddKeys appends registry rows (append-only; duplicates are idempotent).
+func (s *ObserverStorage) AddKeys(rows []addressfilter.GuardRow) error {
+	s.afMu.Lock()
+	defer s.afMu.Unlock()
+	batch := new(leveldb.Batch)
+	for _, r := range rows {
+		b, err := json.Marshal(r)
+		if err != nil {
+			return err
+		}
+		batch.Put([]byte(afGuardKeyPrefix+r.Kind+"|"+r.Chain+"|"+r.Address+"|"+r.PubKey), b)
+	}
+	return s.db.Write(batch, &opt.WriteOptions{Sync: true})
+}
+
+// LoadKeys reads the whole registry.
+func (s *ObserverStorage) LoadKeys() ([]addressfilter.GuardRow, error) {
+	iter := s.db.NewIterator(util.BytesPrefix([]byte(afGuardKeyPrefix)), nil)
+	defer iter.Release()
+	var out []addressfilter.GuardRow
+	for iter.Next() {
+		var r addressfilter.GuardRow
+		if err := json.Unmarshal(iter.Value(), &r); err != nil {
+			return nil, fmt.Errorf("decode guard row: %w", err)
+		}
+		out = append(out, r)
+	}
+	return out, iter.Error()
+}
+
+// AddTombstone records a manual, audited revoke.
+func (s *ObserverStorage) AddTombstone(t addressfilter.GuardTombstone) error {
+	b, err := json.Marshal(t)
+	if err != nil {
+		return err
+	}
+	return s.db.Put([]byte(afGuardTombPrefx+t.Chain+"|"+t.Address), b, &opt.WriteOptions{Sync: true})
+}
+
+// DeleteTombstone undoes a revoke.
+func (s *ObserverStorage) DeleteTombstone(chain common.Chain, address string) error {
+	return s.db.Delete([]byte(afGuardTombPrefx+chain.String()+"|"+address), &opt.WriteOptions{Sync: true})
+}
+
+// LoadTombstones reads every tombstone.
+func (s *ObserverStorage) LoadTombstones() ([]addressfilter.GuardTombstone, error) {
+	iter := s.db.NewIterator(util.BytesPrefix([]byte(afGuardTombPrefx)), nil)
+	defer iter.Release()
+	var out []addressfilter.GuardTombstone
+	for iter.Next() {
+		var t addressfilter.GuardTombstone
+		if err := json.Unmarshal(iter.Value(), &t); err != nil {
+			return nil, fmt.Errorf("decode guard tombstone: %w", err)
+		}
+		out = append(out, t)
+	}
+	return out, iter.Error()
+}
diff --git a/bifrost/observer/addressfilter_storage_test.go b/bifrost/observer/addressfilter_storage_test.go
new file mode 100644
index 00000000000..f0398376cd1
--- /dev/null
+++ b/bifrost/observer/addressfilter_storage_test.go
@@ -0,0 +1,211 @@
+package observer
+
+import (
+	"fmt"
+	"sync"
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/require"
+
+	"gitlab.com/thorchain/thornode/v3/bifrost/pkg/addressfilter"
+	"gitlab.com/thorchain/thornode/v3/bifrost/thorclient/types"
+	"gitlab.com/thorchain/thornode/v3/common"
+	"gitlab.com/thorchain/thornode/v3/common/cosmos"
+	"gitlab.com/thorchain/thornode/v3/config"
+)
+
+func afEnvelope(txID string, height int64, sender string) *addressfilter.SkipEnvelope {
+	it := types.TxInItem{
+		Tx: txID, Sender: sender, To: "bc1qvault", BlockHeight: height, BlockHash: "bh",
+		Coins: common.NewCoins(common.NewCoin(common.BTCAsset, cosmos.NewUint(5))),
+	}
+	return &addressfilter.SkipEnvelope{
+		Occurrence: addressfilter.Occurrence{Chain: "BTC", TxID: txID, BlockHeight: height, BlockHash: "bh"},
+		Item:       it,
+		Screening: addressfilter.Screening{
+			Inputs: addressfilter.NewItemDTO(common.BTCChain, &it, 0), Combine: addressfilter.CombineAny,
+		},
+	}
+}
+
+func TestAddressFilterBucketsSurviveReopen(t *testing.T) {
+	dir := t.TempDir()
+	st, err := NewObserverStorage(dir, config.LevelDBOptions{})
+	require.NoError(t, err)
+
+	// Skip ledger.
+	t0 := time.Date(2026, 11, 20, 12, 0, 0, 0, time.UTC)
+	ledger := addressfilter.NewSkipLedger(st, 0, nil, func() time.Time { return t0 })
+	var keys []string
+	for i := 0; i < 3; i++ {
+		e := afEnvelope(fmt.Sprintf("tx%d", i), 100, "bc1qsender")
+		e.NextCheck = t0.Add(time.Duration(i) * time.Minute)
+		require.NoError(t, ledger.Record(e))
+		keys = append(keys, e.Key())
+	}
+	// Rewrite moves the due index (no stale index row left behind).
+	e0, ok, err := ledger.Get(keys[0])
+	require.NoError(t, err)
+	require.True(t, ok)
+	e0.NextCheck = t0.Add(time.Hour)
+	require.NoError(t, ledger.Update(e0))
+	require.NoError(t, ledger.Archive(keys[2]))
+
+	// Budgets.
+	ok, err = st.Reserve("cred", common.BTCChain, "2026-11-20", 3, 4)
+	require.NoError(t, err)
+	require.True(t, ok)
+	ok, err = st.Reserve("cred", common.BTCChain, "2026-11-20", 2, 4)
+	require.NoError(t, err)
+	require.False(t, ok, "reservation past the limit must fail")
+	require.NoError(t, st.Release("cred", common.BTCChain, "2026-11-20", 1))
+
+	// Guard registry + tombstone.
+	require.NoError(t, st.AddKeys([]addressfilter.GuardRow{{Kind: "vault", Chain: "BTC", Address: "bc1qvault", PubKey: "pk"}}))
+	require.NoError(t, st.AddTombstone(addressfilter.GuardTombstone{Chain: "BTC", Address: "bc1qold", Who: "op", Why: "test", At: t0}))
