+// TestFilterObservationsAddressFilter checks the opt-in static address filter
+// drops inbounds from listed senders only, leaves outbound observations of our
+// own vaults untouched, and is inert when disabled.
+func (s *ObserverSuite) TestFilterObservationsAddressFilter(c *C) {
+	vault := mayachainTypes.GetRandomPubKey()
+	btcCPI, err := common.NewChainPoolInfo(common.BTCChain, vault)
+	c.Assert(err, IsNil)
+	arbCPI, err := common.NewChainPoolInfo(common.ARBChain, vault)
+	c.Assert(err, IsNil)
+	btcVaultAddr := btcCPI.PoolAddress.String()
+	arbVaultAddr := arbCPI.PoolAddress.String()
+
+	pkMgr, err := pubkeymanager.NewPubKeyManager(s.bridge, s.m)
+	c.Assert(err, IsNil)
+	pkMgr.AddPubKey(vault, common.EmptyPubKey, true)
+
+	cache, err := lru.New(100)
+	c.Assert(err, IsNil)
+
+	// Entries taken from a published sanctioned address list.
+	const (
+		listedBTC   = "bc1qjwdw6vrzq4vf6hckutvx4ucj86awwv99mxnz7w"
+		listedETH   = "0x007f2ca1d485ccCDF625C837FAC45b1B13107941"
+		cleanSender = "1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa"
+	)
+	inbound := func(tx, sender, to string) *types.TxInItem {
+		return &types.TxInItem{Tx: tx, Sender: sender, To: to, Memo: "SWAP:BTC.BTC"}
+	}
+
+	obs := &Observer{
+		pubkeyMgr:        pkMgr,
+		logger:           log.With().Str("module", "observer-test").Logger(),
+		signedTxOutCache: cache,
+		addressFilter:    addressfilter.New(listedBTC + "," + listedETH),
+	}
+
+	// listed BTC sender -> dropped
+	result := obs.filterObservations(common.BTCChain, []*types.TxInItem{inbound("tx1", listedBTC, btcVaultAddr)}, false)
+	c.Assert(result, HasLen, 0)
+
+	// non-listed sender -> observed
+	result = obs.filterObservations(common.BTCChain, []*types.TxInItem{inbound("tx2", cleanSender, btcVaultAddr)}, false)
+	c.Assert(result, HasLen, 1)
+
+	// listed 0x sender -> dropped on ARB, case-insensitively
+	result = obs.filterObservations(common.ARBChain, []*types.TxInItem{inbound("tx3", strings.ToLower(listedETH), arbVaultAddr)}, false)
+	c.Assert(result, HasLen, 0)
+
+	// the 0x entry does not leak onto non-EVM chains
+	result = obs.filterObservations(common.BTCChain, []*types.TxInItem{inbound("tx4", listedETH, btcVaultAddr)}, false)
+	c.Assert(result, HasLen, 1)
+
+	// an outbound from our vault to a listed address is still observed
+	result = obs.filterObservations(common.BTCChain, []*types.TxInItem{inbound("tx5", btcVaultAddr, listedBTC)}, false)
+	c.Assert(result, HasLen, 1)
+
+	// nil filter (feature disabled) -> same listed sender observed
+	obsDisabled := &Observer{
+		pubkeyMgr:        pkMgr,
+		logger:           log.With().Str("module", "observer-test").Logger(),
+		signedTxOutCache: cache,
+	}
+	result = obsDisabled.filterObservations(common.BTCChain, []*types.TxInItem{inbound("tx6", listedBTC, btcVaultAddr)}, false)
+	c.Assert(result, HasLen, 1)
+}
