+func TestScreeningMakesNoAdapterIOUnderDeckLock(t *testing.T) {
+	const listed = "bc1qjwdw6vrzq4vf6hckutvx4ucj86awwv99mxnz7w"
+	var deckLocked atomic.Bool
+	src := &fakeListSource{listed: listed, deckLocked: &deckLocked}
+	o, vaultAddr := newScreeningObserver(t, 0, src)
+	o.beforeObservedTxDeckLock = func() { deckLocked.Store(true) }
+
+	var rejected error
+	skip := &types.TxInItem{Tx: "aa01", Sender: listed, To: vaultAddr, Memo: "SWAP:ETH.ETH", BlockHeight: 100,
+		Coins: common.NewCoins(common.NewCoin(common.BTCAsset, cosmos.NewUint(5)))}
+	skip.OnObservedTxRejected = func(err error) { rejected = err }
+	keep := &types.TxInItem{Tx: "aa02", Sender: "1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa", To: vaultAddr, Memo: "SWAP:ETH.ETH", BlockHeight: 100,
+		Coins: common.NewCoins(common.NewCoin(common.BTCAsset, cosmos.NewUint(5)))}
+	txIn := types.TxIn{Chain: common.BTCChain, TxArray: []*types.TxInItem{skip, keep}}
+	require.NoError(t, o.processObservedTx(txIn))
+
+	require.Positive(t, src.calls.Load(), "the screening stage ran")
+	require.Zero(t, src.callsInLck.Load(), "no source call once the deck lock is being taken")
+	require.Error(t, rejected, "the listed item is not observed")
+	n, err := o.afAdapter.Ledger.Count()
+	require.NoError(t, err)
+	require.Equal(t, 1, n, "the skip was recorded before the drop")
+	// One screening call for the whole TxIn (both items), not per item.
+	require.Equal(t, int32(1), src.calls.Load())
+	var onDeck int
+	for _, d := range o.onDeck {
+		onDeck += len(d.TxArray)
+	}
+	require.Equal(t, 1, onDeck, "the clean item is on deck")
+}
