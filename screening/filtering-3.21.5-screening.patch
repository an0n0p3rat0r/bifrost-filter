+// Finding 1: an address-only source over ETH and BSC: a Listed answer for ETH
+// must not be served for BSC, from the cache or from a coalesced request.
+func TestQueryCacheAndCoalescingPerChain(t *testing.T) {
+	var calls atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		time.Sleep(30 * time.Millisecond)
+		_ = json.NewEncoder(w).Encode(map[string]any{"listed": r.URL.Query().Get("coin") == "ETH"})
+	}))
+	defer srv.Close()
+	raw := config.BifrostAddressFilterSource{Name: "mt", Mode: "query", Chains: []string{"ETH", "BSC"},
+		URL: srv.URL + "/risk?coin={chain}&address={address}", Listed: ".listed == true",
+		ChainMap: map[string]string{"BSC": "BNB"}}
+	raw.Cache.MaxEntries = 100
+	known := map[string]common.Chain{"ETH": common.ETHChain, "BSC": common.BSCChain}
+	spec, err := validateSource(raw, known, readFiles(nil), NewEvalSemaphore(0))
+	if err != nil || spec.ContextDependent {
+		t.Fatalf("precondition: address-only source: %v", err)
+	}
+	g := newSyncGuard(true)
+	q, err := NewQuerySource(spec, QuerySourceOptions{Builder: builder(t, spec), Client: srv.Client(),
+		Cache: NewLRUCache(100, time.Hour, time.Minute, g), Guard: g})
+	if err != nil {
+		t.Fatal(err)
+	}
+	addr := "0x00000000000000000000000000000000000000aa"
+	tx := "t1"
+	item := func(c string) []ItemDTO {
+		return []ItemDTO{{ThorChain: c, Chain: c, Address: addr, TxID: &tx, Coins: []CoinDTO{}}}
+	}
+	// Concurrent: the coalescing key must not merge the two chains.
+	var wg sync.WaitGroup
+	var eth, bsc Answer
+	wg.Add(2)
+	go func() { defer wg.Done(); eth = q.Check(context.Background(), common.ETHChain, item("ETH"))[0] }()
+	go func() { defer wg.Done(); bsc = q.Check(context.Background(), common.BSCChain, item("BSC"))[0] }()
+	wg.Wait()
+	if eth.State != Listed || bsc.State != Clean || calls.Load() != 2 {
+		t.Fatalf("concurrent: ETH=%v BSC=%v calls=%d", eth.State, bsc.State, calls.Load())
+	}
+	// Cached: each chain answers from its own entry, no new call.
+	eth = q.Check(context.Background(), common.ETHChain, item("ETH"))[0]
+	bsc = q.Check(context.Background(), common.BSCChain, item("BSC"))[0]
+	if eth.State != Listed || bsc.State != Clean || calls.Load() != 2 {
+		t.Fatalf("cached: ETH=%v BSC=%v calls=%d", eth.State, bsc.State, calls.Load())
+	}
+}
