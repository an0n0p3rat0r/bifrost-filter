@@ -0,0 +1,258 @@
+package observer
+
+import (
+	"context"
+	"fmt"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	lru "github.com/hashicorp/golang-lru"
+	"github.com/prometheus/client_golang/prometheus/testutil"
+	"github.com/stretchr/testify/require"
+
+	"gitlab.com/thorchain/thornode/v3/bifrost/pkg/addressfilter"
+	"gitlab.com/thorchain/thornode/v3/bifrost/pubkeymanager"
+	"gitlab.com/thorchain/thornode/v3/bifrost/thorclient/types"
+	"gitlab.com/thorchain/thornode/v3/common"
+	"gitlab.com/thorchain/thornode/v3/common/cosmos"
+	"gitlab.com/thorchain/thornode/v3/config"
+	stypes "gitlab.com/thorchain/thornode/v3/x/thorchain/types"
+)
+
+// sleepySource covers one chain and sleeps without honouring ctx.
+type sleepySource struct {
+	chain common.Chain
+	sleep time.Duration
+	calls atomic.Int32
+}
+
+func (s *sleepySource) Name() string                { return "sleepy" }
+func (s *sleepySource) Covers(ch common.Chain) bool { return ch.Equals(s.chain) }
+func (s *sleepySource) InMemory() bool              { return false }
+func (s *sleepySource) Check(_ context.Context, _ common.Chain, items []addressfilter.ItemDTO) []addressfilter.Answer {
+	s.calls.Add(1)
+	time.Sleep(s.sleep)
+	out := make([]addressfilter.Answer, len(items))
+	for i := range out {
+		out[i] = addressfilter.Answer{State: addressfilter.Listed}
+	}
+	return out
+}
+
+// switchSource lists every sender until cleared.
+type switchSource struct {
+	clean atomic.Bool
+	calls atomic.Int32
+}
+
+func (s *switchSource) Name() string             { return "switch" }
+func (s *switchSource) Covers(common.Chain) bool { return true }
+func (s *switchSource) InMemory() bool           { return false }
+func (s *switchSource) Check(_ context.Context, _ common.Chain, items []addressfilter.ItemDTO) []addressfilter.Answer {
+	s.calls.Add(1)
+	st := addressfilter.Listed
+	if s.clean.Load() {
+		st = addressfilter.Clean
+	}
+	out := make([]addressfilter.Answer, len(items))
+	for i := range out {
+		out[i] = addressfilter.Answer{State: st}
+	}
+	return out
+}
+
+type integ struct {
+	o      *Observer
+	vault  common.PubKey
+	vault2 common.PubKey
+	addr   map[common.Chain]string
+}
+
+func newInteg(t *testing.T, v addressfilter.Validated, chains []common.Chain, srcs ...addressfilter.Source) *integ {
+	t.Helper()
+	o, _ := newErrataOrderingObserver(t)
+	vault, vault2 := stypes.GetRandomPubKey(), stypes.GetRandomPubKey()
+	pkm, err := pubkeymanager.NewPubKeyManager(nil, nil)
+	require.NoError(t, err)
+	pkm.AddPubKey(vault, false, common.SigningAlgoSecp256k1)
+	pkm.AddPubKey(vault2, false, common.SigningAlgoSecp256k1)
+	cache, err := lru.New(100)
+	require.NoError(t, err)
+	o.pubkeyMgr, o.signedTxOutCache, o.wg = pkm, cache, &sync.WaitGroup{}
+	v.Enabled = true
+	if v.Combine == "" {
+		v.Combine = "any"
+	}
+	a, err := addressfilter.NewAdapter(v, addressfilter.AdapterOptions{Chains: chains, Stores: o.storage, Sources: srcs})
+	require.NoError(t, err)
+	o.afAdapter = a
+	o.startAddressFilter(context.Background())
+	t.Cleanup(o.stopAddressFilter)
+	require.NoError(t, a.Guard.AddPubKey(vault, chains))
+	require.NoError(t, a.Guard.AddPubKey(vault2, chains))
+	a.Guard.MarkReconciled(true)
+	in := &integ{o: o, vault: vault, vault2: vault2, addr: map[common.Chain]string{}}
+	for _, ch := range chains {
+		ad, err := vault.GetAddress(ch)
+		require.NoError(t, err)
+		in.addr[ch] = ad.String()
+	}
+	return in
+}
+
+func inItem(tx, sender, to string) *types.TxInItem {
+	return &types.TxInItem{Tx: tx, Sender: sender, To: to, Memo: "SWAP:ETH.ETH", BlockHeight: 100,
+		Coins: common.NewCoins(common.NewCoin(common.BTCAsset, cosmos.NewUint(5)))}
+}
+
+func deckTxIDs(o *Observer) []string {
+	var out []string
+	for _, d := range o.onDeck {
+		for _, it := range d.TxArray {
+			out = append(out, it.Tx)
+		}
+	}
+	return out
+}
+
+// AC-A1: 500 distinct senders and a source that sleeps 10 s ignoring ctx:
+// the TxIn is delayed by at most the screening deadline and every item is
+// observed (Unknown never skips).
+func TestIntegrationDeadlineBoundsTxIn(t *testing.T) {
+	src := &sleepySource{chain: common.BTCChain, sleep: 10 * time.Second}
+	in := newInteg(t, addressfilter.Validated{ScreenDeadline: 300 * time.Millisecond}, []common.Chain{common.BTCChain}, src)
+	items := make([]*types.TxInItem, 500)
+	for i := range items {
+		items[i] = inItem(fmt.Sprintf("%064x", i+1), fmt.Sprintf("bc1qsender%04d", i), in.addr[common.BTCChain])
+	}
+	start := time.Now()
+	require.NoError(t, in.o.processObservedTx(types.TxIn{Chain: common.BTCChain, TxArray: items}))
+	elapsed := time.Since(start)
+	require.Less(t, elapsed, 300*time.Millisecond+2*time.Second, "bounded by screen_deadline (+ deck work)")
+	require.Len(t, deckTxIDs(in.o), 500, "timeout = Unknown = observe")
+	require.Positive(t, src.calls.Load())
+}
+
+// Two chains screen concurrently: a stuck BTC source never delays ETH.
+func TestIntegrationChainsDoNotBlockEachOther(t *testing.T) {
+	src := &sleepySource{chain: common.BTCChain, sleep: 3 * time.Second}
+	in := newInteg(t, addressfilter.Validated{ScreenDeadline: 2 * time.Second},
+		[]common.Chain{common.BTCChain, common.ETHChain}, src)
+	btcDone := make(chan struct{})
+	go func() {
+		defer close(btcDone)
+		_ = in.o.processObservedTx(types.TxIn{Chain: common.BTCChain, TxArray: []*types.TxInItem{
+			inItem("b1", "bc1qslow", in.addr[common.BTCChain]),
+		}})
+	}()
+	time.Sleep(50 * time.Millisecond) // BTC is now inside its screening call
+	start := time.Now()
+	require.NoError(t, in.o.processObservedTx(types.TxIn{Chain: common.ETHChain, TxArray: []*types.TxInItem{
+		inItem("e1", "0x00000000000000000000000000000000000000e1", in.addr[common.ETHChain]),
+	}}))
+	require.Less(t, time.Since(start), 500*time.Millisecond, "ETH is not queued behind BTC screening")
+	<-btcDone
+}
+
+// Mixed-sender block: only the listed items are skipped (and recorded).
+func TestIntegrationMixedSenderBlock(t *testing.T) {
+	const listed = "bc1qjwdw6vrzq4vf6hckutvx4ucj86awwv99mxnz7w"
+	var lck atomic.Bool
+	src := &fakeListSource{listed: listed, deckLocked: &lck}
+	in := newInteg(t, addressfilter.Validated{}, []common.Chain{common.BTCChain}, src)
+	to := in.addr[common.BTCChain]
+	require.NoError(t, in.o.processObservedTx(types.TxIn{Chain: common.BTCChain, TxArray: []*types.TxInItem{
+		inItem("m1", listed, to), inItem("m2", "bc1qclean1", to), inItem("m3", strings.ToUpper(listed), to), inItem("m4", "bc1qclean2", to),
+	}}))
+	require.ElementsMatch(t, []string{"m2", "m4"}, deckTxIDs(in.o))
+	n, err := in.o.afAdapter.Ledger.Count()
+	require.NoError(t, err)
+	require.Equal(t, 2, n)
+}
+
+// A source that lists everything never skips a vault sender: internal
+// (migration/consolidate) transfers keep both observations.
+func TestIntegrationVaultSenderNeverSkipped(t *testing.T) {
+	src := &switchSource{}
+	in := newInteg(t, addressfilter.Validated{}, []common.Chain{common.BTCChain}, src)
+	from := in.addr[common.BTCChain]
+	to2, err := in.vault2.GetAddress(common.BTCChain)
+	require.NoError(t, err)
+	txIn := &types.TxIn{Chain: common.BTCChain, TxArray: []*types.TxInItem{
+		{Tx: "mig1", Sender: from, To: to2.String(), Memo: "MIGRATE:100", BlockHeight: 100,
+			Coins: common.NewCoins(common.NewCoin(common.BTCAsset, cosmos.NewUint(5)))},
+	}}
+	sc := in.o.screenTxIn(txIn)
+	got := in.o.filterObservationsScreened(common.BTCChain, txIn.TxArray, false, sc)
+	require.Len(t, got, 2, "outbound + inbound observations of an internal transfer")
+	n, err := in.o.afAdapter.Ledger.Count()
+	require.NoError(t, err)
+	require.Zero(t, n, "no skip recorded for a vault sender")
+	require.Zero(t, src.calls.Load(), "a vault sender is never sent to a source")
+}
+
+// Pre-attributed XMR inbounds are exempt: no source call, metric counted.
+func TestIntegrationXMRPreAttributedExempt(t *testing.T) {
+	src := &switchSource{}
+	// XMR addresses need an ed25519 key; the exemption is decided before any
+	// pool lookup, so a BTC-keyed fixture is enough here.
+	in := newInteg(t, addressfilter.Validated{}, []common.Chain{common.BTCChain}, src)
+	it := inItem("x1", "xmr-sender", "xmr-vault")
+	it.ObservedVaultPubKey = in.vault
+	require.Nil(t, in.o.screenTxIn(&types.TxIn{Chain: common.XMRChain, TxArray: []*types.TxInItem{it}}))
+	require.Zero(t, src.calls.Load())
+	require.Equal(t, 1.0, testutil.ToFloat64(in.o.afAdapter.Metrics.Exempt.WithLabelValues("XMR", "xmr_pre_attributed")))
+}
+
+// AC-A1 legacy: a static-only config builds no adapter, and the static path
+// reproduces the running build's drop.
+func TestIntegrationLegacyStaticReproducesDrops(t *testing.T) {
+	const listed = "bc1qjwdw6vrzq4vf6hckutvx4ucj86awwv99mxnz7w"
+	in := newInteg(t, addressfilter.Validated{}, []common.Chain{common.BTCChain}, &switchSource{})
+	o := in.o
+	o.stopAddressFilter()
+	cfg := config.BifrostAddressFilterConfiguration{Enabled: true, Addresses: listed}
+	o.afAdapter = o.newAddressFilterAdapter(cfg, t.TempDir())
+	require.Nil(t, o.afAdapter)
+	o.addressFilter = addressfilter.New(cfg.Addresses)
+	to := in.addr[common.BTCChain]
+	require.NoError(t, o.processObservedTx(types.TxIn{Chain: common.BTCChain, TxArray: []*types.TxInItem{
+		inItem("l1", listed, to), inItem("l2", "bc1qclean", to),
+	}}))
+	require.Equal(t, []string{"l2"}, deckTxIDs(o))
+}
+
+// An invalid config disables the adapter without stopping the observer.
+func TestIntegrationInvalidConfigDisablesFilter(t *testing.T) {
+	o, _ := newErrataOrderingObserver(t)
+	cfg := config.BifrostAddressFilterConfiguration{Enabled: true, Sources: []config.BifrostAddressFilterSource{
+		{Name: "dup", Mode: "list"}, {Name: "dup", Mode: "list"},
+	}}
+	require.Nil(t, o.newAddressFilterAdapter(cfg, t.TempDir()))
+	require.Nil(t, o.screenTxIn(&types.TxIn{Chain: common.BTCChain, TxArray: []*types.TxInItem{inItem("i1", "a", "b")}}))
+}
+
+// A6.5: a recheck that clears the sender releases the record and, with
+// replay on, re-observes it through admission.
+func TestIntegrationRecheckReleaseReplays(t *testing.T) {
+	src := &switchSource{}
+	in := newInteg(t, addressfilter.Validated{}, []common.Chain{common.BTCChain}, src)
+	to := in.addr[common.BTCChain]
+	require.NoError(t, in.o.processObservedTx(types.TxIn{Chain: common.BTCChain, TxArray: []*types.TxInItem{inItem("r1", "bc1qlisted", to)}}))
+	require.Empty(t, in.o.onDeck)
+	src.clean.Store(true)
+	future := time.Now().Add(24 * time.Hour)
+	r := addressfilter.NewRechecker(addressfilter.RecheckerOptions{
+		Ledger: in.o.afAdapter.Ledger, Sources: []addressfilter.Source{src}, Guard: in.o.afAdapter.Guard,
+		Combine: "any", OnRelease: in.o.replaySkipped, Now: func() time.Time { return future },
+	})
+	st := r.Tick(addressfilter.WithRecheck(context.Background()))
+	require.Equal(t, 1, st.Released)
+	require.Equal(t, []string{"r1"}, deckTxIDs(in.o))
+	n, err := in.o.afAdapter.Ledger.Count()
+	require.NoError(t, err)
+	require.Zero(t, n)
+}
