+// ---- A2.2 list source ----
+
+type listServer struct {
+	mu    sync.Mutex
+	body  string
+	etag  string
+	calls int
+}
+
+func (s *listServer) handler(w http.ResponseWriter, r *http.Request) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.calls++
+	if s.etag != "" && r.Header.Get("If-None-Match") == s.etag {
+		w.WriteHeader(http.StatusNotModified)
+		return
+	}
+	if s.etag != "" {
+		w.Header().Set("ETag", s.etag)
+	}
+	io.WriteString(w, s.body)
+}
+
+func (s *listServer) set(body, etag string) {
+	s.mu.Lock()
+	s.body, s.etag = body, etag
+	s.mu.Unlock()
+}
+
+func addrList(n int) string {
+	var b strings.Builder
+	b.WriteString(`{"addresses":[`)
+	for i := 0; i < n; i++ {
+		if i > 0 {
+			b.WriteByte(',')
+		}
+		fmt.Fprintf(&b, `"0x%040x"`, i+1)
+	}
+	b.WriteString(`]}`)
+	return b.String()
+}
+
+type clock struct {
+	mu sync.Mutex
+	t  time.Time
+}
+
+func (c *clock) now() time.Time { c.mu.Lock(); defer c.mu.Unlock(); return c.t }
+func (c *clock) add(d time.Duration) {
+	c.mu.Lock()
+	c.t = c.t.Add(d)
+	c.mu.Unlock()
+}
+
+func newList(t *testing.T, srv *httptest.Server, clk *clock, extra func(*config.BifrostAddressFilterSource)) *ListSource {
+	t.Helper()
+	raw := config.BifrostAddressFilterSource{
+		Name: "lst", Mode: "list", Chains: []string{"ETH"}, URL: srv.URL + "/list",
+		Listed: ".addresses", MaxAge: time.Hour,
+	}
+	if extra != nil {
+		extra(&raw)
+	}
+	spec := querySpec(t, raw, nil)
+	l, err := NewListSource(spec, ListSourceOptions{Builder: builder(t, spec), Client: srv.Client(), Now: clk.now})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return l
+}
