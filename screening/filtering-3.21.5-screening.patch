+	if got := DefaultPerSenderRecords(5); got != 5 {
+		t.Fatalf("never above the chain cap: got %d", got)
+	}
+	v, err := Validate(config.BifrostAddressFilterConfiguration{Enabled: true}, []common.Chain{common.BTCChain, common.ETHChain}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if v.MaxRecordsPerSender != DefaultPerSenderRecords(v.MaxRecordsPerChain) {
+		t.Fatalf("validated sender cap %d for chain cap %d", v.MaxRecordsPerSender, v.MaxRecordsPerChain)
