+func TestRecheckTwentyThousandBoundedAndRoundRobin(t *testing.T) {
+	f := newRecheckFixture(t)
+	const n = 20000
+	for i := 0; i < n; i++ {
+		f.record(t, fmt.Sprintf("bc1qs%05d", i), fmt.Sprintf("tx%05d", i))
+	}
+	src := &fnSource{name: "gj", answer: listedAll}
+	r := NewRechecker(RecheckerOptions{Ledger: f.l, Sources: []Source{src}, Guard: f.g, Now: f.clk.now, Page: 100, Rand: rand.New(rand.NewSource(2))})
+	// Every record is due at t0. Each tick must touch at most 100, and no
+	// record is checked twice before every record was checked once.
+	for tick := 0; tick < n/100; tick++ {
+		before := src.items.Load()
+		st := r.Tick(context.Background())
+		if st.Processed > 100 || src.items.Load()-before > 100 {
+			t.Fatalf("tick %d processed %d", tick, st.Processed)
+		}
+	}
+	keys, _ := f.l.Due(f.clk.now(), 0)
+	if len(keys) != 0 {
+		t.Fatalf("%d records starved after %d ticks", len(keys), n/100)
+	}
+	if src.items.Load() != n {
+		t.Fatalf("%d lookups, want exactly %d (each record once)", src.items.Load(), n)
+	}
+}
