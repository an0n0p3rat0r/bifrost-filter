+	"testing"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+	"gitlab.com/thorchain/thornode/v3/config"
+)
+
+const secKey = "sk-live/0123+456=789"
+
+func TestRedactorScrubsEveryEncoding(t *testing.T) {
+	r := NewRedactor([]string{secKey}, nil)
+	forms := []string{secKey, url.QueryEscape(secKey), url.PathEscape(secKey), base64.StdEncoding.EncodeToString([]byte(secKey))}
+	for _, f := range forms {
+		got := r.String("prefix " + f + " suffix")
+		if strings.Contains(got, f) || !strings.Contains(got, Redacted) {
+			t.Fatalf("form %q leaked: %q", f, got)
+		}
+	}
+}
+
+// A provider that echoes the key in every field (reason, error, body) never
+// gets it into an answer, a verdict or a persisted skip record.
+func TestEchoedSecretNeverReachesSkipRecord(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		k := r.URL.Query().Get("apikey")
+		b64 := base64.StdEncoding.EncodeToString([]byte(k))
+		io.WriteString(w, `{"listed":true,"reason":"key `+k+` / `+url.QueryEscape(k)+` / `+b64+`"}`)
+	}))
+	defer srv.Close()
+	raw := config.BifrostAddressFilterSource{
+		Name: "q", Mode: "query", Chains: []string{"BTC"}, URL: srv.URL + "/c/{address}",
+		Auth: "query", QueryParam: "apikey", SecretFile: "/s", Listed: ".listed", Reason: ".reason",
+		AllowPrivate: true, AllowDirectEgress: true,
+	}
+	spec := querySpec(t, raw, map[string]string{"/s": secKey})
+	q, err := NewQuerySource(spec, QuerySourceOptions{Builder: builder(t, spec), Client: srv.Client()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := NewScreener(ScreenerOptions{Sources: []Source{q}, Guard: newSyncGuard(true)})
+	items := []ItemDTO{{Address: "bc1qechoed"}}
+	v := s.ScreenTxIn(context.Background(), common.BTCChain, items)
+	verdict := v[ItemKey(items[0])]
+	if !verdict.Skip {
+		t.Fatalf("expected a listed verdict: %+v", verdict)
+	}
+	store := NewMemLedgerStore()
+	ledger := NewSkipLedger(store, 0, nil, nil)
+	env := &SkipEnvelope{
+		Occurrence: Occurrence{Chain: "BTC", TxID: "aa", BlockHeight: 1},
+		Screening:  Screening{Inputs: items[0], Answers: verdict.Answers, Combine: verdict.Combine},
+		Reason:     "listed",
+	}
+	if err := ledger.Record(env); err != nil {
+		t.Fatal(err)
+	}
+	stored, ok, err := store.GetEnvelope(env.Key())
+	if err != nil || !ok {
+		t.Fatalf("record missing: %v", err)
+	}
+	vb, _ := json.Marshal(verdict)
+	for _, blob := range []string{string(stored), string(vb)} {
+		for _, f := range []string{secKey, url.QueryEscape(secKey), base64.StdEncoding.EncodeToString([]byte(secKey))} {
+			if strings.Contains(blob, f) {
+				t.Fatalf("secret form %q persisted: %s", f, blob)
+			}
+		}
+	}
+}
diff --git a/bifrost/pkg/addressfilter/signer/elliptic.go b/bifrost/pkg/addressfilter/signer/elliptic.go
new file mode 100644
index 00000000000..5c7baf9dfbd
--- /dev/null
+++ b/bifrost/pkg/addressfilter/signer/elliptic.go
@@ -0,0 +1,51 @@
+package signer
+
+import (
+	"crypto/hmac"
+	"crypto/sha256"
+	"encoding/base64"
+	"errors"
+	"net/http"
+	"strconv"
+	"strings"
+	"time"
+)
+
+// Elliptic signs with HMAC-SHA256 over timestamp(ms) + METHOD + lowercase
+// path-with-query + body (`{}` when the body is empty), keyed by the
+// base64-decoded secret; the signature is base64-encoded.
+type Elliptic struct {
+	key    string
+	secret []byte
+}
+
+// NewElliptic builds the signer; secret is the base64 API secret.
+func NewElliptic(key, secretB64 string) (*Elliptic, error) {
+	if strings.TrimSpace(key) == "" {
+		return nil, errors.New("elliptic-hmac: empty key")
+	}
+	sec, err := base64.StdEncoding.DecodeString(strings.TrimSpace(secretB64))
+	if err != nil || len(sec) == 0 {
+		return nil, errors.New("elliptic-hmac: secret is not base64")
+	}
+	return &Elliptic{key: strings.TrimSpace(key), secret: sec}, nil
+}
+
+// Sign implements Signer.
+func (e *Elliptic) Sign(method, pathWithQuery string, body []byte, now time.Time) (http.Header, []string, error) {
+	ts := strconv.FormatInt(now.UnixMilli(), 10)
+	b := body
+	if len(b) == 0 {
+		b = []byte("{}")
+	}
+	m := hmac.New(sha256.New, e.secret)
+	m.Write([]byte(ts))
+	m.Write([]byte(strings.ToUpper(method)))
+	m.Write([]byte(strings.ToLower(pathWithQuery)))
+	m.Write(b)
+	h := http.Header{}
+	h.Set("x-access-key", e.key)
+	h.Set("x-access-timestamp", ts)
+	h.Set("x-access-sign", base64.StdEncoding.EncodeToString(m.Sum(nil)))
+	return h, []string{"x-access-key", "x-access-sign"}, nil
+}
diff --git a/bifrost/pkg/addressfilter/signer/elliptic_test.go b/bifrost/pkg/addressfilter/signer/elliptic_test.go
new file mode 100644
index 00000000000..5372e3637f4
--- /dev/null
+++ b/bifrost/pkg/addressfilter/signer/elliptic_test.go
@@ -0,0 +1,64 @@
+package signer
+
+import (
+	"sync"
+	"testing"
+	"time"
+)
+
+// Known-answer vectors computed independently (Python hmac) over a synthetic
+// secret; they pin the signing string byte for byte.
+const kSecret = "c3ludGhldGljLXNlY3JldC1mb3ItdGVzdHM=" // "synthetic-secret-for-tests"
+
+func TestEllipticKnownAnswer(t *testing.T) {
+	s, err := NewElliptic("k-1", kSecret)
+	if err != nil {
+		t.Fatal(err)
+	}
+	now := time.UnixMilli(1700000000123)
+	h, sens, err := s.Sign("post", "/V2/Wallet/Synchronous?x=1", []byte(`{"subject":{"asset":"holistic"}}`), now)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := h.Get("x-access-sign"); got != "Io0jykFajIqL4iAXg/QYXtBK8x0lOdMbkMxAscpOPZw=" {
+		t.Fatalf("signature %s", got)
+	}
+	if h.Get("x-access-timestamp") != "1700000000123" || h.Get("x-access-key") != "k-1" {
+		t.Fatalf("headers %v", h)
+	}
+	if len(sens) != 2 || sens[0] != "x-access-key" || sens[1] != "x-access-sign" {
+		t.Fatalf("sensitive %v", sens)
+	}
+	// Empty body signs "{}".
+	h2, _, _ := s.Sign("GET", "/v2/analyses", nil, now)
+	if h2.Get("x-access-sign") != "OHPzRSfVtatdGLgXqXdfa5vvTKQD553CxQPjfl9tlUA=" {
+		t.Fatalf("empty-body signature %s", h2.Get("x-access-sign"))
+	}
+}
+
+func TestEllipticDeterministicAndConcurrent(t *testing.T) {
+	s, _ := NewElliptic("k", kSecret)
+	now := time.UnixMilli(1)
+	want, _, _ := s.Sign("GET", "/a", nil, now)
+	var wg sync.WaitGroup
+	for i := 0; i < 32; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			got, _, _ := s.Sign("GET", "/a", nil, now)
+			if got.Get("x-access-sign") != want.Get("x-access-sign") {
+				t.Error("non-deterministic signature")
+			}
+		}()
+	}
+	wg.Wait()
+}
+
+func TestEllipticBadSecret(t *testing.T) {
+	if _, err := NewElliptic("k", "not base64!!"); err == nil {
+		t.Fatal("want error")
+	}
+	if _, err := New("nope", "k", kSecret); err == nil {
+		t.Fatal("want unknown signer error")
+	}
+}
