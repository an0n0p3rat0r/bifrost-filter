diff --git a/bifrost/signer/sign_addressfilter_test.go b/bifrost/signer/sign_addressfilter_test.go
new file mode 100644
index 00000000000..d7eded2eeb4
--- /dev/null
+++ b/bifrost/signer/sign_addressfilter_test.go
@@ -0,0 +1,173 @@
+package signer
+
+import (
+	. "gopkg.in/check.v1"
+
+	"gitlab.com/thorchain/thornode/v3/bifrost/pkg/addressfilter"
+	"gitlab.com/thorchain/thornode/v3/bifrost/pubkeymanager"
+	"gitlab.com/thorchain/thornode/v3/bifrost/thorclient/types"
+	"gitlab.com/thorchain/thornode/v3/common"
+)
+
+type AddressFilterOutboundSuite struct{}
+
+// TestOutboundDeclineExposureGate locks the exposure predicate guarding the
+// outbound decline: a policy decline fires ONLY for a wholly-unexposed attempt.
+// Any signature/recovery material (SignedTx, outer or nested Checkpoint,
+// Observation) or a round-7 retry must exclude it — dropping an exposed item
+// would strand funds (the N1 fund-strand finding).
+func (s *AddressFilterOutboundSuite) TestOutboundDeclineExposureGate(c *C) {
+	fresh := TxOutStoreItem{TxOutItem: types.TxOutItem{Chain: common.ETHChain, ToAddress: "0xabc"}}
+	c.Assert(refundFundingUnexposed(fresh), Equals, true)
+
+	withSigned := fresh
+	withSigned.SignedTx = []byte{1}
+	c.Assert(refundFundingUnexposed(withSigned), Equals, false)
+
+	withCheckpoint := fresh
+	withCheckpoint.Checkpoint = []byte{1}
+	c.Assert(refundFundingUnexposed(withCheckpoint), Equals, false)
+
+	withNestedCheckpoint := fresh
+	withNestedCheckpoint.TxOutItem.Checkpoint = []byte{1}
+	c.Assert(refundFundingUnexposed(withNestedCheckpoint), Equals, false)
+
+	withObservation := fresh
+	withObservation.Observation = &types.TxInItem{Tx: "x"}
+	c.Assert(refundFundingUnexposed(withObservation), Equals, false)
+
+	withRound7 := fresh
+	withRound7.Round7Retry = true
+	c.Assert(refundFundingUnexposed(withRound7), Equals, false)
+}
+
+var _ = Suite(&AddressFilterOutboundSuite{})
+
+// Entries taken from a published sanctioned address list.
+const (
+	listedETHOut = "0x007f2ca1d485ccCDF625C837FAC45b1B13107941"
+	listedBTCOut = "bc1qjwdw6vrzq4vf6hckutvx4ucj86awwv99mxnz7w"
+	cleanETHOut  = "0x90f2b1ae50e6018230e90a33f98c7844a0ab635a"
+)
+
+func outItem(chain common.Chain, to string) types.TxOutItem {
+	return types.TxOutItem{Chain: chain, ToAddress: common.Address(to), Memo: "OUT:X"}
+}
+
+func (s *AddressFilterOutboundSuite) TestOutboundDeclineExcludedChains(c *C) {
+	// XMR and SOL are exempt from the per-node decline (durable chain-client
+	// signing state); every other chain keeps it.
+	c.Assert(outboundDeclineExcluded(common.XMRChain), Equals, true)
+	c.Assert(outboundDeclineExcluded(common.SOLChain), Equals, true)
+	for _, chain := range []common.Chain{common.ETHChain, common.BTCChain, common.BSCChain, common.BCHChain, common.LTCChain, common.GAIAChain} {
+		c.Assert(outboundDeclineExcluded(chain), Equals, false, Commentf("chain %s", chain))
+	}
+}
+
+func (s *AddressFilterOutboundSuite) TestOutboundFiltered(c *C) {
+	sgn := &Signer{addressFilter: addressfilter.New(listedETHOut + "," + listedBTCOut)}
+
+	// listed EVM destination -> declined
+	c.Assert(sgn.outboundFiltered(outItem(common.ETHChain, listedETHOut)), Equals, true)
+	// case-insensitive on EVM, same key on any EVM chain
+	c.Assert(sgn.outboundFiltered(outItem(common.BSCChain, "0x007F2CA1D485CCCDF625C837FAC45B1B13107941")), Equals, true)
+	// clean EVM destination -> signed
+	c.Assert(sgn.outboundFiltered(outItem(common.ETHChain, cleanETHOut)), Equals, false)
+
+	// listed BTC destination -> declined; same string on a different chain -> not
+	c.Assert(sgn.outboundFiltered(outItem(common.BTCChain, listedBTCOut)), Equals, true)
+	c.Assert(sgn.outboundFiltered(outItem(common.LTCChain, listedBTCOut)), Equals, false)
+}
+
+func (s *AddressFilterOutboundSuite) TestOutboundFilteredFailOpen(c *C) {
+	// feature off (nil filter) -> never declines, signing proceeds
+	sgn := &Signer{}
+	c.Assert(sgn.outboundFiltered(outItem(common.ETHChain, listedETHOut)), Equals, false)
+
+	// empty list -> nothing matches
+	sgn = &Signer{addressFilter: addressfilter.New("")}
+	c.Assert(sgn.outboundFiltered(outItem(common.BTCChain, listedBTCOut)), Equals, false)
+}
+
+// guardPools reports vaultOut as one of our vaults and routerOut as a router.
+type guardPools struct {
+	*pubkeymanager.MockPoolAddressValidator
+}
+
+const (
+	vaultBTCOut = "bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4"
+	routerETH   = "0x3624525075b88B24ecc29CE226b0CEc1fFcB6976"
+)
+
+func (g *guardPools) IsValidPoolAddress(addr string, chain common.Chain) (bool, common.ChainPoolInfo) {
+	return chain.Equals(common.BTCChain) && addr == vaultBTCOut, common.ChainPoolInfo{}
+}
+
+func (g *guardPools) GetContracts(chain common.Chain, _ bool) []common.Address {
+	if chain.Equals(common.ETHChain) {
+		return []common.Address{common.Address(routerETH)}
+	}
+	return nil
+}
+
+func (s *AddressFilterOutboundSuite) TestOutboundNeverDeclinesVaultOrRouter(c *C) {
+	pools := &guardPools{MockPoolAddressValidator: pubkeymanager.NewMockPoolAddressValidator()}
+	// A list that wrongly contains our vault and the router.
+	list := vaultBTCOut + "," + routerETH + "," + listedBTCOut
+	sgn := &Signer{addressFilter: addressfilter.New(list), pubkeyMgr: pools}
+	c.Assert(sgn.outboundFiltered(outItem(common.BTCChain, vaultBTCOut)), Equals, false, Commentf("migration to a listed vault must sign"))
+	c.Assert(sgn.outboundFiltered(outItem(common.ETHChain, routerETH)), Equals, false)
+	c.Assert(sgn.outboundFiltered(outItem(common.ETHChain, "0x3624525075b88b24ecc29ce226b0cec1ffcb6976")), Equals, false, Commentf("router match is case-insensitive"))
+	c.Assert(sgn.outboundFiltered(outItem(common.BTCChain, listedBTCOut)), Equals, true, Commentf("non-vault listed destination unchanged"))
+
+	// The adapter's shared set takes over when installed; the guard still wins.
+	g := &readyGuard{}
+	set := addressfilter.NewOutboundSet(addressfilter.New(list), g)
+	sgn.SetOutboundSet(set)
+	c.Assert(sgn.outboundFiltered(outItem(common.BTCChain, vaultBTCOut)), Equals, false)
+	c.Assert(sgn.outboundFiltered(outItem(common.BTCChain, listedBTCOut)), Equals, true)
+	// Feature off: no filter and no set -> never declines, no pool lookups.
+	off := &Signer{pubkeyMgr: pools}
+	c.Assert(off.outboundFiltered(outItem(common.BTCChain, listedBTCOut)), Equals, false)
+}
+
+type readyGuard struct{}
+
+func (readyGuard) Ready() bool                        { return true }
+func (readyGuard) Epoch() uint64                      { return 1 }
+func (readyGuard) Contains(common.Chain, string) bool { return false }
+
+type fakeOutboundProvider struct{ set *addressfilter.OutboundSet }
+
+func (f fakeOutboundProvider) AddressFilterOutboundSet() *addressfilter.OutboundSet { return f.set }
+
+// NewSigner installs the screening adapter's outbound set (static plus list
+// sources) when filter_outbound is on and the adapter runs; otherwise the
+// static filter stays.
+func (s *AddressFilterOutboundSuite) TestAdapterOutboundSetWiring(c *C) {
+	set := addressfilter.NewOutboundSet(addressfilter.New("bc1qjwdw6vrzq4vf6hckutvx4ucj86awwv99mxnz7w"), readyGuard{})
+	c.Assert(adapterOutboundSet(true, fakeOutboundProvider{set: set}), Equals, set)
+	c.Assert(adapterOutboundSet(false, fakeOutboundProvider{set: set}), IsNil)
+	c.Assert(adapterOutboundSet(true, fakeOutboundProvider{}), IsNil)
+	c.Assert(adapterOutboundSet(true, nil), IsNil)
+}
+
+type unreadyGuard struct{}
+
+func (unreadyGuard) Ready() bool                        { return false }
+func (unreadyGuard) Epoch() uint64                      { return 0 }
+func (unreadyGuard) Contains(common.Chain, string) bool { return false }
+
+// With the adapter's set installed and the vault guard unready (a seed that
+// never verified), the static list still declines exactly as the legacy
+// filter did, and a vault or router destination still signs (live pubkey
+// manager check first).
+func (s *AddressFilterOutboundSuite) TestStaticOutboundDeclineIndependentOfGuard(c *C) {
+	pools := &guardPools{MockPoolAddressValidator: pubkeymanager.NewMockPoolAddressValidator()}
+	list := vaultBTCOut + "," + routerETH + "," + listedBTCOut
+	sgn := &Signer{addressFilter: addressfilter.New(list), pubkeyMgr: pools}
+	sgn.SetOutboundSet(addressfilter.NewOutboundSet(addressfilter.New(list), unreadyGuard{}))
+	c.Assert(sgn.outboundFiltered(outItem(common.BTCChain, listedBTCOut)), Equals, true, Commentf("static decline must not wait for the guard"))
+	c.Assert(sgn.outboundFiltered(outItem(common.BTCChain, vaultBTCOut)), Equals, false)
+	c.Assert(sgn.outboundFiltered(outItem(common.ETHChain, routerETH)), Equals, false)
+}
