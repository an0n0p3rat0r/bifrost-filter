+func TestListShrinkHoldAckAndFingerprint(t *testing.T) {
+	ls := &listServer{body: addrList(100)}
+	srv := httptest.NewServer(http.HandlerFunc(ls.handler))
+	defer srv.Close()
+	clk := &clock{t: time.Unix(1_800_000_000, 0)}
+	l := newList(t, srv, clk, nil)
+	if err := l.RefreshOnce(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	s1 := l.Snapshot()
+	if s1 == nil || s1.Size != 100 || s1.Fingerprint != Fingerprint(s1.Entries()) {
+		t.Fatalf("snapshot %+v", s1)
+	}
+	ls.set(`{"addresses":[]}`, "")
+	if err := l.RefreshOnce(context.Background()); err == nil || !l.Suspect() {
+		t.Fatalf("100 -> 0 must be held as suspect, err=%v", err)
+	}
+	if l.Snapshot().Size != 100 {
+		t.Fatal("old set must keep serving while suspect")
