+func newScreeningObserver(t *testing.T, maxRecords int, src addressfilter.Source) (*Observer, string) {
+	t.Helper()
+	o, _ := newErrataOrderingObserver(t)
+	vault := stypes.GetRandomPubKey()
+	vaultAddr, err := vault.GetAddress(common.BTCChain)
+	require.NoError(t, err)
+	pkm, err := pubkeymanager.NewPubKeyManager(nil, nil)
+	require.NoError(t, err)
+	pkm.AddPubKey(vault, false, common.SigningAlgoSecp256k1)
+	cache, err := lru.New(100)
+	require.NoError(t, err)
+	o.pubkeyMgr = pkm
+	o.signedTxOutCache = cache
+	o.chains = nil
+	o.wg = &sync.WaitGroup{}
+	a, err := addressfilter.NewAdapter(addressfilter.Validated{
+		Enabled: true, Combine: "any", MaxRecords: maxRecords, RecheckPage: 100,
+	}, addressfilter.AdapterOptions{
+		Chains: []common.Chain{common.BTCChain}, Stores: o.storage, Sources: []addressfilter.Source{src},
+	})
+	require.NoError(t, err)
+	o.afAdapter = a
+	o.startAddressFilter(context.Background())
+	t.Cleanup(o.stopAddressFilter)
+	// The guard is fed from the pubkey manager's (BTC) vault.
+	require.NoError(t, a.Guard.AddPubKey(vault, []common.Chain{common.BTCChain}))
+	a.Guard.MarkReconciled(true)
+	require.True(t, a.Guard.Ready())
+	return o, vaultAddr.String()
+}
