+// gjallarEchoServer answers each item: listed when its tx_id is in listedTx,
+// else unverified. echoTx adds tx_id to results; reverse returns them out of
+// order. sent records the item count of the last request.
+func gjallarEchoServer(t *testing.T, listedTx map[string]bool, echoTx, reverse bool, sent *atomic.Int32) *httptest.Server {
+	t.Helper()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		b, _ := io.ReadAll(r.Body)
+		var req struct {
+			Items []map[string]any `json:"items"`
+		}
+		_ = json.Unmarshal(b, &req)
+		sent.Store(int32(len(req.Items)))
+		res := make([]any, 0, len(req.Items))
+		for _, it := range req.Items {
+			tx, _ := it["tx_id"].(string)
+			m := map[string]any{"chain": it["chain"], "address": it["address"], "listed": false, "tier": "unverified", "reason": "vendor_down"}
+			if listedTx[tx] {
+				m["listed"], m["tier"] = true, "own"
+				delete(m, "reason")
+			}
+			if echoTx {
+				m["tx_id"] = tx
+			}
+			res = append(res, m)
+		}
+		if reverse {
+			for i, j := 0, len(res)-1; i < j; i, j = i+1, j-1 {
+				res[i], res[j] = res[j], res[i]
+			}
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{"results": res})
+	}))
+	t.Cleanup(srv.Close)
+	return srv
+}
