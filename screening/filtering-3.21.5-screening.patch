+package addressfilter
+
+import (
+	"errors"
+	"os"
+	"strings"
+	"testing"
+
+	"github.com/spf13/viper"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+	"gitlab.com/thorchain/thornode/v3/config"
+)
+
+var testChains = []common.Chain{common.ETHChain, common.BTCChain, common.BSCChain}
+
+func readOK(p string) ([]byte, error) {
+	if p == "missing" {
+		return nil, os.ErrNotExist
+	}
+	return []byte("s3cr3t-" + p), nil
+}
+
+func querySrc(name, u string) config.BifrostAddressFilterSource {
+	return config.BifrostAddressFilterSource{
+		Name: name, Mode: "query", Chains: []string{"ETH"}, URL: u,
+		Listed: `.listed`, AllowDirectEgress: true,
+	}
+}
+
+func TestValidateLegacyUnchanged(t *testing.T) {
+	v, err := Validate(config.BifrostAddressFilterConfiguration{
+		Enabled: true, FilterOutbound: true, Addresses: "0xabc0000000000000000000000000000000000001",
+	}, testChains, readOK)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(v.Sources) != 1 || v.Sources[0].Name != StaticSourceName || v.Combine != "any" || !v.Enabled || !v.FilterOutbound {
+		t.Fatalf("bad %+v", v)
+	}
+	if v.MaxInflight != DefaultMaxInflight || v.ChainBudgetPct != DefaultChainBudgetPct || v.RecheckPage != DefaultRecheckPage {
+		t.Fatalf("defaults not applied %+v", v)
+	}
+}
+
+func TestValidateDuplicateNamesFatal(t *testing.T) {
+	_, err := Validate(config.BifrostAddressFilterConfiguration{Sources: []config.BifrostAddressFilterSource{
+		querySrc("x", "http://127.0.0.1:1"), querySrc("x", "http://127.0.0.1:2"),
+	}}, testChains, readOK)
+	if !errors.Is(err, ErrFatalConfig) {
+		t.Fatalf("want fatal, got %v", err)
+	}
+}
+
+func TestValidateQuarantine(t *testing.T) {
+	bad := querySrc("bad-secret", "http://127.0.0.1:1")
+	bad.Auth, bad.TokenFile = "bearer", "missing"
+	plain := querySrc("plain-http", "http://example.com/x")
+	loop := querySrc("loop", "http://127.0.0.1:8080/x")
+	noProxy := querySrc("no-proxy", "https://vendor.example/x")
+	noProxy.AllowDirectEgress = false
+	viaProxy := querySrc("via-proxy", "https://vendor.example/x")
+	viaProxy.AllowDirectEgress, viaProxy.ProxyURL = false, "http://127.0.0.1:3128"
+	badChain := querySrc("bad-chain", "http://127.0.0.1:1")
+	badChain.Chains = []string{"ETC"}
+	badExpr := querySrc("bad-expr", "http://127.0.0.1:1")
+	badExpr.Listed = `[range(3)]`
+	v, err := Validate(config.BifrostAddressFilterConfiguration{Sources: []config.BifrostAddressFilterSource{
+		bad, plain, loop, noProxy, viaProxy, badChain, badExpr,
+	}}, testChains, readOK)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for _, q := range []string{"bad-secret", "plain-http", "no-proxy", "bad-chain", "bad-expr"} {
+		if v.Quarantined[q] == nil {
+			t.Errorf("%s not quarantined", q)
+		}
+	}
+	if len(v.Sources) != 2 || v.Sources[0].Name != "loop" || v.Sources[1].Name != "via-proxy" {
+		t.Fatalf("valid sources %+v", v.Sources)
+	}
+}
+
+func TestValidateContextDependent(t *testing.T) {
+	s := querySrc("ctx", "http://127.0.0.1:1")
+	s.Body = `{address: $address, amount: $amount}`
+	a := querySrc("addr", "http://127.0.0.1:1")
+	a.Body = `{address: $address, chain: $chain}`
+	v, err := Validate(config.BifrostAddressFilterConfiguration{Sources: []config.BifrostAddressFilterSource{s, a}}, testChains, readOK)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !v.Sources[0].ContextDependent || v.Sources[1].ContextDependent {
+		t.Fatalf("classification %+v", v.Sources)
+	}
+}
+
+func TestValidateNeverPanicsOnBadGlobals(t *testing.T) {
+	for _, c := range []config.BifrostAddressFilterConfiguration{
+		{Combine: "most"}, {ScreenDeadline: 10e9}, {ChainBudgetPct: 101}, {MaxInflight: -1},
+	} {
+		if _, err := Validate(c, testChains, readOK); !errors.Is(err, ErrFatalConfig) {
+			t.Fatalf("%+v: want fatal, got %v", c, err)
+		}
+	}
+}
+
+func TestConfigRoundTripsFromYAML(t *testing.T) {
+	y := `
+address_filter:
+  enabled: true
+  combine: all
+  screen_deadline: 1500ms
+  max_inflight: 10
+  max_eval: 4
+  chain_budget_pct: 30
+  replay_enabled: true
+  seed: /data/seed.json
+  seed_sha256: abcd
+  sources:
+    - name: gj
+      mode: query
+      chains: [ETH, BTC]
+      url: https://gj.example/v1/check
+      method: POST
+      headers: {x-a: "secret:/s/a"}
+      body: '{items: [{chain: $chain, address: $address}]}'
+      auth: bearer
+      token_file: /s/token
+      batch: 50
+      listed: .listed
+      unknown: .tier == "unverified"
+      retry_after: .retry_after_ms
+      timeout: 1s
+      rate: 5
+      inflight: 8
+      daily_budget: 1000
+      chain_share: {ETH: 50}
+      min_value: {BSC: "1000"}
+      fresh_above: {BTC: "100000000"}
+      high_value_reserve_pct: 30
+      cache: {listed_ttl: 168h, clean_ttl: 5m, max_entries: 1000}
+      refresh: 1m
+      max_age: 1h
+      max_bytes: 1024
+      max_entries: 99
+      max_shrink_pct: 40
+      proxy_url: http://127.0.0.1:3128
+      follow_redirects: none
+      allow_private: false
+`
+	vp := viper.New()
+	vp.SetConfigType("yaml")
+	if err := vp.ReadConfig(strings.NewReader(y)); err != nil {
+		t.Fatal(err)
+	}
+	var c config.BifrostAddressFilterConfiguration
+	if err := vp.UnmarshalKey("address_filter", &c); err != nil {
+		t.Fatal(err)
+	}
+	s := c.Sources[0]
+	if c.Combine != "all" || c.ScreenDeadline.String() != "1.5s" || c.MaxEval != 4 || !c.ReplayEnabled ||
+		s.Name != "gj" || len(s.Chains) != 2 || s.Headers["x-a"] != "secret:/s/a" || s.Batch != 50 ||
+		s.Cache.CleanTTL.String() != "5m0s" || len(s.ChainShare) != 1 || len(s.MinValue) != 1 ||
+		s.ProxyURL == "" || s.MaxShrinkPct != 40 || s.HighValueReserv != 30 {
+		t.Fatalf("round trip lost fields: %+v / %+v", c, s)
+	}
+	// Viper lowercases map keys; Validate restores upper-case tickers.
+	s.ProxyURL, s.TokenFile = "http://127.0.0.1:3128", "tok"
+	s.Headers = nil
+	v, err := Validate(config.BifrostAddressFilterConfiguration{Sources: []config.BifrostAddressFilterSource{s}},
+		[]common.Chain{common.ETHChain, common.BTCChain, common.BSCChain}, readOK)
+	if err != nil || len(v.Sources) != 1 {
+		t.Fatalf("validate: %v %+v", err, v.Quarantined)
+	}
+	r := v.Sources[0].Raw
+	if r.ChainShare["ETH"] != 50 || r.MinValue["BSC"] != "1000" || r.FreshAbove["BTC"] != "100000000" {
+		t.Fatalf("keys not normalized: %+v", r)
+	}
+	if err := CheckUnknownKeys(vp.GetStringMap("address_filter")); err != nil {
+		t.Fatalf("known keys flagged: %v", err)
+	}
+	if err := CheckUnknownKeys(map[string]any{"enabled": true, "bogus": 1}); !errors.Is(err, ErrFatalConfig) {
+		t.Fatalf("unknown key not fatal: %v", err)
+	}
+}
diff --git a/bifrost/pkg/addressfilter/contextdep_test.go b/bifrost/pkg/addressfilter/contextdep_test.go
new file mode 100644
index 00000000000..90c963813a6
--- /dev/null
+++ b/bifrost/pkg/addressfilter/contextdep_test.go
@@ -0,0 +1,231 @@
+package addressfilter
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"github.com/spf13/viper"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+	"gitlab.com/thorchain/thornode/v3/config"
+)
+
+var gjallarTokenFile = map[string]string{"/secrets/gjallar.token": "adapter-token\n"}
+
+// adrGjallarExample loads the ADR's Gjallar worked example verbatim: the
+// testdata file is the ADR's YAML block, byte for byte.
+func adrGjallarExample(t *testing.T) config.BifrostAddressFilterSource {
+	t.Helper()
+	b, err := os.ReadFile("testdata/providers/adr_gjallar_example.yaml")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var sb strings.Builder
+	sb.WriteString("sources:\n")
+	for _, l := range strings.Split(strings.TrimRight(string(b), "\n"), "\n") {
+		sb.WriteString("  " + l + "\n")
+	}
+	vp := viper.New()
+	vp.SetConfigType("yaml")
+	if err := vp.ReadConfig(strings.NewReader(sb.String())); err != nil {
+		t.Fatal(err)
+	}
+	var srcs []config.BifrostAddressFilterSource
+	if err := vp.UnmarshalKey("sources", &srcs); err != nil {
+		t.Fatal(err)
+	}
+	if len(srcs) != 1 {
+		t.Fatalf("want 1 source, got %d", len(srcs))
+	}
+	return srcs[0]
+}
+
+func readFiles(files map[string]string) func(string) ([]byte, error) {
+	return func(p string) ([]byte, error) {
+		if v, ok := files[p]; ok {
+			return []byte(v), nil
+		}
+		return nil, os.ErrNotExist
+	}
+}
+
+// The ADR's Gjallar example, as written, passes Validate (not quarantined),
+// builds a query source, and is context-dependent.
+func TestADRGjallarExampleAcceptedVerbatim(t *testing.T) {
+	raw := adrGjallarExample(t)
+	var chains []common.Chain
+	for _, cs := range raw.Chains {
+		c, err := common.NewChain(cs)
+		if err != nil {
+			t.Fatalf("ADR chain %q: %v", cs, err)
+		}
+		chains = append(chains, c)
+	}
+	v, err := Validate(config.BifrostAddressFilterConfiguration{Enabled: true, Sources: []config.BifrostAddressFilterSource{raw}},
+		chains, readFiles(gjallarTokenFile))
+	if err != nil {
+		t.Fatalf("validate: %v", err)
+	}
+	if len(v.Quarantined) != 0 || len(v.Sources) != 1 {
+		t.Fatalf("ADR example quarantined: %v", v.Quarantined)
+	}
+	spec := v.Sources[0]
+	if !spec.ContextDependent {
+		t.Fatal("the ADR Gjallar example sends height and tx_id: it must be context-dependent")
+	}
+	for _, f := range []string{"results_map", "listed", "unknown", "reason", "retry_after", "body"} {
+		if spec.Exprs[f] == nil {
+			t.Fatalf("expression %s not compiled", f)
+		}
+	}
+	if _, err := NewQuerySource(spec, QuerySourceOptions{Builder: builder(t, spec), Client: http.DefaultClient}); err != nil {
+		t.Fatalf("query source refused the ADR example: %v", err)
+	}
+}
+
+// gjallarCountingServer answers every item clean (tier "vendor") and counts requests.
+func gjallarCountingServer(t *testing.T, calls *atomic.Int32) *httptest.Server {
+	t.Helper()
+	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		calls.Add(1)
+		b, _ := io.ReadAll(r.Body)
+		var req struct {
+			Items []map[string]any `json:"items"`
+		}
+		_ = json.Unmarshal(b, &req)
+		var res []any
+		for _, it := range req.Items {
+			res = append(res, map[string]any{"chain": it["chain"], "address": it["address"], "listed": false, "tier": "vendor"})
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{"results": res})
+	}))
+}
+
+func adrGjallarOn(t *testing.T, srv *httptest.Server, addressOnly bool) SourceSpec {
+	t.Helper()
+	raw := adrGjallarExample(t)
+	raw.URL, raw.ProxyURL = srv.URL+"/v1/check", "" // loopback test server
+	raw.Chains = []string{"BTC", "ETH"}
+	raw.AddressOnly = addressOnly
+	return querySpec(t, raw, gjallarTokenFile)
+}
+
+func ethItem(addr, tx string, h uint64) ItemDTO {
+	return ItemDTO{ThorChain: "ETH", Chain: "ETH", Address: addr, TxID: &tx, Height: &h, Coins: []CoinDTO{}}
+}
+
+// Fail-safe: the batch body sends height and tx_id through $items[], so a
+// clean answer for one inbound must never be reused for the same address in a
+// different inbound, even inside the clean TTL.
+func TestBatchCleanAnswerNotReusedAcrossInbounds(t *testing.T) {
+	var calls atomic.Int32
+	srv := gjallarCountingServer(t, &calls)
+	defer srv.Close()
+	spec := adrGjallarOn(t, srv, false)
+	cache := NewLRUCache(100, time.Hour, 5*time.Minute, nil)
+	q, err := NewQuerySource(spec, QuerySourceOptions{Builder: builder(t, spec), Client: srv.Client(), Cache: cache})
+	if err != nil {
+		t.Fatal(err)
+	}
+	addr := "0x00000000000000000000000000000000000000a1"
+	a1 := q.Check(context.Background(), common.ETHChain, []ItemDTO{ethItem(addr, "0xaaa1", 100)})
+	a2 := q.Check(context.Background(), common.ETHChain, []ItemDTO{ethItem(addr, "0xbbb2", 200)})
+	if a1[0].State != Clean || a2[0].State != Clean {
+		t.Fatalf("answers %+v %+v", a1[0], a2[0])
+	}
+	if n := calls.Load(); n != 2 {
+		t.Fatalf("same address, different height/tx_id inside the clean TTL: %d source calls, want 2 (answer reused across inbounds)", n)
+	}
+	if cache.Len() != 0 {
+		t.Fatalf("a context-dependent source wrote %d cache entries", cache.Len())
+	}
+}
+
+// address_only: true is the explicit opt-in: the same batch source is cached by
+// address again.
+func TestAddressOnlyReenablesCache(t *testing.T) {
+	var calls atomic.Int32
+	srv := gjallarCountingServer(t, &calls)
+	defer srv.Close()
+	spec := adrGjallarOn(t, srv, true)
+	if spec.ContextDependent {
+		t.Fatal("address_only: true must clear context dependence")
+	}
+	cache := NewLRUCache(100, time.Hour, 5*time.Minute, nil)
+	q, err := NewQuerySource(spec, QuerySourceOptions{Builder: builder(t, spec), Client: srv.Client(), Cache: cache})
+	if err != nil {
+		t.Fatal(err)
+	}
+	addr := "0x00000000000000000000000000000000000000a2"
+	q.Check(context.Background(), common.ETHChain, []ItemDTO{ethItem(addr, "0xaaa1", 100)})
+	q.Check(context.Background(), common.ETHChain, []ItemDTO{ethItem(addr, "0xbbb2", 200)})
+	if n := calls.Load(); n != 1 {
+		t.Fatalf("address_only source: %d calls, want 1 (second answered from cache)", n)
+	}
+}
+
+func TestAddressOnlyRefusals(t *testing.T) {
+	read := readFiles(gjallarTokenFile)
+	known := map[string]common.Chain{"BTC": common.BTCChain, "ETH": common.ETHChain}
+	// A response selector that reads context contradicts address_only.
+	s := querySrc("ctxsel", "http://127.0.0.1:1/check/{address}")
+	s.Listed, s.AddressOnly = `.listed and ($height // 0) > 0`, true
+	if _, err := validateSource(s, known, read, NewEvalSemaphore(0)); err == nil || !strings.Contains(err.Error(), "address_only") {
+		t.Fatalf("address_only with a context selector: %v", err)
+	}
+	// address_only is for query sources only.
+	l := config.BifrostAddressFilterSource{Name: "l", Mode: "list", Chains: []string{"BTC"}, URL: "http://127.0.0.1:1/list", Listed: ".", AddressOnly: true}
+	if _, err := validateSource(l, known, read, NewEvalSemaphore(0)); err == nil || !strings.Contains(err.Error(), "address_only") {
+		t.Fatalf("address_only on a list source: %v", err)
+	}
+	// A request body that reads context is fine under address_only (the
+	// operator asserts the provider ignores it).
+	b := querySrc("ctxbody", "http://127.0.0.1:1/check")
+	b.Body, b.AddressOnly = `{a: $address, h: $height}`, true
+	spec, err := validateSource(b, known, read, NewEvalSemaphore(0))
+	if err != nil || spec.ContextDependent {
+		t.Fatalf("address_only with a context body: %v ctx=%v", err, spec.ContextDependent)
+	}
+}
+
+// A per-item request that reads context through the input "." (no context
+// variable named) is still context-dependent; an address-only one is not.
+func TestPerItemRequestReadingInputIsContextDependent(t *testing.T) {
+	read := readFiles(gjallarTokenFile)
+	known := map[string]common.Chain{"BTC": common.BTCChain, "ETH": common.ETHChain}
+	for _, tc := range []struct {
+		name    string
+		body    string
+		headers map[string]string
+		query   map[string]string
+		ctx     bool
+	}{
+		{name: "body .height", body: `{a: $address, h: .height}`, ctx: true},
+		{name: "body whole input", body: `.`, ctx: true},
+		{name: "body .coins", body: `{a: .address, c: (.coins | length)}`, ctx: true},
+		{name: "header .tx_id", headers: map[string]string{"X-Tx": `jq:.tx_id // ""`}, ctx: true},
+		{name: "query .block_time", query: map[string]string{"t": `jq:(.block_time // 0) | tostring`}, ctx: true},
+		{name: "body address only", body: `{a: $address, c: $chain}`, ctx: false},
+		{name: "body input address", body: `{a: .address, c: .chain}`, ctx: false},
+		{name: "header address only", headers: map[string]string{"X-A": `jq:$address | ascii_downcase`}, ctx: false},
+		{name: "no request expressions", ctx: false},
+	} {
+		s := querySrc("p", "http://127.0.0.1:1/check")
+		s.Body, s.Headers, s.Query = tc.body, tc.headers, tc.query
+		spec, err := validateSource(s, known, read, NewEvalSemaphore(0))
+		if err != nil {
+			t.Fatalf("%s: %v", tc.name, err)
+		}
+		if spec.ContextDependent != tc.ctx {
+			t.Fatalf("%s: context-dependent %v, want %v", tc.name, spec.ContextDependent, tc.ctx)
+		}
+	}
+}
diff --git a/bifrost/pkg/addressfilter/dryrun.go b/bifrost/pkg/addressfilter/dryrun.go
new file mode 100644
index 00000000000..e3b8ebe8edb
--- /dev/null
+++ b/bifrost/pkg/addressfilter/dryrun.go
@@ -0,0 +1,118 @@
+package addressfilter
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"net/http"
+	"sort"
+	"strings"
+	"time"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+)
+
+// DryRunReport is what `bifrost address-filter dry-run` prints. Every string
+// in it has been through the source's redactor: no secret value, no signature
+// header value, no sensitive query parameter.
+type DryRunReport struct {
+	Source   string              `json:"source"`
+	Chain    string              `json:"chain"`
+	Method   string              `json:"method"`
+	URL      string              `json:"url"`
+	Headers  map[string][]string `json:"headers"`
+	Body     string              `json:"body,omitempty"`
+	Status   int                 `json:"status"`
+	Response string              `json:"response,omitempty"`
+	// Results holds each expression's result (JSON) or its error.
+	Results map[string]string `json:"results"`
+	Answer  string            `json:"answer"`
+	Reason  string            `json:"reason,omitempty"`
+	Error   string            `json:"error,omitempty"`
+}
+
+// DryRun builds, sends and judges one request for a query source, exactly as
+// screening would, without caches, budgets or rate limits. raw includes the
+// (scrubbed) response body.
+func DryRun(ctx context.Context, spec SourceSpec, client *http.Client, chain common.Chain, address string, raw bool, now time.Time) DryRunReport {
+	rep := DryRunReport{Source: spec.Name, Chain: chain.String(), Results: map[string]string{}}
+	red := NewRedactor(spec.Secrets, nil)
+	fail := func(err error) DryRunReport {
+		rep.Error = red.String(err.Error())
+		rep.Answer = Unknown.String()
+		return rep
+	}
+	if spec.Mode != "query" {
+		return fail(fmt.Errorf("dry-run needs a query source (source %q is %s)", spec.Name, spec.Mode))
+	}
+	auth, err := NewAuthenticator(spec, spec.SecretFiles)
+	if err != nil {
+		return fail(err)
+	}
+	b, err := NewRequestBuilder(spec, spec.SecretFiles, auth)
+	if err != nil {
+		return fail(err)
+	}
+	if client == nil {
+		pol, err := PolicyFor(spec, auth != nil)
+		if err != nil {
+			return fail(err)
+		}
+		client = NewHTTPClient(pol)
+	}
+	providerChain := chain.String()
+	if m, ok := spec.Raw.ChainMap[chain.String()]; ok && m != "" {
+		providerChain = m
+	}
+	d := ItemDTO{ThorChain: chain.String(), Chain: providerChain, Address: address, Coins: []CoinDTO{}}
+	input, vals := d.ToJQ()
+	vals = WithThreshold(vals, spec.Raw.Threshold)
+	br, err := b.Build(ctx, address, providerChain, input, vals, now)
+	if err != nil {
+		return fail(err)
+	}
+	red = br.Redactor
+	rep.Method = br.Req.Method
+	rep.URL = red.URL(br.Req.URL, br.SensitiveParams)
+	rep.Headers = map[string][]string(red.Header(br.Req.Header, br.SensitiveHeaders...))
+	if len(br.Body) > 0 {
+		rep.Body = red.String(string(br.Body))
+	}
+	maxBytes := spec.Raw.MaxBytes
+	if maxBytes <= 0 {
+		maxBytes = DefaultMaxBytes
+	}
+	st, _, body, err := Send(client, br, maxBytes)
+	rep.Status = st
+	if raw {
+		rep.Response = red.String(string(body))
+	}
+	if err != nil {
+		return fail(err)
+	}
+	var doc any
+	if err := json.Unmarshal(body, &doc); err != nil {
+		return fail(fmt.Errorf("response is not JSON"))
+	}
+	names := make([]string, 0, len(spec.Exprs))
+	for n := range spec.Exprs {
+		if strings.HasPrefix(n, "header:") || strings.HasPrefix(n, "query:") || strings.HasPrefix(n, "body") {
+			continue
+		}
+		names = append(names, n)
+	}
+	sort.Strings(names)
+	for _, n := range names {
+		v, err := spec.Exprs[n].Eval(ctx, doc, vals...)
+		if err != nil {
+			rep.Results[n] = "error: " + red.String(err.Error())
+			continue
+		}
+		jb, _ := json.Marshal(v)
+		rep.Results[n] = red.String(string(jb))
+	}
+	q := &QuerySource{name: spec.Name, exprs: spec.Exprs}
+	a := q.judge(ctx, doc, vals, red)
+	rep.Answer, rep.Reason = a.State.String(), a.Reason
+	return rep
+}
