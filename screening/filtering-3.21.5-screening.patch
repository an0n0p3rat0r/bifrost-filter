+	c.Assert(f.Loaded(), Equals, 4)
+	c.Assert(f.Skipped(), Equals, 0)
+	c.Assert(f.Listed(common.TRONChain, tron), Equals, true)
+	c.Assert(f.Listed(common.DOGEChain, doge), Equals, true)
+	c.Assert(f.Listed(common.LTCChain, ltc), Equals, true)
+	c.Assert(f.Listed(common.SOLChain, seedSOL), Equals, true)
+	c.Assert(f.Listed(common.SOLChain, tron), Equals, false)
+	c.Assert(f.Listed(common.BTCChain, doge), Equals, false)
+}
+
+func (s *AddressFilterSuite) TestBTCValidation(c *C) {
+	// valid legacy P2PKH and P2SH load
+	p2sh := altBase58(0x05)
+	c.Assert(p2sh[0], Equals, byte('3'))
+	f := New(legacyBTC + "," + p2sh)
+	c.Assert(f.Loaded(), Equals, 2)
+	c.Assert(f.Listed(common.BTCChain, p2sh), Equals, true)
+
+	// legacy-shaped but bad checksum: skipped
+	badLegacy := legacyBTC[:len(legacyBTC)-1] + "b"
+	f = New(badLegacy)
+	c.Assert(f.Loaded(), Equals, 0)
+	c.Assert(f.Skipped(), Equals, 1)
+
+	// bc1 with a bad checksum (one char changed): skipped
+	last := seedBech32[len(seedBech32)-1]
+	swap := byte('q')
+	if last == 'q' {
+		swap = 'p'
+	}
+	badBech32 := seedBech32[:len(seedBech32)-1] + string(swap)
+	f = New(badBech32)
+	c.Assert(f.Loaded(), Equals, 0)
+	c.Assert(f.Skipped(), Equals, 1)
+	c.Assert(f.Listed(common.BTCChain, badBech32), Equals, false)
+
+	// bc1 prefix with garbage, and a testnet address: skipped
+	f = New("bc1notanaddress,tb1qw508d6qejxtdg4y5r3zarvary0c5xw7kxpjzsx")
+	c.Assert(f.Loaded(), Equals, 0)
+	c.Assert(f.Skipped(), Equals, 2)
+
+	// valid bc1 still loads, in either case
+	f = New(strings.ToUpper(seedBech32))
+	c.Assert(f.Loaded(), Equals, 1)
+	c.Assert(f.Listed(common.BTCChain, seedBech32), Equals, true)
+}
diff --git a/bifrost/pkg/addressfilter/auth.go b/bifrost/pkg/addressfilter/auth.go
new file mode 100644
index 00000000000..ffb23d28ff2
--- /dev/null
+++ b/bifrost/pkg/addressfilter/auth.go
@@ -0,0 +1,90 @@
+package addressfilter
+
+import (
+	"fmt"
+	"net/http"
+	"net/url"
+	"strings"
+	"time"
+
+	"gitlab.com/thorchain/thornode/v3/bifrost/pkg/addressfilter/signer"
+)
+
+// Authenticator applies a source's auth mode to a fully built request. It
+// returns the sensitive header names and query parameters it set, for the
+// redactor. Secrets are loaded once (at Validate); Apply does no file I/O.
+type Authenticator struct {
+	mode   string // none | bearer | query | signer
+	token  string
+	param  string
+	secret string
+	signer signer.Signer
+}
+
+// NewAuthenticator builds the authenticator for a validated source. secrets
+// maps a secret file path to its loaded value.
+func NewAuthenticator(spec SourceSpec, secrets map[string]string) (*Authenticator, error) {
+	r := spec.Raw
+	mode := strings.ToLower(strings.TrimSpace(r.Auth))
+	switch {
+	case mode == "" || mode == "none":
+		return &Authenticator{mode: "none"}, nil
+	case mode == "bearer":
+		return &Authenticator{mode: "bearer", token: secrets[r.TokenFile]}, nil
+	case mode == "query":
+		return &Authenticator{mode: "query", param: r.QueryParam, secret: secrets[r.SecretFile]}, nil
+	case strings.HasPrefix(mode, "signer:"):
+		s, err := signer.New(strings.TrimPrefix(mode, "signer:"), secrets[r.KeyFile], secrets[r.SecretFile])
+		if err != nil {
+			return nil, err
+		}
+		return &Authenticator{mode: "signer", signer: s}, nil
+	}
+	return nil, fmt.Errorf("auth %q", r.Auth)
+}
+
+// Signed reports whether requests are authenticated (redirects are then
+// never followed).
+func (a *Authenticator) Signed() bool { return a.mode != "none" }
+
+// Apply sets auth on req (whose body bytes are body). It must be the last
+// mutation before sending: a signer signs the final bytes.
+func (a *Authenticator) Apply(req *http.Request, body []byte, now time.Time) (sensitiveHeaders, sensitiveParams []string, err error) {
+	switch a.mode {
+	case "bearer":
+		req.Header.Set("Authorization", "Bearer "+a.token)
+		return []string{"Authorization"}, nil, nil
+	case "query":
+		q := req.URL.Query()
+		q.Set(a.param, a.secret)
+		req.URL.RawQuery = q.Encode()
+		return nil, []string{a.param}, nil
+	case "signer":
+		pq := req.URL.EscapedPath()
+		if req.URL.RawQuery != "" {
+			pq += "?" + req.URL.RawQuery
+		}
+		h, sens, err := a.signer.Sign(req.Method, pq, body, now)
+		if err != nil {
+			return nil, nil, err
+		}
+		for k, vs := range h {
+			for _, v := range vs {
+				req.Header.Set(k, v)
+			}
+		}
+		return sens, nil, nil
+	}
+	return nil, nil, nil
+}
+
+// secretValues returns the loaded secret values for redaction.
+func (a *Authenticator) secretValues() []string {
+	var out []string
+	for _, s := range []string{a.token, a.secret} {
+		if s != "" {
+			out = append(out, s, url.QueryEscape(s))
+		}
+	}
+	return out
+}
diff --git a/bifrost/pkg/addressfilter/auth_test.go b/bifrost/pkg/addressfilter/auth_test.go
new file mode 100644
index 00000000000..4e795d1d9a2
