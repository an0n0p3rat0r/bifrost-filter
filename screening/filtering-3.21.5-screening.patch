+// Finding 9: every non-answer is counted by source and kind and warned
+// (rate-limited); list refresh errors and held shrinks are reported.
+func TestNonAnswersCountedAndWarned(t *testing.T) {
+	g := newSyncGuard(true)
+	m := NewMetrics()
+	var warned []string
+	w := NewWarnLimiter(time.Minute, nil, func(class, source, msg string) { warned = append(warned, class+"/"+source) })
+	src := &fnSource{name: "vend", answer: func(context.Context, ItemDTO) Answer { return unknown(KindStatus, "502") }}
+	s := NewScreener(ScreenerOptions{Sources: []Source{src}, Guard: g, Metrics: m, Warn: w})
+	s.ScreenTxIn(context.Background(), common.ETHChain, ethItems(3))
+	if got := testutilCounter(t, m.SourceErrors.WithLabelValues("vend", KindStatus)); got != 3 {
+		t.Fatalf("source_errors_total{vend,status} = %v, want 3", got)
+	}
+	if len(warned) != 1 || warned[0] != "source_status/vend" {
+		t.Fatalf("one warning per source and kind: %v", warned)
+	}
+
+	ls := &listServer{body: addrList(100)}
+	srv := httptest.NewServer(http.HandlerFunc(ls.handler))
+	defer srv.Close()
+	clk := &clock{t: time.Unix(1_800_000_000, 0)}
+	l := newList(t, srv, clk, nil)
+	var refreshErr error
+	var suspect bool
+	l.onRefresh = func(err error, s bool) { refreshErr, suspect = err, s }
+	if err := l.RefreshOnce(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	ls.set(`{"addresses":[]}`, "")
+	_ = l.RefreshOnce(context.Background())
+	if refreshErr == nil || !suspect {
+		t.Fatalf("a held shrink must be reported: err=%v suspect=%v", refreshErr, suspect)
+	}
+}
