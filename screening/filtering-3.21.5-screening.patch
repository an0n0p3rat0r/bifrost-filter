+// NEW-3: one sender can't fill its chain's share: past max_records_per_sender
+// its skips are observed (ErrSenderCap, not the critical ledger-full), and
+// other senders on the same chain still record.
+func TestPerSenderLedgerCap(t *testing.T) {
+	m := NewMetrics()
+	l := NewSkipLedger(NewMemLedgerStore(), 1000, m, nil)
+	l.SetChainCap(500)
+	l.SetSenderCap(16)
+	for i := 0; i < 16; i++ {
+		if err := l.Record(r3Envelope(t, "ETH", fmt.Sprintf("a%d", i), "0xAAaa")); err != nil {
+			t.Fatalf("record %d: %v", i, err)
+		}
+	}
+	err := l.Record(r3Envelope(t, "ETH", "a16", "0xaaAA"))
+	if !errors.Is(err, ErrSenderCap) {
+		t.Fatalf("NEW-3: the 17th record of one sender must hit the sender cap (case-insensitive): %v", err)
+	}
+	if err := l.Record(r3Envelope(t, "ETH", "b0", "0xbbbb")); err != nil {
+		t.Fatalf("another sender on the same chain still records: %v", err)
+	}
+	if err := l.Record(r3Envelope(t, "BTC", "c0", "0xAAaa")); err != nil {
+		t.Fatalf("the cap is per chain: %v", err)
+	}
+}
+
+// NEW-3: the default per-sender cap follows the per-chain cap (a 16th, at
+// least 16), so filling one chain takes at least 16 listed senders.
+func TestDefaultPerSenderCap(t *testing.T) {
+	if got := DefaultPerSenderRecords(3125); got != 195 {
