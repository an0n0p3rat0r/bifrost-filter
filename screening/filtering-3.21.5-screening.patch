+func TestGuardSeedAndRevoke(t *testing.T) {
+	g, _ := NewGuard(&memGuardStore{}, nil)
+	// A seed entry is a vault address with the pubkey it derives from
+	// (round 3, NEW-6).
+	pk := ttypes.GetRandomPubKey()
+	vaultBCH := mustAddr(t, pk, common.BCHChain)
+	seed := []byte(`{"version":1,"built_at_height":1,"entries":[{"pubkey":"` + pk.String() + `","chain":"BCH","address":"` + vaultBCH + `"}]}`)
+	if err := g.LoadSeed(seed, strings.Repeat("0", 64)); err == nil {
+		t.Fatal("a wrong sha256 must refuse the seed")
+	}
+	g.MarkReconciled(true)
+	if g.Ready() {
+		t.Fatal("a refused seed keeps the guard unready")
+	}
+	if err := g.LoadSeed(seed, sha256Hex(seed)); err != nil {
+		t.Fatal(err)
+	}
+	if !g.Ready() || !g.Contains(common.BCHChain, vaultBCH) {
+		t.Fatal("a seeded vault address is guarded")
+	}
+	// Aliases: a guarded cashaddr also guards its legacy form.
+	if err := g.AddAddress("vault", common.BCHChain, "bitcoincash:qpm2qsznhks23z7629mms6s4cwef74vcwvy22gdx6a"); err != nil {
+		t.Fatal(err)
+	}
+	if !g.Contains(common.BCHChain, "1BpEi6DfDAUFd7GtittLSdBeYJvcoaVggu") {
+		t.Fatal("a guarded cashaddr must guard its legacy alias")
+	}
+	e0 := g.Epoch()
+	if err := g.Revoke(common.BCHChain, "1BpEi6DfDAUFd7GtittLSdBeYJvcoaVggu", "operator", "test"); err != nil {
+		t.Fatal(err)
+	}
+	if g.Contains(common.BCHChain, "bitcoincash:qpm2qsznhks23z7629mms6s4cwef74vcwvy22gdx6a") || g.Epoch() == e0 {
+		t.Fatal("revoking one alias revokes all aliases and bumps the epoch")
+	}
+	if err := g.Unrevoke(common.BCHChain, "bitcoincash:qpm2qsznhks23z7629mms6s4cwef74vcwvy22gdx6a"); err != nil {
+		t.Fatal(err)
+	}
+	if !g.Contains(common.BCHChain, "1BpEi6DfDAUFd7GtittLSdBeYJvcoaVggu") {
+		t.Fatal("unrevoke restores")
+	}
+}
