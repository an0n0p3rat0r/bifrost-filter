+	src := &ctxDepSrc{listedTx: map[string]bool{"tx2": true}}
+	r := NewRechecker(RecheckerOptions{Ledger: f.l, Sources: []Source{src}, Guard: f.g, Now: f.clk.now,
+		OnRelease: func(*SkipEnvelope) error { return nil }})
