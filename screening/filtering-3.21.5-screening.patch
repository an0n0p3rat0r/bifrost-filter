+	"gitlab.com/thorchain/thornode/v3/common/cosmos"
+)
+
+func TestItemDTOUnknownHeightIsNull(t *testing.T) {
+	it := &stypes.TxInItem{Sender: "0xabc", Tx: "TX1", BlockHeight: 0}
+	b, err := json.Marshal(NewItemDTO(common.ETHChain, it, 0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	s := string(b)
+	for _, want := range []string{`"height":null`, `"block_time":null`, `"asset":null`, `"amount":null`, `"coins":[]`} {
+		if !strings.Contains(s, want) {
+			t.Fatalf("missing %s in %s", want, s)
+		}
+	}
+}
+
+func TestItemDTOCoinsAndExactAmount(t *testing.T) {
+	big := cosmos.NewUintFromString("123456789012345678901234567890")
+	it := &stypes.TxInItem{
+		Sender: "bc1qx", Tx: "TX2", BlockHeight: 42,
+		Coins: common.Coins{
+			common.NewCoin(common.BTCAsset, big),
+			common.NewCoin(common.RuneAsset(), cosmos.NewUint(7)),
+		},
+	}
+	d := NewItemDTO(common.BTCChain, it, 1700000000)
+	if len(d.Coins) != 2 || *d.Asset != common.BTCAsset.String() || *d.Amount != "123456789012345678901234567890" {
+		t.Fatalf("bad dto %+v", d)
+	}
+	if *d.Height != 42 || *d.BlockTime != 1700000000 {
+		t.Fatalf("bad height/time %+v", d)
+	}
+	m, vals := d.ToJQ()
+	if m["address"] != "bc1qx" || vals[2] != "bc1qx" || vals[8] != "123456789012345678901234567890" {
+		t.Fatalf("bad jq view %v %v", m, vals)
+	}
+}
+
+func TestItemDTONegativeHeightIsNull(t *testing.T) {
+	d := NewItemDTO(common.ETHChain, &stypes.TxInItem{BlockHeight: -5}, -1)
+	if d.Height != nil || d.BlockTime != nil {
+		t.Fatalf("negative must be null: %+v", d)
+	}
+}
diff --git a/bifrost/pkg/addressfilter/expr.go b/bifrost/pkg/addressfilter/expr.go
new file mode 100644
index 00000000000..fe618a09e66
--- /dev/null
+++ b/bifrost/pkg/addressfilter/expr.go
@@ -0,0 +1,174 @@
+package addressfilter
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"reflect"
+	"strings"
+
+	"github.com/itchyny/gojq"
+)
+
+// exprAllowed is the builtin allowlist (R3-A9): path/index access, select,
+// map/.[] over input, comparisons and boolean ops, and a few pure string and
+// number helpers. Everything else (generators, I/O, env, recursion, user defs)
+// is rejected at config load.
+var exprAllowed = map[string]bool{
+	"select": true, "map": true, "length": true, "first": true, "any": true,
+	"all": true, "has": true, "tostring": true, "tonumber": true,
+	"ascii_downcase": true, "test": true, "ltrimstr": true, "rtrimstr": true,
+	"not": true, "type": true, "null": true, "true": true, "false": true,
+	"join": true,
+}
+
+// exprDeniedVars are variables that would expose the environment or source
+// positions.
+var exprDeniedVars = map[string]bool{"$ENV": true, "$__loc__": true}
+
+const (
+	// MaxExprOutput caps the JSON-encoded size of one expression result.
+	MaxExprOutput = 64 << 10
+	// DefaultMaxEval is the default global evaluation concurrency.
+	DefaultMaxEval = 32
+)
+
+var (
+	// ErrExprResults is returned when an expression yields zero or several results.
+	ErrExprResults = errors.New("expression must yield exactly one result")
+	// ErrExprOutput is returned when a result exceeds MaxExprOutput.
+	ErrExprOutput = errors.New("expression result exceeds output cap")
+)
+
+// Expr is a compiled, allowlisted expression. Safe for concurrent use.
+type Expr struct {
+	src  string
+	code *gojq.Code
+	sem  chan struct{}
+	// vars are the variable names referenced by the expression (for the
+	// address-only vs context-dependent classification, R3-A8).
+	vars map[string]bool
+}
+
+// NewEvalSemaphore returns a global evaluation semaphore of size n.
+func NewEvalSemaphore(n int) chan struct{} {
+	if n <= 0 {
+		n = DefaultMaxEval
+	}
+	return make(chan struct{}, n)
+}
+
+// CompileExpr parses src, rejects anything outside the allowlist, and compiles
+// it with the given variable names. sem bounds concurrent evaluations.
+func CompileExpr(src string, vars []string, sem chan struct{}) (*Expr, error) {
+	q, err := gojq.Parse(src)
+	if err != nil {
+		return nil, fmt.Errorf("parse: %w", err)
+	}
+	used := map[string]bool{}
+	if err := checkAST(reflect.ValueOf(q), used); err != nil {
+		return nil, err
+	}
+	code, err := gojq.Compile(q, gojq.WithVariables(vars))
+	if err != nil {
+		return nil, fmt.Errorf("compile: %w", err)
+	}
+	if sem == nil {
+		sem = NewEvalSemaphore(DefaultMaxEval)
+	}
+	return &Expr{src: src, code: code, sem: sem, vars: used}, nil
+}
+
+// References reports whether the expression reads variable name (e.g. "$amount").
+func (e *Expr) References(name string) bool { return e.vars[name] }
+
+// String returns the source text.
+func (e *Expr) String() string { return e.src }
+
+func checkAST(v reflect.Value, used map[string]bool) error {
+	switch v.Kind() {
+	case reflect.Ptr, reflect.Interface:
+		if v.IsNil() {
+			return nil
+		}
+		switch n := v.Interface().(type) {
+		case *gojq.FuncDef:
+			return errors.New("expression: user definitions (def) are not allowed")
+		case *gojq.Func:
+			if strings.HasPrefix(n.Name, "$") {
+				if exprDeniedVars[n.Name] {
+					return fmt.Errorf("expression: %s is not allowed", n.Name)
+				}
+				used[n.Name] = true
+			} else if !exprAllowed[n.Name] {
+				return fmt.Errorf("expression: builtin %s/%d is not allowed", n.Name, len(n.Args))
+			}
+		case *gojq.Term:
+			if n.Format != "" {
+				return fmt.Errorf("expression: format %s is not allowed", n.Format)
+			}
+			if n.Reduce != nil || n.Foreach != nil || n.Label != nil {
+				return errors.New("expression: reduce/foreach/label are not allowed")
+			}
+		}
+		return checkAST(v.Elem(), used)
+	case reflect.Struct:
+		for i := 0; i < v.NumField(); i++ {
+			if v.Type().Field(i).IsExported() {
+				if err := checkAST(v.Field(i), used); err != nil {
+					return err
+				}
+			}
+		}
+	case reflect.Slice, reflect.Array:
+		for i := 0; i < v.Len(); i++ {
+			if err := checkAST(v.Index(i), used); err != nil {
+				return err
+			}
+		}
+	}
+	return nil
+}
+
+// Eval runs the expression under ctx. It requires exactly one result and a
+// clean end of the iterator, and caps the encoded result at MaxExprOutput.
+func (e *Expr) Eval(ctx context.Context, input any, vals ...any) (any, error) {
+	return e.EvalLimit(ctx, MaxExprOutput, input, vals...)
+}
+
+// EvalLimit is Eval with a caller-chosen output cap (a list source's
+// `listed` array is bounded by its max_bytes, not the per-item cap).
+func (e *Expr) EvalLimit(ctx context.Context, limit int, input any, vals ...any) (any, error) {
+	select {
+	case e.sem <- struct{}{}:
+	case <-ctx.Done():
+		return nil, ctx.Err()
+	}
+	defer func() { <-e.sem }()
+	it := e.code.RunWithContext(ctx, input, vals...)
+	v, ok := it.Next()
+	if !ok {
+		return nil, ErrExprResults
+	}
+	if err, isErr := v.(error); isErr {
+		return nil, fmt.Errorf("expression: %w", err)
+	}
+	if extra, more := it.Next(); more {
+		if err, isErr := extra.(error); isErr {
+			return nil, fmt.Errorf("expression: trailing error: %w", err)
+		}
+		return nil, ErrExprResults
+	}
+	if err := ctx.Err(); err != nil {
+		return nil, err
+	}
+	b, err := json.Marshal(v)
+	if err != nil {
+		return nil, fmt.Errorf("expression: encode result: %w", err)
+	}
+	if len(b) > limit {
+		return nil, ErrExprOutput
+	}
+	return v, nil
+}
diff --git a/bifrost/pkg/addressfilter/expr_test.go b/bifrost/pkg/addressfilter/expr_test.go
new file mode 100644
index 00000000000..44d8a107c35
--- /dev/null
+++ b/bifrost/pkg/addressfilter/expr_test.go
@@ -0,0 +1,96 @@
+package addressfilter
+
+import (
+	"context"
+	"strings"
+	"testing"
+	"time"
+)
+
+func TestExprAllowlistedExamplesCompile(t *testing.T) {
+	for _, src := range []string{
+		`.listed`,
+		`.results | map(select(.address == $address)) | first | .listed`,
+		`.results | map(select(.address == $address)) | length != 1`,
+		`.data.score >= 91 and .success == true`,
+		`.success != true`,
+		`(.risk_score // null) != null and .risk_score >= 5`,
+		`{address: $address, chain: $chain, amount: $amount}`,
+		`.tier | ascii_downcase | test("^unverified$")`,
+	} {
+		if _, err := CompileExpr(src, VarNames, nil); err != nil {
+			t.Errorf("%s: %v", src, err)
+		}
+	}
+}
+
+func TestExprRejected(t *testing.T) {
+	for _, src := range []string{
+		`[range(10)]`, `[repeat(1)]`, `[while(true; .)]`, `[until(true; .)]`,
+		`[recurse]`, `[limit(1; .[])]`, `input`, `[inputs]`, `env`, `$ENV`,
+		`$__loc__`, `@base64d`, `[splits("a")]`, `[combinations]`, `walk(.)`,
+		`def f: .; f`, `reduce .[] as $x (0; . + $x)`,
+	} {
+		if _, err := CompileExpr(src, VarNames, nil); err == nil {
+			t.Errorf("%s: compiled, want rejection", src)
+		}
+	}
+}
+
+func TestExprEval(t *testing.T) {
+	ctx := context.Background()
+	e, _ := CompileExpr(`.listed`, VarNames, nil)
+	v, err := e.Eval(ctx, map[string]any{"listed": true}, make([]any, len(VarNames))...)
+	if err != nil || v != true {
+		t.Fatalf("got %v %v", v, err)
+	}
+	two, _ := CompileExpr(`true, false`, VarNames, nil)
+	if _, err := two.Eval(ctx, nil, make([]any, len(VarNames))...); err == nil {
+		t.Fatal("two results must error")
+	}
+	trailing, err := CompileExpr(`true, (null | tonumber)`, VarNames, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if _, err := trailing.Eval(ctx, nil, make([]any, len(VarNames))...); err == nil {
+		t.Fatal("trailing error must error")
+	}
+	big := make([]any, 4<<20/8)
+	for i := range big {
+		big[i] = "abcdefg"
+	}
+	arr, _ := CompileExpr(`[.a[]]`, VarNames, nil)
+	if _, err := arr.Eval(ctx, map[string]any{"a": big}, make([]any, len(VarNames))...); err != ErrExprOutput {
+		t.Fatalf("want output cap error, got %v", err)
+	}
+	cctx, cancel := context.WithCancel(ctx)
+	cancel()
+	if _, err := e.Eval(cctx, map[string]any{"listed": true}, make([]any, len(VarNames))...); err == nil {
+		t.Fatal("cancelled ctx must error")
+	}
+}
+
+func TestExprDeadlineStopsLongIteration(t *testing.T) {
+	big := make([]any, 2_000_000)
+	for i := range big {
+		big[i] = i
+	}
+	e, _ := CompileExpr(`[.[] | select(. >= 0) | tostring] | length`, VarNames, nil)
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	start := time.Now()
+	_, err := e.Eval(ctx, big, make([]any, len(VarNames))...)
+	if err == nil || !strings.Contains(err.Error(), "deadline") {
+		t.Fatalf("want deadline error, got %v", err)
+	}
+	if time.Since(start) > 2*time.Second {
+		t.Fatalf("deadline not honoured: %v", time.Since(start))
+	}
+}
+
+func TestExprReferences(t *testing.T) {
+	e, _ := CompileExpr(`{a: $address, m: $amount}`, VarNames, nil)
+	if !e.References("$amount") || e.References("$height") {
+		t.Fatal("bad variable classification")
+	}
+}
diff --git a/bifrost/pkg/addressfilter/failopen_test.go b/bifrost/pkg/addressfilter/failopen_test.go
new file mode 100644
index 00000000000..f47e4e55043
--- /dev/null
+++ b/bifrost/pkg/addressfilter/failopen_test.go
@@ -0,0 +1,95 @@
+package addressfilter
+
+import (
+	"context"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+	"time"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+	"gitlab.com/thorchain/thornode/v3/config"
+)
+
+// AC-A5: every source failure mode yields Unknown and the item is observed.
+func TestFailOpenMatrix(t *testing.T) {
+	cases := []struct {
+		name    string
+		handler http.HandlerFunc
+		raw     config.BifrostAddressFilterSource
+		budget  bool
+	}{
+		{name: "5xx", handler: func(w http.ResponseWriter, _ *http.Request) { w.WriteHeader(502) }},
+		{name: "429", handler: func(w http.ResponseWriter, _ *http.Request) {
+			w.Header().Set("Retry-After", "1")
+			w.WriteHeader(429)
+		}},
+		{name: "malformed json", handler: func(w http.ResponseWriter, _ *http.Request) { io.WriteString(w, `{"listed":`) }},
+		{name: "missing field", handler: func(w http.ResponseWriter, _ *http.Request) { io.WriteString(w, `{"other":true}`) }},
+		{name: "non-boolean", handler: func(w http.ResponseWriter, _ *http.Request) { io.WriteString(w, `{"listed":"yes"}`) }},
+		{name: "timeout", handler: func(w http.ResponseWriter, r *http.Request) {
+			select {
+			case <-time.After(2 * time.Second):
+			case <-r.Context().Done():
+			}
+			io.WriteString(w, `{"listed":true}`)
+		}, raw: config.BifrostAddressFilterSource{Timeout: 100 * time.Millisecond}},
+		{name: "budget exhausted", handler: func(w http.ResponseWriter, _ *http.Request) { io.WriteString(w, `{"listed":true}`) }, budget: true},
+	}
+	for _, tc := range cases {
+		t.Run(tc.name, func(t *testing.T) {
+			srv := httptest.NewServer(tc.handler)
+			defer srv.Close()
+			raw := tc.raw
+			raw.Listed = ".listed"
+			o := QuerySourceOptions{}
+			if tc.budget {
+				b, err := NewBudget(BudgetConfig{Credential: "q", Daily: 1}, NewMemBudgetStore())
+				if err != nil {
+					t.Fatal(err)
+				}
+				if _, ok, _ := b.Reserve(common.BTCChain, ""); !ok {
+					t.Fatal("first reservation must succeed")
+				}
+				o.Budget = b
+			}
+			q := newQuery(t, srv, raw, o)
+			s := NewScreener(ScreenerOptions{Sources: []Source{q}, Guard: newSyncGuard(true), Deadline: 300 * time.Millisecond})
+			items := []ItemDTO{{Address: "bc1qlisted"}}
+			v := s.ScreenTxIn(context.Background(), common.BTCChain, items)
+			for k, vv := range v {
+				if vv.Skip {
+					t.Fatalf("%s: %s skipped on a failed source", tc.name, k)
+				}
+			}
+			if len(v) != 1 {
+				t.Fatalf("%s: want 1 verdict, got %d", tc.name, len(v))
+			}
+		})
+	}
+}
+
+// Under "all", a timeout on one source observes even if the other lists.
+func TestFailOpenAllUnderTimeout(t *testing.T) {
+	slow := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		select {
+		case <-time.After(2 * time.Second):
+		case <-r.Context().Done():
+		}
+		io.WriteString(w, `{"listed":true}`)
+	}))
+	defer slow.Close()
+	fast := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) { io.WriteString(w, `{"listed":true}`) }))
+	defer fast.Close()
+	qs := newQuery(t, slow, config.BifrostAddressFilterSource{Listed: ".listed", Timeout: 100 * time.Millisecond}, QuerySourceOptions{})
+	qf := newQuery(t, fast, config.BifrostAddressFilterSource{Listed: ".listed"}, QuerySourceOptions{})
+	qs.name, qf.name = "slow", "fast" // newQuery names every source "q"; Validate forbids duplicates
+	s := NewScreener(ScreenerOptions{Sources: []Source{qs, qf}, Guard: newSyncGuard(true), Combine: CombineAll, Deadline: 300 * time.Millisecond})
+	v := s.ScreenTxIn(context.Background(), common.BTCChain, []ItemDTO{{Address: "bc1qx"}})
+	for _, vv := range v {
+		if vv.Skip {
+			t.Fatal("all + one timeout must observe")
+		}
+	}
+}
diff --git a/bifrost/pkg/addressfilter/fingerprint.go b/bifrost/pkg/addressfilter/fingerprint.go
new file mode 100644
index 00000000000..28434e74e7c
--- /dev/null
+++ b/bifrost/pkg/addressfilter/fingerprint.go
@@ -0,0 +1,78 @@
+package addressfilter
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/binary"
+	"encoding/hex"
+	"sort"
+	"strings"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+)
+
+// Fingerprint encoding v1 (shared with the list server; golden vectors in
+// testdata/fingerprint_vectors.json). Each address becomes rows
+// `u8 kind | u16be chain_len | chain | u16be key_len | key`; an EVM account is
+// expanded to one row per FingerprintEVMTickers entry. Rows are sorted,
+// deduplicated, concatenated and hashed with sha256.
+
+// FingerprintEVMTickers is fixed by encoding v1.
+var FingerprintEVMTickers = []string{"AVAX", "BASE", "BSC", "ETH", "POL"}
+
+func fpRow(kind byte, chain string, key []byte) []byte {
+	r := make([]byte, 0, 5+len(chain)+len(key))
+	r = append(r, kind)
+	r = binary.BigEndian.AppendUint16(r, uint16(len(chain)))
+	r = append(r, chain...)
+	r = binary.BigEndian.AppendUint16(r, uint16(len(key)))
+	return append(r, key...)
+}
+
+// FingerprintRows returns the encoding-v1 rows for one (chain, address).
+func FingerprintRows(chain common.Chain, addr string) [][]byte {
+	c := asciiUpper(strings.TrimSpace(chain.String()))
+	a := strings.TrimSpace(addr)
+	kind, key, ok := canonKey(c, a)
+	if !ok {
+		return [][]byte{fpRow(kindRawAddr, c, []byte(a))}
+	}
+	if kind == kindEVM {
+		rows := make([][]byte, 0, len(FingerprintEVMTickers))
+		for _, t := range FingerprintEVMTickers {
+			rows = append(rows, fpRow(kind, t, key))
+		}
+		return rows
+	}
+	return [][]byte{fpRow(kind, c, key)}
+}
+
+// FingerprintOfRows hashes a row set (order and duplicates don't matter).
+func FingerprintOfRows(rows [][]byte) string {
+	sort.Slice(rows, func(i, j int) bool { return bytes.Compare(rows[i], rows[j]) < 0 })
+	h := sha256.New()
+	var prev []byte
+	for i, r := range rows {
+		if i > 0 && bytes.Equal(r, prev) {
+			continue
+		}
+		h.Write(r)
+		prev = r
+	}
+	return hex.EncodeToString(h.Sum(nil))
+}
+
+// ChainAddr is one (chain, address) entry.
+type ChainAddr struct {
+	Chain   common.Chain
+	Address string
+}
+
+// Fingerprint returns the encoding-v1 fingerprint of a set of entries.
+func Fingerprint(entries []ChainAddr) string {
+	var rows [][]byte
+	for _, e := range entries {
+		rows = append(rows, FingerprintRows(e.Chain, e.Address)...)
+	}
+	return FingerprintOfRows(rows)
+}
diff --git a/bifrost/pkg/addressfilter/fingerprint_test.go b/bifrost/pkg/addressfilter/fingerprint_test.go
new file mode 100644
index 00000000000..4e61045d23f
--- /dev/null
+++ b/bifrost/pkg/addressfilter/fingerprint_test.go
@@ -0,0 +1,64 @@
+package addressfilter
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"os"
+	"reflect"
+	"testing"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+)
+
+type fpVector struct {
+	Name    string      `json:"name"`
+	Entries [][2]string `json:"entries"`
+	SHA256  string      `json:"sha256"`
+}
+
+type fpFile struct {
+	Version    int        `json:"version"`
+	EVMTickers []string   `json:"evm_tickers"`
+	Vectors    []fpVector `json:"vectors"`
+}
+
+// fingerprintVectorsSHA256 pins the shared file: it must stay byte-identical
+// to the list server's copy.
+const fingerprintVectorsSHA256 = "5a599a035c3f2b67b70230f2568575ffb455efc2846711067b86958b34660c8e"
+
+func TestFingerprintSharedVectors(t *testing.T) {
+	raw, err := os.ReadFile("testdata/fingerprint_vectors.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	sum := sha256.Sum256(raw)
+	if got := hex.EncodeToString(sum[:]); got != fingerprintVectorsSHA256 {
+		t.Fatalf("vector file changed: sha256 %s", got)
+	}
+	var f fpFile
+	if err := json.Unmarshal(raw, &f); err != nil {
+		t.Fatal(err)
+	}
+	if f.Version != 1 || !reflect.DeepEqual(f.EVMTickers, FingerprintEVMTickers) {
+		t.Fatalf("version/tickers mismatch: %d %v", f.Version, f.EVMTickers)
+	}
+	for _, v := range f.Vectors {
+		var es []ChainAddr
+		for _, e := range v.Entries {
+			// common.NewChain rejects names under 3 chars ("OP"); the
+			// fingerprint normalizes the chain itself, like the server.
+			es = append(es, ChainAddr{Chain: common.Chain(e[0]), Address: e[1]})
+		}
+		if got := Fingerprint(es); got != v.SHA256 {
+			t.Errorf("vector %s: got %s want %s", v.Name, got, v.SHA256)
+		}
+	}
+}
+
+func TestFingerprintEVMExpansion(t *testing.T) {
+	rows := FingerprintRows(common.ETHChain, "0xAbC0000000000000000000000000000000000001")
+	if len(rows) != len(FingerprintEVMTickers) {
+		t.Fatalf("want %d rows, got %d", len(FingerprintEVMTickers), len(rows))
+	}
+}
diff --git a/bifrost/pkg/addressfilter/guard.go b/bifrost/pkg/addressfilter/guard.go
new file mode 100644
index 00000000000..f6bbac61d6f
--- /dev/null
+++ b/bifrost/pkg/addressfilter/guard.go
@@ -0,0 +1,285 @@
+package addressfilter
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+)
+
+// Guard is the durable vault registry (R3-A3): every vault pubkey ever seen,
+// derived per chain, plus routers and module accounts. It is append-only;
+// the only removal is a manual, audited Revoke. Contains is answered from
+// memory; additions are persisted through the GuardStore.
+type Guard struct {
+	mu     sync.RWMutex
+	keys   map[string]struct{}       // SetKey -> present
+	tombs  map[string]GuardTombstone // SetKey -> revoke record
+	epoch  atomic.Uint64
+	ready  atomic.Bool
+	seeded atomic.Bool // false while a configured seed hasn't verified
+	store  GuardStore
+	chains []common.Chain
+	now    func() time.Time
+}
+
+// GuardSeed is the seed file schema shared with the list server (S-A1). An
+// entry is a vault address with the vault pubkey it derives from (kind
+// "vault", the default), or an explicitly typed router contract (kind
+// "router", no pubkey). Nothing else is accepted: a seed entry exempts its
+// address from every static drop and outbound decline, so an arbitrary
+// address must never get in.
+type GuardSeed struct {
+	Version       int    `json:"version"`
+	BuiltAtHeight uint64 `json:"built_at_height"`
+	Entries       []struct {
+		Kind    string `json:"kind,omitempty"`
+		PubKey  string `json:"pubkey"`
+		Chain   string `json:"chain"`
+		Address string `json:"address"`
+	} `json:"entries"`
+}
+
+// NewGuard loads the persisted registry. chains are the chains a pubkey is
+// derived on. A store error is returned with a usable (empty, unready) guard.
+func NewGuard(store GuardStore, chains []common.Chain) (*Guard, error) {
+	g := &Guard{
+		keys: map[string]struct{}{}, tombs: map[string]GuardTombstone{},
+		store: store, chains: chains, now: time.Now,
+	}
+	g.seeded.Store(true)
+	if store == nil {
+		return g, nil
+	}
+	rows, err := store.LoadKeys()
+	if err != nil {
+		return g, fmt.Errorf("guard: load keys: %w", err)
+	}
+	for _, r := range rows {
+		g.keys[SetKey(common.Chain(r.Chain), r.Address)] = struct{}{}
+	}
+	ts, err := store.LoadTombstones()
+	if err != nil {
+		return g, fmt.Errorf("guard: load tombstones: %w", err)
+	}
+	for _, t := range ts {
+		g.tombs[SetKey(common.Chain(t.Chain), t.Address)] = t
+	}
+	return g, nil
+}
+
+// Ready is false until a reconciliation pass succeeded (and a configured seed
+// verified).
+func (g *Guard) Ready() bool { return g != nil && g.ready.Load() && g.seeded.Load() }
+
+// Seeded is false while a configured seed hasn't verified.
+func (g *Guard) Seeded() bool { return g != nil && g.seeded.Load() }
+
+// MarkReconciled records the outcome of one reconciliation pass.
+func (g *Guard) MarkReconciled(ok bool) {
+	if ok {
+		g.ready.Store(true)
+	}
+}
+
+func (g *Guard) Epoch() uint64 { return g.epoch.Load() }
+
+// Contains reports whether (chain, addr) is a guarded address under any
+// spelling (and any EVM ticker for an EVM account), unless revoked.
+func (g *Guard) Contains(chain common.Chain, addr string) bool {
+	if g == nil {
+		return false
+	}
+	k := SetKey(chain, addr)
+	g.mu.RLock()
+	defer g.mu.RUnlock()
+	if _, ok := g.keys[k]; !ok {
+		return false
+	}
+	_, revoked := g.tombs[k]
+	return !revoked
+}
+
+// Len returns the number of guarded keys (revoked ones included).
+func (g *Guard) Len() int {
+	g.mu.RLock()
+	defer g.mu.RUnlock()
+	return len(g.keys)
+}
+
+// add inserts rows; new keys are applied in memory even when persisting fails
+// (more guarded is the safe side) and the store error is returned.
+func (g *Guard) add(rows []GuardRow) error {
+	var fresh []GuardRow
+	g.mu.Lock()
+	for _, r := range rows {
+		k := SetKey(common.Chain(r.Chain), r.Address)
+		if _, ok := g.keys[k]; ok {
+			continue
+		}
+		g.keys[k] = struct{}{}
+		fresh = append(fresh, r)
+	}
+	g.mu.Unlock()
+	if len(fresh) == 0 {
+		return nil
+	}
+	g.epoch.Add(1)
+	if g.store != nil {
+		if err := g.store.AddKeys(fresh); err != nil {
+			return fmt.Errorf("guard: persist: %w", err)
+		}
+	}
+	return nil
+}
+
+// AddPubKey guards pk's address on every chain the guard derives (chains the
+// key type can't derive are skipped). chains overrides the default set.
+func (g *Guard) AddPubKey(pk common.PubKey, chains []common.Chain) error {
+	if chains == nil {
+		chains = g.chains
+	}
+	var rows []GuardRow
+	for _, c := range chains {
+		a, err := pk.GetAddress(c)
+		if err != nil || a.IsEmpty() {
+			continue
+		}
+		rows = append(rows, GuardRow{Kind: "vault", Chain: c.String(), Address: a.String(), PubKey: pk.String()})
+	}
+	return g.add(rows)
+}
+
+// AddAddress guards one address (kind: vault | router | module | seed).
+func (g *Guard) AddAddress(kind string, chain common.Chain, addr string) error {
+	addr = strings.TrimSpace(addr)
+	if addr == "" {
+		return errors.New("guard: empty address")
+	}
+	return g.add([]GuardRow{{Kind: kind, Chain: chain.String(), Address: addr}})
+}
+
+// LoadSeed verifies the file's sha256 against wantSHA256 (hex) and adds every
+// entry. A mismatch or parse error refuses the seed and keeps the guard
+// unready.
+func (g *Guard) LoadSeed(raw []byte, wantSHA256 string) error {
+	g.seeded.Store(false)
+	sum := sha256.Sum256(raw)
+	if !strings.EqualFold(hex.EncodeToString(sum[:]), strings.TrimSpace(wantSHA256)) {
+		return errors.New("guard: seed sha256 mismatch; seed refused")
+	}
+	var s GuardSeed
+	if err := json.Unmarshal(raw, &s); err != nil {
+		return fmt.Errorf("guard: seed: %w", err)
+	}
+	if s.Version != 1 {
+		return fmt.Errorf("guard: seed version %d", s.Version)
+	}
+	rows := make([]GuardRow, 0, len(s.Entries))
+	for i, e := range s.Entries {
+		row, err := seedRow(e.Kind, e.PubKey, e.Chain, e.Address)
+		if err != nil {
+			return fmt.Errorf("guard: seed entry %d refused (%w); seed refused", i, err)
+		}
+		rows = append(rows, row)
+	}
+	err := g.add(rows)
+	g.seeded.Store(true)
+	return err
+}
+
+// seedRow validates one seed entry: a vault address must be the address its
+// pubkey derives on that chain (any alias); a router entry must say so and
+// carry no pubkey.
+func seedRow(kind, pubkey, chain, addr string) (GuardRow, error) {
+	ticker := asciiUpper(strings.TrimSpace(chain))
+	addr = strings.TrimSpace(addr)
+	pubkey = strings.TrimSpace(pubkey)
+	if ticker == "" || addr == "" {
+		return GuardRow{}, errors.New("no chain or address")
+	}
+	ch, err := common.NewChain(ticker)
+	if err != nil {
+		return GuardRow{}, fmt.Errorf("chain %q", chain)
+	}
+	switch strings.ToLower(strings.TrimSpace(kind)) {
+	case "router":
+		if pubkey != "" {
+			return GuardRow{}, errors.New("a router entry carries no pubkey")
+		}
+		return GuardRow{Kind: "router", Chain: ticker, Address: addr}, nil
+	case "", "vault":
+		if pubkey == "" {
+			return GuardRow{}, errors.New("a vault entry needs its pubkey (or kind router)")
+		}
+		pk, err := common.NewPubKey(pubkey)
+		if err != nil {
+			return GuardRow{}, errors.New("bad pubkey")
+		}
+		derived, err := pk.GetAddress(ch)
+		if err != nil || derived.IsEmpty() {
+			return GuardRow{}, fmt.Errorf("pubkey derives no %s address", ticker)
+		}
+		if SetKey(ch, derived.String()) != SetKey(ch, addr) {
+			return GuardRow{}, errors.New("address is not derived from its pubkey")
+		}
+		return GuardRow{Kind: "seed", Chain: ticker, Address: addr, PubKey: pubkey}, nil
+	default:
+		return GuardRow{}, fmt.Errorf("kind %q (want vault|router)", kind)
+	}
+}
+
+// RefuseSeed records that a configured seed could not be loaded: the guard
+// stays unready (no lookups, no skips) until a seed verifies.
+func (g *Guard) RefuseSeed() { g.seeded.Store(false) }
+
+// Revoke tombstones (chain, addr): every spelling of that key stops being
+// guarded. It is the only removal and is persisted with who and why.
+func (g *Guard) Revoke(chain common.Chain, addr, who, why string) error {
+	if strings.TrimSpace(who) == "" || strings.TrimSpace(why) == "" {
+		return errors.New("guard: revoke needs who and why")
+	}
+	t := GuardTombstone{Chain: chain.String(), Address: strings.TrimSpace(addr), Who: who, Why: why, At: g.now().UTC()}
+	k := SetKey(chain, addr)
+	g.mu.Lock()
+	if _, ok := g.keys[k]; !ok {
+		g.mu.Unlock()
+		return errors.New("guard: not a guarded address")
+	}
+	g.tombs[k] = t
+	g.mu.Unlock()
+	g.epoch.Add(1)
+	if g.store != nil {
+		return g.store.AddTombstone(t)
+	}
+	return nil
+}
+
+// Unrevoke removes a tombstone, restoring the key.
+func (g *Guard) Unrevoke(chain common.Chain, addr string) error {
+	k := SetKey(chain, addr)
+	g.mu.Lock()
+	t, ok := g.tombs[k]
+	delete(g.tombs, k)
+	g.mu.Unlock()
+	if !ok {
+		return errors.New("guard: no tombstone")
+	}
+	g.epoch.Add(1)
+	if g.store != nil {
+		return g.store.DeleteTombstone(common.Chain(t.Chain), t.Address)
+	}
+	return nil
+}
+
+func sha256Hex(b []byte) string {
+	s := sha256.Sum256(b)
+	return hex.EncodeToString(s[:])
+}
diff --git a/bifrost/pkg/addressfilter/inflight.go b/bifrost/pkg/addressfilter/inflight.go
new file mode 100644
index 00000000000..be902a71c7f
--- /dev/null
+++ b/bifrost/pkg/addressfilter/inflight.go
@@ -0,0 +1,88 @@
+package addressfilter
+
+import (
+	"context"
+	"sync/atomic"
+)
+
+type recheckCtxKey struct{}
+
+// WithRecheck marks ctx as recheck work: sources bypass positive caches (fresh
+// lookup) and charge the recovery budget class instead of the live one.
+func WithRecheck(ctx context.Context) context.Context {
+	return context.WithValue(ctx, recheckCtxKey{}, true)
+}
+
+// IsRecheck reports whether ctx carries recheck work.
+func IsRecheck(ctx context.Context) bool {
+	v, _ := ctx.Value(recheckCtxKey{}).(bool)
+	return v
+}
+
+// InflightCap is the global cap on outstanding external requests across all
+// sources (max_inflight). Live and recheck requests share the cap; Live counts
+// only live ones so the recheck scheduler can pause while live load is high.
+type InflightCap struct {
+	sem  chan struct{}
+	live atomic.Int64
+}
+
+// NewInflightCap returns a cap of n (n <= 0 means DefaultMaxInflight).
+func NewInflightCap(n int) *InflightCap {
+	if n <= 0 {
+		n = DefaultMaxInflight
+	}
+	return &InflightCap{sem: make(chan struct{}, n)}
+}
+
+// Acquire takes one slot, or fails when ctx ends first. A nil cap always
+// succeeds. The returned release func must be called exactly once.
+func (c *InflightCap) Acquire(ctx context.Context) (release func(), ok bool) {
+	if c == nil {
+		return func() {}, true
+	}
+	select {
+	case c.sem <- struct{}{}:
+	case <-ctx.Done():
+		return nil, false
+	}
+	recheck := IsRecheck(ctx)
+	if !recheck {
+		c.live.Add(1)
+	}
+	var done atomic.Bool
+	return func() {
+		if !done.CompareAndSwap(false, true) {
+			return
+		}
+		if !recheck {
+			c.live.Add(-1)
+		}
+		<-c.sem
+	}, true
+}
+
+// Cap is the configured maximum.
+func (c *InflightCap) Cap() int {
+	if c == nil {
+		return 0
+	}
+	return cap(c.sem)
+}
+
+// Live is the number of live (non-recheck) requests in flight.
+func (c *InflightCap) Live() int {
+	if c == nil {
+		return 0
+	}
+	return int(c.live.Load())
+}
+
+// LiveBusy is true while live in-flight requests exceed half of the cap
+// (R3-A6: recheck pauses so live screening keeps priority).
+func (c *InflightCap) LiveBusy() bool {
+	if c == nil {
+		return false
+	}
+	return c.Live()*2 > c.Cap()
+}
diff --git a/bifrost/pkg/addressfilter/list.go b/bifrost/pkg/addressfilter/list.go
new file mode 100644
index 00000000000..4fd3d15e68d
--- /dev/null
+++ b/bifrost/pkg/addressfilter/list.go
@@ -0,0 +1,404 @@
+package addressfilter
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+)
+
+// List source defaults.
+const (
+	DefaultListRefresh    = 10 * time.Minute
+	DefaultListMaxAge     = time.Hour
+	DefaultListMaxEntries = 1_000_000
+	// DefaultListFetchTimeout bounds one refresh (every fetch and body read)
+	// when the source sets no fetch_timeout. A list source's timeout key does
+	// not apply to it (it bounds query answers; Validate warns).
+	DefaultListFetchTimeout = time.Minute
+)
+
+// ListSnapshot is one immutable published list state. The set and its
+// fingerprint are published together, so a reader never sees one without the
+// other.
+type ListSnapshot struct {
+	Source      string
+	Fingerprint string
+	Size        int
+	ETag        string
+	FetchedAt   time.Time
+	FreshUntil  time.Time
+	chains      map[common.Chain]bool
+	set         map[string]struct{}
+	entries     []ChainAddr
+}
+
+// Covers reports whether the list screens chain.
+func (s *ListSnapshot) Covers(chain common.Chain) bool { return s.chains[chain] }
+
+// Fresh reports whether the snapshot may still answer (now < FreshUntil).
+func (s *ListSnapshot) Fresh(now time.Time) bool { return now.Before(s.FreshUntil) }
+
+// Entries returns the snapshot's (chain, address) entries (fingerprint union).
+func (s *ListSnapshot) Entries() []ChainAddr { return s.entries }
+
+func (s *ListSnapshot) has(key string) bool {
+	_, ok := s.set[key]
+	return ok
+}
+
+// ListSource fetches a published list every refresh and answers from memory.
+type ListSource struct {
+	name       string
+	chains     []common.Chain
+	perChain   bool // url has {chain}: one fetch per chain
+	chainMap   map[string]string
+	listed     *Expr
+	maxBytes   int64
+	maxEntries int
+	maxShrink  int
+	refresh    time.Duration
+	maxAge     time.Duration
+	timeout    time.Duration
+	builder    *RequestBuilder
+	client     *http.Client
+	now        func() time.Time
+	onPublish  func(*ListSnapshot)
+	onRefresh  func(err error, suspect bool)
+
+	snap    atomic.Pointer[ListSnapshot]
+	mu      sync.Mutex // serializes refresh/ack
+	pending *ListSnapshot
+	suspect atomic.Bool
+	lastErr atomic.Value // string
+}
+
+// ListSourceOptions are the runtime pieces a list source needs beside its spec.
+type ListSourceOptions struct {
+	Builder *RequestBuilder
+	Client  *http.Client
+	Now     func() time.Time
+	// OnPublish is called after every publish (outbound set, fingerprint).
+	OnPublish func(*ListSnapshot)
+	// OnRefresh is called after every refresh with its error (nil = good)
+	// and whether a shrink is held (metrics and logs).
+	OnRefresh func(err error, suspect bool)
+}
+
+// NewListSource builds a list source from a validated spec.
+func NewListSource(spec SourceSpec, o ListSourceOptions) (*ListSource, error) {
+	r := spec.Raw
+	if spec.Exprs["listed"] == nil {
+		return nil, errors.New("list source needs a listed expression")
+	}
+	if strings.Contains(r.URL, "{address}") {
+		return nil, errors.New("list url cannot use {address}")
+	}
+	l := &ListSource{
+		name: spec.Name, chains: spec.Chains, chainMap: r.ChainMap,
+		perChain:   strings.Contains(r.URL, "{chain}"),
+		listed:     spec.Exprs["listed"],
+		maxBytes:   r.MaxBytes,
+		maxEntries: r.MaxEntries,
+		maxShrink:  r.MaxShrinkPct,
+		refresh:    r.Refresh,
+		maxAge:     r.MaxAge,
+		timeout:    r.FetchTimeout, // not r.Timeout: that bounds a query answer
+		builder:    o.Builder,
+		client:     o.Client,
+		now:        o.Now,
+		onPublish:  o.OnPublish,
+		onRefresh:  o.OnRefresh,
+	}
+	if l.timeout <= 0 {
+		l.timeout = DefaultListFetchTimeout
+	}
+	if l.maxBytes <= 0 {
+		l.maxBytes = DefaultMaxBytes
+	}
+	if l.maxEntries <= 0 {
+		l.maxEntries = DefaultListMaxEntries
+	}
+	if l.maxShrink <= 0 {
+		l.maxShrink = DefaultListMaxShrink
+	}
+	if l.refresh <= 0 {
+		l.refresh = DefaultListRefresh
+	}
+	if l.maxAge <= 0 {
+		l.maxAge = DefaultListMaxAge
+	}
+	if l.now == nil {
+		l.now = time.Now
+	}
+	return l, nil
+}
+
+func (l *ListSource) Name() string { return l.name }
+
+// InMemory marks the source as answering from its snapshot (no I/O per item).
+func (l *ListSource) InMemory() bool { return true }
+
+func (l *ListSource) Covers(chain common.Chain) bool {
+	for _, c := range l.chains {
+		if c.Equals(chain) {
+			return true
+		}
+	}
+	return false
+}
+
+// Snapshot returns the current snapshot, or nil when none is fresh (a stale
+// list leaves the fingerprint union and the outbound set).
+func (l *ListSource) Snapshot() *ListSnapshot {
+	s := l.snap.Load()
+	if s == nil || !s.Fresh(l.now()) {
+		return nil
+	}
+	return s
+}
+
+// Suspect reports whether a fetched shrink is held for ListAck.
+func (l *ListSource) Suspect() bool { return l.suspect.Load() }
+
+// LastError is the last refresh error (redacted), "" after a good refresh.
+func (l *ListSource) LastError() string {
+	s, _ := l.lastErr.Load().(string)
+	return s
+}
+
+// Check answers from the published set; Unknown when no fresh set exists.
+func (l *ListSource) Check(_ context.Context, chain common.Chain, items []ItemDTO) []Answer {
+	out := make([]Answer, len(items))
+	s := l.Snapshot()
+	for i, it := range items {
+		switch {
+		case s == nil:
+			out[i] = Answer{State: Unknown, Reason: "stale_list"}
+		case s.has(SetKey(chain, it.Address)):
+			out[i] = Answer{State: Listed, Reason: "list " + l.name}
+		default:
+			out[i] = Answer{State: Clean}
+		}
+	}
+	return out
+}
+
+// Run refreshes every refresh interval until ctx ends (started and stopped by
+// the observer's worker lifecycle).
+func (l *ListSource) Run(ctx context.Context) {
+	t := time.NewTicker(l.refresh)
+	defer t.Stop()
+	for {
+		_ = l.RefreshOnce(ctx)
+		select {
+		case <-ctx.Done():
+			return
+		case <-t.C:
+		}
+	}
+}
+
+func (l *ListSource) providerChain(c common.Chain) string {
+	if m, ok := l.chainMap[c.String()]; ok && m != "" {
+		return m
+	}
+	return c.String()
+}
+
+// fetch performs one GET with If-None-Match. notModified=true means 304.
+func (l *ListSource) fetch(ctx context.Context, chain string, etag string) (body []byte, newETag string, notModified bool, err error) {
+	vals := make([]any, len(VarNames))
+	br, err := l.builder.Build(ctx, "", chain, map[string]any{}, vals, l.now())
+	if err != nil {
+		return nil, "", false, err
+	}
+	if etag != "" {
+		br.Req.Header.Set("If-None-Match", etag)
+	}
+	st, h, b, err := Send(l.client, br, l.maxBytes)
+	if err != nil {
+		return nil, "", false, err
+	}
+	if st == http.StatusNotModified {
+		return nil, etag, true, nil
+	}
+	return b, h.Get("ETag"), false, nil
+}
+
+// parse turns a response body into entries for chain (or for every chain when
+// the list isn't per-chain).
+func (l *ListSource) parse(ctx context.Context, body []byte, chain *common.Chain) ([]ChainAddr, error) {
+	var input any
+	if err := json.Unmarshal(body, &input); err != nil {
+		return nil, fmt.Errorf("decode: %w", err)
+	}
+	v, err := l.listed.EvalLimit(ctx, int(l.maxBytes), input, make([]any, len(VarNames))...)
+	if err != nil {
+		return nil, err
+	}
+	arr, ok := v.([]any)
+	if !ok {
+		return nil, fmt.Errorf("listed must yield an array, got %T", v)
+	}
+	var out []ChainAddr
+	for _, e := range arr {
+		switch x := e.(type) {
+		case string:
+			if chain != nil {
+				out = append(out, ChainAddr{Chain: *chain, Address: x})
+				continue
+			}
+			for _, c := range l.chains {
+				out = append(out, ChainAddr{Chain: c, Address: x})
+			}
+		case map[string]any:
+			cs, _ := x["chain"].(string)
+			as, _ := x["address"].(string)
+			if as == "" {
+				return nil, errors.New("list element without address")
+			}
+			c := common.Chain(asciiUpper(strings.TrimSpace(cs)))
+			if chain != nil && cs == "" {
+				c = *chain
+			}
+			if l.Covers(c) {
+				out = append(out, ChainAddr{Chain: c, Address: as})
+			}
+		default:
+			return nil, fmt.Errorf("list element of type %T", e)
+		}
+	}
+	return out, nil
+}
+
+// RefreshOnce fetches and, when valid, publishes one snapshot. A parse error,
+// non-2xx or oversized list keeps the last good set; a 304 renews freshness;
+// a shrink beyond max_shrink_pct is held as suspect until ListAck.
+func (l *ListSource) RefreshOnce(ctx context.Context) error {
+	l.mu.Lock()
+	// One deadline for the whole refresh, body reads included: a server that
+	// drips its response can't stall refreshes (or list-ack) indefinitely.
+	rctx, cancel := context.WithTimeout(ctx, l.timeout)
+	err := l.refreshLocked(rctx)
+	cancel()
+	if err != nil {
+		l.lastErr.Store(err.Error())
+	} else {
+		l.lastErr.Store("")
+	}
+	suspect := l.suspect.Load()
+	l.mu.Unlock()
+	if l.onRefresh != nil {
+		l.onRefresh(err, suspect)
+	}
+	return err
+}
+
+func (l *ListSource) refreshLocked(ctx context.Context) error {
+	old := l.snap.Load()
+	oldETag := ""
+	if old != nil {
+		oldETag = old.ETag
+	}
+	now := l.now()
+	var entries []ChainAddr
+	etag := ""
+	if l.perChain {
+		// Per-chain fetches share one snapshot; an ETag is kept only for
+		// single-fetch lists.
+		for _, c := range l.chains {
+			c := c
+			b, _, _, err := l.fetch(ctx, l.providerChain(c), "")
+			if err != nil {
+				return err
+			}
+			es, err := l.parse(ctx, b, &c)
+			if err != nil {
+				return err
+			}
+			entries = append(entries, es...)
+		}
+	} else {
+		b, et, nm, err := l.fetch(ctx, "", oldETag)
+		if err != nil {
+			return err
+		}
+		if nm && old != nil {
+			renewed := *old
+			renewed.FreshUntil = now.Add(l.maxAge)
+			l.snap.Store(&renewed)
+			l.published(&renewed)
+			return nil
+		}
+		if nm {
+			return errors.New("304 without a cached list")
+		}
+		etag = et
+		if entries, err = l.parse(ctx, b, nil); err != nil {
+			return err
+		}
+	}
+	snap := &ListSnapshot{
+		Source: l.name, ETag: etag, FetchedAt: now, FreshUntil: now.Add(l.maxAge),
+		chains: map[common.Chain]bool{}, set: map[string]struct{}{},
+	}
+	for _, c := range l.chains {
+		snap.chains[c] = true
+	}
+	for _, e := range entries {
+		k := SetKey(e.Chain, e.Address)
+		if _, dup := snap.set[k]; dup {
+			continue
+		}
+		snap.set[k] = struct{}{}
+		snap.entries = append(snap.entries, e)
+	}
+	snap.Size = len(snap.set)
+	if snap.Size > l.maxEntries {
+		return fmt.Errorf("list has %d entries, max_entries %d", snap.Size, l.maxEntries)
+	}
+	snap.Fingerprint = Fingerprint(snap.entries)
+	if old != nil && old.Size > 0 {
+		drop := (old.Size - snap.Size) * 100 / old.Size
+		if drop > l.maxShrink {
+			l.pending = snap
+			l.suspect.Store(true)
+			return fmt.Errorf("list shrank %d%% (%d -> %d): held until list-ack", drop, old.Size, snap.Size)
+		}
+	}
+	l.pending = nil
+	l.suspect.Store(false)
+	l.snap.Store(snap)
+	l.published(snap)
+	return nil
+}
+
+func (l *ListSource) published(s *ListSnapshot) {
+	if l.onPublish != nil {
+		l.onPublish(s)
+	}
+}
+
+// ListAck publishes a held (suspect) snapshot; it returns false when nothing
+// is held.
+func (l *ListSource) ListAck() bool {
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	if l.pending == nil {
+		return false
+	}
+	p := l.pending
+	l.pending = nil
+	l.suspect.Store(false)
+	l.snap.Store(p)
+	l.published(p)
+	return true
+}
