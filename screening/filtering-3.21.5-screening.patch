@@ -0,0 +1,305 @@
+package addressfilter
+
+import (
+	"context"
+	"fmt"
+	"sync"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+)
+
+// ---- A3.1 combine ----
+
+func TestCombineTruthTable(t *testing.T) {
+	L, C, U := Answer{State: Listed}, Answer{State: Clean}, Answer{State: Unknown}
+	cases := []struct {
+		name     string
+		mode     string
+		answers  map[string]Answer
+		covering []string
+		skip     bool
+	}{
+		{"all L,L", CombineAll, map[string]Answer{"a": L, "b": L}, []string{"a", "b"}, true},
+		{"all L,timeout", CombineAll, map[string]Answer{"a": L}, []string{"a", "b"}, false},
+		{"all L,clean", CombineAll, map[string]Answer{"a": L, "b": C}, []string{"a", "b"}, false},
+		{"all L,unknown", CombineAll, map[string]Answer{"a": L, "b": U}, []string{"a", "b"}, false},
+		{"any U,L", CombineAny, map[string]Answer{"a": U, "b": L}, []string{"a", "b"}, true},
+		{"any empty", CombineAny, map[string]Answer{}, []string{"a"}, false},
+		{"any none covering", CombineAny, map[string]Answer{"a": L}, nil, false},
+		{"all none covering", CombineAll, map[string]Answer{"a": L}, nil, false},
+		{"any listed by non-covering", CombineAny, map[string]Answer{"x": L, "a": C}, []string{"a"}, false},
+		{"default mode is any", "", map[string]Answer{"a": C, "b": L}, []string{"a", "b"}, true},
+	}
+	for _, c := range cases {
+		if got := Combine(c.mode, c.answers, c.covering); got != c.skip {
+			t.Errorf("%s: skip=%v, want %v", c.name, got, c.skip)
+		}
+	}
+}
+
+// ---- A3.2 screening stage ----
+
+type syncGuard struct {
+	mu    sync.Mutex
+	ready bool
+	epoch uint64
+	set   map[string]bool
+}
+
+func newSyncGuard(ready bool) *syncGuard { return &syncGuard{ready: ready, set: map[string]bool{}} }
+
+func (g *syncGuard) Ready() bool { g.mu.Lock(); defer g.mu.Unlock(); return g.ready }
+func (g *syncGuard) Epoch() uint64 {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	return g.epoch
+}
+
+func (g *syncGuard) Contains(c common.Chain, a string) bool {
+	g.mu.Lock()
+	defer g.mu.Unlock()
+	return g.set[SetKey(c, a)]
+}
+
+func (g *syncGuard) add(c common.Chain, a string) {
+	g.mu.Lock()
+	g.set[SetKey(c, a)] = true
+	g.epoch++
+	g.mu.Unlock()
+}
+
+// fnSource is a scriptable source.
+type fnSource struct {
+	name   string
+	mem    bool
+	calls  atomic.Int64
+	items  atomic.Int64
+	answer func(ctx context.Context, it ItemDTO) Answer
+}
+
+func (f *fnSource) Name() string             { return f.name }
+func (f *fnSource) Covers(common.Chain) bool { return true }
+func (f *fnSource) InMemory() bool           { return f.mem }
+func (f *fnSource) Check(ctx context.Context, _ common.Chain, items []ItemDTO) []Answer {
+	f.calls.Add(1)
+	f.items.Add(int64(len(items)))
+	out := make([]Answer, len(items))
+	for i, it := range items {
+		out[i] = f.answer(ctx, it)
+	}
+	return out
+}
+
+func listedAll(context.Context, ItemDTO) Answer { return Answer{State: Listed, Reason: "test"} }
+
+func ethItems(n int) []ItemDTO {
+	out := make([]ItemDTO, n)
+	for i := range out {
+		tx := fmt.Sprintf("%064x", i+1)
+		out[i] = ItemDTO{Chain: "ETH", Address: fmt.Sprintf("0x%040x", i+1), TxID: &tx}
+	}
+	return out
+}
+
+func TestScreenDeadlineWithSleepingSource(t *testing.T) {
+	g := newSyncGuard(true)
+	// The source sleeps 10 s and ignores ctx on purpose.
+	slow := &slowSource{fnSource: fnSource{name: "sleepy"}, d: 10 * time.Second}
+	s := NewScreener(ScreenerOptions{Sources: []Source{slow}, Guard: g, Deadline: 200 * time.Millisecond})
+	items := ethItems(500)
+	start := time.Now()
+	v := s.ScreenTxIn(context.Background(), common.ETHChain, items)
+	took := time.Since(start)
+	if took > s.Deadline()+50*time.Millisecond {
+		t.Fatalf("screening took %s, deadline %s", took, s.Deadline())
+	}
+	if len(v) != 500 {
+		t.Fatalf("got %d verdicts", len(v))
+	}
+	for k, vv := range v {
+		if vv.Skip {
+			t.Fatalf("%s skipped past the deadline", k)
+		}
+		if vv.Answers["sleepy"].State != Unknown {
+			t.Fatalf("late source must be Unknown, got %v", vv.Answers["sleepy"].State)
+		}
+	}
+}
+
+// slowSource sleeps once for the whole batch, ignoring ctx.
+type slowSource struct {
+	fnSource
+	d time.Duration
+}
+
+func (s *slowSource) Check(_ context.Context, _ common.Chain, items []ItemDTO) []Answer {
+	s.calls.Add(1)
+	time.Sleep(s.d)
+	out := make([]Answer, len(items))
+	for i := range out {
+		out[i] = Answer{State: Listed}
+	}
+	return out
+}
+
+func TestScreenGuardNotReadyMakesNoRequests(t *testing.T) {
+	g := newSyncGuard(false)
+	ext := &fnSource{name: "ext", answer: listedAll}
+	static := NewStaticSource(ethItems(1)[0].Address, nil)
+	s := NewScreener(ScreenerOptions{Sources: []Source{static, ext}, Guard: g})
+	v := s.ScreenTxIn(context.Background(), common.ETHChain, ethItems(3))
+	if ext.calls.Load() != 0 {
+		t.Fatalf("guard not ready: %d source calls", ext.calls.Load())
+	}
+	for k, vv := range v {
+		if vv.Skip {
+			t.Fatalf("%s skipped with an unready guard (static included)", k)
+		}
+	}
+	if len(v) != 3 {
+		t.Fatalf("got %d verdicts", len(v))
+	}
+}
+
+func TestScreenSkipsListedAndDropsGuardedSenders(t *testing.T) {
+	g := newSyncGuard(true)
+	items := ethItems(3)
+	g.add(common.ETHChain, items[0].Address) // a vault sender
+	ext := &fnSource{name: "ext", answer: listedAll}
+	s := NewScreener(ScreenerOptions{Sources: []Source{ext}, Guard: g})
+	v := s.ScreenTxIn(context.Background(), common.ETHChain, items)
+	if v[ItemKey(items[0])].Skip {
+		t.Fatal("guarded sender must be observed")
+	}
+	if !v[ItemKey(items[1])].Skip || !v[ItemKey(items[2])].Skip {
+		t.Fatal("listed senders must be skipped")
+	}
+	if ext.items.Load() != 2 {
+		t.Fatalf("source saw %d items, want 2 (guarded sender never screened)", ext.items.Load())
+	}
+	if vv := v[ItemKey(items[1])]; vv.Combine != CombineAny || vv.Answers["ext"].State != Listed || vv.GuardEpoch != g.Epoch() {
+		t.Fatalf("verdict fields: %+v", vv)
+	}
+}
+
+func TestScreenEpochFenceWhitelistWhileInFlight(t *testing.T) {
+	g := newSyncGuard(true)
+	items := ethItems(2)
+	ext := &fnSource{name: "ext"}
+	ext.answer = func(_ context.Context, it ItemDTO) Answer {
+		if it.Address == items[0].Address {
+			g.add(common.ETHChain, it.Address) // becomes a vault mid-request
+		}
+		return Answer{State: Listed}
+	}
+	s := NewScreener(ScreenerOptions{Sources: []Source{ext}, Guard: g})
+	v := s.ScreenTxIn(context.Background(), common.ETHChain, items)
+	if v[ItemKey(items[0])].Skip {
+		t.Fatal("sender whitelisted while its request was in flight must be observed")
+	}
+	if !v[ItemKey(items[1])].Skip {
+		t.Fatal("other listed sender must still skip")
+	}
+}
+
+func TestScreenAllModeNeedsEveryCoveringSource(t *testing.T) {
+	g := newSyncGuard(true)
+	a := &fnSource{name: "a", answer: listedAll}
+	b := &fnSource{name: "b", answer: func(context.Context, ItemDTO) Answer { return Answer{State: Unknown} }}
+	s := NewScreener(ScreenerOptions{Sources: []Source{a, b}, Guard: g, Combine: CombineAll})
+	items := ethItems(1)
+	if s.ScreenTxIn(context.Background(), common.ETHChain, items)[ItemKey(items[0])].Skip {
+		t.Fatal("all mode with one Unknown must observe")
+	}
+}
+
+func TestScreenPanickingSourceObserves(t *testing.T) {
+	g := newSyncGuard(true)
+	p := &fnSource{name: "p", answer: func(context.Context, ItemDTO) Answer { panic("boom") }}
+	s := NewScreener(ScreenerOptions{Sources: []Source{p}, Guard: g})
+	items := ethItems(2)
+	for _, vv := range s.ScreenTxIn(context.Background(), common.ETHChain, items) {
+		if vv.Skip {
+			t.Fatal("a panicking source must mean observe")
+		}
+	}
+}
+
+func TestScreenChainBreakerFallsBackToInMemory(t *testing.T) {
+	g := newSyncGuard(true)
+	items := ethItems(1)
+	ext := &fnSource{name: "ext", answer: func(ctx context.Context, _ ItemDTO) Answer {
+		select {
+		case <-time.After(60 * time.Millisecond):
+		case <-ctx.Done():
+		}
+		return Answer{State: Clean}
+	}}
+	static := NewStaticSource(items[0].Address, nil)
+	s := NewScreener(ScreenerOptions{Sources: []Source{static, ext}, Guard: g, BreakerWindow: time.Second, ChainBudgetPct: 20})
+	for i := 0; i < 5 && !s.BreakerOpen(common.ETHChain); i++ {
+		s.ScreenTxIn(context.Background(), common.ETHChain, items)
+	}
+	if !s.BreakerOpen(common.ETHChain) {
+		t.Fatal("breaker should trip after sustained slow screening")
+	}
+	before := ext.calls.Load()
+	v := s.ScreenTxIn(context.Background(), common.ETHChain, items)
+	if ext.calls.Load() != before {
+		t.Fatal("external source consulted while the chain breaker is open")
+	}
+	vv := v[ItemKey(items[0])]
+	if !vv.Skip || vv.Answers[StaticSourceName].State != Listed {
+		t.Fatalf("static source must still answer while the breaker is open: %+v", vv)
+	}
+	// The external source still covers the chain: it is a non-answer
+	// (breaker), never absent, so combine: all can't skip on static alone.
+	if a, ok := vv.Answers["ext"]; !ok || a.State != Unknown || a.Reason != KindBreaker {
+		t.Fatalf("external source must be a breaker non-answer while the breaker is open: %+v", vv.Answers)
+	}
+	if s.BreakerOpen(common.BTCChain) {
+		t.Fatal("breaker is per chain")
+	}
+	// Recovery: once the window slides past the slow screens, it closes.
+	time.Sleep(1100 * time.Millisecond)
+	if s.BreakerOpen(common.ETHChain) {
+		t.Fatal("breaker should recover after the window")
+	}
+}
+
+func TestInflightCapLiveBusyIgnoresRecheck(t *testing.T) {
+	c := NewInflightCap(4)
+	var rel []func()
+	for i := 0; i < 2; i++ {
+		r, ok := c.Acquire(WithRecheck(context.Background()))
+		if !ok {
+			t.Fatal("acquire")
+		}
+		rel = append(rel, r)
+	}
+	if c.LiveBusy() || c.Live() != 0 {
+		t.Fatal("recheck requests must not count as live")
+	}
+	for i := 0; i < 2; i++ {
+		r, _ := c.Acquire(context.Background())
+		rel = append(rel, r)
+	}
+	if c.Live() != 2 || c.LiveBusy() {
+		t.Fatalf("live=%d busy=%v at exactly half", c.Live(), c.LiveBusy())
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), 20*time.Millisecond)
+	defer cancel()
+	if _, ok := c.Acquire(ctx); ok {
+		t.Fatal("cap exceeded")
+	}
+	for _, r := range rel {
+		r()
+		r() // idempotent
+	}
+	if c.Live() != 0 {
+		t.Fatal("release")
+	}
+}
