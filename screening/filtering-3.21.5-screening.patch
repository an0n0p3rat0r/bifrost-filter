new file mode 100644
index 00000000000..b4504bfe4ad
--- /dev/null
+++ b/bifrost/pkg/addressfilter/query.go
@@ -0,0 +1,688 @@
+package addressfilter
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math"
+	"net/http"
+	"strconv"
+	"strings"
+	"sync"
+	"sync/atomic"
+	"time"
+
+	"golang.org/x/sync/singleflight"
+	"golang.org/x/time/rate"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+)
+
+// Query source defaults and clamps.
+const (
+	DefaultQueryInflight = 16
+	MinRetryAfter        = time.Second
+	MaxRetryAfter        = 10 * time.Minute
+	maxReasonLen         = 256
+)
+
+// MaxItemsPerSender caps one sender's inbounds per request round to a
+// context-dependent source, so result matching stays bounded. The excess is
+// never dropped: it takes Listed when the sender is Listed on another inbound
+// of the same call, else it is asked in follow-up rounds within the deadline.
+const MaxItemsPerSender = 32
+
+// Non-answer kinds (bifrost_address_filter_source_errors_total{kind}); an
+// Unknown answer's Reason starts with one of them.
+const (
+	KindTimeout     = "timeout"
+	KindTransport   = "transport"
+	KindStatus      = "status"
+	KindRateLimited = "rate_limited"
+	KindBudget      = "budget"
+	KindDecode      = "decode"
+	KindExpr        = "expr"
+	KindNonBoolean  = "non_boolean"
+	KindBackoff     = "backoff"
+	KindUnsupported = "unsupported_chain"
+	KindMissing     = "missing_result"
+	KindRefresh     = "refresh"
+	KindQuarantined = "quarantined"
+	KindBreaker     = "breaker"
+	KindSenderCap   = "sender_cap"
+)
+
+// QuerySource asks an HTTP service about each item (or each batch of items).
+// Everything that isn't an exact `listed: true` is Clean (exact false) or
+// Unknown; Unknown is never cached.
+type QuerySource struct {
+	name      string
+	chains    map[common.Chain]bool
+	chainMap  map[string]string
+	ctxDep    bool
+	inOrder   bool // results_in_order: results answer items by position
+	batch     int
+	maxBytes  int64
+	exprs     map[string]*Expr
+	builder   *RequestBuilder
+	client    *http.Client
+	cache     DecisionCache
+	budget    *Budget
+	limiter   *rate.Limiter
+	sem       chan struct{}
+	sf        singleflight.Group
+	guard     GuardView
+	inflight  *InflightCap
+	threshold *float64
+	now       func() time.Time
+	backoffNs atomic.Int64 // unix nanos until which the source is backed off
+}
+
+// QuerySourceOptions are the runtime pieces beside the spec.
+type QuerySourceOptions struct {
+	Builder *RequestBuilder
+	Client  *http.Client
+	// Cache is used only for address-only sources (ignored otherwise).
+	Cache  DecisionCache
+	Budget *Budget
+	Guard  GuardView
+	// Inflight is the global cap shared by every source (nil = no global cap).
+	Inflight *InflightCap
+	Now      func() time.Time
+}
+
+// NewQuerySource builds a query source from a validated spec.
+func NewQuerySource(spec SourceSpec, o QuerySourceOptions) (*QuerySource, error) {
+	r := spec.Raw
+	if spec.Exprs["listed"] == nil && spec.Exprs["results_map"] == nil {
+		return nil, errors.New("query source needs listed or results_map")
+	}
+	if spec.Exprs["listed"] == nil {
+		return nil, errors.New("query source needs a listed selector")
+	}
+	q := &QuerySource{
+		name: spec.Name, chains: map[common.Chain]bool{}, chainMap: r.ChainMap,
+		ctxDep: spec.ContextDependent, inOrder: r.ResultsInOrder, batch: r.Batch, maxBytes: r.MaxBytes,
+		exprs: spec.Exprs, builder: o.Builder, client: o.Client, budget: o.Budget,
+		guard: o.Guard, inflight: o.Inflight, now: o.Now, threshold: r.Threshold,
+	}
+	for _, c := range spec.Chains {
+		q.chains[c] = true
+	}
+	if q.batch < 1 {
+		q.batch = 1
+	}
+	if q.batch > 1 && strings.Contains(r.URL, "{address}") {
+		return nil, errors.New("batch source url cannot use {address}")
+	}
+	if q.batch > 1 && spec.Exprs["results_map"] == nil {
+		return nil, errors.New("batch source needs results_map")
+	}
+	if q.maxBytes <= 0 {
+		q.maxBytes = DefaultMaxBytes
+	}
+	if !q.ctxDep {
+		q.cache = o.Cache
+	}
+	inflight := r.Inflight
+	if inflight <= 0 {
+		inflight = DefaultQueryInflight
+	}
+	q.sem = make(chan struct{}, inflight)
+	if r.Rate > 0 {
+		burst := int(math.Ceil(r.Rate))
+		q.limiter = rate.NewLimiter(rate.Limit(r.Rate), burst)
+	}
+	if q.now == nil {
+		q.now = time.Now
+	}
+	return q, nil
+}
+
+func (q *QuerySource) Name() string { return q.name }
+
+func (q *QuerySource) Covers(chain common.Chain) bool { return q.chains[chain] }
+
+// ContextDependent reports whether answers depend on more than the address.
+func (q *QuerySource) ContextDependent() bool { return q.ctxDep }
+
+// BackedOffUntil returns the source back-off deadline (zero when none).
+func (q *QuerySource) BackedOffUntil() time.Time {
+	n := q.backoffNs.Load()
+	if n == 0 {
+		return time.Time{}
+	}
+	return time.Unix(0, n)
+}
+
+func (q *QuerySource) backoff(d time.Duration) {
+	until := q.now().Add(clampRetry(d)).UnixNano()
+	for {
+		cur := q.backoffNs.Load()
+		if cur >= until || q.backoffNs.CompareAndSwap(cur, until) {
+			return
+		}
+	}
+}
+
+func clampRetry(d time.Duration) time.Duration {
+	if d < MinRetryAfter {
+		return MinRetryAfter
+	}
+	if d > MaxRetryAfter {
+		return MaxRetryAfter
+	}
+	return d
+}
+
+func unknown(kind, detail string) Answer {
+	r := kind
+	if detail != "" {
+		r += ": " + detail
+	}
+	if len(r) > maxReasonLen {
+		r = r[:maxReasonLen]
+	}
+	return Answer{State: Unknown, Reason: r}
+}
+
+func (q *QuerySource) providerChain(c common.Chain) string {
+	if m, ok := q.chainMap[c.String()]; ok && m != "" {
+		return m
+	}
+	return c.String()
+}
+
+// Check answers every item; it never blocks past ctx's deadline.
+func (q *QuerySource) Check(ctx context.Context, chain common.Chain, items []ItemDTO) []Answer {
+	out := make([]Answer, len(items))
+	if !q.Covers(chain) {
+		for i := range out {
+			out[i] = unknown(KindUnsupported, "")
+		}
+		return out
+	}
+	if until := q.backoffNs.Load(); until != 0 && q.now().UnixNano() < until {
+		for i := range out {
+			out[i] = unknown(KindBackoff, "")
+		}
+		return out
+	}
+	var epoch uint64
+	if q.guard != nil {
+		epoch = q.guard.Epoch()
+	}
+	if q.ctxDep {
+		q.perInbound(ctx, chain, items, out)
+		return out
+	}
+	// A recheck is a fresh lookup: positive (and clean) cache entries are
+	// bypassed, but the fresh answer is still stored.
+	recheck := IsRecheck(ctx)
+	var todo []int
+	// An address-only source answers by address alone: one lookup per
+	// address, copied to its duplicates (dups[k] = the todo index it copies).
+	dups := map[int]int{}
+	firstByKey := map[string]int{}
+	for i, it := range items {
+		if q.cache != nil && !recheck {
+			if a, ok := q.cache.Get(chain, it.Address, epoch); ok {
+				out[i] = a
+				continue
+			}
+		}
+		k := SetKey(chain, it.Address)
+		if j, seen := firstByKey[k]; seen {
+			dups[i] = j
+			continue
+		}
+		firstByKey[k] = i
+		todo = append(todo, i)
+	}
+	q.dispatch(ctx, chain, items, todo, out)
+	for i, j := range dups {
+		out[i] = out[j]
+	}
+	if q.cache != nil {
+		for _, k := range todo {
+			if out[k].State != Unknown {
+				q.cache.Put(chain, items[k].Address, out[k], epoch)
+			}
+		}
+	}
+	return out
+}
+
+// dispatch asks the source about items[todo] in batches of q.batch, in
+// parallel, writing each answer into out.
+func (q *QuerySource) dispatch(ctx context.Context, chain common.Chain, items []ItemDTO, todo []int, out []Answer) {
+	var wg sync.WaitGroup
+	for start := 0; start < len(todo); start += q.batch {
+		end := start + q.batch
+		if end > len(todo) {
+			end = len(todo)
+		}
+		idx := todo[start:end]
+		wg.Add(1)
+		go func(idx []int) {
+			defer wg.Done()
+			var answers []Answer
+			if len(idx) == 1 && q.batch == 1 {
+				answers = []Answer{q.single(ctx, chain, items[idx[0]])}
+			} else {
+				batch := make([]ItemDTO, len(idx))
+				for j, k := range idx {
+					batch[j] = items[k]
+				}
+				answers = q.doBatch(ctx, chain, batch)
+			}
+			for j, k := range idx {
+				out[k] = answers[j]
+			}
+		}(idx)
+	}
+	wg.Wait()
+}
+
+func itemAmount(it ItemDTO) string {
+	if it.Amount == nil {
+		return ""
+	}
+	return *it.Amount
+}
+
+// senderListed is the answer given to a sender's other inbounds once one of
+// its inbounds in this call is Listed.
+func senderListed() Answer {
+	return Answer{State: Listed, Reason: KindSenderCap + ": sender listed on another inbound in this call"}
+}
+
+// perInbound asks a context-dependent source about each inbound. One
+// sender's inbounds go at most MaxItemsPerSender per round (bounded result
+// matching). Once any inbound of a sender is Listed in this call, the
+// sender's remaining inbounds are Listed without asking (decoys can't push a
+// real inbound past the cap); otherwise the excess is asked in follow-up
+// rounds within the same deadline. A clean answer is never copied to another
+// inbound. Inbounds under the source's min_value floor are never asked and
+// don't count toward the cap; they too become Listed when the sender is.
+func (q *QuerySource) perInbound(ctx context.Context, chain common.Chain, items []ItemDTO, out []Answer) {
+	var order []string
+	pending := map[string][]int{}
+	floor := map[string][]int{}
+	for i, it := range items {
+		k := SetKey(chain, it.Address)
+		if q.budget.BelowFloor(chain, itemAmount(it)) {
+			out[i] = unknown(KindBudget, BudgetBelowFloor)
+			floor[k] = append(floor[k], i)
+			continue
+		}
+		if _, seen := pending[k]; !seen {
+			order = append(order, k)
+		}
+		pending[k] = append(pending[k], i)
+	}
+	listed := map[string]bool{}
+	for round := 0; ; round++ {
+		var todo []int
+		for _, k := range order {
+			p := pending[k]
+			if len(p) == 0 {
+				continue
+			}
+			if listed[k] {
+				for _, i := range p {
+					out[i] = senderListed()
+				}
+				pending[k] = nil
+				continue
+			}
+			n := len(p)
+			if n > MaxItemsPerSender {
+				n = MaxItemsPerSender
+			}
+			todo = append(todo, p[:n]...)
+			pending[k] = p[n:]
+		}
+		if len(todo) == 0 {
+			break
+		}
+		if round > 0 && ctx.Err() != nil {
+			// Out of time for a follow-up: the rest is observed.
+			for _, i := range todo {
+				out[i] = unknown(KindSenderCap, "deadline before follow-up")
+			}
+			for _, k := range order {
+				for _, i := range pending[k] {
+					out[i] = unknown(KindSenderCap, "deadline before follow-up")
+				}
+				pending[k] = nil
+			}
+			break
+		}
+		q.dispatch(ctx, chain, items, todo, out)
+		for _, i := range todo {
+			if out[i].State == Listed {
+				listed[SetKey(chain, items[i].Address)] = true
+			}
+		}
+	}
+	for k, idx := range floor {
+		if listed[k] {
+			for _, i := range idx {
+				out[i] = senderListed()
+			}
+		}
+	}
+}
+
+// single answers one item, coalescing identical in-flight lookups.
+func (q *QuerySource) single(ctx context.Context, chain common.Chain, it ItemDTO) Answer {
+	// The key is chain-scoped: one EVM account can have a different answer
+	// on each EVM chain (the provider is asked per chain).
+	var key string
+	if q.ctxDep {
+		b, _ := json.Marshal(it)
+		key = q.name + "|" + chain.String() + "|" + string(b)
+	} else {
+		key = q.name + "|" + cacheKey(chain, it.Address)
+	}
+	ch := q.sf.DoChan(key, func() (any, error) {
+		return q.doBatch(ctx, chain, []ItemDTO{it})[0], nil
+	})
+	select {
+	case r := <-ch:
+		return r.Val.(Answer)
+	case <-ctx.Done():
+		return unknown(KindTimeout, "")
+	}
+}
+
+func maxValue(items []ItemDTO) string {
+	var best string
+	var bestF float64 = -1
+	for _, it := range items {
+		if it.Amount == nil {
+			continue
+		}
+		f, err := strconv.ParseFloat(*it.Amount, 64)
+		if err == nil && f > bestF {
+			bestF, best = f, *it.Amount
+		}
+	}
+	return best
+}
+
+func fill(n int, a Answer) []Answer {
+	out := make([]Answer, n)
+	for i := range out {
+		out[i] = a
+	}
+	return out
+}
+
+// doBatch performs one request for items (len 1 in per-item mode).
+func (q *QuerySource) doBatch(ctx context.Context, chain common.Chain, items []ItemDTO) []Answer {
+	n := len(items)
+	// Items under the floor never cost a call.
+	reserve := q.budget.Reserve
+	if IsRecheck(ctx) {
+		reserve = q.budget.ReserveRecheck
+	}
+	t, ok, why := reserve(chain, maxValue(items))
+	if !ok {
+		return fill(n, unknown(KindBudget, why))
+	}
+	if q.limiter != nil {
+		if err := q.limiter.Wait(ctx); err != nil {
+			t.Release()
+			return fill(n, unknown(KindRateLimited, "local rate"))
+		}
+	}
+	select {
+	case q.sem <- struct{}{}:
+	case <-ctx.Done():
+		t.Release()
+		return fill(n, unknown(KindTimeout, "inflight"))
+	}
+	defer func() { <-q.sem }()
+	release, ok := q.inflight.Acquire(ctx)
+	if !ok {
+		t.Release()
+		return fill(n, unknown(KindTimeout, "inflight"))
+	}
+	defer release()
+
+	var input any
+	var vals []any
+	addr := ""
+	pc := q.providerChain(chain)
+	if q.batch == 1 && n == 1 {
+		input, vals = items[0].ForProvider(pc).ToJQ()
+		addr = items[0].Address
+	} else {
+		arr := make([]any, n)
+		for i, it := range items {
+			arr[i], _ = it.ForProvider(pc).ToJQ()
+		}
+		input = map[string]any{"items": arr}
+		vals = make([]any, len(VarNames))
+		vals[itemsVar] = arr
+	}
+	vals = WithThreshold(vals, q.threshold)
+	br, err := q.builder.Build(ctx, addr, q.providerChain(chain), input, vals, q.now())
+	if err != nil {
+		t.Release()
+		return fill(n, unknown(KindExpr, err.Error()))
+	}
+	t.Dispatched()
+	st, hdr, body, err := Send(q.client, br, q.maxBytes)
+	if err != nil {
+		kind := KindTransport
+		switch {
+		case errors.Is(ctx.Err(), context.DeadlineExceeded) || strings.Contains(err.Error(), "deadline exceeded"):
+			kind = KindTimeout
+		case st == http.StatusTooManyRequests || st == http.StatusServiceUnavailable:
+			kind = KindRateLimited
+			if ra := hdr.Get("Retry-After"); ra != "" {
+				if secs, perr := strconv.Atoi(strings.TrimSpace(ra)); perr == nil && secs >= 0 {
+					q.backoff(time.Duration(secs) * time.Second)
+				} else if when, perr := http.ParseTime(ra); perr == nil {
+					q.backoff(when.Sub(q.now()))
+				}
+			}
+		case st != 0:
+			kind = KindStatus
+		}
+		return fill(n, unknown(kind, br.Redactor.String(err.Error())))
+	}
+	var doc any
+	if err := json.Unmarshal(body, &doc); err != nil {
+		return fill(n, unknown(KindDecode, "response is not JSON"))
+	}
+	if e := q.exprs["source_backoff"]; e != nil {
+		if v, err := e.Eval(ctx, doc, vals...); err == nil {
+			if secs, ok := toSeconds(v); ok && secs > 0 {
+				q.backoff(time.Duration(secs * float64(time.Second)))
+			}
+		}
+	}
+	if q.exprs["results_map"] == nil {
+		return []Answer{q.judge(ctx, doc, vals, br.Redactor)}
+	}
+	return q.mapResults(ctx, chain, doc, items, br.Redactor)
+}
+
+// mapResults evaluates results_map once and gives each item its own result:
+//   - by position, when the source declares results_in_order and the
+//     response bears it out (same length, every position echoes its item's
+//     address, and its tx_id when the provider echoes one);
+//   - else by (address, tx_id), when the provider echoes the item's tx_id;
+//   - else by address: several results for one address all apply when they
+//     agree; when they disagree the items are Unknown (observed).
+//
+// A missing address is Unknown for that item.
+func (q *QuerySource) mapResults(ctx context.Context, chain common.Chain, doc any, items []ItemDTO, red *Redactor) []Answer {
+	out := make([]Answer, len(items))
+	v, err := q.exprs["results_map"].EvalLimit(ctx, int(q.maxBytes), doc, WithThreshold(make([]any, len(VarNames)), q.threshold)...)
+	if err != nil {
+		return fill(len(items), unknown(KindExpr, red.String(err.Error())))
+	}
+	arr, ok := v.([]any)
+	if !ok {
+		return fill(len(items), unknown(KindExpr, "results_map must yield an array"))
+	}
+	itemVals := func(it ItemDTO) []any {
+		_, vals := it.ForProvider(q.providerChain(chain)).ToJQ()
+		return WithThreshold(vals, q.threshold)
+	}
+	if q.inOrder && positional(chain, arr, items) {
+		for i, it := range items {
+			out[i] = q.judge(ctx, arr[i].(map[string]any), itemVals(it), red)
+		}
+		return out
+	}
+	byKey := map[string][]map[string]any{}
+	byTx := map[string][]map[string]any{}
+	for _, e := range arr {
+		m, ok := e.(map[string]any)
+		if !ok {
+			continue
+		}
+		a, _ := m["address"].(string)
+		if a == "" {
+			continue
+		}
+		k := SetKey(chain, a)
+		byKey[k] = append(byKey[k], m)
+		if tx, _ := m["tx_id"].(string); tx != "" {
+			byTx[k+"|"+tx] = append(byTx[k+"|"+tx], m)
+		}
+	}
+	for i, it := range items {
+		k := SetKey(chain, it.Address)
+		rs := byKey[k]
+		if it.TxID != nil && *it.TxID != "" {
+			if tr := byTx[k+"|"+*it.TxID]; len(tr) > 0 {
+				rs = tr // the provider echoed this inbound's tx_id
+			}
+		}
+		vals := itemVals(it)
+		switch len(rs) {
+		case 0:
+			out[i] = unknown(KindMissing, "")
+		case 1:
+			out[i] = q.judge(ctx, rs[0], vals, red)
+		default:
+			out[i] = q.judgeAgreeing(ctx, rs, vals, red)
+		}
+	}
+	return out
+}
+
+// positional reports whether results can answer items one-to-one in request
+// order: same length, every result a map echoing its item's address (and its
+// tx_id, when the result carries one). A response that contradicts this falls
+// back to tx_id and address matching.
+func positional(chain common.Chain, arr []any, items []ItemDTO) bool {
+	if len(arr) != len(items) || len(items) == 0 {
+		return false
+	}
+	for i, e := range arr {
+		m, ok := e.(map[string]any)
+		if !ok {
+			return false
+		}
+		a, _ := m["address"].(string)
+		if a == "" || SetKey(chain, a) != SetKey(chain, items[i].Address) {
+			return false
+		}
+		if tx, _ := m["tx_id"].(string); tx != "" {
+			if items[i].TxID == nil || *items[i].TxID != tx {
+				return false
+			}
+		}
+	}
+	return true
+}
+
+// judgeAgreeing judges every result for one address and returns the common
+// answer when they all agree on the state; otherwise Unknown.
+func (q *QuerySource) judgeAgreeing(ctx context.Context, rs []map[string]any, vals []any, red *Redactor) Answer {
+	first := q.judge(ctx, rs[0], vals, red)
+	for _, r := range rs[1:] {
+		if a := q.judge(ctx, r, vals, red); a.State != first.State {
+			return unknown(KindMissing, "conflicting results for one address")
+		}
+	}
+	return first
+}
+
+func toSeconds(v any) (float64, bool) {
+	switch x := v.(type) {
+	case float64:
+		return x, !math.IsNaN(x) && !math.IsInf(x, 0)
+	case int:
+		return float64(x), true
+	case json.Number:
+		f, err := x.Float64()
+		return f, err == nil
+	}
+	return 0, false
+}
+
+// judge applies the tri-state rule to one result document: unknown expr true
+// -> Unknown; listed exactly true -> Listed; exactly false -> Clean; else
+// Unknown.
+func (q *QuerySource) judge(ctx context.Context, doc any, vals []any, red *Redactor) Answer {
+	var a Answer
+	if e := q.exprs["retry_after"]; e != nil {
+		if v, err := e.Eval(ctx, doc, vals...); err == nil {
+			if secs, ok := toSeconds(v); ok && secs > 0 {
+				a.RetryAfter = clampRetry(time.Duration(secs * float64(time.Second)))
+			}
+		}
+	}
+	if e := q.exprs["unknown"]; e != nil {
+		v, err := e.Eval(ctx, doc, vals...)
+		if err != nil {
+			u := unknown(KindExpr, red.String(err.Error()))
+			u.RetryAfter = a.RetryAfter
+			return u
+		}
+		if b, ok := v.(bool); ok && b {
+			u := unknown("unknown", "source said unknown")
+			u.RetryAfter = a.RetryAfter
+			return u
+		}
+	}
+	v, err := q.exprs["listed"].Eval(ctx, doc, vals...)
+	if err != nil {
+		u := unknown(KindExpr, red.String(err.Error()))
+		u.RetryAfter = a.RetryAfter
+		return u
+	}
+	b, ok := v.(bool)
+	if !ok {
+		u := unknown(KindNonBoolean, fmt.Sprintf("%T", v))
+		u.RetryAfter = a.RetryAfter
+		return u
+	}
+	if b {
+		a.State = Listed
+	} else {
+		a.State = Clean
+	}
+	if e := q.exprs["reason"]; e != nil {
+		if rv, err := e.Eval(ctx, doc, vals...); err == nil {
+			if s, ok := rv.(string); ok {
+				s = red.String(s)
+				if len(s) > maxReasonLen {
+					s = s[:maxReasonLen]
+				}
+				a.Reason = s
+			}
+		}
+	}
+	return a
+}
diff --git a/bifrost/pkg/addressfilter/recheck.go b/bifrost/pkg/addressfilter/recheck.go
new file mode 100644
index 00000000000..afce7dbac89
--- /dev/null
+++ b/bifrost/pkg/addressfilter/recheck.go
@@ -0,0 +1,280 @@
+package addressfilter
+
+import (
+	"context"
+	"math/rand"
+	"time"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+)
+
+// Recheck defaults (R3-A6).
+const (
+	DefaultRecheckBase = time.Minute // ~10 THORChain blocks
+	DefaultRecheckCap  = 6 * time.Hour
+)
+
+// RecheckerOptions configure a Rechecker.
+type RecheckerOptions struct {
+	Ledger  *SkipLedger
+	Sources []Source
+	Guard   GuardView
+	Combine string
+	// Page is recheck_page: records per tick (default 100).
+	Page int
+	// Base and Cap bound the exponential back-off per record.
+	Base, Cap time.Duration
+	// Retention: records older than this are archived with an alert (7 d).
+	Retention time.Duration
+	// Deadline bounds one tick's lookups (default MaxScreenDeadline).
+	Deadline time.Duration
+	// Inflight is the shared global cap; a tick is skipped while live
+	// in-flight requests exceed half of it.
+	Inflight *InflightCap
+	// OnRelease hands a released record to replay (A5.1); a nil return
+	// releases it, an error keeps it pending and retries on the next back-off
+	// step. A nil func is record-only mode: the record moves to the archive as
+	// released (kept as evidence, never re-observed).
+	OnRelease func(*SkipEnvelope) error
+	Metrics   *Metrics
+	Now       func() time.Time
+	Rand      *rand.Rand
+}
+
+// Rechecker re-screens skipped records on a bounded schedule.
+type Rechecker struct {
+	o RecheckerOptions
+}
+
+// RecheckStats summarises one tick.
+type RecheckStats struct {
+	Paused      bool
+	Processed   int
+	Queries     int // distinct (chain, sender) lookups made
+	Released    int
+	Rescheduled int
+	Archived    int
+}
+
+// NewRechecker applies defaults.
+func NewRechecker(o RecheckerOptions) *Rechecker {
+	if o.Page <= 0 {
+		o.Page = DefaultRecheckPage
+	}
+	if o.Base <= 0 {
+		o.Base = DefaultRecheckBase
+	}
+	if o.Cap <= 0 {
+		o.Cap = DefaultRecheckCap
+	}
+	if o.Retention <= 0 {
+		o.Retention = DefaultRetention
+	}
+	if o.Deadline <= 0 {
+		o.Deadline = MaxScreenDeadline
+	}
+	if o.Combine != CombineAll {
+		o.Combine = CombineAny
+	}
+	if o.Now == nil {
+		o.Now = time.Now
+	}
+	if o.Rand == nil {
+		o.Rand = rand.New(rand.NewSource(time.Now().UnixNano()))
+	}
+	return &Rechecker{o: o}
+}
+
+// backoff returns the delay before attempt n+1: Base * 2^n, capped, with up
+// to 10 % jitter.
+func (r *Rechecker) backoff(attempts int) time.Duration {
+	d := r.o.Base
+	for i := 0; i < attempts && d < r.o.Cap; i++ {
+		d *= 2
+	}
+	if d > r.o.Cap {
+		d = r.o.Cap
+	}
+	if j := int64(d / 10); j > 0 {
+		d += time.Duration(r.o.Rand.Int63n(j))
+	}
+	return d
+}
+
+type recheckGroup struct {
+	chain common.Chain
+	dto   ItemDTO
+	envs  []*SkipEnvelope
+}
+
+// Tick processes at most Page due records.
+func (r *Rechecker) Tick(ctx context.Context) RecheckStats {
+	var st RecheckStats
+	o := r.o
+	if o.Guard == nil || !o.Guard.Ready() || o.Inflight.LiveBusy() {
+		st.Paused = true
+		return st
+	}
+	now := o.Now()
+	keys, err := o.Ledger.Due(now, o.Page)
+	if err != nil || len(keys) == 0 {
+		return st
+	}
+	o.Metrics.recheckBacklog(len(keys))
+	// Dedupe by (chain, sender) within the tick: one lookup per sender per chain.
+	groups := map[string]*recheckGroup{}
+	var order []string
+	for _, k := range keys {
+		env, ok, err := o.Ledger.Get(k)
+		if err != nil || !ok {
+			continue
+		}
+		st.Processed++
+		if now.Sub(env.CreatedAt) > o.Retention {
+			if o.Ledger.Archive(k) == nil {
+				st.Archived++
+			}
+			continue
+		}
+		chain, err := common.NewChain(env.Occurrence.Chain)
+		if err != nil {
+			r.reschedule(env, &st)
+			continue
+		}
+		// A sender the guard now contains (a vault, router or module) was
+		// never meant to be skipped: release it without asking any source.
+		if o.Guard.Contains(chain, env.Item.Sender) {
+			r.release(env, &st)
+			continue
+		}
+		// Per chain: SetKey is chain-free for EVM accounts, but a source may
+		// answer differently per chain (one EVM address listed on ETH, clean
+		// on BSC), so an ETH record is never judged on a BSC answer. When a
+		// context-dependent source covers the chain, each record is asked
+		// with its own tx context: one inbound's answer never decides the
+		// sender's other records.
+		gk := chain.String() + "|" + SetKey(chain, env.Item.Sender)
+		if r.contextDependent(chain) {
+			gk = "rec|" + env.Key()
+		}
+		g := groups[gk]
+		if g == nil {
+			g = &recheckGroup{chain: chain, dto: env.Screening.Inputs}
+			groups[gk] = g
+			order = append(order, gk)
+		}
+		g.envs = append(g.envs, env)
+	}
+	if len(order) == 0 {
+		return st
+	}
+	// Batch per chain, fresh lookups (bypass positive caches), recovery budget.
+	byChain := map[common.Chain][]*recheckGroup{}
+	for _, gk := range order {
+		g := groups[gk]
+		byChain[g.chain] = append(byChain[g.chain], g)
+	}
+	rctx, cancel := context.WithTimeout(WithRecheck(ctx), o.Deadline)
+	defer cancel()
+	for chain, gs := range byChain {
+		items := make([]ItemDTO, len(gs))
+		for i, g := range gs {
+			items[i] = g.dto
+		}
+		st.Queries += len(items)
+		var names []string
+		answers := map[string][]Answer{}
+		for _, src := range o.Sources {
+			if !src.Covers(chain) {
+				continue
+			}
+			names = append(names, src.Name())
+			a := safeCheck(rctx, src, chain, items)
+			if len(a) == len(items) {
+				answers[src.Name()] = a
+			}
+		}
+		for i, g := range gs {
+			m := map[string]Answer{}
+			pessimistic := map[string]Answer{}
+			for _, n := range names {
+				a, ok := answers[n]
+				if !ok {
+					m[n] = Answer{State: Unknown, Reason: "timeout"}
+				} else {
+					m[n] = a[i]
+				}
+				// Release needs a definitive answer: an Unknown (source down,
+				// budget, timeout) counts as still listed, so an outage never
+				// releases a skipped record.
+				p := m[n]
+				if p.State == Unknown {
+					p.State = Listed
+				}
+				pessimistic[n] = p
+			}
+			stillListed := len(names) == 0 || Combine(o.Combine, pessimistic, names)
+			for _, env := range g.envs {
+				// A sender guarded since the lookup started is released (the
+				// guard check above runs before the lookup).
+				if stillListed && !o.Guard.Contains(chain, env.Item.Sender) {
+					env.Screening.Answers = m
+					r.reschedule(env, &st)
+					continue
+				}
+				r.release(env, &st)
+			}
+		}
+	}
+	return st
+}
+
+// contextDependent reports whether any source covering chain answers per
+// inbound (tx context), not per address.
+func (r *Rechecker) contextDependent(chain common.Chain) bool {
+	for _, src := range r.o.Sources {
+		if !src.Covers(chain) {
+			continue
+		}
+		if cd, ok := src.(interface{ ContextDependent() bool }); ok && cd.ContextDependent() {
+			return true
+		}
+	}
+	return false
+}
+
+// release re-observes the record (replay) or, in record-only mode, closes it
+// into the archive as released: the evidence is kept either way.
+func (r *Rechecker) release(env *SkipEnvelope, st *RecheckStats) {
+	o := r.o
+	if o.OnRelease == nil {
+		if o.Ledger.Resolve(env) == nil {
+			st.Released++
+		}
+		return
+	}
+	if err := o.OnRelease(env); err != nil {
+		r.reschedule(env, st)
+		return
+	}
+	if o.Ledger.Release(env.Key()) == nil {
+		st.Released++
+	}
+}
+
+func (r *Rechecker) reschedule(env *SkipEnvelope, st *RecheckStats) {
+	env.Attempts++
+	env.NextCheck = r.o.Now().Add(r.backoff(env.Attempts))
+	if r.o.Ledger.Update(env) == nil {
+		st.Rescheduled++
+	}
+}
+
+func safeCheck(ctx context.Context, src Source, chain common.Chain, items []ItemDTO) (out []Answer) {
+	defer func() {
+		if recover() != nil {
+			out = nil
+		}
+	}()
+	return src.Check(ctx, chain, items)
+}
diff --git a/bifrost/pkg/addressfilter/redact.go b/bifrost/pkg/addressfilter/redact.go
new file mode 100644
index 00000000000..af942f761e9
--- /dev/null
+++ b/bifrost/pkg/addressfilter/redact.go
@@ -0,0 +1,149 @@
+package addressfilter
+
+import (
+	"encoding/base64"
+	"errors"
+	"net/http"
+	"net/url"
+	"sort"
+	"strings"
+)
+
+// Redacted replaces every secret occurrence in adapter output.
+const Redacted = "[REDACTED]"
+
+// Redactor scrubs a source's secrets (raw, URL-encoded and base64 forms) and
+// sensitive headers/parameters from URLs, errors, response snippets,
+// expression outputs and log fields (R3-A12). It is safe for concurrent use.
+type Redactor struct {
+	needles []string // longest first
+	headers map[string]bool
+}
+
+// NewRedactor builds a redactor for secret values and sensitive header names.
+// Authorization and Proxy-Authorization are always sensitive.
+func NewRedactor(secrets []string, sensitiveHeaders []string) *Redactor {
+	r := &Redactor{headers: map[string]bool{"authorization": true, "proxy-authorization": true}}
+	for _, h := range sensitiveHeaders {
+		r.headers[strings.ToLower(h)] = true
+	}
+	return r.WithValues(secrets...)
+}
+
+// WithValues returns a redactor that also scrubs vals (e.g. per-request
+// signature header values). The receiver is not modified.
+func (r *Redactor) WithValues(vals ...string) *Redactor {
+	seen := map[string]bool{}
+	var n []string
+	add := func(s string) {
+		if s != "" && !seen[s] {
+			seen[s] = true
+			n = append(n, s)
+		}
+	}
+	for _, s := range r.needles {
+		add(s)
+	}
+	for _, v := range vals {
+		v = strings.TrimSpace(v)
+		if v == "" {
+			continue
+		}
+		add(v)
+		add(url.QueryEscape(v))
+		add(url.PathEscape(v))
+		add(base64.StdEncoding.EncodeToString([]byte(v)))
+		add(base64.RawStdEncoding.EncodeToString([]byte(v)))
+		add(base64.URLEncoding.EncodeToString([]byte(v)))
+		add(base64.RawURLEncoding.EncodeToString([]byte(v)))
+	}
+	sort.SliceStable(n, func(i, j int) bool { return len(n[i]) > len(n[j]) })
+	hs := make(map[string]bool, len(r.headers))
+	for k := range r.headers {
+		hs[k] = true
+	}
+	return &Redactor{needles: n, headers: hs}
+}
+
+// String scrubs every known secret form from s.
+func (r *Redactor) String(s string) string {
+	if r == nil {
+		return s
+	}
+	for _, n := range r.needles {
+		if strings.Contains(s, n) {
+			s = strings.ReplaceAll(s, n, Redacted)
+		}
+	}
+	return s
+}
+
+// Error returns err with its message scrubbed (nil stays nil).
+func (r *Redactor) Error(err error) error {
+	if err == nil {
+		return nil
+	}
+	return errors.New(r.String(err.Error()))
+}
+
+// URL renders u with sensitive query parameters replaced and secrets scrubbed.
+func (r *Redactor) URL(u *url.URL, sensitiveParams []string) string {
+	if u == nil {
+		return ""
+	}
+	c := *u
+	c.User = nil
+	if len(sensitiveParams) > 0 && c.RawQuery != "" {
+		q := c.Query()
+		for _, p := range sensitiveParams {
+			if _, ok := q[p]; ok {
+				q.Set(p, Redacted)
+			}
+		}
+		c.RawQuery = q.Encode()
+	}
+	return r.String(c.String())
+}
+
+// Header returns a copy of h with sensitive headers (known names plus extra)
+// replaced and secrets scrubbed from the rest.
+func (r *Redactor) Header(h http.Header, extra ...string) http.Header {
+	sens := map[string]bool{}
+	for _, e := range extra {
+		sens[strings.ToLower(e)] = true
+	}
+	out := make(http.Header, len(h))
+	for k, vs := range h {
+		lk := strings.ToLower(k)
+		for _, v := range vs {
+			if r.headers[lk] || sens[lk] {
+				out.Add(k, Redacted)
+			} else {
+				out.Add(k, r.String(v))
+			}
+		}
+	}
+	return out
+}
+
+// Value scrubs secrets from a JSON-like value (expression outputs), returning
+// a scrubbed copy.
+func (r *Redactor) Value(v any) any {
+	switch x := v.(type) {
+	case string:
+		return r.String(x)
+	case []any:
+		out := make([]any, len(x))
+		for i, e := range x {
+			out[i] = r.Value(e)
+		}
+		return out
+	case map[string]any:
+		out := make(map[string]any, len(x))
+		for k, e := range x {
+			out[r.String(k)] = r.Value(e)
+		}
+		return out
+	}
+	return v
+}
diff --git a/bifrost/pkg/addressfilter/request.go b/bifrost/pkg/addressfilter/request.go
new file mode 100644
index 00000000000..d957ea3a6ab
--- /dev/null
+++ b/bifrost/pkg/addressfilter/request.go
@@ -0,0 +1,270 @@
+package addressfilter
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"net/url"
+	"sort"
+	"strings"
+	"time"
+)
+
+// Header and query values are a literal, "secret:<file>" (loaded at
+// startup), or "jq:<expression>" over the item variables. Only the {address}
+// and {chain} placeholders exist in the URL; both are URL-escaped for the
+// part of the URL they sit in. The body is a jq expression serialized with
+// encoding/json: an address never reaches a request by string concatenation.
+
+const (
+	// ValueSecretPrefix marks a header/query value read from a secret file.
+	ValueSecretPrefix = "secret:"
+	// ValueExprPrefix marks a header/query value computed by a jq expression.
+	ValueExprPrefix = "jq:"
+	// MaxRequestBody caps a serialized request body.
+	MaxRequestBody = 1 << 20
+)
+
+// ErrRequestBody is returned when the body expression yields too much data.
+var ErrRequestBody = errors.New("request body exceeds 1 MiB")
+
+type valueSpec struct {
+	literal string
+	expr    *Expr
+}
+
+// RequestBuilder builds the HTTP requests of one list/query source.
+type RequestBuilder struct {
+	method   string
+	tmpl     string
+	headers  map[string]valueSpec
+	query    map[string]valueSpec
+	body     *Expr
+	auth     *Authenticator
+	redactor *Redactor
+}
+
+// BuiltRequest is a request ready to send, plus what the redactor needs.
+type BuiltRequest struct {
+	Req              *http.Request
+	Body             []byte
+	SensitiveHeaders []string
+	SensitiveParams  []string
+	// Redactor scrubs the source's secrets plus this request's signature
+	// header values.
+	Redactor *Redactor
+}
+
+// NewRequestBuilder prepares a builder for a validated source. secrets maps a
+// secret file path to its loaded value; header/query expressions were
+// compiled by Validate (spec.Exprs["header:<name>"], ["query:<name>"]).
+func NewRequestBuilder(spec SourceSpec, secrets map[string]string, auth *Authenticator) (*RequestBuilder, error) {
+	r := spec.Raw
+	b := &RequestBuilder{
+		tmpl:    r.URL,
+		headers: map[string]valueSpec{},
+		query:   map[string]valueSpec{},
+		body:    spec.Exprs["body"],
+		auth:    auth,
+	}
+	if err := checkURLTemplate(r.URL); err != nil {
+		return nil, err
+	}
+	b.method = strings.ToUpper(strings.TrimSpace(r.Method))
+	if b.method == "" {
+		b.method = http.MethodGet
+		if b.body != nil {
+			b.method = http.MethodPost
+		}
+	}
+	if b.method != http.MethodGet && b.method != http.MethodPost {
+		return nil, fmt.Errorf("method %q (want GET|POST)", r.Method)
+	}
+	var sens []string
+	fill := func(kind string, in map[string]string, out map[string]valueSpec) error {
+		for k, v := range in {
+			switch {
+			case strings.HasPrefix(v, ValueSecretPrefix):
+				sec, ok := secrets[strings.TrimPrefix(v, ValueSecretPrefix)]
+				if !ok || sec == "" {
+					return fmt.Errorf("%s %q: secret not loaded", kind, k)
+				}
+				out[k] = valueSpec{literal: sec}
+				if kind == "header" {
+					sens = append(sens, k)
+				}
+			case strings.HasPrefix(v, ValueExprPrefix):
+				e := spec.Exprs[kind+":"+k]
+				if e == nil {
+					return fmt.Errorf("%s %q: expression not compiled", kind, k)
+				}
+				out[k] = valueSpec{expr: e}
+			default:
+				out[k] = valueSpec{literal: v}
+			}
+		}
+		return nil
+	}
+	if err := fill("header", r.Headers, b.headers); err != nil {
+		return nil, err
+	}
+	if err := fill("query", r.Query, b.query); err != nil {
+		return nil, err
+	}
+	b.redactor = NewRedactor(spec.Secrets, sens)
+	return b, nil
+}
+
+// checkURLTemplate refuses placeholders outside path and query (a
+// placeholder in the scheme or host could redirect the request).
+func checkURLTemplate(t string) error {
+	i := strings.Index(t, "://")
+	if i < 0 {
+		return errors.New("bad url")
+	}
+	rest := t[i+3:]
+	end := strings.IndexAny(rest, "/?#")
+	if end < 0 {
+		end = len(rest)
+	}
+	if strings.ContainsAny(t[:i+3+end], "{}") {
+		return errors.New("url placeholders are only allowed in path and query")
+	}
+	if strings.Contains(t, "#") {
+		return errors.New("url fragment not allowed")
+	}
+	return nil
+}
+
+// expandURL substitutes {address} and {chain}: path-escaped before '?',
+// query-escaped after it.
+func expandURL(t, address, chain string) string {
+	path, query, hasQ := strings.Cut(t, "?")
+	pr := strings.NewReplacer("{address}", url.PathEscape(address), "{chain}", url.PathEscape(chain))
+	out := pr.Replace(path)
+	if hasQ {
+		qr := strings.NewReplacer("{address}", url.QueryEscape(address), "{chain}", url.QueryEscape(chain))
+		out += "?" + qr.Replace(query)
+	}
+	return out
+}
+
+// exprString evaluates a header/query expression to a string value.
+func exprString(ctx context.Context, e *Expr, input any, vals []any) (string, error) {
+	v, err := e.Eval(ctx, input, vals...)
+	if err != nil {
+		return "", err
+	}
+	switch x := v.(type) {
+	case string:
+		return x, nil
+	case bool, float64, int, json.Number:
+		b, _ := json.Marshal(x)
+		return string(b), nil
+	}
+	return "", fmt.Errorf("value expression must yield a string, number or boolean, got %T", v)
+}
+
+// Build builds the request for one item (or one batch: the caller supplies
+// the expression input and variable values). chain is the provider's chain
+// name after chain_map. Auth is applied last, over the final bytes.
+func (b *RequestBuilder) Build(ctx context.Context, address, chain string, input any, vals []any, now time.Time) (*BuiltRequest, error) {
+	rawURL := expandURL(b.tmpl, address, chain)
+	u, err := url.Parse(rawURL)
+	if err != nil {
+		return nil, b.redactor.Error(fmt.Errorf("built url: %w", err))
+	}
+	if len(b.query) > 0 {
+		q := u.Query()
+		for _, k := range sortedKeys(b.query) {
+			vs := b.query[k]
+			val := vs.literal
+			if vs.expr != nil {
+				if val, err = exprString(ctx, vs.expr, input, vals); err != nil {
+					return nil, b.redactor.Error(fmt.Errorf("query %q: %w", k, err))
+				}
+			}
+			q.Set(k, val)
+		}
+		u.RawQuery = q.Encode()
+	}
+	var body []byte
+	if b.body != nil {
+		v, err := b.body.Eval(ctx, input, vals...)
+		if err != nil {
+			return nil, b.redactor.Error(fmt.Errorf("body: %w", err))
+		}
+		if body, err = json.Marshal(v); err != nil {
+			return nil, b.redactor.Error(fmt.Errorf("body: %w", err))
+		}
+		if len(body) > MaxRequestBody {
+			return nil, ErrRequestBody
+		}
+	}
+	var rd *bytes.Reader
+	if body != nil {
+		rd = bytes.NewReader(body)
+	}
+	var req *http.Request
+	if rd != nil {
+		req, err = http.NewRequestWithContext(ctx, b.method, u.String(), rd)
+	} else {
+		req, err = http.NewRequestWithContext(ctx, b.method, u.String(), nil)
+	}
+	if err != nil {
+		return nil, b.redactor.Error(err)
+	}
+	req.Header.Set("Accept", "application/json")
+	if body != nil {
+		req.Header.Set("Content-Type", "application/json")
+	}
+	var sensHeaders []string
+	for _, k := range sortedKeys(b.headers) {
+		vs := b.headers[k]
+		val := vs.literal
+		if vs.expr != nil {
+			if val, err = exprString(ctx, vs.expr, input, vals); err != nil {
+				return nil, b.redactor.Error(fmt.Errorf("header %q: %w", k, err))
+			}
+		}
+		req.Header.Set(k, val)
+	}
+	for k := range b.redactor.headers {
+		sensHeaders = append(sensHeaders, k)
+	}
+	var sensParams []string
+	red := b.redactor
+	if b.auth != nil {
+		hs, ps, err := b.auth.Apply(req, body, now)
+		if err != nil {
+			return nil, b.redactor.Error(fmt.Errorf("auth: %w", err))
+		}
+		sensHeaders = append(sensHeaders, hs...)
+		sensParams = append(sensParams, ps...)
+		var vals []string
+		for _, h := range hs {
+			vals = append(vals, req.Header.Get(h))
+		}
+		red = red.WithValues(vals...)
+		red.headersAdd(hs)
+	}
+	return &BuiltRequest{Req: req, Body: body, SensitiveHeaders: sensHeaders, SensitiveParams: sensParams, Redactor: red}, nil
+}
+
+func (r *Redactor) headersAdd(hs []string) {
+	for _, h := range hs {
+		r.headers[strings.ToLower(h)] = true
+	}
+}
+
+func sortedKeys(m map[string]valueSpec) []string {
+	out := make([]string, 0, len(m))
+	for k := range m {
+		out = append(out, k)
+	}
+	sort.Strings(out)
+	return out
+}
