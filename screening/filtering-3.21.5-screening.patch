+package main
+
+import (
+	"bytes"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"gitlab.com/thorchain/thornode/v3/config"
+)
+
+func TestAddressFilterCLIValidateAndDryRun(t *testing.T) {
+	const key = "cli-secret-abcdef0123"
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		io.WriteString(w, `{"listed":false,"echo":"`+r.URL.Query().Get("k")+`"}`)
+	}))
+	defer srv.Close()
+	dir := t.TempDir()
+	sf := filepath.Join(dir, "key")
+	if err := os.WriteFile(sf, []byte(key), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	good := config.BifrostAddressFilterConfiguration{
+		Enabled: true,
+		Sources: []config.BifrostAddressFilterSource{{
+			Name: "q", Mode: "query", Chains: []string{"BTC"}, URL: srv.URL + "/a/{address}",
+			Auth: "query", QueryParam: "k", SecretFile: sf, Listed: ".listed", AllowPrivate: true, AllowDirectEgress: true,
+		}},
+	}
+	load := func() config.BifrostAddressFilterConfiguration { return good }
+	var out bytes.Buffer
+	if code := runAddressFilter([]string{"validate"}, &out, load); code != 0 {
+		t.Fatalf("validate exit %d: %s", code, out.String())
+	}
+	out.Reset()
+	code := runAddressFilter([]string{"dry-run", "--source", "q", "--chain", "BTC", "--address", "bc1qcli", "--raw"}, &out, load)
+	if code != 0 || strings.Contains(out.String(), key) || !strings.Contains(out.String(), `"answer": "clean"`) {
+		t.Fatalf("dry-run exit %d leaks=%v: %s", code, strings.Contains(out.String(), key), out.String())
+	}
+
+	bad := good
+	bad.Sources = append([]config.BifrostAddressFilterSource{}, good.Sources...)
+	bad.Sources[0].Mode = "bogus"
+	out.Reset()
+	if code := runAddressFilter([]string{"validate"}, &out, func() config.BifrostAddressFilterConfiguration { return bad }); code == 0 || !strings.Contains(out.String(), "QUARANTINED q") {
+		t.Fatalf("strict validate must fail on a quarantine: %d %s", code, out.String())
+	}
+	if code := runAddressFilter(nil, &out, load); code != 2 {
+		t.Fatal("usage")
+	}
+}
+
+func TestAddressFilterCLIListAckWritesMarker(t *testing.T) {
+	cfg := config.BifrostAddressFilterConfiguration{
+		Enabled: true,
+		Sources: []config.BifrostAddressFilterSource{{Name: "lst", Mode: "list"}, {Name: "q", Mode: "query"}},
+	}
+	load := func() config.BifrostAddressFilterConfiguration { return cfg }
+	dir := filepath.Join(t.TempDir(), "ack")
+	var out bytes.Buffer
+	if code := runAddressFilter([]string{"list-ack", "lst", "--ack-dir", dir}, &out, load); code != 0 {
+		t.Fatalf("list-ack exit %d: %s", code, out.String())
+	}
+	if _, err := os.Stat(filepath.Join(dir, "lst")); err != nil {
+		t.Fatalf("marker not written: %v", err)
+	}
+	for _, bad := range []string{"q", "nope", "../lst"} {
+		out.Reset()
+		if code := runAddressFilter([]string{"list-ack", bad, "--ack-dir", dir}, &out, load); code == 0 {
+			t.Fatalf("%q must fail: %s", bad, out.String())
+		}
+	}
+	if strings.Contains(out.String(), "panic") {
+		t.Fatal(out.String())
+	}
+}
