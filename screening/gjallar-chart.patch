+appVersion: "0.1.0"
diff --git a/gjallar/README.md b/gjallar/README.md
new file mode 100644
index 00000000..b6cc35ac
--- /dev/null
+++ b/gjallar/README.md
@@ -0,0 +1,72 @@
+# Gjallar screening proxy for the bifrost observation filter
+
+Optional, off by default. Runs Gjallar next to bifrost. Gjallar is a screening service that answers "is this sender on the operator's screening list?" Bifrost's opt-in observation filter queries it and skips observing an inbound whose sender is listed. This is a per-node policy: no consensus or economic change, and a node that filters simply does not sign that observation.
+
+## What Gjallar does
+
+Every address is answered in fixed tiers, stopping at the first that applies:
+
+1. **Vault whitelist.** Every Asgard vault address (all states), router and module account is never listed. Gjallar builds this from keygen and vault-rotation events plus Midgard history, independently of bifrost's own vault guard.
+2. **Own list.** Versioned sets built from the configured sources (OFAC SDN, CSV, JSON, web pages, fixed lists), optionally extended by bounded N-hop derivation.
+3. **Screening vendor on a miss.** Optional, cached, budgeted.
+
+It **fails open**: if it cannot answer in time, the answer is "not listed" and the node observes as it does today.
+
+Bifrost can use it in two modes (both supported by the screening adapter):
+
+- `list`: bifrost pulls `GET /v1/list/{chain}` (the exportable own list) every `refresh` and matches locally. This is the default here: no per-block call, and a Gjallar outage leaves the last good list in place until `max_age`.
+- `query`: bifrost sends each block's senders to `POST /v1/check`.
+
+## Enable
+
+In your thornode-stack values:
+
+```yaml
+gjallar:
+  enabled: true
+  image:
+    name: <registry>/gjallar
+    tag: <tag>
+    hash: <sha256 digest, no prefix>
+  tls:
+    secretName: gjallar-tls          # kubernetes.io/tls, valid for "gjallar"
+  thorchainApiKey:                   # optional
+    secretName: gjallar-env
+    secretKey: thorchain-api-key
+  config:
+    server:
+      auth:
+        cidrs:
+          - principal: bifrost
+            cidr: <pod CIDR>         # keep networkPolicy on: it limits the port to bifrost
+    thorchain:
+      rest_url: https://<thorchain api provider>
+      rpc_url: https://<thorchain rpc provider>
+      confirm_url: https://<a second provider, different host>
+
+thornode:
+  bifrost:
+    screening:
+      enabled: true
+      caSecret: gjallar-ca           # Secret with ca.crt that issued gjallar-tls
+```
+
+Bifrost must run an image built with the screening adapter. A stock bifrost ignores the `BIFROST_ADDRESS_FILTER_*` keys.
+
+### Requirements
+
+- **TLS is mandatory.** Gjallar refuses a non-loopback bind without TLS. Create a CA, issue a certificate for `gjallar` and `gjallar.<namespace>.svc`, and store it as a `kubernetes.io/tls` Secret. Put the CA in a Secret with key `ca.crt` for bifrost.
+- **THORChain endpoints must be https.** The in-cluster thornode service is plain http, so it does not qualify. `confirm_url` must be on a different host from `rest_url`.
+- **Image.** There is no official image yet. Build one from the Gjallar source with the `gjallar` binary as the entrypoint (the chart passes `serve /etc/gjallar/gjallar.toml`).
+- **One pod.** The list, snapshots and vault whitelist live in one data dir on the PVC, so the deployment runs one replica with a `Recreate` strategy.
+
+## Config
+
+`gjallar.config` mirrors `gjallar.toml` (see `config.example.toml` and `API.md` in the Gjallar source). The chart owns `data_dir`, `server.bind`, `server.admin_bind`, the TLS paths and `thorchain.api_key_env`. Sources go under `config.source` as a list; each entry becomes a `[[source]]` table.
+
+The admin listener (`/v1/version`, `/metrics`, `/healthz/detail`) stays on loopback inside the pod. Use `kubectl port-forward` or `kubectl exec` to reach it.
+
+## Behaviour to know before enabling
+
+- **Missed observations.** A filtering node does not sign listed inbounds. While fewer than 1/3 of active nodes filter, those inbounds still reach 2/3 and are processed without them, and the node accrues the normal missed-observation slash points.
+- **`filterOutbound: true`** also refuses to sign outbounds to a listed destination. Expect failed keysigns and jail for the node whenever it is selected for one.
diff --git a/gjallar/templates/_helpers.tpl b/gjallar/templates/_helpers.tpl
new file mode 100644
index 00000000..77d91d8e
--- /dev/null
+++ b/gjallar/templates/_helpers.tpl
@@ -0,0 +1,156 @@
+{{/* vim: set filetype=mustache: */}}
+
+{{/*
+Expand the name of the chart.
+*/}}
+{{- define "gjallar.name" -}}
+{{- default .Chart.Name .Values.nameOverride | trunc 63 | trimSuffix "-" }}
+{{- end }}
+
+{{/*
+Create a default fully qualified app name.
+We truncate at 63 chars because some Kubernetes name fields are limited to this (by the DNS naming spec).
+If release name contains chart name it will be used as a full name.
+*/}}
+{{- define "gjallar.fullname" -}}
+{{- if .Values.fullnameOverride }}
+{{- .Values.fullnameOverride | trunc 63 | trimSuffix "-" }}
+{{- else }}
+{{- $name := default .Chart.Name .Values.nameOverride }}
+{{- if contains $name .Release.Name }}
+{{- .Release.Name | trunc 63 | trimSuffix "-" }}
+{{- else }}
+{{- printf "%s-%s" .Release.Name $name | trunc 63 | trimSuffix "-" }}
+{{- end }}
+{{- end }}
+{{- end }}
+
+{{/*
+Create chart name and version as used by the chart label.
+*/}}
+{{- define "gjallar.chart" -}}
+{{- printf "%s-%s" .Chart.Name .Chart.Version | replace "+" "_" | trunc 63 | trimSuffix "-" }}
+{{- end }}
+
+{{/*
+Common labels
+*/}}
+{{- define "gjallar.labels" -}}
+helm.sh/chart: {{ include "gjallar.chart" . }}
+{{ include "gjallar.selectorLabels" . }}
+app.kubernetes.io/version: {{ .Values.image.tag | default .Chart.AppVersion | quote }}
+app.kubernetes.io/managed-by: {{ .Release.Service }}
+{{- end }}
+
+{{/*
+Selector labels
+*/}}
+{{- define "gjallar.selectorLabels" -}}
+app.kubernetes.io/name: {{ include "gjallar.name" . }}
+app.kubernetes.io/instance: {{ .Release.Name }}
+{{- end }}
+
+{{/*
+Container securityContext. Rendered by hand so the capabilities lists come out as indented
+block sequences (yamllint-clean); toYaml would emit them unindented.
+*/}}
+{{- define "gjallar.containerSecurityContext" -}}
+{{- with omit .Values.securityContext "capabilities" }}{{ toYaml . }}{{ end }}
+{{- with .Values.securityContext.capabilities }}
+capabilities:
+  {{- range $key, $list := . }}
+  {{ $key }}:
+    {{- range $list }}
+    - {{ . | quote }}
+    {{- end }}
+  {{- end }}
+{{- end }}
+{{- end }}
+
+{{/*
+gjallar.toml rendering. Helm's toToml writes every number as a float (1500.0), which Gjallar's
+integer fields reject, so the config is rendered by hand: whole numbers as integers, maps as
+[tables], `source` entries as [[source]], maps and lists inside a value as inline TOML.
+Keys with a null value are skipped.
+*/}}
+{{- define "gjallar.tomlKey" -}}
+{{- if regexMatch "^[A-Za-z0-9_-]+$" . }}{{ . }}{{ else }}{{ . | toJson }}{{ end }}
+{{- end }}
+
+{{- define "gjallar.tomlValue" -}}
+{{- $v := . -}}
+{{- if kindIs "string" $v -}}
+{{ $v | toJson }}
+{{- else if kindIs "bool" $v -}}
+{{ $v }}
+{{- else if or (kindIs "float64" $v) (kindIs "int" $v) (kindIs "int64" $v) -}}
+{{- if eq (float64 (int64 $v)) (float64 $v) }}{{ int64 $v }}{{ else }}{{ $v }}{{ end }}
+{{- else if kindIs "slice" $v -}}
+[{{ range $i, $e := $v }}{{ if $i }}, {{ end }}{{ include "gjallar.tomlValue" $e }}{{ end }}]
+{{- else if kindIs "map" $v -}}
+{ {{- $first := true }}{{ range $k := keys $v | sortAlpha }}{{ $e := get $v $k }}{{ if not (kindIs "invalid" $e) }}{{ if not $first }},{{ end }} {{ include "gjallar.tomlKey" $k }} = {{ include "gjallar.tomlValue" $e }}{{ $first = false }}{{ end }}{{ end }} }
+{{- else -}}
+{{ fail (printf "gjallar.config: cannot render %v (%s) as TOML" $v (kindOf $v)) }}
+{{- end -}}
+{{- end }}
+
+{{/* key = value lines of map .m (maps excluded, they become sub-tables) */}}
+{{- define "gjallar.tomlScalars" -}}
+{{- range $k := keys .m | sortAlpha }}
+{{- $v := get $.m $k }}
+{{- if not (or (kindIs "map" $v) (kindIs "invalid" $v)) }}
+{{ include "gjallar.tomlKey" $k }} = {{ include "gjallar.tomlValue" $v }}
+{{- end }}
+{{- end }}
+{{- end }}
+
+{{/* [path.k] sub-tables of map .m, recursively */}}
+{{- define "gjallar.tomlTables" -}}
+{{- range $k := keys .m | sortAlpha }}
+{{- $v := get $.m $k }}
+{{- if kindIs "map" $v }}
+{{- $p := printf "%s%s" $.path (include "gjallar.tomlKey" $k) }}
+
+[{{ $p }}]
+{{- include "gjallar.tomlScalars" (dict "m" $v) }}
+{{- include "gjallar.tomlTables" (dict "m" $v "path" (printf "%s." $p)) }}
+{{- end }}
+{{- end }}
+{{- end }}
+
+{{/*
+The full gjallar.toml: .Values.config plus the fields the chart owns (data dir, listeners, TLS
+paths, API key env).
+*/}}
+{{- define "gjallar.config" -}}
+{{- $c := deepCopy .Values.config }}
+{{- $t := default dict $c.thorchain }}
+{{- $_ := required "gjallar.config.thorchain.rest_url is required (https)" $t.rest_url }}
+{{- $_ := required "gjallar.config.thorchain.rpc_url is required (https)" $t.rpc_url }}
+{{- $_ := required "gjallar.config.thorchain.confirm_url is required (https, a different host from rest_url)" $t.confirm_url }}
+{{- if .Values.thorchainApiKey.secretName }}
+{{- $_ := set $t "api_key_env" "GJALLAR_THORCHAIN_API_KEY" }}
+{{- end }}
+{{- $_ := set $c "thorchain" $t }}
+{{- $s := default dict $c.server }}
+{{- $_ := set $s "bind" (printf "0.0.0.0:%d" (int .Values.service.port)) }}
+{{- $_ := set $s "admin_bind" "127.0.0.1:9443" }}
+{{- $_ := set $s "tls" (dict "cert_path" "/etc/gjallar/tls/tls.crt" "key_path" "/etc/gjallar/tls/tls.key") }}
+{{- $_ := set $c "server" $s }}
+{{- $sources := default list $c.source }}
+{{- $c = omit $c "source" "data_dir" -}}
+data_dir = "/var/lib/gjallar"
+{{- include "gjallar.tomlScalars" (dict "m" $c) }}
+{{- include "gjallar.tomlTables" (dict "m" $c "path" "") }}
+{{- range $sources }}
+
+[[source]]
+{{- $src := . }}
+{{- range $k := keys $src | sortAlpha }}
+{{- $v := get $src $k }}
+{{- if not (kindIs "invalid" $v) }}
+{{ include "gjallar.tomlKey" $k }} = {{ include "gjallar.tomlValue" $v }}
+{{- end }}
+{{- end }}
+{{- end }}
+{{- end }}
