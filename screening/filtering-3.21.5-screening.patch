+// N2: the static outbound decline never depends on guard readiness. A seed
+// that fails to verify keeps the guard unready; the legacy list must still
+// decline exactly as before. Only list sources wait for a ready guard.
+func TestOutboundStaticDeclinesWhileGuardUnready(t *testing.T) {
+	const static = "0x00000000000000000000000000000000000000cc"
+	const fromList = "0x00000000000000000000000000000000000000dd"
+	g, err := NewGuard(nil, []common.Chain{common.ETHChain})
+	if err != nil {
+		t.Fatal(err)
+	}
+	g.MarkReconciled(true)
+	g.RefuseSeed() // seed refused: the guard stays unready
+	if g.Ready() {
+		t.Fatal("setup: guard must be unready")
+	}
+	o := NewOutboundSet(New(static), g)
+	now := time.Unix(1_700_000_000, 0)
+	o.now = func() time.Time { return now }
+	o.SwapLists([]*ListSnapshot{{
+		FreshUntil: now.Add(time.Hour),
+		chains:     map[common.Chain]bool{common.ETHChain: true},
+		set:        map[string]struct{}{SetKey(common.ETHChain, fromList): {}},
+	}})
+	if !o.Listed(common.ETHChain, static) {
+		t.Fatal("N2: a statically listed destination must be declined while the guard is unready")
+	}
+	if o.Listed(common.ETHChain, fromList) {
+		t.Fatal("a list-source decline must wait for a ready guard")
+	}
+	// Once the seed verifies the list declines too, and a guarded address is
+	// exempt from both.
+	g.seeded.Store(true)
+	if !o.Listed(common.ETHChain, fromList) {
+		t.Fatal("ready guard: the list must decline")
+	}
+	if err := g.AddAddress("seed", common.ETHChain, static); err != nil {
+		t.Fatal(err)
+	}
+	if o.Listed(common.ETHChain, static) {
+		t.Fatal("a guarded address must never be declined")
+	}
+}
