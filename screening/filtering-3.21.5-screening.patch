+// MistTrack: '$chain' in query is evaluated (after chain_map), $threshold
+// decides, and the reason's join() compiles.
+func TestADRMistTrackQueryAndThreshold(t *testing.T) {
+	var gotCoin, gotAddr atomic.Value
+	score := atomic.Int64{}
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		gotCoin.Store(r.URL.Query().Get("coin"))
+		gotAddr.Store(r.URL.Query().Get("address"))
+		_ = json.NewEncoder(w).Encode(map[string]any{"success": true, "data": map[string]any{
+			"score": score.Load(), "risk_level": "Severe", "detail_list": []string{"theft", "mixer"},
+		}})
+	}))
+	defer srv.Close()
+	raw := adrSources(t, "adr_misttrack_example.yaml")[0]
+	raw.URL = srv.URL + "/v3/risk_score"
+	raw.AllowDirectEgress = false // loopback test server
+	known := map[string]common.Chain{}
+	for _, c := range reviewChains {
+		known[c.String()] = c
+	}
+	spec, err := validateSource(raw, known, readFiles(map[string]string{"/secrets/misttrack.key": "mt-key"}), NewEvalSemaphore(0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	q, err := NewQuerySource(spec, QuerySourceOptions{Builder: builder(t, spec), Client: srv.Client()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	addr := "0x00000000000000000000000000000000000000cc"
+	score.Store(95)
+	a := q.Check(context.Background(), common.BSCChain, []ItemDTO{{ThorChain: "BSC", Chain: "BSC", Address: addr, Coins: []CoinDTO{}}})[0]
+	if gotCoin.Load() != "BNB" || gotAddr.Load() != addr {
+		t.Fatalf("query sent coin=%v address=%v, want BNB and the address", gotCoin.Load(), gotAddr.Load())
+	}
+	if a.State != Listed || a.Reason != "Severe: theft, mixer" {
+		t.Fatalf("score 95 >= 91 must be listed with the joined reason: %+v", a)
+	}
+	score.Store(50)
+	a = q.Check(context.Background(), common.ETHChain, []ItemDTO{{ThorChain: "ETH", Chain: "ETH", Address: addr, Coins: []CoinDTO{}}})[0]
+	if a.State != Clean {
+		t.Fatalf("score 50 < 91 must be clean: %+v", a)
+	}
+}
