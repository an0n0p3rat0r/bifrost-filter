+package addressfilter
+
+import (
+	"context"
+	"encoding/hex"
+	"strings"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+)
+
+// SetKey is the comparison key list and guard sets use: the payload-canonical
+// key (EVM accounts share one "EVM" scope across tickers), or the trimmed raw
+// string under its chain when the address doesn't canonicalize.
+func SetKey(chain common.Chain, addr string) string {
+	c := asciiUpper(strings.TrimSpace(chain.String()))
+	a := strings.TrimSpace(addr)
+	kind, key, ok := canonKey(c, a)
+	if !ok {
+		return "raw|" + c + "|" + a
+	}
+	if kind == kindEVM {
+		return "evm|" + hex.EncodeToString(key)
+	}
+	return string('0'+kind) + "|" + c + "|" + hex.EncodeToString(key)
+}
+
+// StaticSource wraps the legacy comma-separated address list as a source. It
+// answers every item (Listed or Clean) and does no I/O.
+type StaticSource struct {
+	name   string
+	filter *Filter
+	chains map[common.Chain]bool
+}
+
+// NewStaticSource parses addresses exactly like New. chains limits coverage
+// (nil = every chain). The source is named "static" (the legacy list).
+func NewStaticSource(addresses string, chains []common.Chain) *StaticSource {
+	return NewNamedStaticSource(StaticSourceName, addresses, chains)
+}
+
+// NewNamedStaticSource is NewStaticSource for a configured static source with
+// its own name and address list.
+func NewNamedStaticSource(name, addresses string, chains []common.Chain) *StaticSource {
+	s := &StaticSource{name: name, filter: New(addresses)}
+	if chains != nil {
+		s.chains = map[common.Chain]bool{}
+		for _, c := range chains {
+			s.chains[c] = true
+		}
+	}
+	return s
+}
+
+// Filter returns the parsed legacy set (shared with the outbound set).
+func (s *StaticSource) Filter() *Filter { return s.filter }
+
+func (s *StaticSource) Name() string { return s.name }
+
+// InMemory marks the source as answering from memory (no external I/O).
+func (s *StaticSource) InMemory() bool { return true }
+
+func (s *StaticSource) Covers(chain common.Chain) bool {
+	return s.chains == nil || s.chains[chain]
+}
+
+func (s *StaticSource) Check(_ context.Context, chain common.Chain, items []ItemDTO) []Answer {
+	out := make([]Answer, len(items))
+	for i, it := range items {
+		if s.filter.Listed(chain, it.Address) {
+			out[i] = Answer{State: Listed, Reason: "static list"}
+		} else {
+			out[i] = Answer{State: Clean}
+		}
+	}
+	return out
+}
diff --git a/bifrost/pkg/addressfilter/staticset.go b/bifrost/pkg/addressfilter/staticset.go
new file mode 100644
index 00000000000..b7c937272fa
--- /dev/null
+++ b/bifrost/pkg/addressfilter/staticset.go
@@ -0,0 +1,132 @@
+package addressfilter
+
+import (
+	"fmt"
+	"strings"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+	"gitlab.com/thorchain/thornode/v3/config"
+)
+
+// StaticSet unions static address lists, each limited to its own chains (nil
+// = every chain). It does no I/O. Build it fully before sharing it: Add is not
+// safe concurrently with Listed.
+type StaticSet struct {
+	entries []staticEntry
+}
+
+type staticEntry struct {
+	filter *Filter
+	chains map[common.Chain]bool // nil = every chain
+}
+
+// NewStaticSet returns an empty set.
+func NewStaticSet() *StaticSet { return &StaticSet{} }
+
+// Add appends f, limited to chains (nil or empty = every chain).
+func (s *StaticSet) Add(f *Filter, chains []common.Chain) {
+	if s == nil || f == nil {
+		return
+	}
+	e := staticEntry{filter: f}
+	if len(chains) > 0 {
+		e.chains = make(map[common.Chain]bool, len(chains))
+		for _, c := range chains {
+			e.chains[c] = true
+		}
+	}
+	s.entries = append(s.entries, e)
+}
+
+// Listed reports whether any entry covering chain lists addr. Nil-safe.
+func (s *StaticSet) Listed(chain common.Chain, addr string) bool {
+	if s == nil {
+		return false
+	}
+	for _, e := range s.entries {
+		if e.chains != nil && !e.chains[chain] {
+			continue
+		}
+		if e.filter.Listed(chain, addr) {
+			return true
+		}
+	}
+	return false
+}
+
+// Len is the number of lists in the set.
+func (s *StaticSet) Len() int {
+	if s == nil {
+		return 0
+	}
+	return len(s.entries)
+}
+
+// Loaded is the total number of entries across the lists.
+func (s *StaticSet) Loaded() int {
+	if s == nil {
+		return 0
+	}
+	n := 0
+	for _, e := range s.entries {
+		n += e.filter.Loaded()
+	}
+	return n
+}
+
+// SalvageStatic returns the named static sources of c that validate on their
+// own, for when the config as a whole fails validation (a typo in an adapter
+// key, a bad combine value, a duplicate source name). The operator's static
+// lists then still apply on the static path, each with its own chains.
+// Sources sharing a name are all kept: for a static list, dropping more is
+// the safe side. A source that doesn't validate (or failed to decode) is in
+// Quarantined, as in Validate.
+func SalvageStatic(c config.BifrostAddressFilterConfiguration, chains []common.Chain, readFile func(string) ([]byte, error)) Validated {
+	v := Validated{Enabled: c.Enabled, Quarantined: map[string]error{}}
+	known := make(map[string]common.Chain, len(chains))
+	for _, ch := range chains {
+		known[ch.String()] = ch
+	}
+	for _, s := range c.Sources {
+		if strings.ToLower(strings.TrimSpace(s.Mode)) != "static" {
+			continue
+		}
+		name := strings.TrimSpace(s.Name)
+		if s.DecodeErr != nil {
+			v.Quarantined[name] = fmt.Errorf("decode: %w", s.DecodeErr)
+			continue
+		}
+		spec, err := validateSource(s, known, readFile, nil)
+		if err != nil {
+			v.Quarantined[name] = err
+			continue
+		}
+		v.Sources = append(v.Sources, spec)
+	}
+	return v
+}
+
+// NamedStaticSet collects the named static sources of v (every static source
+// with its own address list, each limited to its chains). The legacy
+// address_filter.addresses list is NOT included: the caller's legacy filter
+// already applies it on every chain. Nil when there are none.
+//
+// The observer uses it when no screening adapter runs (a static-only config,
+// every list/query source quarantined, or an adapter build failure), so a
+// named static source applies on inbound and outbound either way.
+func NamedStaticSet(v Validated) *StaticSet {
+	if !v.Enabled {
+		return nil
+	}
+	var set *StaticSet
+	for _, spec := range v.Sources {
+		if spec.Mode != "static" || spec.Raw.Addresses == "" {
+			continue // the legacy list is the caller's
+		}
+		if set == nil {
+			set = NewStaticSet()
+		}
+		set.Add(New(spec.Raw.Addresses), spec.Chains)
+	}
+	return set
+}
