@@ -0,0 +1,247 @@
+package addressfilter
+
+import (
+	"sync"
+	"time"
+
+	"github.com/prometheus/client_golang/prometheus"
+)
+
+const metricsNS = "observer"
+const metricsSub = "address_filter"
+
+// Metrics holds the adapter's collectors. Every method is nil-safe so pure
+// package code and tests can run without one. The observer registers
+// Collectors() on its registry (A4).
+type Metrics struct {
+	GuardReady         prometheus.Gauge
+	ConfigInvalid      prometheus.Gauge
+	SourceQuarantined  *prometheus.GaugeVec
+	SkipLedgerRecords  prometheus.Gauge
+	SkipLedgerWriteErr prometheus.Counter
+	SkipLedgerFull     prometheus.Counter
+	// SkipLedgerSenderCap counts skips observed because one sender reached
+	// its share of a chain's ledger records (max_records_per_sender).
+	SkipLedgerSenderCap prometheus.Counter
+	SkipArchived        prometheus.Counter
+	RecheckBacklog      prometheus.Gauge
+	ChainBreakerOpen    *prometheus.GaugeVec
+	BudgetUsed          *prometheus.GaugeVec
+	ListSuspect         *prometheus.GaugeVec
+	// SourceErrors counts non-answers by source and kind (timeout, transport,
+	// status, rate_limited, budget, decode, expr, non_boolean, backoff,
+	// stale_list, breaker, refresh, ...).
+	SourceErrors *prometheus.CounterVec
+	// Skipped counts inbounds actually dropped by screening (counted once,
+	// after the skip record is written).
+	Skipped       *prometheus.CounterVec
+	ScreenSeconds *prometheus.HistogramVec
+	// Exempt counts inbounds deliberately not screened (e.g. pre-attributed XMR).
+	Exempt *prometheus.CounterVec
+}
+
+// NewMetrics builds unregistered collectors.
+func NewMetrics() *Metrics {
+	g := func(name, help string) prometheus.Gauge {
+		return prometheus.NewGauge(prometheus.GaugeOpts{Namespace: metricsNS, Subsystem: metricsSub, Name: name, Help: help})
+	}
+	c := func(name, help string) prometheus.Counter {
+		return prometheus.NewCounter(prometheus.CounterOpts{Namespace: metricsNS, Subsystem: metricsSub, Name: name, Help: help})
+	}
+	gv := func(name, help string, labels ...string) *prometheus.GaugeVec {
+		return prometheus.NewGaugeVec(prometheus.GaugeOpts{Namespace: metricsNS, Subsystem: metricsSub, Name: name, Help: help}, labels)
+	}
+	return &Metrics{
+		GuardReady:         g("guard_ready", "1 once the vault guard has reconciled; until then nothing is skipped and no external request is made"),
+		ConfigInvalid:      g("config_invalid", "1 when the adapter config is invalid and the filter is disabled"),
+		SourceQuarantined:  gv("source_quarantined", "1 for a source disabled by a config error", "source"),
+		SkipLedgerRecords:  g("skip_ledger_records", "pending skip-ledger records"),
+		SkipLedgerWriteErr: c("skip_ledger_write_errors_total", "skip-ledger writes that failed (the item was observed instead)"),
+		SkipLedgerFull:     c("skip_ledger_full_total", "CRITICAL: skips observed because the skip ledger is at max_records"),
+		SkipLedgerSenderCap: c("skip_ledger_sender_cap_total",
+			"skips observed because one sender is at max_records_per_sender (a sender flooding the ledger)"),
+		SkipArchived:     c("skip_ledger_archived_total", "skip records archived unresolved past retention (alert)"),
+		RecheckBacklog:   g("recheck_backlog", "skip records due for a recheck"),
+		ChainBreakerOpen: gv("chain_breaker_open", "1 while a chain is screened by in-memory sources only (screening-time breaker)", "chain"),
+		BudgetUsed:       gv("budget_used", "calls charged today", "credential", "chain"),
+		ListSuspect:      gv("list_suspect", "1 while a list source holds a suspicious shrink", "source"),
+		SourceErrors: prometheus.NewCounterVec(prometheus.CounterOpts{
+			Namespace: metricsNS, Subsystem: metricsSub, Name: "source_errors_total",
+			Help: "screening non-answers (the item was observed) by source and kind",
+		}, []string{"source", "kind"}),
+		Skipped: prometheus.NewCounterVec(prometheus.CounterOpts{
+			Namespace: metricsNS, Subsystem: metricsSub, Name: "skipped_total",
+			Help: "inbound items skipped by screening",
+		}, []string{"chain"}),
+		ScreenSeconds: prometheus.NewHistogramVec(prometheus.HistogramOpts{
+			Namespace: metricsNS, Subsystem: metricsSub, Name: "screen_seconds",
+			Help:    "time spent in the screening stage per TxIn",
+			Buckets: []float64{.001, .01, .05, .1, .25, .5, 1, 2, 3},
+		}, []string{"chain"}),
+		Exempt: prometheus.NewCounterVec(prometheus.CounterOpts{
+			Namespace: metricsNS, Subsystem: metricsSub, Name: "exempt_total",
+			Help: "inbound items exempt from screening",
+		}, []string{"chain", "reason"}),
+	}
+}
+
+// Collectors returns every collector for registration.
+func (m *Metrics) Collectors() []prometheus.Collector {
+	if m == nil {
+		return nil
+	}
+	return []prometheus.Collector{
+		m.GuardReady, m.ConfigInvalid, m.SourceQuarantined, m.SkipLedgerRecords,
+		m.SkipLedgerWriteErr, m.SkipLedgerFull, m.SkipLedgerSenderCap, m.SkipArchived, m.RecheckBacklog,
+		m.ChainBreakerOpen, m.BudgetUsed, m.ListSuspect, m.SourceErrors, m.Skipped, m.ScreenSeconds, m.Exempt,
+	}
+}
+
+func b2f(b bool) float64 {
+	if b {
+		return 1
+	}
+	return 0
+}
+
+func (m *Metrics) setGuardReady(ok bool) {
+	if m != nil {
+		m.GuardReady.Set(b2f(ok))
+	}
+}
+
+func (m *Metrics) setBreaker(chain string, open bool) {
+	if m != nil {
+		m.ChainBreakerOpen.WithLabelValues(chain).Set(b2f(open))
+	}
+}
+
+func (m *Metrics) observeScreen(chain string, d time.Duration) {
+	if m == nil {
+		return
+	}
+	m.ScreenSeconds.WithLabelValues(chain).Observe(d.Seconds())
+}
+
+// CountSkip counts one inbound dropped by screening (after its record).
+func (m *Metrics) CountSkip(chain string) {
+	if m != nil {
+		m.Skipped.WithLabelValues(chain).Inc()
+	}
+}
+
+func (m *Metrics) sourceErrors(source, kind string, n int) {
+	if m != nil && n > 0 {
+		m.SourceErrors.WithLabelValues(source, kind).Add(float64(n))
+	}
+}
+
+// SetConfigInvalid sets the config_invalid gauge.
+func (m *Metrics) SetConfigInvalid(invalid bool) {
+	if m != nil {
+		m.ConfigInvalid.Set(b2f(invalid))
+	}
+}
+
+// SetQuarantined sets source_quarantined for one source.
+func (m *Metrics) SetQuarantined(source string, q bool) {
+	if m != nil {
+		m.SourceQuarantined.WithLabelValues(source).Set(b2f(q))
+	}
+}
+
+func (m *Metrics) setListSuspect(source string, suspect bool) {
+	if m != nil {
+		m.ListSuspect.WithLabelValues(source).Set(b2f(suspect))
+	}
+}
+
+func (m *Metrics) setBudgetUsed(credential, pool string, used uint64) {
+	if m != nil {
+		m.BudgetUsed.WithLabelValues(credential, pool).Set(float64(used))
+	}
+}
+
+func (m *Metrics) ledgerWriteError() {
+	if m != nil {
+		m.SkipLedgerWriteErr.Inc()
+	}
+}
+
+func (m *Metrics) ledgerFull() {
+	if m != nil {
+		m.SkipLedgerFull.Inc()
+	}
+}
+
+func (m *Metrics) ledgerSenderCap() {
+	if m != nil {
+		m.SkipLedgerSenderCap.Inc()
+	}
+}
+
+func (m *Metrics) ledgerRecords(n int) {
+	if m != nil {
+		m.SkipLedgerRecords.Set(float64(n))
+	}
+}
+
+func (m *Metrics) archived() {
+	if m != nil {
+		m.SkipArchived.Inc()
+	}
+}
+
+func (m *Metrics) recheckBacklog(n int) {
+	if m != nil {
+		m.RecheckBacklog.Set(float64(n))
+	}
+}
+
+// WarnLimiter emits at most one warning per (class, source) per interval.
+type WarnLimiter struct {
+	mu       sync.Mutex
+	last     map[string]time.Time
+	interval time.Duration
+	now      func() time.Time
+	sink     func(class, source, msg string)
+}
+
+// NewWarnLimiter returns a limiter (interval 0 = one minute). sink receives the
+// warnings that pass; it must log at warn level and never print secrets.
+func NewWarnLimiter(interval time.Duration, now func() time.Time, sink func(class, source, msg string)) *WarnLimiter {
+	if interval <= 0 {
+		interval = time.Minute
+	}
+	if now == nil {
+		now = time.Now
+	}
+	return &WarnLimiter{last: map[string]time.Time{}, interval: interval, now: now, sink: sink}
+}
+
+// Warn forwards msg unless the same (class, source) warned within the
+// interval. It reports whether the warning was emitted.
+func (w *WarnLimiter) Warn(class, source, msg string) bool {
+	if w == nil || w.sink == nil {
+		return false
+	}
+	k := class + "\x00" + source
+	now := w.now()
+	w.mu.Lock()
+	if t, ok := w.last[k]; ok && now.Sub(t) < w.interval {
+		w.mu.Unlock()
+		return false
+	}
+	w.last[k] = now
+	w.mu.Unlock()
+	w.sink(class, source, msg)
+	return true
+}
+
+// ShortAddr shortens an address for logs (never log a full address at info).
+func ShortAddr(a string) string {
+	if len(a) <= 12 {
+		return a
+	}
+	return a[:6] + "…" + a[len(a)-4:]
+}
diff --git a/bifrost/pkg/addressfilter/outbound.go b/bifrost/pkg/addressfilter/outbound.go
new file mode 100644
index 00000000000..4293d4f128b
--- /dev/null
+++ b/bifrost/pkg/addressfilter/outbound.go
@@ -0,0 +1,76 @@
+package addressfilter
+
+import (
+	"sync/atomic"
+	"time"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+)
+
+// OutboundSet answers the outbound keysign decline synchronously: the static
+// lists plus every fresh list set, minus anything the vault guard contains. It
+// does no I/O. Query sources never feed it.
+//
+// The static lists decline exactly as the legacy static filter does, at all
+// times: they never depend on the guard being ready (a seed that fails to
+// verify must not switch the static decline off). The guard only ever
+// exempts (a guarded address is never declined), and the signer checks the
+// live pubkey manager for vaults and routers before asking this set. List
+// sources decline only once the guard is ready.
+type OutboundSet struct {
+	static *StaticSet
+	guard  GuardView
+	lists  atomic.Pointer[[]*ListSnapshot]
+	now    func() time.Time
+}
+
+// NewOutboundSet builds the set over one static filter that applies on every
+// chain (may be nil) and the guard (may be nil).
+func NewOutboundSet(static *Filter, guard GuardView) *OutboundSet {
+	s := NewStaticSet()
+	s.Add(static, nil)
+	return NewOutboundSetFromStatic(s, guard)
+}
+
+// NewOutboundSetFromStatic builds the set over static lists that each keep
+// their own chains (may be nil) and the guard (may be nil).
+func NewOutboundSetFromStatic(static *StaticSet, guard GuardView) *OutboundSet {
+	o := &OutboundSet{static: static, guard: guard, now: time.Now}
+	empty := []*ListSnapshot{}
+	o.lists.Store(&empty)
+	return o
+}
+
+// SwapLists atomically replaces the list snapshots (called when a list
+// source publishes).
+func (o *OutboundSet) SwapLists(lists []*ListSnapshot) {
+	cp := append([]*ListSnapshot(nil), lists...)
+	o.lists.Store(&cp)
+}
+
+// Listed reports whether an outbound to (chain, addr) should be declined.
+func (o *OutboundSet) Listed(chain common.Chain, addr string) bool {
+	if o == nil {
+		return false
+	}
+	// Exemption only: a guarded address is never declined, in any guard state.
+	if o.guard != nil && o.guard.Contains(chain, addr) {
+		return false
+	}
+	// Static lists: as the legacy filter, independent of guard readiness.
+	if o.static.Listed(chain, addr) {
+		return true
+	}
+	// List sources need a ready guard (proven vault set) before declining.
+	if o.guard == nil || !o.guard.Ready() {
+		return false
+	}
+	key := SetKey(chain, addr)
+	now := o.now()
+	for _, l := range *o.lists.Load() {
+		if l != nil && l.Fresh(now) && l.Covers(chain) && l.has(key) {
+			return true
+		}
+	}
+	return false
+}
diff --git a/bifrost/pkg/addressfilter/providers_test.go b/bifrost/pkg/addressfilter/providers_test.go
new file mode 100644
index 00000000000..18db3472df7
--- /dev/null
+++ b/bifrost/pkg/addressfilter/providers_test.go
@@ -0,0 +1,240 @@
+package addressfilter
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"reflect"
+	"sort"
+	"sync"
+	"testing"
+	"time"
+
+	stypes "gitlab.com/thorchain/thornode/v3/bifrost/thorclient/types"
+	"gitlab.com/thorchain/thornode/v3/common"
+	"gitlab.com/thorchain/thornode/v3/config"
+)
+
+// The adapter's Gjallar query source is the ADR's worked example, loaded verbatim
+// (adrGjallarExample, contextdep_test.go): bearer token, batch, the same body,
+// results_map with per-result expressions, and Gjallar's "unverified" tier as
+// Unknown (never cached as clean). Only the URL is pointed at the test server.
+
+// gjallarFixture is Gjallar's exported request fixture: the body its CheckRequest
+// decoder accepts for this config (shared byte for byte with the Gjallar repo).
+func gjallarFixture(t *testing.T) []map[string]any {
+	t.Helper()
+	b, err := os.ReadFile("testdata/providers/gjallar_check_request.json")
+	if err != nil {
+		t.Fatal(err)
+	}
+	var f struct {
+		Items []map[string]any `json:"items"`
+	}
+	if err := json.Unmarshal(b, &f); err != nil {
+		t.Fatal(err)
+	}
+	return f.Items
+}
+
+// txInFor turns one fixture item back into what bifrost observed.
+func txInFor(t *testing.T, it map[string]any) (*stypes.TxInItem, int64) {
+	t.Helper()
+	ti := &stypes.TxInItem{Sender: it["address"].(string)}
+	if v, ok := it["tx_id"].(string); ok {
+		ti.Tx = v
+	}
+	if v, ok := it["height"].(float64); ok {
+		ti.BlockHeight = int64(v)
+	}
+	var bt int64
+	if v, ok := it["block_time"].(float64); ok {
+		bt = int64(v)
+	}
+	return ti, bt
+}
+
+type captured struct {
+	mu     sync.Mutex
+	bodies [][]byte
+	auth   []string
+}
+
+func gjallarServer(t *testing.T, c *captured, respond func(req map[string]any) any) *httptest.Server {
+	t.Helper()
+	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		b, _ := io.ReadAll(r.Body)
+		c.mu.Lock()
+		c.bodies = append(c.bodies, b)
+		c.auth = append(c.auth, r.Header.Get("Authorization"))
+		c.mu.Unlock()
+		if r.URL.Path != "/v1/check" || r.Method != http.MethodPost {
+			w.WriteHeader(http.StatusNotFound)
+			return
+		}
+		var req map[string]any
+		_ = json.Unmarshal(b, &req)
+		_ = json.NewEncoder(w).Encode(respond(req))
+	}))
+}
+
+func checkFixtureChains(t *testing.T, q *QuerySource, items []map[string]any) map[string][]Answer {
+	t.Helper()
+	byChain := map[string][]ItemDTO{}
+	for _, it := range items {
+		ch := it["chain"].(string)
+		c, err := common.NewChain(ch)
+		if err != nil {
+			t.Fatal(err)
+		}
+		ti, bt := txInFor(t, it)
+		byChain[ch] = append(byChain[ch], NewItemDTO(c, ti, bt))
+	}
+	out := map[string][]Answer{}
+	for ch, dtos := range byChain {
+		c, _ := common.NewChain(ch)
+		out[ch] = q.Check(context.Background(), c, dtos)
+	}
+	return out
+}
+
+func newGjallarQuery(t *testing.T, srv *httptest.Server) *QuerySource {
+	t.Helper()
+	spec := adrGjallarOn(t, srv, false)
+	q, err := NewQuerySource(spec, QuerySourceOptions{Builder: builder(t, spec), Client: srv.Client()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return q
+}
+
+// A6.1 (Gjallar half): the request the adapter generates for the example config is,
+// item for item, Gjallar's exported request fixture: same fields, nulls for unknowns,
+// the THORChain ticker as chain.
+func TestGjallarContractRequestIsTheFixture(t *testing.T) {
+	want := gjallarFixture(t)
+	c := &captured{}
+	srv := gjallarServer(t, c, func(map[string]any) any { return map[string]any{"results": []any{}} })
+	defer srv.Close()
+	checkFixtureChains(t, newGjallarQuery(t, srv), want)
+
+	var got []map[string]any
+	for i, b := range c.bodies {
+		var req struct {
+			Items []map[string]any `json:"items"`
+		}
+		if err := json.Unmarshal(b, &req); err != nil {
+			t.Fatalf("request %d is not JSON: %s", i, b)
+		}
+		if c.auth[i] != "Bearer adapter-token" {
+			t.Fatalf("request %d auth %q", i, c.auth[i])
+		}
+		got = append(got, req.Items...)
+	}
+	key := func(m map[string]any) string { return m["chain"].(string) + "|" + m["address"].(string) }
+	sort.Slice(got, func(i, j int) bool { return key(got[i]) < key(got[j]) })
+	sort.Slice(want, func(i, j int) bool { return key(want[i]) < key(want[j]) })
+	if !reflect.DeepEqual(got, want) {
+		gb, _ := json.Marshal(got)
+		wb, _ := json.Marshal(want)
+		t.Fatalf("generated request differs from Gjallar's fixture\n got: %s\nwant: %s", gb, wb)
+	}
+}
+
+// A6.1 (Gjallar half), end to end: Gjallar's node-scope answers for the fixture
+// (listed own entry, whitelisted router, unverified with retry_after_ms, invalid) map
+// to Listed / Clean / Unknown with retry / Clean.
+func TestGjallarContractAnswersEndToEnd(t *testing.T) {
+	c := &captured{}
+	srv := gjallarServer(t, c, func(req map[string]any) any {
+		var res []any
+		for _, x := range req["items"].([]any) {
+			it := x.(map[string]any)
+			r := map[string]any{"chain": it["chain"], "address": it["address"], "listed": false}
+			switch it["address"] {
+			case "0x0000000000000000000000000000000000000002":
+				r["listed"], r["tier"], r["sources"] = true, "own", []any{"sdn"}
+			case "0x000000000000000000000000000000000000dEaD":
+				r["tier"] = "whitelist"
+			case "0x0000000000000000000000000000000000000003":
+				r["tier"], r["reason"], r["retry_after_ms"] = "unverified", "vendor_down", 3000
+			case "not-an-address":
+				r["tier"], r["reason"] = "invalid", "malformed"
+			default:
+				r["tier"] = "vendor"
+			}
+			res = append(res, r)
+		}
+		return map[string]any{"list_version": "v-contract", "results": res}
+	})
+	defer srv.Close()
+	items := gjallarFixture(t)
+	got := checkFixtureChains(t, newGjallarQuery(t, srv), items)
+
+	byAddr := map[string]Answer{}
+	for ch, answers := range got {
+		i := 0
+		for _, it := range items {
+			if it["chain"] == ch {
+				byAddr[it["address"].(string)] = answers[i]
+				i++
+			}
+		}
+	}
+	if a := byAddr["0x0000000000000000000000000000000000000002"]; a.State != Listed || a.Reason != "own:" {
+		t.Fatalf("own hit: %+v", a)
+	}
+	if a := byAddr["0x000000000000000000000000000000000000dEaD"]; a.State != Clean {
+		t.Fatalf("router: %+v", a)
+	}
+	if a := byAddr["0x0000000000000000000000000000000000000003"]; a.State != Unknown || a.RetryAfter != 3*time.Second {
+		t.Fatalf("unverified must be Unknown with retry: %+v", a)
+	}
+	if a := byAddr["not-an-address"]; a.State != Clean || a.Reason != "invalid:malformed" {
+		t.Fatalf("invalid: %+v", a)
+	}
+	if a := byAddr["bc1qj08ys4ct2hzzc2hcz6h2hgrvlmsjynawlht528"]; a.State != Clean {
+		t.Fatalf("btc vendor clean: %+v", a)
+	}
+	if len(c.bodies) != 2 {
+		t.Fatalf("one batch per chain, got %d requests", len(c.bodies))
+	}
+}
+
+// $thor_chain is the THORChain ticker; $chain is the source's own name for the chain
+// after chain_map, in per-item and batch requests alike.
+func TestChainVarsAreTickerAndProviderName(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		b, _ := io.ReadAll(r.Body)
+		_, _ = w.Write(b) // echo the request body as the response
+	}))
+	defer srv.Close()
+	for _, batch := range []int{1, 10} {
+		raw := config.BifrostAddressFilterSource{
+			Name: "q", Mode: "query", Chains: []string{"ETH"}, Method: "POST",
+			URL: srv.URL + "/check", Batch: batch, ChainMap: map[string]string{"ETH": "ethereum"},
+			Listed: `$thor_chain == "ETH" and $chain == "ethereum" and .chain == "ethereum"`,
+		}
+		if batch == 1 {
+			raw.Body = `{chain: $chain, thor_chain: $thor_chain, address: $address}`
+		} else {
+			raw.Body = `{results: [$items[] | {chain, thor_chain, address}]}`
+			raw.ResultsMap = `.results`
+		}
+		spec := querySpec(t, raw, nil)
+		q, err := NewQuerySource(spec, QuerySourceOptions{Builder: builder(t, spec), Client: srv.Client()})
+		if err != nil {
+			t.Fatal(err)
+		}
+		dto := NewItemDTO(common.ETHChain, &stypes.TxInItem{Sender: "0x0000000000000000000000000000000000000009"}, 0)
+		if a := q.Check(context.Background(), common.ETHChain, []ItemDTO{dto})[0]; a.State != Listed {
+			t.Fatalf("batch %d: %+v", batch, a)
+		}
+		if dto.Chain != "ETH" {
+			t.Fatalf("the adapter's DTO keeps the ticker: %q", dto.Chain)
+		}
+	}
+}
