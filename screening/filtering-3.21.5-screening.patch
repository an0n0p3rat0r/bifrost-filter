+	require.NoError(t, err)
+	require.Equal(t, []string{keys[1]}, due, "only tx1 is due; tx0 moved to +1h, tx2 archived")
+	due, err = re.Due(t0.Add(2*time.Hour), 0)
+	require.NoError(t, err)
+	require.Equal(t, []string{keys[1], keys[0]}, due, "oldest next_check first")
