+func (s *ObserveExtraSuite) TestFilterObservationsAddressFilter(c *C) {
+	vault := stypes.GetRandomPubKey()
+	btcVaultAddr, err := vault.GetAddress(common.BTCChain)
+	c.Assert(err, IsNil)
+	ethVaultAddr, err := vault.GetAddress(common.ETHChain)
+	c.Assert(err, IsNil)
+
+	cache, err := lru.New(100)
+	c.Assert(err, IsNil)
+	pkm, err := pubkeymanager.NewPubKeyManager(nil, nil)
+	c.Assert(err, IsNil)
+	pkm.AddPubKey(vault, false, common.SigningAlgoSecp256k1)
+
+	// Entries taken from a published sanctioned address list.
+	const (
+		listedBTC   = "bc1qjwdw6vrzq4vf6hckutvx4ucj86awwv99mxnz7w"
+		listedETH   = "0x007f2ca1d485ccCDF625C837FAC45b1B13107941"
+		cleanSender = "1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa"
+	)
+	inbound := func(tx, sender, to string) *types.TxInItem {
+		return &types.TxInItem{Tx: tx, Sender: sender, To: to, Memo: "SWAP:BTC.BTC"}
+	}
+
+	o := &Observer{
+		logger:           log.Logger,
+		pubkeyMgr:        pkm,
+		signedTxOutCache: cache,
+		addressFilter:    addressfilter.New(listedBTC + "," + listedETH),
+	}
+
+	// listed BTC sender -> dropped
+	result := o.filterObservations(common.BTCChain, []*types.TxInItem{inbound("tx1", listedBTC, btcVaultAddr.String())}, false)
+	c.Assert(result, HasLen, 0)
+
+	// non-listed sender -> observed
+	result = o.filterObservations(common.BTCChain, []*types.TxInItem{inbound("tx2", cleanSender, btcVaultAddr.String())}, false)
+	c.Assert(result, HasLen, 1)
+
+	// listed 0x sender -> dropped on EVM, case-insensitively
+	result = o.filterObservations(common.ETHChain, []*types.TxInItem{inbound("tx3", strings.ToLower(listedETH), ethVaultAddr.String())}, false)
+	c.Assert(result, HasLen, 0)
+
+	// the 0x entry does not leak onto non-EVM chains
+	result = o.filterObservations(common.BTCChain, []*types.TxInItem{inbound("tx4", listedETH, btcVaultAddr.String())}, false)
+	c.Assert(result, HasLen, 1)
+
+	// nil filter (feature disabled) -> same listed sender observed
+	oDisabled := &Observer{
+		logger:           log.Logger,
+		pubkeyMgr:        pkm,
+		signedTxOutCache: cache,
+	}
+	result = oDisabled.filterObservations(common.BTCChain, []*types.TxInItem{inbound("tx5", listedBTC, btcVaultAddr.String())}, false)
+	c.Assert(result, HasLen, 1)
+}
