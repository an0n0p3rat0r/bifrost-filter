+func TestBudgetFloorSharesRetriesAndStoreFailure(t *testing.T) {
+	store := NewMemBudgetStore()
+	clk := &clock{t: time.Date(2026, 11, 20, 12, 0, 0, 0, time.UTC)}
+	b, err := NewBudget(BudgetConfig{
+		Credential: "k", Daily: 100, ChainShare: map[string]int{"bsc": 10, "btc": 50},
+		HighValuePct: 10, MinValue: map[string]string{"BSC": "1000"}, FreshAbove: map[string]string{"BSC": "500000"},
+		Now: clk.now,
+	}, store)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 1000; i++ {
+		if _, ok, why := b.Reserve(common.BSCChain, "999"); ok || why != BudgetBelowFloor {
+			t.Fatalf("dust must be refused with no call: %v %s", ok, why)
+		}
+	}
+	// general = 100 - 10 reserve - 10 recovery = 80; BSC share 10% = 8 calls.
+	n := 0
+	for {
+		tk, ok, _ := b.Reserve(common.BSCChain, "2000")
+		if !ok {
+			break
+		}
+		tk.Dispatched()
+		n++
+	}
+	if n != 8 {
+		t.Fatalf("BSC share allowed %d calls, want 8", n)
+	}
+	if _, ok, _ := b.Reserve(common.BTCChain, "1"); !ok {
+		t.Fatal("BTC must still have budget after BSC ran out")
+	}
+	if tk, ok, _ := b.Reserve(common.BSCChain, "600000"); !ok || tk.pool != poolReserve {
+		t.Fatal("a high-value BSC item must use the reserve")
+	}
+	tk, ok, _ := b.Reserve(common.BTCChain, "1")
+	if !ok {
+		t.Fatal("reserve BTC")
+	}
+	tk.Dispatched()
+	if ok, _ := tk.Retry(); !ok {
+		t.Fatal("retry")
+	}
+	day := "2026-11-20"
+	if used, _ := store.Used("k", "BTC", day); used != 3 {
+		t.Fatalf("BTC charged %d, want 3 (1 + 1 + retry)", used)
+	}
+	store.Fail = errors.New("disk")
+	if _, ok, why := b.Reserve(common.BTCChain, "1"); ok || why != BudgetStoreError {
+		t.Fatalf("store error must mean no call: %v %s", ok, why)
+	}
