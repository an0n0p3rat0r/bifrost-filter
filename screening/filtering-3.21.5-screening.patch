+// NEW-3: after an upgrade lowers the per-chain cap, a chain already over it
+// keeps every record (still readable and updatable) and records nothing new
+// until it drains; other chains are unaffected.
+func TestUpgradeOverCapKeepsRecords(t *testing.T) {
+	store := NewMemLedgerStore()
+	old := NewSkipLedger(store, 1000, nil, nil)
+	old.SetChainCap(500)
+	old.SetSenderCap(500)
+	var first *SkipEnvelope
+	for i := 0; i < 10; i++ {
+		e := r3Envelope(t, "ETH", fmt.Sprintf("u%d", i), fmt.Sprintf("0x%02d", i))
+		if i == 0 {
+			first = e
+		}
+		if err := old.Record(e); err != nil {
+			t.Fatal(err)
+		}
+	}
+	l := NewSkipLedger(store, 1000, nil, nil)
+	l.SetChainCap(5)
+	over := l.OverCap([]string{"ETH", "BTC"})
+	if over["ETH"] != 10 || len(over) != 1 {
+		t.Fatalf("OverCap: %v", over)
+	}
+	if err := l.Record(r3Envelope(t, "ETH", "new", "0xff")); !errors.Is(err, ErrLedgerFull) {
+		t.Fatalf("a chain over its cap records nothing new: %v", err)
+	}
+	if n, _ := store.Count(); n != 10 {
+		t.Fatalf("records kept: %d", n)
+	}
+	if err := l.Record(first); err != nil {
+		t.Fatalf("an existing record is still updatable: %v", err)
+	}
+	if _, ok, err := l.Get(first.Key()); !ok || err != nil {
+		t.Fatalf("existing record readable: %v %v", ok, err)
+	}
+	if err := l.Record(r3Envelope(t, "BTC", "b", "bc1q")); err != nil {
+		t.Fatalf("other chains unaffected: %v", err)
+	}
+}
