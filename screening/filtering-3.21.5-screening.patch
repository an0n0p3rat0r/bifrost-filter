+// r3Server answers like Gjallar (one result per item, in order): listed when
+// the item's tx_id is in listedTx, else unverified. It records the request
+// count and the largest number of items one sender had in one request.
+type r3Server struct {
+	srv         *httptest.Server
+	mu          sync.Mutex
+	requests    int
+	maxPerAddr  int
+	itemsSeen   int
+	listedTx    map[string]bool
+	sawTxInReqs map[string]int
+}
+
+func newR3Server(t *testing.T, listedTx map[string]bool) *r3Server {
+	t.Helper()
+	s := &r3Server{listedTx: listedTx, sawTxInReqs: map[string]int{}}
+	s.srv = httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		b, _ := io.ReadAll(r.Body)
+		var req struct {
+			Items []map[string]any `json:"items"`
+		}
+		_ = json.Unmarshal(b, &req)
+		perAddr := map[string]int{}
+		res := make([]any, 0, len(req.Items))
+		s.mu.Lock()
+		s.requests++
+		for _, it := range req.Items {
+			a, _ := it["address"].(string)
+			tx, _ := it["tx_id"].(string)
+			perAddr[a]++
+			s.itemsSeen++
+			s.sawTxInReqs[tx]++
+			m := map[string]any{"chain": it["chain"], "address": a, "listed": false, "tier": "unverified", "reason": "vendor_down"}
+			if s.listedTx[tx] {
+				m["listed"], m["tier"] = true, "own"
+				delete(m, "reason")
+			}
+			res = append(res, m)
+		}
+		for _, n := range perAddr {
+			if n > s.maxPerAddr {
+				s.maxPerAddr = n
+			}
+		}
+		s.mu.Unlock()
+		_ = json.NewEncoder(w).Encode(map[string]any{"results": res})
+	}))
+	t.Cleanup(s.srv.Close)
+	return s
+}
+
+func r3Query(t *testing.T, s *r3Server, budget *Budget) *QuerySource {
+	t.Helper()
+	spec := adrGjallarOn(t, s.srv, false)
+	q, err := NewQuerySource(spec, QuerySourceOptions{Builder: builder(t, spec), Client: s.srv.Client(), Budget: budget})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return q
+}
