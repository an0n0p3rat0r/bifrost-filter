+	vaultBTC := mustAddr(t, pk, common.BTCChain)
+	other := mustAddr(t, ttypes.GetRandomPubKey(), common.BTCChain)
+	const listed = "bc1qjwdw6vrzq4vf6hckutvx4ucj86awwv99mxnz7w"
