+package observer
+
+import (
+	"crypto/sha256"
+	"encoding/hex"
+	"os"
+	"sync"
+	"sync/atomic"
+	"testing"
+
+	lru "github.com/hashicorp/golang-lru"
+	"github.com/rs/zerolog/log"
+	"github.com/stretchr/testify/require"
+
+	"gitlab.com/thorchain/thornode/v3/bifrost/pkg/addressfilter"
+	"gitlab.com/thorchain/thornode/v3/bifrost/pkg/chainclients"
+	"gitlab.com/thorchain/thornode/v3/bifrost/pubkeymanager"
+	"gitlab.com/thorchain/thornode/v3/bifrost/thorclient/types"
+	"gitlab.com/thorchain/thornode/v3/common"
+	"gitlab.com/thorchain/thornode/v3/common/cosmos"
+	"gitlab.com/thorchain/thornode/v3/config"
+	stypes "gitlab.com/thorchain/thornode/v3/x/thorchain/types"
+)
+
+// Round-2 review fixes (re-review of a18932b859e). Each test fails without
+// its fix.
+
+// newNamedStaticObserver is an observer with one BTC vault, no adapter, and
+// the chains named static sources may name.
+func newNamedStaticObserver(t *testing.T) (*Observer, string) {
+	t.Helper()
+	o, _ := newErrataOrderingObserver(t)
+	vault := stypes.GetRandomPubKey()
+	vaultAddr, err := vault.GetAddress(common.BTCChain)
+	require.NoError(t, err)
+	pkm, err := pubkeymanager.NewPubKeyManager(nil, nil)
+	require.NoError(t, err)
+	pkm.AddPubKey(vault, false, common.SigningAlgoSecp256k1)
+	cache, err := lru.New(100)
+	require.NoError(t, err)
+	o.logger = log.Logger
+	o.pubkeyMgr, o.signedTxOutCache, o.wg = pkm, cache, &sync.WaitGroup{}
+	o.chains = map[common.Chain]chainclients.ChainClient{common.BTCChain: nil, common.ETHChain: nil, common.BSCChain: nil}
+	return o, vaultAddr.String()
+}
+
+func btcSwapFrom(tx, sender, to string) *types.TxInItem {
+	return &types.TxInItem{Tx: tx, Sender: sender, To: to, Memo: "SWAP:ETH.ETH", BlockHeight: 100,
+		Coins: common.NewCoins(common.NewCoin(common.BTCAsset, cosmos.NewUint(5)))}
+}
+
+// N1: a named static source applies on inbound and outbound with no adapter
+// (a static-only config, and next to a quarantined query source).
+func TestNamedStaticSourceAppliesWithoutAdapter(t *testing.T) {
+	named := config.BifrostAddressFilterSource{Name: "ofac", Mode: "static", Addresses: reviewListed}
+	for _, tc := range []struct {
+		name   string
+		cfg    config.BifrostAddressFilterConfiguration
+		reason string
+	}{
+		{"static_only", config.BifrostAddressFilterConfiguration{Enabled: true, FilterOutbound: true,
+			Sources: []config.BifrostAddressFilterSource{named}}, "static_only"},
+		{"next_to_quarantined_query", config.BifrostAddressFilterConfiguration{Enabled: true, FilterOutbound: true,
+			Sources: []config.BifrostAddressFilterSource{named, {Name: "broken", Mode: "query", Chains: []string{"BTC"}}}}, "invalid"},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			o, vaultAddr := newNamedStaticObserver(t)
+			require.Nil(t, o.newAddressFilterAdapter(tc.cfg, t.TempDir()))
+			require.Equal(t, tc.reason, o.afDisabled)
+			got := o.filterObservations(common.BTCChain, []*types.TxInItem{btcSwapFrom("n1", reviewListed, vaultAddr)}, false)
+			require.Empty(t, got, "inbound from a sender the named static source lists must be dropped")
+			got = o.filterObservations(common.BTCChain, []*types.TxInItem{btcSwapFrom("n2", "1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa", vaultAddr)}, false)
+			require.Len(t, got, 1, "an unlisted sender is observed")
+			out := o.AddressFilterOutboundSet()
+			require.NotNil(t, out, "the signer needs the named static source on outbound")
+			require.True(t, out.Listed(common.BTCChain, reviewListed))
+		})
+	}
+}
+
+// N1: a named static source keeps its chains on the no-adapter path, inbound
+// and outbound; the legacy list still applies on every chain.
+func TestNamedStaticSourceKeepsItsChains(t *testing.T) {
+	const evmListed = "0x00000000000000000000000000000000000000bb"
+	const legacyEVM = "0x00000000000000000000000000000000000000ee"
+	o, _ := newNamedStaticObserver(t)
+	cfg := config.BifrostAddressFilterConfiguration{Enabled: true, FilterOutbound: true, Addresses: legacyEVM,
+		Sources: []config.BifrostAddressFilterSource{{Name: "ofac", Mode: "static", Chains: []string{"ETH"}, Addresses: evmListed}}}
+	o.addressFilter = addressfilter.New(cfg.Addresses)
+	require.Nil(t, o.newAddressFilterAdapter(cfg, t.TempDir()))
+	require.True(t, o.afNamedStatic.Listed(common.ETHChain, evmListed))
+	require.False(t, o.afNamedStatic.Listed(common.BSCChain, evmListed), "an ETH-only source must not list on BSC")
+	out := o.AddressFilterOutboundSet()
+	require.NotNil(t, out)
+	require.True(t, out.Listed(common.ETHChain, evmListed))
+	require.False(t, out.Listed(common.BSCChain, evmListed), "outbound respects the named source's chains")
+	require.True(t, out.Listed(common.BSCChain, legacyEVM), "the legacy list declines on every chain")
+}
+
+// N1: the drain keeps a record whose sender only a named static source lists.
+func TestDrainKeepsRecordNamedStaticLists(t *testing.T) {
+	var deckLocked atomic.Bool
+	src := &fakeListSource{listed: reviewListed, deckLocked: &deckLocked}
+	o, vaultAddr := newScreeningObserver(t, 0, src)
+	require.NoError(t, o.processObservedTx(types.TxIn{Chain: common.BTCChain,
+		TxArray: []*types.TxInItem{btcSwapFrom("nd01", reviewListed, vaultAddr)}}))
+	o.stopAddressFilter()
+	count := func() int {
+		n, err := addressfilter.NewSkipLedger(o.storage, 0, nil, nil).Count()
+		require.NoError(t, err)
+		return n
+	}
+	require.Equal(t, 1, count())
+	o.chains = map[common.Chain]chainclients.ChainClient{common.BTCChain: nil}
+	o.addressFilter = nil // no legacy list
+	cfg := config.BifrostAddressFilterConfiguration{Enabled: true, ReplayEnabled: true,
+		Sources: []config.BifrostAddressFilterSource{{Name: "ofac", Mode: "static", Addresses: reviewListed}}}
+	o.afAdapter = o.newAddressFilterAdapter(cfg, t.TempDir())
+	require.Equal(t, "static_only", o.afDisabled)
+	o.drainSkipLedger(cfg)
+	require.Equal(t, 1, count(), "a sender a named static source lists stays recorded")
+	require.Empty(t, deckJSON(t, o))
+}
+
+// N2: a refused seed is retried on the reconcile tick; once it verifies the
+// guard becomes ready.
+func TestRefusedSeedRetriedOnReconcile(t *testing.T) {
+	o, _ := newUnreadyAdapterObserver(t)
+	o.afVaultsLoaded = func() bool { return true }
+	// A vault address with its pubkey (round 3, NEW-6), never a listed one.
+	seedPK := stypes.GetRandomPubKey()
+	seedAddr, err := seedPK.GetAddress(common.BTCChain)
+	require.NoError(t, err)
+	seed := []byte(`{"version":1,"built_at_height":1,"entries":[{"pubkey":"` + seedPK.String() + `","chain":"BTC","address":"` + seedAddr.String() + `"}]}`)
+	dir := t.TempDir()
+	p := dir + "/seed.json"
+	sum := sha256Hex(seed)
+	o.afSeedPath, o.afSeedSHA256 = p, sum
+	o.loadAddressFilterSeed(o.afAdapter) // file missing: refused
+	o.reconcileAddressFilterGuard()
+	require.False(t, o.afAdapter.Guard.Ready(), "a refused seed keeps the guard unready")
+	writeFile(t, p, seed)
+	o.reconcileAddressFilterGuard()
+	require.True(t, o.afAdapter.Guard.Ready(), "the seed is retried on reconcile and verifies")
+	require.True(t, o.afAdapter.Guard.Contains(common.BTCChain, seedAddr.String()))
+}
+
+func sha256Hex(b []byte) string {
+	s := sha256.Sum256(b)
+	return hex.EncodeToString(s[:])
+}
+
+func writeFile(t *testing.T, p string, b []byte) {
+	t.Helper()
+	require.NoError(t, os.WriteFile(p, b, 0o600))
+}
