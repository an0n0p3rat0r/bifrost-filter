+		{"typed_router", `{"kind":"router","pubkey":"","chain":"ETH","address":"0x00000000000000000000000000000000000000cc"}`, true},
+		{"arbitrary_address", `{"pubkey":"","chain":"BTC","address":"` + listed + `"}`, false},
+		{"address_not_from_pubkey", `{"pubkey":"` + pk.String() + `","chain":"BTC","address":"` + other + `"}`, false},
+		{"router_with_pubkey", `{"kind":"router","pubkey":"` + pk.String() + `","chain":"BTC","address":"` + listed + `"}`, false},
+		{"unknown_kind", `{"kind":"module","pubkey":"","chain":"BTC","address":"` + listed + `"}`, false},
