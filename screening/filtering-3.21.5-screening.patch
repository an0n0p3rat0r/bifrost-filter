new file mode 100644
index 00000000000..3692c3be156
--- /dev/null
+++ b/cmd/bifrost/addressfilter.go
@@ -0,0 +1,166 @@
+package main
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"io"
+	"os"
+	"sort"
+	"time"
+
+	flag "github.com/spf13/pflag"
+
+	"gitlab.com/thorchain/thornode/v3/bifrost/observer"
+	"gitlab.com/thorchain/thornode/v3/bifrost/pkg/addressfilter"
+	tcommon "gitlab.com/thorchain/thornode/v3/common"
+	"gitlab.com/thorchain/thornode/v3/config"
+)
+
+// addressFilterCmd is the first argument that selects the operator CLI:
+//
+//	bifrost address-filter validate
+//	bifrost address-filter dry-run --source <name> --chain <C> --address <A> [--raw]
+//	bifrost address-filter list-ack <source> [--ack-dir <dir>]
+const addressFilterCmd = "address-filter"
+
+func loadBifrostConfig() config.BifrostAddressFilterConfiguration {
+	config.Init()
+	config.InitBifrost()
+	return config.GetBifrost().AddressFilter
+}
+
+// defaultAckDir is the running observer's list-ack marker directory.
+func defaultAckDir() string {
+	chains := config.GetBifrost().GetChains()
+	if c, ok := chains[tcommon.BTCChain]; ok && c.BlockScanner.DBPath != "" {
+		return observer.AddressFilterAckDir(c.BlockScanner.DBPath)
+	}
+	return ""
+}
+
+func allChains() []tcommon.Chain {
+	out := make([]tcommon.Chain, 0, len(tcommon.AllChains))
+	out = append(out, tcommon.AllChains[:]...)
+	return out
+}
+
+// runAddressFilter runs the operator CLI and returns the process exit code.
+// Nothing it prints contains a secret value.
+func runAddressFilter(args []string, out io.Writer, load func() config.BifrostAddressFilterConfiguration) int {
+	usage := func() int {
+		fmt.Fprintln(out, "usage: bifrost address-filter validate | dry-run --source <name> --chain <CHAIN> --address <ADDR> [--raw] | list-ack <source> [--ack-dir <dir>]")
+		return 2
+	}
+	if len(args) == 0 {
+		return usage()
+	}
+	switch args[0] {
+	case "validate":
+		v, err := addressfilter.Validate(load(), allChains(), os.ReadFile)
+		if err != nil {
+			fmt.Fprintf(out, "INVALID (filter disabled): %v\n", err)
+			return 1
+		}
+		names := make([]string, 0, len(v.Quarantined))
+		for n := range v.Quarantined {
+			names = append(names, n)
+		}
+		sort.Strings(names)
+		for _, n := range names {
+			fmt.Fprintf(out, "QUARANTINED %s: %v\n", n, v.Quarantined[n])
+		}
+		for _, s := range v.Sources {
+			fmt.Fprintf(out, "ok %s (%s, %d chains, timeout %s)\n", s.Name, s.Mode, len(s.Chains), s.Timeout)
+		}
+		if len(names) > 0 {
+			return 1
+		}
+		fmt.Fprintf(out, "OK: %d sources, combine %s, enabled %v\n", len(v.Sources), v.Combine, v.Enabled)
+		return 0
+	case "dry-run":
+		fs := flag.NewFlagSet("dry-run", flag.ContinueOnError)
+		fs.SetOutput(out)
+		source := fs.String("source", "", "source name")
+		chain := fs.String("chain", "", "chain ticker")
+		address := fs.String("address", "", "address to screen")
+		raw := fs.Bool("raw", false, "include the scrubbed response body")
+		if err := fs.Parse(args[1:]); err != nil || *source == "" || *chain == "" || *address == "" {
+			return usage()
+		}
+		ch, err := tcommon.NewChain(*chain)
+		if err != nil {
+			fmt.Fprintf(out, "bad chain %q\n", *chain)
+			return 2
+		}
+		v, err := addressfilter.Validate(load(), allChains(), os.ReadFile)
+		if err != nil {
+			fmt.Fprintf(out, "INVALID (filter disabled): %v\n", err)
+			return 1
+		}
+		if q, ok := v.Quarantined[*source]; ok {
+			fmt.Fprintf(out, "QUARANTINED %s: %v\n", *source, q)
+			return 1
+		}
+		for _, s := range v.Sources {
+			if s.Name != *source {
+				continue
+			}
+			ctx, cancel := context.WithTimeout(context.Background(), addressfilter.MaxScreenDeadline+s.Timeout)
+			defer cancel()
+			rep := addressfilter.DryRun(ctx, s, nil, ch, *address, *raw, time.Now())
+			b, _ := json.MarshalIndent(rep, "", "  ")
+			fmt.Fprintln(out, string(b))
+			if rep.Error != "" {
+				return 1
+			}
+			return 0
+		}
+		fmt.Fprintf(out, "no source %q\n", *source)
+		return 1
+	case "list-ack":
+		fs := flag.NewFlagSet("list-ack", flag.ContinueOnError)
+		fs.SetOutput(out)
+		ackDir := fs.String("ack-dir", "", "list-ack marker directory (default: next to the observer database)")
+		if err := fs.Parse(args[1:]); err != nil || fs.NArg() != 1 {
+			return usage()
+		}
+		source := fs.Arg(0)
+		cfg := load()
+		known := false
+		for _, s := range cfg.Sources {
+			if s.Name == source && s.Mode == "list" {
+				known = true
+			}
+		}
+		if !known {
+			fmt.Fprintf(out, "no list source %q in the config\n", source)
+			return 1
+		}
+		dir := *ackDir
+		if dir == "" {
+			dir = defaultAckDir()
+		}
+		if dir == "" {
+			fmt.Fprintln(out, "cannot derive the ack directory; pass --ack-dir")
+			return 1
+		}
+		p, err := addressfilter.AckMarkerPath(dir, source)
+		if err != nil {
+			fmt.Fprintln(out, err)
+			return 1
+		}
+		if err := os.MkdirAll(dir, 0o700); err != nil {
+			fmt.Fprintf(out, "create %s: %v\n", dir, err)
+			return 1
+		}
+		if err := os.WriteFile(p, []byte(time.Now().UTC().Format(time.RFC3339)+"\n"), 0o600); err != nil {
+			fmt.Fprintf(out, "write %s: %v\n", p, err)
+			return 1
+		}
+		fmt.Fprintf(out, "list-ack queued for %s; the running bifrost publishes the held list within %s\n", source, addressfilter.AckPollInterval)
+		return 0
+	default:
+		return usage()
+	}
+}
