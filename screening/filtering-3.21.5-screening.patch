+// Finding 10: a recorded skip whose sender is now guarded is released (and
+// the sender is never sent to a source).
+func TestRecheckReleasesGuardedSender(t *testing.T) {
+	f := newRecheckFixture(t)
+	f.record(t, "bc1qlatevault", "tx1")
+	f.g.add(common.BTCChain, "bc1qlatevault")
+	src := &fnSource{name: "gj", answer: func(context.Context, ItemDTO) Answer { return Answer{State: Listed} }}
+	var released atomic.Int64
+	r := NewRechecker(RecheckerOptions{Ledger: f.l, Sources: []Source{src}, Guard: f.g, Now: f.clk.now,
+		OnRelease: func(*SkipEnvelope) error { released.Add(1); return nil }})
+	r.Tick(context.Background())
+	if released.Load() != 1 {
+		t.Fatal("a guarded sender's skip must be released (replayed)")
+	}
+	if src.calls.Load() != 0 {
+		t.Fatal("a guarded sender must not be sent to a source")
+	}
+}
