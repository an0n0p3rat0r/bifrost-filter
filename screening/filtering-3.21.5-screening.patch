+// Finding 11: a list server that drips its body can't stall a refresh past
+// the source timeout.
+func TestListRefreshTimesOut(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(200)
+		fl, _ := w.(http.Flusher)
+		for i := 0; i < 100; i++ {
+			if _, err := w.Write([]byte(" ")); err != nil {
+				return
+			}
+			if fl != nil {
+				fl.Flush()
+			}
+			select {
+			case <-r.Context().Done():
+				return
+			case <-time.After(100 * time.Millisecond):
+			}
+		}
+	}))
+	defer srv.Close()
+	clk := &clock{t: time.Unix(1_800_000_000, 0)}
+	l := newList(t, srv, clk, func(r *config.BifrostAddressFilterSource) { r.FetchTimeout = 200 * time.Millisecond })
+	start := time.Now()
+	err := l.RefreshOnce(context.Background())
+	if err == nil || time.Since(start) > 2*time.Second {
+		t.Fatalf("refresh err=%v after %v; want a timeout within ~200ms", err, time.Since(start))
+	}
+}
