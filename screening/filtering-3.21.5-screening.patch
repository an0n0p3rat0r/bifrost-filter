diff --git a/config/addressfilter_decode.go b/config/addressfilter_decode.go
new file mode 100644
index 00000000000..a5e52e880c9
--- /dev/null
+++ b/config/addressfilter_decode.go
@@ -0,0 +1,249 @@
+package config
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"reflect"
+	"strings"
+
+	"github.com/mitchellh/mapstructure"
+	"github.com/spf13/viper"
+	"gopkg.in/yaml.v3"
+)
+
+// configDecodeHook is the decode option of the global config unmarshal:
+// viper's default hooks plus addressFilterDecodeHook.
+func configDecodeHook() viper.DecoderConfigOption {
+	return viper.DecodeHook(mapstructure.ComposeDecodeHookFunc(
+		addressFilterDecodeHook,
+		// viper's defaults, kept because DecodeHook replaces them.
+		mapstructure.StringToTimeDurationHookFunc(),
+		mapstructure.StringToSliceHookFunc(","),
+	))
+}
+
+// addressFilterLegacyKeys are decoded strictly, as before the screening
+// adapter: a mistake there still fails the config load.
+var addressFilterLegacyKeys = map[string]bool{"enabled": true, "filter_outbound": true, "addresses": true}
+
+// addressFilterDecodeHook decodes bifrost.address_filter itself. The legacy
+// keys (enabled, filter_outbound, addresses) decode strictly; every
+// screening-adapter key decodes leniently: a type error or an unknown key sets
+// AdapterErr (the adapter is disabled), and a bad source sets that source's
+// DecodeErr (it is quarantined). Either way the load succeeds, so a screening
+// config mistake never stops Bifrost (R3-A14).
+func addressFilterDecodeHook(_ reflect.Type, to reflect.Type, data any) (any, error) {
+	if to != reflect.TypeOf(BifrostAddressFilterConfiguration{}) {
+		return data, nil
+	}
+	m, ok := toStringMap(data)
+	if !ok {
+		if data == nil {
+			return BifrostAddressFilterConfiguration{}, nil
+		}
+		// Not a map at all: the legacy keys can't be read either, so this is
+		// a fatal load error as before the screening adapter. Silently
+		// returning a zero config would turn the legacy list off unlogged.
+		return nil, fmt.Errorf("address_filter: want a map, got %T", data)
+	}
+	return DecodeAddressFilter(m)
+}
+
+// DecodeAddressFilter decodes a raw address_filter map (see
+// addressFilterDecodeHook). Only a legacy-key error is returned as an error.
+func DecodeAddressFilter(m map[string]any) (BifrostAddressFilterConfiguration, error) {
+	var out BifrostAddressFilterConfiguration
+	legacy := map[string]any{}
+	adapter := map[string]any{}
+	var rawSources any
+	for k, v := range m {
+		switch {
+		case addressFilterLegacyKeys[k]:
+			legacy[k] = v
+		case k == "sources":
+			rawSources = v
+		default:
+			adapter[k] = v
+		}
+	}
+	if err := decodeInto(legacy, &out, false); err != nil {
+		return out, fmt.Errorf("address_filter: %w", err)
+	}
+	if err := decodeInto(adapter, &out, true); err != nil {
+		out.AdapterErr = fmt.Errorf("address_filter: %w", err)
+	}
+	srcs, err := decodeSources(rawSources)
+	if err != nil && out.AdapterErr == nil {
+		out.AdapterErr = fmt.Errorf("address_filter.sources: %w", err)
+	}
+	out.Sources = srcs
+	return out, nil
+}
+
+func decodeInto(in map[string]any, out any, errorUnused bool) error {
+	d, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{
+		ErrorUnused:      errorUnused,
+		WeaklyTypedInput: true,
+		DecodeHook: mapstructure.ComposeDecodeHookFunc(
+			mapstructure.StringToTimeDurationHookFunc(),
+			mapstructure.StringToSliceHookFunc(","),
+		),
+		Result: out,
+	})
+	if err != nil {
+		return err
+	}
+	return d.Decode(in)
+}
+
+// decodeSources accepts a list, or a JSON/YAML string holding one (the
+// BIFROST_ADDRESS_FILTER_SOURCES environment form). Each element decodes on
+// its own; a bad element keeps its name, mode and chains (best effort) and
+// carries DecodeErr.
+func decodeSources(raw any) ([]BifrostAddressFilterSource, error) {
+	if raw == nil {
+		return nil, nil
+	}
+	if s, ok := raw.(string); ok {
+		s = strings.TrimSpace(s)
+		if s == "" {
+			return nil, nil
+		}
+		var parsed any
+		if err := json.Unmarshal([]byte(s), &parsed); err != nil {
+			if yerr := yaml.Unmarshal([]byte(s), &parsed); yerr != nil {
+				return nil, fmt.Errorf("not a JSON or YAML list: %w", yerr)
+			}
+		}
+		raw = parsed
+	}
+	list, ok := raw.([]any)
+	if !ok {
+		rv := reflect.ValueOf(raw)
+		if rv.Kind() != reflect.Slice {
+			return nil, fmt.Errorf("want a list, got %T", raw)
+		}
+		list = make([]any, rv.Len())
+		for i := range list {
+			list[i] = rv.Index(i).Interface()
+		}
+	}
+	out := make([]BifrostAddressFilterSource, 0, len(list))
+	for i, e := range list {
+		em, ok := toStringMap(e)
+		if !ok {
+			out = append(out, BifrostAddressFilterSource{
+				Name: fmt.Sprintf("source[%d]", i), DecodeErr: fmt.Errorf("source %d: not a map", i),
+			})
+			continue
+		}
+		out = append(out, decodeSource(i, em))
+	}
+	return out, nil
+}
+
+func decodeSource(i int, em map[string]any) BifrostAddressFilterSource {
+	var src BifrostAddressFilterSource
+	norm, nerr := normalizeSourceAuth(em)
+	err := nerr
+	if err == nil {
+		err = decodeInto(norm, &src, true)
+	}
+	if err == nil {
+		return src
+	}
+	// Best effort: keep what identifies the source so it can be quarantined
+	// by name and still count for its chains (combine: all).
+	bad := BifrostAddressFilterSource{DecodeErr: err}
+	if n, ok := em["name"].(string); ok && strings.TrimSpace(n) != "" {
+		bad.Name = n
+	} else {
+		bad.Name = fmt.Sprintf("source[%d]", i)
+	}
+	if mo, ok := em["mode"].(string); ok {
+		bad.Mode = mo
+	}
+	var chains struct {
+		Chains []string `mapstructure:"chains"`
+	}
+	if decodeInto(map[string]any{"chains": em["chains"]}, &chains, false) == nil {
+		bad.Chains = chains.Chains
+	}
+	return bad
+}
+
+// normalizeSourceAuth turns the map form of auth into the flat fields:
+//
+//	auth: {signer: <name>, key_file: ..., secret_file: ...} -> auth: "signer:<name>"
+//	auth: {query: <param>, secret_file: ...}                -> auth: "query", query_param
+//	auth: {bearer: <token_file>} or {token_file: ...}       -> auth: "bearer"
+//
+// A key set both inside the map and at the top level must agree.
+func normalizeSourceAuth(em map[string]any) (map[string]any, error) {
+	a, ok := em["auth"]
+	if !ok {
+		return em, nil
+	}
+	am, ok := toStringMap(a)
+	if !ok {
+		return em, nil
+	}
+	out := make(map[string]any, len(em)+3)
+	for k, v := range em {
+		out[k] = v
+	}
+	lift := func(key string, v any) error {
+		if cur, ok := out[key]; ok && fmt.Sprint(cur) != fmt.Sprint(v) {
+			return fmt.Errorf("auth.%s conflicts with %s", key, key)
+		}
+		out[key] = v
+		return nil
+	}
+	mode := ""
+	for k, v := range am {
+		switch k {
+		case "signer":
+			mode = "signer:" + fmt.Sprint(v)
+		case "query":
+			mode = "query"
+			if err := lift("query_param", v); err != nil {
+				return nil, err
+			}
+		case "bearer":
+			mode = "bearer"
+			if err := lift("token_file", v); err != nil {
+				return nil, err
+			}
+		case "key_file", "secret_file", "token_file", "query_param":
+			if err := lift(k, v); err != nil {
+				return nil, err
+			}
+		default:
+			return nil, fmt.Errorf("auth: unknown key %q", k)
+		}
+	}
+	if mode == "" {
+		if _, ok := out["token_file"]; ok {
+			mode = "bearer"
+		} else {
+			return nil, errors.New("auth map needs signer, query or bearer")
+		}
+	}
+	out["auth"] = mode
+	return out, nil
+}
+
+func toStringMap(v any) (map[string]any, bool) {
+	switch m := v.(type) {
+	case map[string]any:
+		return m, true
+	case map[any]any:
+		out := make(map[string]any, len(m))
+		for k, val := range m {
+			out[fmt.Sprint(k)] = val
+		}
+		return out, true
+	}
+	return nil, false
+}
