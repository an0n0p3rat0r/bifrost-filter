+// Package signer holds request signers for screening sources. Secrets are
+// loaded once at construction; Sign does no file I/O and is safe for
+// concurrent use.
+package signer
+
+import (
+	"fmt"
+	"net/http"
+	"time"
+)
+
+// Signer signs the final request bytes. It returns the headers to add and the
+// names of headers whose values are sensitive (for redaction).
+type Signer interface {
+	Sign(method, pathWithQuery string, body []byte, now time.Time) (h http.Header, sensitive []string, err error)
+}
+
+// New returns the named signer built from already-loaded secret material.
+func New(name, key, secret string) (Signer, error) {
+	switch name {
+	case "elliptic-hmac":
+		return NewElliptic(key, secret)
+	default:
+		return nil, fmt.Errorf("unknown signer %q", name)
+	}
+}
diff --git a/bifrost/pkg/addressfilter/skipledger.go b/bifrost/pkg/addressfilter/skipledger.go
new file mode 100644
index 00000000000..facb86ab5f4
--- /dev/null
+++ b/bifrost/pkg/addressfilter/skipledger.go
@@ -0,0 +1,552 @@
+package addressfilter
+
+import (
+	"encoding/json"
+	"errors"
+	"fmt"
+	"sort"
+	"strconv"
+	"strings"
+	"sync"
+	"time"
+	"unicode/utf8"
+
+	stypes "gitlab.com/thorchain/thornode/v3/bifrost/thorclient/types"
+)
+
+// SkipEnvelopeVersion is the current envelope format.
+const SkipEnvelopeVersion = 1
+
+// MaxReasonBytes caps every reason string stored in the ledger (R3-A18).
+const MaxReasonBytes = 256
+
+// Skip record states.
+const (
+	SkipPending  = "pending"
+	SkipReleased = "released"
+	SkipArchived = "archived"
+)
+
+var (
+	// ErrLedgerFull means max_records is reached: the caller observes the item
+	// (fail-open) and the critical metric fires.
+	ErrLedgerFull = errors.New("skip ledger full")
+	// ErrNoLedger means no store is configured: the caller observes.
+	ErrNoLedger = errors.New("skip ledger not configured")
+	// ErrSenderCap means this sender holds max_records_per_sender records on
+	// the chain already: the caller observes the item, so one sender can't
+	// fill a chain's share of the ledger for everyone else.
+	ErrSenderCap = errors.New("skip ledger sender cap")
+)
+
+// Occurrence identifies one mined occurrence of an inbound. A reorg re-mine is
+// a different occurrence (different block hash), so a different record.
+type Occurrence struct {
+	Chain       string `json:"chain"`
+	TxID        string `json:"tx_id"`
+	BlockHeight int64  `json:"block_height"`
+	BlockHash   string `json:"block_hash"`
+}
+
+// TxInContext is the TxIn-level state needed to rebuild the observation.
+type TxInContext struct {
+	ConfirmationRequired int64             `json:"confirmation_required"`
+	ObservedVaultPubKey  string            `json:"observed_vault_pubkey"`
+	Mempool              bool              `json:"mempool"`
+	Finalised            bool              `json:"finalised"`
+	Extra                map[string]string `json:"extra,omitempty"`
+}
+
+// Screening is the decision record.
+type Screening struct {
+	Inputs      ItemDTO           `json:"inputs"`
+	Answers     map[string]Answer `json:"answers"`
+	Combine     string            `json:"combine"`
+	Fingerprint string            `json:"list_fingerprint"`
+	GuardEpoch  uint64            `json:"guard_epoch"`
+}
+
+// SkipEnvelope is the complete, replayable record of one skipped inbound
+// (R3-A5). It is written before the scanner item is acknowledged.
+type SkipEnvelope struct {
+	Version    int               `json:"version"`
+	Occurrence Occurrence        `json:"occurrence"`
+	Context    TxInContext       `json:"txin_context"`
+	Item       stypes.TxInItem   `json:"item"`
+	Screening  Screening         `json:"screening"`
+	Reason     string            `json:"reason"`
+	CreatedAt  time.Time         `json:"created_at"`
+	NextCheck  time.Time         `json:"next_check"`
+	Attempts   int               `json:"attempts"`
+	State      string            `json:"state"`
+	Generation uint64            `json:"generation"`
+	Meta       map[string]string `json:"meta,omitempty"`
+}
+
+// Key is the ledger key of the envelope: the occurrence plus the sender (an
+// occurrence can carry more than one item).
+func (e *SkipEnvelope) Key() string {
+	o := e.Occurrence
+	return o.Chain + "|" + o.TxID + "|" + strconv.FormatInt(o.BlockHeight, 10) + "|" + o.BlockHash + "|" + e.Item.Sender
+}
+
+// TruncateReason cuts s to at most MaxReasonBytes without splitting a rune.
+func TruncateReason(s string) string {
+	if len(s) <= MaxReasonBytes {
+		return s
+	}
+	cut := MaxReasonBytes
+	for cut > 0 && !utf8.RuneStart(s[cut]) {
+		cut--
+	}
+	return s[:cut]
+}
+
+func (e *SkipEnvelope) clamp() {
+	e.Reason = TruncateReason(e.Reason)
+	for k, a := range e.Screening.Answers {
+		a.Reason = TruncateReason(a.Reason)
+		e.Screening.Answers[k] = a
+	}
+}
+
+// SkipLedger stores skip envelopes in a LedgerStore (write-before-drop).
+type SkipLedger struct {
+	store      LedgerStore
+	maxRecords int
+	maxChain   int // per-chain cap, so one chain can't fill the ledger
+	// reserve is the per-chain floor: a chain under it may record even when
+	// max_records is reached (by other chains), so quiet chains never starve.
+	reserve int
+	// maxSender caps one sender's records on one chain, so one listed sender
+	// can't fill its chain's share (and leave that chain failing open).
+	maxSender    int
+	senderCapSet bool
+	metrics      *Metrics
+	now          func() time.Time
+	mu           sync.Mutex // serialises the count check with the write
+}
+
+// NewSkipLedger wraps store. maxRecords <= 0 means DefaultMaxRecords; the
+// per-chain cap defaults to DefaultPerChainRecords(maxRecords), the per-sender
+// cap to DefaultPerSenderRecords(per-chain cap), and there is no per-chain
+// reserve until SetChainReserve.
+func NewSkipLedger(store LedgerStore, maxRecords int, m *Metrics, now func() time.Time) *SkipLedger {
+	if maxRecords <= 0 {
+		maxRecords = DefaultMaxRecords
+	}
+	if now == nil {
+		now = time.Now
+	}
+	maxChain := DefaultPerChainRecords(maxRecords)
+	return &SkipLedger{
+		store: store, maxRecords: maxRecords, maxChain: maxChain,
+		maxSender: DefaultPerSenderRecords(maxChain), metrics: m, now: now,
+	}
+}
+
+// SetChainCap sets the per-chain cap (n <= 0 or above max_records keeps the
+// default). Unless SetSenderCap was called, the per-sender cap follows it.
+func (l *SkipLedger) SetChainCap(n int) {
+	if n > 0 && n <= l.maxRecords {
+		l.maxChain = n
+		if !l.senderCapSet {
+			l.maxSender = DefaultPerSenderRecords(n)
+		}
+	}
+}
+
+// SetChainReserve sets the per-chain floor (n <= 0: none; clamped to the
+// per-chain cap).
+func (l *SkipLedger) SetChainReserve(n int) {
+	if n < 0 {
+		n = 0
+	}
+	if n > l.maxChain {
+		n = l.maxChain
+	}
+	l.reserve = n
+}
+
+// SetSenderCap sets the per-sender cap (n <= 0 keeps the default; clamped to
+// the per-chain cap).
+func (l *SkipLedger) SetSenderCap(n int) {
+	if n <= 0 {
+		return
+	}
+	if n > l.maxChain {
+		n = l.maxChain
+	}
+	l.maxSender, l.senderCapSet = n, true
+}
+
+// OverCap reports the chains holding more records than their cap (e.g.
+// after an upgrade lowered it): their records are kept, and new skips on
+// them are observed until they drain below it.
+func (l *SkipLedger) OverCap(chains []string) map[string]int {
+	if l == nil || l.store == nil {
+		return nil
+	}
+	var out map[string]int
+	for _, c := range chains {
+		n, err := l.store.CountChain(c)
+		if err == nil && n > l.maxChain {
+			if out == nil {
+				out = map[string]int{}
+			}
+			out[c] = n
+		}
+	}
+	return out
+}
+
+// ChainCap is the per-chain cap in force.
+func (l *SkipLedger) ChainCap() int { return l.maxChain }
+
+// Record persists a pending envelope. It must succeed before the caller drops
+// the item; on any error the caller observes the item instead.
+func (l *SkipLedger) Record(env *SkipEnvelope) error {
+	if l == nil || l.store == nil {
+		return ErrNoLedger
+	}
+	env.Version = SkipEnvelopeVersion
+	env.State = SkipPending
+	if env.CreatedAt.IsZero() {
+		env.CreatedAt = l.now()
+	}
+	if env.NextCheck.IsZero() {
+		env.NextCheck = env.CreatedAt
+	}
+	env.clamp()
+	b, err := json.Marshal(env)
+	if err != nil {
+		l.metrics.ledgerWriteError()
+		return fmt.Errorf("encode skip envelope: %w", err)
+	}
+	l.mu.Lock()
+	defer l.mu.Unlock()
+	key := env.Key()
+	_, exists, err := l.store.GetEnvelope(key)
+	if err != nil {
+		l.metrics.ledgerWriteError()
+		return fmt.Errorf("read skip ledger: %w", err)
+	}
+	n, err := l.store.Count()
+	if err != nil {
+		l.metrics.ledgerWriteError()
+		return fmt.Errorf("count skip ledger: %w", err)
+	}
+	if !exists {
+		nc, err := l.store.CountChain(env.Occurrence.Chain)
+		if err != nil {
+			l.metrics.ledgerWriteError()
+			return fmt.Errorf("count skip ledger: %w", err)
+		}
+		// The global cap binds only once this chain has its reserved floor:
+		// other chains filling max_records can't starve it. A chain already
+		// over its cap (e.g. after an upgrade lowered it) keeps its records
+		// and records nothing new until it drains below the cap.
+		if nc >= l.maxChain || (n >= l.maxRecords && nc >= l.reserve) {
+			l.metrics.ledgerFull()
+			return ErrLedgerFull
+		}
+		ns, err := l.store.CountSender(env.Occurrence.Chain, env.Item.Sender)
+		if err != nil {
+			l.metrics.ledgerWriteError()
+			return fmt.Errorf("count skip ledger: %w", err)
+		}
+		if ns >= l.maxSender {
+			l.metrics.ledgerSenderCap()
+			return ErrSenderCap
+		}
+	}
+	if err := l.store.PutEnvelope(key, b, env.NextCheck); err != nil {
+		l.metrics.ledgerWriteError()
+		return fmt.Errorf("write skip ledger: %w", err)
+	}
+	if !exists {
+		n++
+	}
+	l.metrics.ledgerRecords(n)
+	return nil
+}
+
+// Get loads a pending envelope.
+func (l *SkipLedger) Get(key string) (*SkipEnvelope, bool, error) {
+	b, ok, err := l.store.GetEnvelope(key)
+	if err != nil || !ok {
+		return nil, ok, err
+	}
+	var env SkipEnvelope
+	if err := json.Unmarshal(b, &env); err != nil {
+		return nil, false, fmt.Errorf("decode skip envelope %s: %w", key, err)
+	}
+	return &env, true, nil
+}
+
+// Update rewrites a pending envelope (attempts, next check).
+func (l *SkipLedger) Update(env *SkipEnvelope) error {
+	env.clamp()
+	b, err := json.Marshal(env)
+	if err != nil {
+		return err
+	}
+	return l.store.PutEnvelope(env.Key(), b, env.NextCheck)
+}
+
+// Release removes a resolved record (replayed or recorded as released).
+func (l *SkipLedger) Release(key string) error {
+	if err := l.store.DeleteEnvelope(key); err != nil {
+		return err
+	}
+	if n, err := l.store.Count(); err == nil {
+		l.metrics.ledgerRecords(n)
+	}
+	return nil
+}
+
+// Resolve closes a record whose sender is no longer listed in record-only
+// mode (no replay): it leaves the live ledger but is kept in the archive as
+// released, so the evidence that this inbound was skipped and never
+// re-observed survives. No alert: it was resolved, not abandoned.
+func (l *SkipLedger) Resolve(env *SkipEnvelope) error {
+	env.State = SkipReleased
+	if env.Meta == nil {
+		env.Meta = map[string]string{}
+	}
+	env.Meta["resolved_at"] = l.now().UTC().Format(time.RFC3339)
+	env.Meta["resolution"] = "record_only_not_reobserved"
+	env.clamp()
+	b, err := json.Marshal(env)
+	if err != nil {
+		return err
+	}
+	if err := l.store.ArchiveEnvelope(env.Key(), b); err != nil {
+		return err
+	}
+	if n, err := l.store.Count(); err == nil {
+		l.metrics.ledgerRecords(n)
+	}
+	return nil
+}
+
+// Archive moves an unresolved record out of the live ledger into the archive
+// (never silently deleted) and raises the alert metric.
+func (l *SkipLedger) Archive(key string) error {
+	env, ok, err := l.Get(key)
+	if err != nil {
+		return err
+	}
+	if !ok {
+		return nil
+	}
+	env.State = SkipArchived
+	b, err := json.Marshal(env)
+	if err != nil {
+		return err
+	}
+	if err := l.store.ArchiveEnvelope(key, b); err != nil {
+		return err
+	}
+	l.metrics.archived()
+	if n, err := l.store.Count(); err == nil {
+		l.metrics.ledgerRecords(n)
+	}
+	return nil
+}
+
+// Due lists up to limit keys whose next check is due, oldest first.
+func (l *SkipLedger) Due(now time.Time, limit int) ([]string, error) {
+	return l.store.Due(now, limit)
+}
+
+// Count is the number of pending records.
+func (l *SkipLedger) Count() (int, error) { return l.store.Count() }
+
+var drainUntil = time.Unix(1<<40, 0)
+
+// ErrKeepRecord, returned by a Drain callback, leaves that record pending and
+// continues with the next one.
+var ErrKeepRecord = errors.New("keep skip record")
+
+// Drain hands every pending envelope to fn (used on disable). A nil return
+// releases the record; ErrKeepRecord keeps it and goes on; any other error
+// stops the drain and leaves the record (and the rest) pending. Every record
+// is visited at most once.
+func (l *SkipLedger) Drain(page int, fn func(*SkipEnvelope) error) error {
+	keys, err := l.store.Due(drainUntil, 0)
+	if err != nil {
+		return err
+	}
+	for _, k := range keys {
+		env, ok, err := l.Get(k)
+		if err != nil {
+			return err
+		}
+		if !ok {
+			continue
+		}
+		if err := fn(env); err != nil {
+			if errors.Is(err, ErrKeepRecord) {
+				continue
+			}
+			return err
+		}
+		if err := l.Release(k); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// MemLedgerStore is an in-memory LedgerStore (tests; the observer uses its
+// LevelDB store, A4.2).
+type MemLedgerStore struct {
+	mu       sync.Mutex
+	live     map[string]memLedgerRow
+	archive  map[string][]byte
+	PutErr   error
+	CountErr error
+}
+
+type memLedgerRow struct {
+	env  []byte
+	next time.Time
+}
+
+// NewMemLedgerStore returns an empty store.
+func NewMemLedgerStore() *MemLedgerStore {
+	return &MemLedgerStore{live: map[string]memLedgerRow{}, archive: map[string][]byte{}}
+}
+
+func (m *MemLedgerStore) PutEnvelope(key string, env []byte, next time.Time) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.PutErr != nil {
+		return m.PutErr
+	}
+	m.live[key] = memLedgerRow{env: append([]byte(nil), env...), next: next}
+	return nil
+}
+
+func (m *MemLedgerStore) GetEnvelope(key string) ([]byte, bool, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	r, ok := m.live[key]
+	return r.env, ok, nil
+}
+
+func (m *MemLedgerStore) DeleteEnvelope(key string) error {
+	m.mu.Lock()
+	delete(m.live, key)
+	m.mu.Unlock()
+	return nil
+}
+
+func (m *MemLedgerStore) ArchiveEnvelope(key string, env []byte) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	m.archive[key] = append([]byte(nil), env...)
+	delete(m.live, key)
+	return nil
+}
+
+// Archived returns the archived envelope for key.
+func (m *MemLedgerStore) Archived(key string) ([]byte, bool) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	b, ok := m.archive[key]
+	return b, ok
+}
+
+func (m *MemLedgerStore) Due(now time.Time, limit int) ([]string, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	type kv struct {
+		k string
+		t time.Time
+	}
+	var due []kv
+	for k, r := range m.live {
+		if !r.next.After(now) {
+			due = append(due, kv{k, r.next})
+		}
+	}
+	sort.Slice(due, func(i, j int) bool {
+		if due[i].t.Equal(due[j].t) {
+			return due[i].k < due[j].k
+		}
+		return due[i].t.Before(due[j].t)
+	})
+	if limit > 0 && len(due) > limit {
+		due = due[:limit]
+	}
+	out := make([]string, len(due))
+	for i, d := range due {
+		out[i] = d.k
+	}
+	return out, nil
+}
+
+func (m *MemLedgerStore) Count() (int, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.CountErr != nil {
+		return 0, m.CountErr
+	}
+	return len(m.live), nil
+}
+
+func (m *MemLedgerStore) CountChain(chain string) (int, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.CountErr != nil {
+		return 0, m.CountErr
+	}
+	n := 0
+	for k := range m.live {
+		if LedgerKeyChain(k) == chain {
+			n++
+		}
+	}
+	return n, nil
+}
+
+func (m *MemLedgerStore) CountSender(chain, sender string) (int, error) {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if m.CountErr != nil {
+		return 0, m.CountErr
+	}
+	want := LedgerSenderKey(chain, sender)
+	n := 0
+	for k := range m.live {
+		if LedgerKeySenderKey(k) == want {
+			n++
+		}
+	}
+	return n, nil
+}
+
+// LedgerSenderKey is the per-sender count key: chain|lower-case sender.
+func LedgerSenderKey(chain, sender string) string {
+	return chain + "|" + strings.ToLower(sender)
+}
+
+// LedgerKeySenderKey is the per-sender count key of a ledger key
+// (chain|txid|height|hash|sender).
+func LedgerKeySenderKey(key string) string {
+	parts := strings.SplitN(key, "|", 5)
+	if len(parts) < 5 {
+		return LedgerSenderKey(LedgerKeyChain(key), "")
+	}
+	return LedgerSenderKey(parts[0], parts[4])
+}
+
+// LedgerKeyChain is the chain ticker a ledger key starts with.
+func LedgerKeyChain(key string) string {
+	if i := strings.IndexByte(key, '|'); i >= 0 {
+		return key[:i]
+	}
+	return key
+}
diff --git a/bifrost/pkg/addressfilter/skipledger_test.go b/bifrost/pkg/addressfilter/skipledger_test.go
new file mode 100644
index 00000000000..1790600ded8
--- /dev/null
+++ b/bifrost/pkg/addressfilter/skipledger_test.go
@@ -0,0 +1,402 @@
+package addressfilter
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"math/rand"
+	"reflect"
+	"strings"
+	"sync/atomic"
+	"testing"
+	"time"
+
+	stypes "gitlab.com/thorchain/thornode/v3/bifrost/thorclient/types"
+	"gitlab.com/thorchain/thornode/v3/common"
+	"gitlab.com/thorchain/thornode/v3/common/cosmos"
+	ttypes "gitlab.com/thorchain/thornode/v3/x/thorchain/types"
+)
+
+// ---- A3.3 skip ledger ----
+
+// fillTxInItem sets every serialized TxInItem field to a non-zero value. An
+// unhandled field type fails the test, so a new TxInItem field can't silently
+// drop out of the envelope.
+func fillTxInItem(t *testing.T) stypes.TxInItem {
+	t.Helper()
+	var it stypes.TxInItem
+	v := reflect.ValueOf(&it).Elem()
+	ty := v.Type()
+	coins := common.NewCoins(common.NewCoin(common.BTCAsset, cosmos.NewUint(12345)))
+	u := cosmos.NewUint(777)
+	for i := 0; i < ty.NumField(); i++ {
+		f := ty.Field(i)
+		if f.Tag.Get("json") == "-" {
+			continue // local-only handoff state, never stored or sent
+		}
+		fv := v.Field(i)
+		switch fv.Interface().(type) {
+		case string:
+			fv.SetString("v-" + f.Name)
+		case bool:
+			fv.SetBool(true)
+		case int64:
+			fv.SetInt(int64(100 + i))
+		case common.Coins:
+			fv.Set(reflect.ValueOf(coins))
+		case common.Gas:
+			fv.Set(reflect.ValueOf(common.Gas(coins)))
+		case common.PubKey:
+			fv.Set(reflect.ValueOf(ttypes.GetRandomPubKey()))
+		case *cosmos.Uint:
+			fv.Set(reflect.ValueOf(&u))
+		case []*common.OutputRef:
+			fv.Set(reflect.ValueOf([]*common.OutputRef{{TxHash: "h", OutputIndex: 2, KeyImage: "k", SpendTxHash: "s"}}))
+		case *common.SolNonceUpdate:
+			fv.Set(reflect.ValueOf(&common.SolNonceUpdate{NonceAccount: "a", Nonce: "n", Slot: 9}))
+		default:
+			t.Fatalf("TxInItem.%s: unhandled type %s; extend the envelope test", f.Name, f.Type)
+		}
+	}
+	return it
+}
+
+func testEnvelope(t *testing.T, it stypes.TxInItem) *SkipEnvelope {
+	return &SkipEnvelope{
+		Occurrence: Occurrence{Chain: "BTC", TxID: it.Tx, BlockHeight: 900, BlockHash: "bh"},
+		Context:    TxInContext{ConfirmationRequired: 3, ObservedVaultPubKey: "pk", Extra: map[string]string{"k": "v"}},
+		Item:       it,
+		Screening: Screening{
+			Inputs:  NewItemDTO(common.BTCChain, &it, 1700000000),
+			Answers: map[string]Answer{"gjallar": {State: Listed, Reason: "listed"}},
+			Combine: CombineAny, Fingerprint: "fp", GuardEpoch: 4,
+		},
+	}
+}
