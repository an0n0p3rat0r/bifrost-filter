+
+func querySpec(t *testing.T, raw config.BifrostAddressFilterSource, files map[string]string) SourceSpec {
+	t.Helper()
+	read := func(p string) ([]byte, error) {
+		if v, ok := files[p]; ok {
+			return []byte(v), nil
+		}
+		return nil, errors.New("no such file")
+	}
+	spec, err := validateSource(raw, map[string]common.Chain{"BTC": common.BTCChain, "ETH": common.ETHChain}, read, NewEvalSemaphore(0))
+	if err != nil {
+		t.Fatalf("validate: %v", err)
+	}
+	return spec
+}
+
+func builder(t *testing.T, spec SourceSpec) *RequestBuilder {
+	t.Helper()
+	auth, err := NewAuthenticator(spec, spec.SecretFiles)
+	if err != nil {
+		t.Fatal(err)
+	}
+	b, err := NewRequestBuilder(spec, spec.SecretFiles, auth)
+	if err != nil {
+		t.Fatal(err)
+	}
+	return b
+}
+
+func dtoFor(addr string) (any, []any) {
+	d := ItemDTO{ThorChain: "thorchain", Chain: "BTC", Address: addr, Coins: []CoinDTO{}}
+	return d.ToJQ()
+}
+
+func TestRequestAddressEscapedInPathAndQuery(t *testing.T) {
+	spec := querySpec(t, config.BifrostAddressFilterSource{
+		Name: "q", Mode: "query", Chains: []string{"BTC"},
+		URL: "http://127.0.0.1:1/v1/{chain}/{address}?a={address}", Listed: ".listed",
+	}, nil)
+	b := builder(t, spec)
+	in, vals := dtoFor("a/b?c")
+	br, err := b.Build(context.Background(), "a/b?c", "BTC", in, vals, time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if got := br.Req.URL.EscapedPath(); got != "/v1/BTC/a%2Fb%3Fc" {
+		t.Fatalf("path %q", got)
+	}
+	if got := br.Req.URL.Query().Get("a"); got != "a/b?c" {
+		t.Fatalf("query a = %q", got)
+	}
+	if br.Req.URL.Host != "127.0.0.1:1" {
+		t.Fatalf("host changed: %q", br.Req.URL.Host)
+	}
+}
+
+func TestRequestPlaceholderInHostRefused(t *testing.T) {
+	if err := checkURLTemplate("https://{address}.example/x"); err == nil {
+		t.Fatal("placeholder in host accepted")
+	}
+	if err := checkURLTemplate("https://example/x#{address}"); err == nil {
+		t.Fatal("fragment accepted")
+	}
+}
+
+func TestRequestBodyIsJSONMarshalled(t *testing.T) {
+	spec := querySpec(t, config.BifrostAddressFilterSource{
+		Name: "q", Mode: "query", Chains: []string{"BTC"},
+		URL: "http://127.0.0.1:1/check", Body: `{address: $address, chain: $chain}`, Listed: ".listed",
+	}, nil)
+	b := builder(t, spec)
+	evil := `x","listed":true,"y":"\`
+	in, vals := dtoFor(evil)
+	br, err := b.Build(context.Background(), evil, "BTC", in, vals, time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	if br.Req.Method != http.MethodPost || br.Req.Header.Get("Content-Type") != "application/json" {
+		t.Fatalf("method %s ct %q", br.Req.Method, br.Req.Header.Get("Content-Type"))
+	}
+	var m map[string]any
+	if err := json.Unmarshal(br.Body, &m); err != nil {
+		t.Fatal(err)
+	}
+	if len(m) != 2 || m["address"] != evil {
+		t.Fatalf("body %s", br.Body)
+	}
+}
+
+func TestRequestHeaderQueryValueForms(t *testing.T) {
+	spec := querySpec(t, config.BifrostAddressFilterSource{
+		Name: "q", Mode: "query", Chains: []string{"BTC"},
+		URL:     "http://127.0.0.1:1/check",
+		Headers: map[string]string{"X-Lit": "plain", "X-Key": "secret:/k", "X-Addr": "jq:$address"},
+		Query:   map[string]string{"amt": "jq:$amount // \"none\""},
+		Listed:  ".listed",
+	}, map[string]string{"/k": "s3cr3t-value"})
+	if !spec.ContextDependent {
+		t.Fatal("a query value reading $amount must make the source context-dependent")
+	}
+	b := builder(t, spec)
+	in, vals := dtoFor("bc1qxyz")
+	br, err := b.Build(context.Background(), "bc1qxyz", "BTC", in, vals, time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	h := br.Req.Header
+	if h.Get("X-Lit") != "plain" || h.Get("X-Key") != "s3cr3t-value" || h.Get("X-Addr") != "bc1qxyz" {
+		t.Fatalf("headers %v", h)
+	}
+	if br.Req.URL.Query().Get("amt") != "none" {
+		t.Fatalf("query %q", br.Req.URL.RawQuery)
+	}
+	red := br.Redactor.Header(h, br.SensitiveHeaders...)
+	if red.Get("X-Key") != Redacted {
+		t.Fatalf("secret header not redacted: %v", red)
+	}
+}
+
+func TestEchoedSecretScrubbedFromError(t *testing.T) {
+	const key = "api-key-0123456789"
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		w.WriteHeader(http.StatusUnauthorized)
+		io.WriteString(w, `{"error":"bad key `+r.URL.Query().Get("apikey")+`"}`)
+	}))
+	defer srv.Close()
+	spec := querySpec(t, config.BifrostAddressFilterSource{
+		Name: "q", Mode: "query", Chains: []string{"BTC"}, URL: srv.URL + "/c/{address}",
+		Auth: "query", QueryParam: "apikey", SecretFile: "/s", Listed: ".listed",
+	}, map[string]string{"/s": key})
+	b := builder(t, spec)
+	in, vals := dtoFor("addr1")
+	br, err := b.Build(context.Background(), "addr1", "BTC", in, vals, time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	pol, _ := PolicyFor(spec, true)
+	_, _, _, err = Send(NewHTTPClient(pol), br, 1<<20)
+	if err == nil || strings.Contains(err.Error(), key) || !strings.Contains(err.Error(), Redacted) {
+		t.Fatalf("err %v", err)
+	}
+	if got := br.Redactor.URL(br.Req.URL, br.SensitiveParams); strings.Contains(got, key) {
+		t.Fatalf("url leaks key: %s", got)
+	}
+}
+
+func TestSignedRequestNeverFollowsRedirect(t *testing.T) {
+	var hops int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path == "/next" {
+			atomic.AddInt32(&hops, 1)
+			io.WriteString(w, `{"listed":false}`)
+			return
+		}
+		http.Redirect(w, r, "http://"+r.Host+"/next", http.StatusFound)
+	}))
+	defer srv.Close()
+	spec := querySpec(t, config.BifrostAddressFilterSource{
+		Name: "q", Mode: "query", Chains: []string{"BTC"}, URL: srv.URL + "/c",
+		Auth: "bearer", TokenFile: "/t", FollowRedirects: "same-origin-https", Listed: ".listed",
+	}, map[string]string{"/t": "tok-abcdef"})
+	b := builder(t, spec)
+	in, vals := dtoFor("addr1")
+	br, err := b.Build(context.Background(), "addr1", "BTC", in, vals, time.Now())
+	if err != nil {
+		t.Fatal(err)
+	}
+	pol, _ := PolicyFor(spec, true)
+	_, _, _, err = Send(NewHTTPClient(pol), br, 1<<20)
+	if err == nil || !strings.Contains(err.Error(), ErrRedirectRefused.Error()) {
+		t.Fatalf("want redirect refused, got %v", err)
+	}
+	if atomic.LoadInt32(&hops) != 0 {
+		t.Fatal("redirect was followed")
+	}
+}
+
+func TestNonLoopbackNeedsProxyOrDirectEgress(t *testing.T) {
+	raw := config.BifrostAddressFilterSource{
+		Name: "v", Mode: "query", Chains: []string{"BTC"}, URL: "https://vendor.example/check", Listed: ".listed",
+	}
+	_, err := validateSource(raw, map[string]common.Chain{"BTC": common.BTCChain}, nil, NewEvalSemaphore(0))
+	if err == nil || !strings.Contains(err.Error(), "proxy_url") {
+		t.Fatalf("want proxy_url error, got %v", err)
+	}
+	raw.ProxyURL = "http://10.0.0.5:3128"
+	if _, err := validateSource(raw, map[string]common.Chain{"BTC": common.BTCChain}, nil, NewEvalSemaphore(0)); err != nil {
+		t.Fatal(err)
+	}
+}
+
+// connectProxy is a minimal HTTP CONNECT proxy that records its targets.
+func connectProxy(t *testing.T, seen *atomic.Value) *httptest.Server {
+	return httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.Method != http.MethodConnect {
+			http.Error(w, "connect only", http.StatusMethodNotAllowed)
+			return
+		}
+		seen.Store(r.Host)
+		dst, err := net.Dial("tcp", r.Host)
+		if err != nil {
+			http.Error(w, err.Error(), http.StatusBadGateway)
+			return
+		}
+		hj, _ := w.(http.Hijacker)
+		w.WriteHeader(http.StatusOK)
+		conn, buf, err := hj.Hijack()
+		if err != nil {
+			dst.Close()
+			return
+		}
+		go func() { _, _ = io.Copy(dst, buf); dst.Close() }()
+		go func() { _, _ = io.Copy(conn, bufio.NewReader(dst)); conn.Close() }()
+	}))
+}
+
+func TestRequestGoesThroughConnectProxy(t *testing.T) {
+	target := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		io.WriteString(w, `{"listed":false}`)
+	}))
+	defer target.Close()
+	var seen atomic.Value
+	proxy := connectProxy(t, &seen)
+	defer proxy.Close()
+	pu, _ := url.Parse(proxy.URL)
+	tlsCfg := target.Client().Transport.(*http.Transport).TLSClientConfig.Clone()
+	pol := TransportPolicy{Proxy: pu, TLS: tlsCfg}
+	req, _ := http.NewRequest(http.MethodGet, target.URL+"/c", nil)
+	br := &BuiltRequest{Req: req, Redactor: NewRedactor(nil, nil)}
+	st, _, body, err := Send(NewHTTPClient(pol), br, 1<<20)
+	if err != nil || st != 200 || string(body) != `{"listed":false}` {
+		t.Fatalf("st %d body %s err %v", st, body, err)
+	}
+	tu, _ := url.Parse(target.URL)
+	if seen.Load() != tu.Host {
+		t.Fatalf("proxy saw %v, want CONNECT %s", seen.Load(), tu.Host)
+	}
+}
+
+func TestDirectDialToPrivateRefused(t *testing.T) {
+	target := httptest.NewTLSServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {}))
+	defer target.Close()
+	tlsCfg := target.Client().Transport.(*http.Transport).TLSClientConfig.Clone()
+	req, _ := http.NewRequest(http.MethodGet, target.URL, nil)
+	br := &BuiltRequest{Req: req, Redactor: NewRedactor(nil, nil)}
+	_, _, _, err := Send(NewHTTPClient(TransportPolicy{TLS: tlsCfg}), br, 1<<20)
+	if err == nil || !strings.Contains(err.Error(), ErrDestinationRefused.Error()) {
+		t.Fatalf("want destination refused, got %v", err)
+	}
+	req2, _ := http.NewRequest(http.MethodGet, target.URL, nil)
+	br2 := &BuiltRequest{Req: req2, Redactor: NewRedactor(nil, nil)}
+	if _, _, _, err := Send(NewHTTPClient(TransportPolicy{TLS: tlsCfg, Loopback: true}), br2, 1<<20); err != nil {
+		t.Fatalf("loopback source must reach loopback: %v", err)
+	}
+}
+
+func TestResponseCap(t *testing.T) {
+	if _, err := ReadCapped(strings.NewReader("12345"), 4); !errors.Is(err, ErrResponseTooLarge) {
+		t.Fatalf("got %v", err)
+	}
+}
+
+func TestRedactorForms(t *testing.T) {
+	r := NewRedactor([]string{"p@ss/w+rd"}, nil)
+	for _, in := range []string{"p@ss/w+rd", url.QueryEscape("p@ss/w+rd"), "cEBzcy93K3Jk"} {
+		if got := r.String("x " + in + " y"); strings.Contains(got, in) {
+			t.Fatalf("%q not scrubbed: %q", in, got)
+		}
+	}
+	v := r.Value(map[string]any{"k": []any{"p@ss/w+rd"}}).(map[string]any)
+	if v["k"].([]any)[0] != Redacted {
+		t.Fatalf("value %v", v)
+	}
+}
