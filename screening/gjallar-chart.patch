diff --git a/gjallar/values.yaml b/gjallar/values.yaml
new file mode 100644
index 00000000..7f12d1e4
--- /dev/null
+++ b/gjallar/values.yaml
@@ -0,0 +1,129 @@
+# Gjallar screening proxy for bifrost's opt-in observation filter. Off by default: enable it in
+# thornode-stack with `gjallar.enabled: true` and point bifrost at it with
+# `thornode.bifrost.screening.enabled: true` (needs a bifrost image built with the screening adapter).
+# See README.md in this chart.
+
+nameOverride: ""
+fullnameOverride: ""
+
+# Gjallar keeps its own list, snapshots and vault whitelist in one data dir (SQLite), so it runs as
+# a single pod with a Recreate strategy.
+replicaCount: 1
+
+# There is no official image yet: build one from the Gjallar source and set all three fields.
+image:
+  name: ""
+  tag: ""
+  hash: ""
+
+# TLS is mandatory: Gjallar refuses a non-loopback bind without it. A kubernetes.io/tls Secret
+# (keys tls.crt / tls.key) whose certificate is valid for the service name bifrost dials
+# (default gjallar, gjallar.<namespace>.svc). Give bifrost the issuing CA with
+# thornode.bifrost.screening.caSecret.
+tls:
+  secretName: ""
+
+# Optional Secret with the THORChain API key Gjallar sends to thorchain.rest_url / rpc_url
+# (env GJALLAR_THORCHAIN_API_KEY). Leave empty for endpoints that need no key.
+thorchainApiKey:
+  secretName: ""
+  secretKey: ""
+
+# Optional Secret with the vendor credentials (env names must match vendor.key_env / secret_env).
+vendorSecret:
+  secretName: ""
+
+# gjallar.toml, minus the fields the chart owns (data_dir, server.bind, server.admin_bind,
+# server.tls paths, thorchain.api_key_env). Rendered as TOML; `source` is an array of tables.
+# See config.example.toml and API.md in the Gjallar source for every key.
+config:
+  server:
+    request_deadline_ms: 1500
+    max_vendor_items: 1000
+    max_connections: 64
+    max_connections_per_peer: 32
+    max_tls_handshakes: 64
+    max_tls_handshakes_per_peer: 8
+    http2: false
+    idle_timeout_secs: 60
+    header_read_timeout_secs: 10
+    # cidr: source-IP allowlist (bifrost pod IPs; set the pod CIDR and allow_wide_cidr, and keep
+    # networkPolicy on so only bifrost can reach the port). token: add `tokens` entries
+    # ({principal, sha256, admin}) and give bifrost the token with a bearer source.
+    auth:
+      modes: ["cidr"]
+      allow_wide_cidr: true
+      cidrs: []
+      # - principal: bifrost
+      #   cidr: 10.1.0.0/16
+  thorchain:
+    # THORChain REST / RPC (+ optional websocket) for the vault whitelist. Gjallar requires
+    # https/wss (or loopback), so the in-cluster thornode service does not qualify; use a provider.
+    # confirm_url is the independent cross-check and must be on a different host from rest_url.
+    # Required when the chart is enabled.
+    rest_url: ""
+    rpc_url: ""
+    # ws_url: wss://...
+    confirm_url: ""
+    fresh_blocks: 10
+    backstop_poll_secs: 60
+    confirm_within_secs: 120
+  vendor:
+    kind: none
+  health:
+    strict_health: false
+  source:
+    - id: sdn
+      kind: ofac
+      url: https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN.CSV
+      overflow_url: https://sanctionslistservice.ofac.treas.gov/api/PublicationPreview/exports/SDN_COMMENTS.CSV
+      redirect_hosts:
+        - wc2h-sls-prod-public-published.s3.us-gov-west-1.amazonaws.com
+      hops: 0
+
+service:
