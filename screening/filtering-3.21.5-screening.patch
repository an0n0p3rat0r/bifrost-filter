+// adrQuerySource builds the ADR example source `file` against a loopback
+// test server answering body.
+func adrQuerySource(t *testing.T, file string, body string) *QuerySource {
+	t.Helper()
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.Header().Set("Content-Type", "application/json")
+		_, _ = w.Write([]byte(body))
+	}))
+	t.Cleanup(srv.Close)
+	raw := adrSources(t, file)[0]
+	raw.URL = srv.URL + "/check"
+	raw.AllowDirectEgress = false // loopback test server
+	known := map[string]common.Chain{}
+	for _, c := range reviewChains {
+		known[c.String()] = c
+	}
+	files := readFiles(map[string]string{
+		"/secrets/misttrack.key": "mt-key", "/secrets/elliptic.key": "k", "/secrets/elliptic.secret": "c2VjcmV0",
+	})
+	spec, err := validateSource(raw, known, files, NewEvalSemaphore(0))
+	if err != nil {
+		t.Fatal(err)
+	}
+	q, err := NewQuerySource(spec, QuerySourceOptions{Builder: builder(t, spec), Client: srv.Client()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	return q
+}
