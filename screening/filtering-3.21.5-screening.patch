+func TestErrataCleanupRemovesSkipEnvelopeInSameBatch(t *testing.T) {
+	dir := t.TempDir()
+	st, err := NewObserverStorage(dir, config.LevelDBOptions{})
+	require.NoError(t, err)
+	defer cleanupTestDB(t, st, dir)
+	ledger := addressfilter.NewSkipLedger(st, 0, nil, nil)
+	reorged := afEnvelope("AABB", 100, "bc1qsender")
+	otherHeight := afEnvelope("AABB", 101, "bc1qsender") // re-mined occurrence
+	otherTx := afEnvelope("CCDD", 100, "bc1qsender")
+	for _, e := range []*addressfilter.SkipEnvelope{reorged, otherHeight, otherTx} {
+		require.NoError(t, ledger.Record(e))
+	}
+	// A failing errata write must leave the envelope too (same batch).
+	st.beforeErrataWrite = func() error { return fmt.Errorf("injected") }
+	require.Error(t, st.applyErrata(types.ErrataBlock{Height: 100, Txs: []types.ErrataTx{{Chain: common.BTCChain, TxID: "aabb"}}}, nil))
+	_, ok, err := st.GetEnvelope(reorged.Key())
+	require.NoError(t, err)
+	require.True(t, ok, "envelope must survive a failed errata batch")
+	st.beforeErrataWrite = nil
+
+	require.NoError(t, st.applyErrata(types.ErrataBlock{Height: 100, Txs: []types.ErrataTx{{Chain: common.BTCChain, TxID: "aabb"}}}, nil))
+	_, ok, err = st.GetEnvelope(reorged.Key())
+	require.NoError(t, err)
+	require.False(t, ok, "errata'd occurrence's envelope must be removed")
+	due, err := st.Due(time.Now().Add(time.Hour), 0)
+	require.NoError(t, err)
+	require.ElementsMatch(t, []string{otherHeight.Key(), otherTx.Key()}, due, "due index cleaned with the envelope; other occurrences kept")
+}
+
+func TestSkipEnvelopeSurvivesCrashBeforeDrop(t *testing.T) {
+	// Write the envelope (record) and "crash" before the item is acknowledged:
+	// on restart the envelope is there, so the skip is recoverable.
+	dir := t.TempDir()
+	st, err := NewObserverStorage(dir, config.LevelDBOptions{})
+	require.NoError(t, err)
+	e := afEnvelope("EEFF", 100, "bc1qsender")
+	require.NoError(t, addressfilter.NewSkipLedger(st, 0, nil, nil).Record(e))
+	require.NoError(t, st.Close())
+	re, err := NewObserverStorage(dir, config.LevelDBOptions{})
+	require.NoError(t, err)
+	defer cleanupTestDB(t, re, dir)
+	got, ok, err := addressfilter.NewSkipLedger(re, 0, nil, nil).Get(e.Key())
+	require.NoError(t, err)
+	require.True(t, ok)
+	require.Equal(t, addressfilter.SkipPending, got.State)
+	require.Equal(t, e.Item.Tx, got.Item.Tx)
+}
+
+// TestErrataAndSkipLedgerConcurrentNoDeadlock exercises the errataMu -> afMu
+// nesting against concurrent afMu-only writers (ledger record/delete, budget
+// reserve/release, guard rows). A lock-order inversion would deadlock here.
+func TestErrataAndSkipLedgerConcurrentNoDeadlock(t *testing.T) {
+	dir := t.TempDir()
+	st, err := NewObserverStorage(dir, config.LevelDBOptions{})
+	require.NoError(t, err)
+	defer cleanupTestDB(t, st, dir)
+	ledger := addressfilter.NewSkipLedger(st, 0, nil, nil)
+
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		var wg sync.WaitGroup
+		for w := 0; w < 4; w++ {
+			wg.Add(1)
+			go func(w int) {
+				defer wg.Done()
+				for i := 0; i < 50; i++ {
+					e := afEnvelope(fmt.Sprintf("AA%02d%03d", w, i), 100, "bc1qsender")
+					_ = ledger.Record(e)
+					_, _ = st.Reserve("cred", common.BTCChain, "2026-11-20", 1, 1_000_000)
+					_ = st.Release("cred", common.BTCChain, "2026-11-20", 1)
+					_ = st.DeleteEnvelope(e.Key())
+				}
+			}(w)
+		}
+		for w := 0; w < 2; w++ {
+			wg.Add(1)
+			go func(w int) {
+				defer wg.Done()
+				for i := 0; i < 50; i++ {
+					_ = st.applyErrata(types.ErrataBlock{Height: 100, Txs: []types.ErrataTx{{Chain: common.BTCChain, TxID: common.TxID(fmt.Sprintf("aa%02d%03d", w, i))}}}, nil)
+				}
+			}(w)
+		}
+		wg.Wait()
+	}()
+	select {
+	case <-done:
+	case <-time.After(30 * time.Second):
+		t.Fatal("errata and skip-ledger writers deadlocked")
+	}
+}
+
+func TestDueWithFarFutureSentinelReturnsEverything(t *testing.T) {
+	// The ledger's drain sentinel (year ~36812) overflows UnixNano; Due must
+	// clamp, not return nothing.
+	dir := t.TempDir()
+	st, err := NewObserverStorage(dir, config.LevelDBOptions{})
+	require.NoError(t, err)
+	defer cleanupTestDB(t, st, dir)
+	ledger := addressfilter.NewSkipLedger(st, 0, nil, nil)
+	require.NoError(t, ledger.Record(afEnvelope("FF01", 100, "bc1qsender")))
+	keys, err := st.Due(time.Unix(1<<40, 0), 0)
+	require.NoError(t, err)
+	require.Len(t, keys, 1)
+	var drained int
+	require.NoError(t, ledger.Drain(0, func(*addressfilter.SkipEnvelope) error { drained++; return nil }))
+	require.Equal(t, 1, drained)
+	n, err := ledger.Count()
+	require.NoError(t, err)
+	require.Zero(t, n)
+}
