+// N8: a list source's query-style timeout no longer caps the refresh; the
+// refresh deadline is fetch_timeout (default 60s), and a short one warns.
+func TestListFetchDeadlineSeparateFromTimeout(t *testing.T) {
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(200)
+		fl, _ := w.(http.Flusher)
+		_, _ = w.Write([]byte(`{"addresses": [`))
+		if fl != nil {
+			fl.Flush()
+		}
+		time.Sleep(300 * time.Millisecond) // a large list takes a while
+		_, _ = w.Write([]byte(`"0x00000000000000000000000000000000000000aa"]}`))
+	}))
+	defer srv.Close()
+	clk := &clock{t: time.Unix(1_800_000_000, 0)}
+	l := newList(t, srv, clk, func(r *config.BifrostAddressFilterSource) { r.Timeout = 100 * time.Millisecond })
+	if err := l.RefreshOnce(context.Background()); err != nil {
+		t.Fatalf("N8: a list's query timeout must not cap the refresh: %v", err)
+	}
