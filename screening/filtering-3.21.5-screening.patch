+// fakeListSource lists one sender and records whether it was ever called
+// while the observer deck lock was (about to be) held.
+type fakeListSource struct {
+	listed     string
+	deckLocked *atomic.Bool
+	calls      atomic.Int32
+	callsInLck atomic.Int32
+}
+
+func (f *fakeListSource) Name() string             { return "fake" }
+func (f *fakeListSource) Covers(common.Chain) bool { return true }
+func (f *fakeListSource) InMemory() bool           { return false }
+func (f *fakeListSource) Check(_ context.Context, _ common.Chain, items []addressfilter.ItemDTO) []addressfilter.Answer {
+	f.calls.Add(1)
+	if f.deckLocked.Load() {
+		f.callsInLck.Add(1)
+	}
+	out := make([]addressfilter.Answer, len(items))
+	for i, it := range items {
+		if strings.EqualFold(it.Address, f.listed) {
+			out[i] = addressfilter.Answer{State: addressfilter.Listed, Reason: "fake list"}
+		} else {
+			out[i] = addressfilter.Answer{State: addressfilter.Clean}
+		}
+	}
+	return out
+}
