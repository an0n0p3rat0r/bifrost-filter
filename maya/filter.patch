+type AddressFilterSuite struct{}
+
+var _ = Suite(&AddressFilterSuite{})
+
+// Entries taken from a published sanctioned address list, plus valid
+// vectors for the other chains MAYAChain observes.
+const (
+	seedETH    = "0x007f2ca1d485ccCDF625C837FAC45b1B13107941"
+	seedBech32 = "bc1qjwdw6vrzq4vf6hckutvx4ucj86awwv99mxnz7w"
+	seedSOL    = "AffzFDKZbyMiU11zmVBoAqD25ugpr7xoWWyRyGigBEaU"
+	seedTRON   = "TN3W4H6rK2ce4vX9YnFQHwKENnHjoxb3m9"
+	legacyBTC  = "1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa"
+	dashP2PKH  = "XpESxaUmonkq8RaLLp46Brx2K39ggQe226"
+	dashP2SH   = "7gnwGHt17heGpG9Crfeh4KGpYNFugPhJdh"
+	zecT1      = "t1VJ17NpeS82EE4wEsztKdctrVi3JSW7h9J" // zecT3's payload with the t1 prefix
+	zecT3      = "t3Vz22vK5z2LcKEdg16Yv4FFneEL1zg9ojd"
+	thorAddr   = "thor1dheycdevq39qlkxs2a6wuuzyn4aqxhve4qxtxt"
+	kujiAddr   = "kujira1r8egcurpwxftegr07gjv9gwffw4fk00960dj4f"
+	adaAddr    = "addr1qx2fxv2umyhttkxyxp8x0dlpdt3k6cwng5pxj3jhsydzer3n0d3vllmyqwsx5wktcd8cc3sq835lu7drv2xwl2wywfgse35a3x"
+)
+
+var xrdAddr = common.RadixAccountAddressPrefix + "6xx0jcv3s3zx7zvmkzq4ss6vd5mx0glz5yf8k7cp4tkkwmlrnmdpar"
+
+func (s *AddressFilterSuite) TestParseCounts(c *C) {
+	f := New(strings.Join([]string{
+		seedETH, seedBech32, legacyBTC,
+		seedETH,                   // duplicate, not double-counted
+		"  " + legacyBTC + " ",    // whitespace tolerated
+		"not-an-address", "0x123", // garbage skipped
+		seedSOL, seedTRON, // chains MAYAChain does not support: skipped
+		"",
+	}, ","))
+	c.Assert(f.Loaded(), Equals, 3)
+	c.Assert(f.Skipped(), Equals, 4)
+}
+
+func (s *AddressFilterSuite) TestEVMEntryAppliesToAllEVMChains(c *C) {
+	f := New(seedETH)
+	for _, chain := range common.GetEVMChains() {
+		c.Assert(f.Listed(chain, seedETH), Equals, true, Commentf("chain %s", chain))
+		// case-insensitive: lowercased query against checksummed entry
+		c.Assert(f.Listed(chain, strings.ToLower(seedETH)), Equals, true, Commentf("chain %s lower", chain))
+	}
+	// but not on non-EVM chains
+	for _, chain := range []common.Chain{common.BTCChain, common.DASHChain, common.ZECChain, common.THORChain, common.KUJIChain, common.XRDChain, common.ADAChain} {
+		c.Assert(f.Listed(chain, seedETH), Equals, false, Commentf("chain %s", chain))
+	}
+}
+
+func (s *AddressFilterSuite) TestBTCMatching(c *C) {
+	f := New(seedBech32 + "," + legacyBTC)
+	// bech32 matches case-insensitively
+	c.Assert(f.Listed(common.BTCChain, seedBech32), Equals, true)
+	c.Assert(f.Listed(common.BTCChain, strings.ToUpper(seedBech32)), Equals, true)
+	// legacy matches exactly, and base58 case flips must NOT match
+	c.Assert(f.Listed(common.BTCChain, legacyBTC), Equals, true)
+	c.Assert(f.Listed(common.BTCChain, strings.ToUpper(legacyBTC)), Equals, false)
+	// not on other chains
+	c.Assert(f.Listed(common.DASHChain, legacyBTC), Equals, false)
+	c.Assert(f.Listed(common.ETHChain, seedBech32), Equals, false)
+}
+
+func (s *AddressFilterSuite) TestBase58Chains(c *C) {
+	f := New(strings.Join([]string{dashP2PKH, dashP2SH, zecT1, zecT3}, ","))
+	c.Assert(f.Loaded(), Equals, 4)
+	c.Assert(f.Skipped(), Equals, 0)
+	c.Assert(f.Listed(common.DASHChain, dashP2PKH), Equals, true)
+	c.Assert(f.Listed(common.DASHChain, dashP2SH), Equals, true)
+	c.Assert(f.Listed(common.ZECChain, zecT1), Equals, true)
+	c.Assert(f.Listed(common.ZECChain, zecT3), Equals, true)
+	// base58 is case-sensitive
+	c.Assert(f.Listed(common.DASHChain, strings.ToLower(dashP2PKH)), Equals, false)
+	c.Assert(f.Listed(common.ZECChain, strings.ToUpper(zecT1)), Equals, false)
+	// no cross-chain leakage
+	c.Assert(f.Listed(common.BTCChain, dashP2PKH), Equals, false)
+	c.Assert(f.Listed(common.BTCChain, zecT1), Equals, false)
+	c.Assert(f.Listed(common.DASHChain, zecT1), Equals, false)
+}
+
+func (s *AddressFilterSuite) TestBech32Chains(c *C) {
+	f := New(strings.Join([]string{thorAddr, kujiAddr, xrdAddr, adaAddr}, ","))
+	c.Assert(f.Loaded(), Equals, 4)
+	for _, tc := range []struct {
+		chain common.Chain
+		addr  string
+	}{
+		{common.THORChain, thorAddr},
+		{common.KUJIChain, kujiAddr},
+		{common.XRDChain, xrdAddr},
+		{common.ADAChain, adaAddr},
+	} {
+		c.Assert(f.Listed(tc.chain, tc.addr), Equals, true, Commentf("chain %s", tc.chain))
+		// bech32 is case-insensitive
+		c.Assert(f.Listed(tc.chain, strings.ToUpper(tc.addr)), Equals, true, Commentf("chain %s upper", tc.chain))
+		// and does not leak onto another chain
+		c.Assert(f.Listed(common.BTCChain, tc.addr), Equals, false, Commentf("chain %s on BTC", tc.chain))
+	}
+}
+
+func (s *AddressFilterSuite) TestExplicitChainPrefix(c *C) {
+	// inference: a valid BTC legacy address infers BTC
+	f := New(legacyBTC)
+	c.Assert(f.Listed(common.BTCChain, legacyBTC), Equals, true)
+	c.Assert(f.Listed(common.DASHChain, legacyBTC), Equals, false)
+
+	// explicit prefix overrides inference
+	f = New("DASH:" + legacyBTC)
+	c.Assert(f.Listed(common.DASHChain, legacyBTC), Equals, true)
+	c.Assert(f.Listed(common.BTCChain, legacyBTC), Equals, false)
+
+	// EVM prefix shares the EVM bucket
+	f = New("ARB:" + seedETH)
+	for _, chain := range common.GetEVMChains() {
+		c.Assert(f.Listed(chain, seedETH), Equals, true, Commentf("chain %s", chain))
+	}
+
+	// unknown or unsupported chain ticker is skipped, not fatal
+	f = New("FOO:" + seedETH + ",SOL:" + seedSOL + ",TRON:" + seedTRON)
+	c.Assert(f.Loaded(), Equals, 0)
+	c.Assert(f.Skipped(), Equals, 3)
+	c.Assert(f.Listed(common.ETHChain, seedETH), Equals, false)
+}
+
+func (s *AddressFilterSuite) TestInertFilter(c *C) {
+	// nil filter matches nothing (feature disabled)
+	var f *Filter
+	c.Assert(f.Listed(common.ETHChain, seedETH), Equals, false)
+	c.Assert(f.Loaded(), Equals, 0)
+	c.Assert(f.Skipped(), Equals, 0)
+
+	// empty config loads nothing
+	f = New("")
+	c.Assert(f.Loaded(), Equals, 0)
+	c.Assert(f.Listed(common.ETHChain, seedETH), Equals, false)
+}
+
+// base58check vectors for chains whose addresses share BTC's base58 alphabet
+// and lengths, built from a fixed 20-byte payload with each chain's mainnet
+// version byte.
+func altBase58(version byte) string {
+	payload := make([]byte, 20)
+	for i := range payload {
+		payload[i] = byte(i + 1)
+	}
+	return base58.CheckEncode(payload, version)
+}
+
+// flipLast changes the final character, which breaks a base58check or bech32
+// checksum while keeping the address shape.
+func flipLast(addr string) string {
+	swap := "q"
+	if strings.HasSuffix(addr, "q") {
+		swap = "p"
+	}
+	return addr[:len(addr)-1] + swap
+}
+
+func (s *AddressFilterSuite) TestAmbiguousBase58Skipped(c *C) {
+	tron := altBase58(0x41) // T...
+	doge := altBase58(0x1e) // D...
+	ltc := altBase58(0x30)  // L...
+	c.Assert(tron[0], Equals, byte('T'))
+	c.Assert(doge[0], Equals, byte('D'))
+	c.Assert(ltc[0], Equals, byte('L'))
+
+	// bare: none is guessed onto any chain, all are counted as skipped
+	f := New(strings.Join([]string{tron, doge, ltc, seedSOL}, ","))
+	c.Assert(f.Loaded(), Equals, 0)
+	c.Assert(f.Skipped(), Equals, 4)
+
+	// DASH/ZEC/BTC shapes with a bad checksum or another chain's version
+	// byte are skipped instead of inferring that chain
+	notDASH := altBase58(0x4b) // X..., but not DASH's version byte
+	c.Assert(notDASH[0], Equals, byte('X'))
+	f = New(strings.Join([]string{
+		flipLast(dashP2PKH), flipLast(dashP2SH), flipLast(zecT3), flipLast(legacyBTC),
+		notDASH,
+		"t1Rv4exT7bqhZqi2j7xz8bUHDMxwosrjADU", // t1-shaped, bad checksum
+	}, ","))
+	c.Assert(f.Loaded(), Equals, 0)
+	c.Assert(f.Skipped(), Equals, 6)
+	for _, chain := range []common.Chain{common.DASHChain, common.ZECChain, common.BTCChain} {
+		c.Assert(f.Listed(chain, notDASH), Equals, false, Commentf("chain %s", chain))
+	}
+
+	// an explicit prefix still loads any shape under a supported chain
+	f = New("DASH:" + notDASH)
+	c.Assert(f.Loaded(), Equals, 1)
+	c.Assert(f.Listed(common.DASHChain, notDASH), Equals, true)
+}
+
+func (s *AddressFilterSuite) TestBTCValidation(c *C) {
+	// valid legacy P2PKH and P2SH load
+	p2sh := altBase58(0x05)
+	c.Assert(p2sh[0], Equals, byte('3'))
+	f := New(legacyBTC + "," + p2sh)
+	c.Assert(f.Loaded(), Equals, 2)
+	c.Assert(f.Listed(common.BTCChain, p2sh), Equals, true)
+
+	// bc1 with a bad checksum (one char changed): skipped
+	badBech32 := flipLast(seedBech32)
+	f = New(badBech32)
+	c.Assert(f.Loaded(), Equals, 0)
+	c.Assert(f.Skipped(), Equals, 1)
+	c.Assert(f.Listed(common.BTCChain, badBech32), Equals, false)
+
+	// bc1 prefix with garbage, and a testnet address: skipped
+	f = New("bc1notanaddress,tb1qw508d6qejxtdg4y5r3zarvary0c5xw7kxpjzsx")
+	c.Assert(f.Loaded(), Equals, 0)
+	c.Assert(f.Skipped(), Equals, 2)
+
+	// valid bc1 still loads, in either case
+	f = New(strings.ToUpper(seedBech32))
+	c.Assert(f.Loaded(), Equals, 1)
+	c.Assert(f.Listed(common.BTCChain, seedBech32), Equals, true)
+}
