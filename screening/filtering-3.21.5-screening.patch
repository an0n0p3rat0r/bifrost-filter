+func TestListConcurrentReadersSeeMatchingFingerprint(t *testing.T) {
+	ls := &listServer{body: addrList(10)}
+	srv := httptest.NewServer(http.HandlerFunc(ls.handler))
+	defer srv.Close()
+	clk := &clock{t: time.Unix(1_800_000_000, 0)}
+	l := newList(t, srv, clk, func(r *config.BifrostAddressFilterSource) { r.MaxShrinkPct = 100 })
+	_ = l.RefreshOnce(context.Background())
+	stop := make(chan struct{})
+	var bad atomic.Int32
+	var wg sync.WaitGroup
+	for i := 0; i < 4; i++ {
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			for {
+				select {
+				case <-stop:
+					return
+				default:
+				}
+				if s := l.Snapshot(); s != nil && s.Fingerprint != Fingerprint(s.Entries()) {
+					bad.Add(1)
+				}
+			}
+		}()
+	}
+	for i := 1; i <= 20; i++ {
+		ls.set(addrList(10+i), "")
+		_ = l.RefreshOnce(context.Background())
+	}
+	close(stop)
+	wg.Wait()
+	if bad.Load() != 0 {
+		t.Fatalf("%d reads saw a set without its fingerprint", bad.Load())
+	}
