+securityContext:
+  allowPrivilegeEscalation: false
+  readOnlyRootFilesystem: true
+  capabilities:
+    drop: ["ALL"]
+
+nodeSelector: {}
+
+affinity: {}
+
+tolerations: []
+
+imagePullSecrets: []
