+func (m *memGuardStore) DeleteTombstone(c common.Chain, a string) error {
+	for i, t := range m.tombs {
+		if t.Chain == c.String() && t.Address == a {
+			m.tombs = append(m.tombs[:i], m.tombs[i+1:]...)
+			return nil
+		}
+	}
+	return nil
+}
