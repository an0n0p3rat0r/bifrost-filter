+// Finding 4: combine: all with the breaker open must not skip on the static
+// source alone while the external source says Clean.
+func TestCombineAllBreakerDoesNotSkipOnStaticAlone(t *testing.T) {
+	g := newSyncGuard(true)
+	items := ethItems(1)
+	ext := &fnSource{name: "ext", answer: func(ctx context.Context, _ ItemDTO) Answer {
+		select {
+		case <-time.After(60 * time.Millisecond):
+		case <-ctx.Done():
+		}
+		return Answer{State: Clean}
+	}}
+	static := NewStaticSource(items[0].Address, nil)
+	s := NewScreener(ScreenerOptions{Sources: []Source{static, ext}, Guard: g, Combine: CombineAll, BreakerWindow: time.Second, ChainBudgetPct: 20})
+	for i := 0; i < 5 && !s.BreakerOpen(common.ETHChain); i++ {
+		s.ScreenTxIn(context.Background(), common.ETHChain, items)
+	}
+	if !s.BreakerOpen(common.ETHChain) {
+		t.Fatal("precondition: breaker open")
+	}
+	if v := s.ScreenTxIn(context.Background(), common.ETHChain, items)[ItemKey(items[0])]; v.Skip {
+		t.Fatalf("combine all skipped on static alone while the breaker is open: %+v", v.Answers)
+	}
+}
