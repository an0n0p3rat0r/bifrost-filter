+package observer
+
+import (
+	"errors"
+	"testing"
+
+	"github.com/stretchr/testify/require"
+
+	"gitlab.com/thorchain/thornode/v3/bifrost/thorclient/types"
+	"gitlab.com/thorchain/thornode/v3/common"
+	"gitlab.com/thorchain/thornode/v3/config"
+)
+
+// Round-3 review fixes (final verification of e5ab2e7c525). Each test fails
+// without its fix.
+
+// NEW-2: an invalid screening config (a typo in an adapter key, a bad
+// combine value, a duplicate source name) no longer drops the named static
+// sources: they still apply on inbound and outbound.
+func TestNamedStaticAppliesWhenAdapterConfigInvalid(t *testing.T) {
+	named := config.BifrostAddressFilterSource{Name: "ofac", Mode: "static", Addresses: reviewListed}
+	for _, tc := range []struct {
+		name string
+		cfg  config.BifrostAddressFilterConfiguration
+	}{
+		{"adapter_key_typo", config.BifrostAddressFilterConfiguration{Enabled: true, FilterOutbound: true,
+			AdapterErr: errors.New("address_filter: invalid keys: screen_deadlin"),
+			Sources:    []config.BifrostAddressFilterSource{named}}},
+		{"bad_combine", config.BifrostAddressFilterConfiguration{Enabled: true, FilterOutbound: true, Combine: "most",
+			Sources: []config.BifrostAddressFilterSource{named}}},
+		{"duplicate_source_name", config.BifrostAddressFilterConfiguration{Enabled: true, FilterOutbound: true,
+			Sources: []config.BifrostAddressFilterSource{named, {Name: "ofac", Mode: "list", Chains: []string{"BTC"},
+				URL: "http://127.0.0.1:1/list", Listed: "."}}}},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			o, vaultAddr := newNamedStaticObserver(t)
+			require.Nil(t, o.newAddressFilterAdapter(tc.cfg, t.TempDir()))
+			require.Equal(t, "invalid", o.afDisabled)
+			got := o.filterObservations(common.BTCChain, []*types.TxInItem{btcSwapFrom("i1", reviewListed, vaultAddr)}, false)
+			require.Empty(t, got, "NEW-2: a named static source must still drop on inbound when the config is invalid")
+			out := o.AddressFilterOutboundSet()
+			require.NotNil(t, out, "NEW-2: the signer needs the named static source on outbound")
+			require.True(t, out.Listed(common.BTCChain, reviewListed))
+		})
+	}
+}
+
+// NEW-5: in adapter mode a named static source drops on inbound exactly like
+// the legacy list: before screening, whatever the guard readiness or the
+// combine rule (here combine: all with an unready guard).
+func TestAdapterModeNamedStaticDropsBeforeScreening(t *testing.T) {
+	o, vaultAddr := newNamedStaticObserver(t)
+	cfg := config.BifrostAddressFilterConfiguration{Enabled: true, FilterOutbound: true, Combine: "all",
+		Sources: []config.BifrostAddressFilterSource{
+			{Name: "ofac", Mode: "static", Chains: []string{"BTC"}, Addresses: reviewListed},
+			{Name: "lst", Mode: "list", Chains: []string{"BTC"}, URL: "http://127.0.0.1:1/list", Listed: "."},
+		}}
+	a := o.newAddressFilterAdapter(cfg, t.TempDir())
+	require.NotNil(t, a, "adapter mode")
+	o.afAdapter = a
+	require.False(t, a.Guard.Ready(), "the guard is not ready yet")
+	got := o.filterObservations(common.BTCChain, []*types.TxInItem{btcSwapFrom("a1", reviewListed, vaultAddr)}, false)
+	require.Empty(t, got, "NEW-5: a named static source drops before screening, like the legacy key")
+	got = o.filterObservations(common.BTCChain, []*types.TxInItem{btcSwapFrom("a2", "1A1zP1eP5QGefi2DMPTfTL5SLmv7DivfNa", vaultAddr)}, false)
+	require.Len(t, got, 1, "an unlisted sender is observed")
+	// The vault/router/pool exemption is unchanged (covered by
+	// TestAdapterModeStaticPathNeverDropsGuardedSender).
+}
