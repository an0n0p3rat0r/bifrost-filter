+// Finding 6: two inbounds from the same listed sender in one batch stay
+// listed (agreeing results), conflicting results observe, and an address-only
+// batch sends each address once.
+func TestBatchDuplicateSender(t *testing.T) {
+	var listed atomic.Bool
+	var conflict atomic.Bool
+	var reverse atomic.Bool
+	var lastItems atomic.Int32
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		b, _ := io.ReadAll(r.Body)
+		var req struct {
+			Items []map[string]any `json:"items"`
+		}
+		_ = json.Unmarshal(b, &req)
+		lastItems.Store(int32(len(req.Items)))
+		var res []any
+		for i, it := range req.Items {
+			l := listed.Load()
+			if conflict.Load() && i == 1 {
+				l = !l
+			}
+			res = append(res, map[string]any{"chain": it["chain"], "address": it["address"], "listed": l, "tier": "own"})
+		}
+		if reverse.Load() {
+			for i, j := 0, len(res)-1; i < j; i, j = i+1, j-1 {
+				res[i], res[j] = res[j], res[i]
+			}
+		}
+		_ = json.NewEncoder(w).Encode(map[string]any{"results": res})
+	}))
+	defer srv.Close()
+	q, err := NewQuerySource(adrGjallarOn(t, srv, false), QuerySourceOptions{Builder: builder(t, adrGjallarOn(t, srv, false)), Client: srv.Client()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	addr := "0x00000000000000000000000000000000000000bb"
+	pair := []ItemDTO{ethItem(addr, "a", 10), ethItem(addr, "b", 10)}
+	listed.Store(true)
+	got := q.Check(context.Background(), common.ETHChain, pair)
+	if got[0].State != Listed || got[1].State != Listed {
+		t.Fatalf("both inbounds of a listed sender must stay listed: %v/%v", got[0], got[1])
+	}
+	conflict.Store(true)
+	// One result per item, in request order: each inbound gets its own.
+	got = q.Check(context.Background(), common.ETHChain, pair)
+	if got[0].State != Listed || got[1].State != Clean {
+		t.Fatalf("in-order results answer per inbound: %v/%v", got[0], got[1])
+	}
+	// Without results_in_order, out of order and no tx_id echoed: conflicting
+	// results for one address can't be told apart, so both are observed.
+	reverse.Store(true)
+	unordered := adrGjallarOn(t, srv, false)
+	unordered.Raw.ResultsInOrder = false
+	qu, err := NewQuerySource(unordered, QuerySourceOptions{Builder: builder(t, unordered), Client: srv.Client()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	got = qu.Check(context.Background(), common.ETHChain, pair)
+	if got[0].State != Unknown || got[1].State != Unknown {
+		t.Fatalf("conflicting unmatched results must observe: %v/%v", got[0], got[1])
+	}
+	reverse.Store(false)
+	conflict.Store(false)
+	// Address-only: one item per address in the request, the answer copied.
+	qa, err := NewQuerySource(adrGjallarOn(t, srv, true), QuerySourceOptions{Builder: builder(t, adrGjallarOn(t, srv, true)), Client: srv.Client()})
+	if err != nil {
+		t.Fatal(err)
+	}
+	got = qa.Check(context.Background(), common.ETHChain, pair)
+	if lastItems.Load() != 1 || got[0].State != Listed || got[1].State != Listed {
+		t.Fatalf("address-only dedupe: items=%d %v/%v", lastItems.Load(), got[0], got[1])
+	}
+}
