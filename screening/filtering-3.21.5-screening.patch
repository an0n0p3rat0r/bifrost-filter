+// ctxDepSrc is a context-dependent source answering per tx_id.
+type ctxDepSrc struct {
+	listedTx map[string]bool
+	calls    int
+}
+
+func (c *ctxDepSrc) Name() string             { return "ctx" }
+func (c *ctxDepSrc) Covers(common.Chain) bool { return true }
+func (c *ctxDepSrc) ContextDependent() bool   { return true }
+func (c *ctxDepSrc) Check(_ context.Context, _ common.Chain, items []ItemDTO) []Answer {
+	c.calls++
+	out := make([]Answer, len(items))
+	for i, it := range items {
+		if it.TxID != nil && c.listedTx[*it.TxID] {
+			out[i] = Answer{State: Listed}
+		} else {
+			out[i] = Answer{State: Clean}
+		}
+	}
+	return out
+}
