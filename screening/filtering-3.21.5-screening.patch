+const r3Addr = "0x00000000000000000000000000000000000000bb"
+
+// NEW-1: decoys can't push a listed sender's real inbound past the cap. The
+// reviewer's probe: every inbound is listed; the 33rd used to come back
+// Unknown (sender_cap) and was observed.
+func TestSenderCapExcessTakesSendersListed(t *testing.T) {
+	n := MaxItemsPerSender + 1
+	listed := map[string]bool{}
+	items := make([]ItemDTO, n)
+	for i := range items {
+		tx := fmt.Sprintf("tx%d", i)
+		listed[tx] = true
+		items[i] = ethItem(r3Addr, tx, 10)
+	}
+	s := newR3Server(t, listed)
+	got := r3Query(t, s, nil).Check(context.Background(), common.ETHChain, items)
+	for i, a := range got {
+		if a.State != Listed {
+			t.Fatalf("NEW-1: inbound %d of a listed sender is %v (%q)", i, a.State, a.Reason)
+		}
+	}
+	if s.maxPerAddr > MaxItemsPerSender {
+		t.Fatalf("one request carried %d inbounds of one sender, cap %d", s.maxPerAddr, MaxItemsPerSender)
+	}
+	if s.requests != 1 {
+		t.Fatalf("a sender already listed needs no follow-up: %d requests", s.requests)
+	}
+}
