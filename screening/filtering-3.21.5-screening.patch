+// NEW-1: with no Listed answer in the first round, the excess is asked in a
+// follow-up round (still at most MaxItemsPerSender per sender per request),
+// so a listed inbound behind 32 unverified decoys is still caught.
+func TestSenderCapExcessAskedInFollowUp(t *testing.T) {
+	n := MaxItemsPerSender + 8
+	items := make([]ItemDTO, n)
+	for i := range items {
+		items[i] = ethItem(r3Addr, fmt.Sprintf("tx%d", i), 10)
+	}
+	last := fmt.Sprintf("tx%d", n-1)
+	s := newR3Server(t, map[string]bool{last: true})
+	got := r3Query(t, s, nil).Check(context.Background(), common.ETHChain, items)
+	if got[n-1].State != Listed {
+		t.Fatalf("NEW-1: the listed inbound behind the cap is %v (%q)", got[n-1].State, got[n-1].Reason)
+	}
+	if s.maxPerAddr > MaxItemsPerSender {
+		t.Fatalf("one request carried %d inbounds of one sender, cap %d", s.maxPerAddr, MaxItemsPerSender)
+	}
+	if s.requests != 2 || s.itemsSeen != n {
+		t.Fatalf("want 2 rounds covering all %d inbounds once: requests=%d items=%d", n, s.requests, s.itemsSeen)
+	}
+	for i := 0; i < n-1; i++ {
+		if got[i].State != Unknown || ReasonKind(got[i].Reason) == KindSenderCap {
+			t.Fatalf("decoy %d keeps its own (unverified) answer, never sender_cap: %+v", i, got[i])
+		}
+	}
+}
+
+// NEW-1: inbounds under min_value are never asked and don't count toward the
+// cap, so dust decoys can't push the real inbound out; once the sender is
+// Listed, its dust inbounds in the same call are Listed too.
+func TestBelowFloorDecoysDontCountTowardCap(t *testing.T) {
+	b, err := NewBudget(BudgetConfig{MinValue: map[string]string{"ETH": "1"}}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	dust, real := "0.001", "5"
+	n := MaxItemsPerSender + 8
+	items := make([]ItemDTO, n)
+	for i := 0; i < n-1; i++ {
+		items[i] = ethItem(r3Addr, fmt.Sprintf("dust%d", i), 10)
+		items[i].Amount = &dust
+	}
+	items[n-1] = ethItem(r3Addr, "real", 10)
+	items[n-1].Amount = &real
+	s := newR3Server(t, map[string]bool{"real": true})
+	got := r3Query(t, s, b).Check(context.Background(), common.ETHChain, items)
+	if got[n-1].State != Listed {
+		t.Fatalf("NEW-1: the real inbound behind %d dust decoys is %v (%q)", n-1, got[n-1].State, got[n-1].Reason)
+	}
+	for i := 0; i < n-1; i++ {
+		if got[i].State != Listed {
+			t.Fatalf("dust inbound %d of a listed sender is %v (%q)", i, got[i].State, got[i].Reason)
+		}
+	}
+	if s.itemsSeen != 1 {
+		t.Fatalf("dust under min_value must never be sent: %d items sent", s.itemsSeen)
+	}
+}
