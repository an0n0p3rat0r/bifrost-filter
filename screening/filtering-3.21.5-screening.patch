@@ -0,0 +1,36 @@
+package pubkeymanager
+
+import (
+	"sync/atomic"
+	"testing"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+	"gitlab.com/thorchain/thornode/v3/x/thorchain/types"
+)
+
+// RegisterCallback runs while the pubkey refresh may already be adding keys
+// and firing callbacks (the observer registers after pubkeyMgr.Start). Under
+// -race this fails without the callback lock.
+func TestRegisterCallbackConcurrentWithAddPubKey(t *testing.T) {
+	pkm, err := NewPubKeyManager(nil, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var fired atomic.Int64
+	done := make(chan struct{})
+	go func() {
+		defer close(done)
+		for i := 0; i < 50; i++ {
+			pkm.AddPubKey(types.GetRandomPubKey(), false, common.SigningAlgoSecp256k1)
+		}
+	}()
+	for i := 0; i < 50; i++ {
+		pkm.RegisterCallback(func(common.PubKey) error { fired.Add(1); return nil })
+	}
+	<-done
+	before := fired.Load()
+	pkm.AddPubKey(types.GetRandomPubKey(), false, common.SigningAlgoSecp256k1)
+	if got := fired.Load() - before; got != 50 {
+		t.Fatalf("a new key must fire every registered callback once: fired %d, want 50", got)
+	}
+}
