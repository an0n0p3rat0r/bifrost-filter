+func TestRecheckStillListedBacksOffAndOldRecordArchives(t *testing.T) {
+	f := newRecheckFixture(t)
+	e := f.record(t, "bc1qlisted", "tx1")
+	src := &fnSource{name: "gj", answer: listedAll}
+	r := NewRechecker(RecheckerOptions{Ledger: f.l, Sources: []Source{src}, Guard: f.g, Now: f.clk.now, Rand: rand.New(rand.NewSource(1))})
+	r.Tick(context.Background())
+	got, _, _ := f.l.Get(e.Key())
+	if got.Attempts != 1 || !got.NextCheck.After(f.clk.now()) {
+		t.Fatalf("still listed: attempts %d next %s", got.Attempts, got.NextCheck)
+	}
+	first := got.NextCheck.Sub(f.clk.now())
+	if first < DefaultRecheckBase*2 || first > DefaultRecheckBase*2*11/10 {
+		t.Fatalf("first back-off %s", first)
+	}
+	// Back-off is capped at 6 h (+10 % jitter).
+	if d := r.backoff(40); d > DefaultRecheckCap*11/10 || d < DefaultRecheckCap {
+		t.Fatalf("capped back-off %s", d)
+	}
+	// 8 days later: archived with the alert, not deleted.
+	f.clk.add(8 * 24 * time.Hour)
+	st := r.Tick(context.Background())
+	if st.Archived != 1 {
+		t.Fatalf("stats %+v", st)
+	}
+	if _, ok := f.store.Archived(e.Key()); !ok {
+		t.Fatal("old record must be archived")
+	}
+}
