+// N6: the per-chain ledger share is max_records split over the configured
+// chains, so spamming a handful of cheap chains to their caps leaves room for
+// every other chain.
+func TestPerChainCapIsEvenShare(t *testing.T) {
+	var chains []common.Chain
+	for _, c := range []string{"BTC", "ETH", "BSC", "AVAX", "BASE", "LTC", "DOGE", "BCH", "GAIA", "TRON", "XRP", "SOL", "ZEC", "ADA", "DOT"} {
+		chains = append(chains, common.Chain(c))
+	}
+	v, err := Validate(config.BifrostAddressFilterConfiguration{Enabled: true, MaxRecords: 60}, chains, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	// Since round 3 the even share (60/15 = 4) is every chain's reserve and
+	// the cap is raised to the floor (min(100, max_records) = 60).
+	if v.ReservedPerChain != 4 || v.MaxRecordsPerChain != 60 {
+		t.Fatalf("per-chain share: reserve %d (want 60/15 = 4), cap %d (want the floor 60)", v.ReservedPerChain, v.MaxRecordsPerChain)
+	}
+	l := NewSkipLedger(NewMemLedgerStore(), v.MaxRecords, nil, nil)
+	l.SetChainCap(v.MaxRecordsPerChain)
+	l.SetChainReserve(v.ReservedPerChain)
+	for _, ch := range []string{"BSC", "BASE", "AVAX", "ETH"} {
+		for i := 0; i < 20; i++ {
+			e := testEnvelope(t, fillTxInItem(t))
+			e.Occurrence.Chain, e.Occurrence.TxID = ch, fmt.Sprintf("%s-%d", ch, i)
+			_ = l.Record(e) // past the share: ErrLedgerFull, as intended
+		}
+	}
+	e := testEnvelope(t, fillTxInItem(t))
+	e.Occurrence.Chain, e.Occurrence.TxID = "BTC", "b0"
+	if err := l.Record(e); err != nil {
+		t.Fatalf("N6: BTC must still record after 4 chains hit their caps: %v", err)
+	}
+	// An explicit value above the even share is kept (the reserve protects
+	// the other chains); the tiny share itself is warned.
+	v, err = Validate(config.BifrostAddressFilterConfiguration{Enabled: true, MaxRecords: 60, MaxRecordsPerChain: 30}, chains, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if v.MaxRecordsPerChain != 30 || v.ReservedPerChain != 4 || len(v.Warnings) != 1 {
+		t.Fatalf("explicit share above even: got %d reserve %d warnings=%v", v.MaxRecordsPerChain, v.ReservedPerChain, v.Warnings)
+	}
+}
