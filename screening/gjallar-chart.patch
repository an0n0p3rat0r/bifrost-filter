diff --git a/thornode/values.yaml b/thornode/values.yaml
index 76a243d2..b374fe47 100644
--- a/thornode/values.yaml
+++ b/thornode/values.yaml
@@ -303,6 +303,34 @@ bifrost:
     enabled: false
     baseRpcHost: http://erpc:4000/main/evm/8453
 
+  # Opt-in observation filter: bifrost skips observing an inbound whose sender a screening source
+  # lists (per-node policy, no consensus change). The default source is the Gjallar screening proxy
+  # (gjallar/ chart, deployed with gjallar.enabled=true in thornode-stack; see gjallar/README.md).
+  # Needs a bifrost image built with the screening adapter; a stock image ignores these keys.
+  # When enabled, BIFROST_ADDRESS_FILTER_ENABLED / _FILTER_OUTBOUND / _SOURCES (and SSL_CERT_DIR
+  # with caSecret) override the same keys in env or secretEnv.
+  screening:
+    enabled: false
+    # also refuse to sign outbounds to a listed destination (expect missed keysigns and jail)
+    filterOutbound: false
+    # Secret with the CA that issued Gjallar's TLS certificate (key ca.crt); mounted at
+    # /etc/bifrost-screening-ca and appended to SSL_CERT_DIR.
+    # trunk-ignore(checkov/CKV_SECRET_6): the name of a Secret, not a secret
+    caSecret: ""
+    # Rendered as JSON into BIFROST_ADDRESS_FILTER_SOURCES, one entry per source (mode static |
+    # list | query). list mode pulls Gjallar's exportable set per chain and refreshes it.
+    sources:
+      - name: gjallar
+        mode: list
+        chains: [BTC, ETH, BSC, AVAX, BASE, LTC, BCH, DOGE, TRON, XRP, ZEC]
+        url: https://gjallar:8443/v1/list/{chain}
+        auth: none
+        listed: .addresses
+        allow_private: true
+        allow_direct_egress: true
+        refresh: 10m
+        max_age: 2h
+
   # Provisioning the signer does NOT enable XMR in Bifrost or change any mimir.
   xmrSigner:
     enabled: false
