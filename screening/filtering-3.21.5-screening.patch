+	BudgetStore
+	GuardStore
+}
+
+// AdapterOptions configures NewAdapter.
+type AdapterOptions struct {
+	Chains []common.Chain
+	Stores AdapterStores
+	// StaticAddresses is the legacy bifrost.address_filter.addresses value.
+	StaticAddresses string
+	// RecheckInterval is the recheck tick period (default 30 s).
+	RecheckInterval time.Duration
+	// OnRelease hands a released record to replay; nil = record-only.
+	OnRelease func(*SkipEnvelope) error
+	// Warn receives rate-limited warnings (class, source, message).
+	Warn func(class, source, msg string)
+	Now  func() time.Time
+	// AckDir is where `bifrost address-filter list-ack <source>` drops a
+	// marker file; the adapter polls it and acks the held list (no network
+	// surface). Empty disables list-ack.
+	AckDir string
+	// Sources, when set, replaces the sources built from the validated specs
+	// (tests and embedders); list/query workers are then not created.
+	Sources []Source
+	// Metrics, when set, is used instead of a new set (the observer registers
+	// it before building the adapter, so an invalid config still reports).
+	Metrics *Metrics
+}
+
+// Adapter wires the screening stage used by the observer: sources, the
+// screener, the skip ledger, the recheck scheduler, the vault guard and the
+// outbound set. A legacy config (static addresses only) never builds an
+// Adapter; the observer keeps its static path unchanged.
+type Adapter struct {
+	v   Validated
+	now func() time.Time
+
+	Metrics   *Metrics
+	Guard     *Guard
+	Ledger    *SkipLedger
+	Screener  *Screener
+	Rechecker *Rechecker
+	Outbound  *OutboundSet
+	Static    *StaticSource
+
+	lists           []*ListSource
+	ackDir          string
+	warn            func(class, source, msg string)
+	inflight        *InflightCap
+	recheckInterval time.Duration
+
+	mu      sync.Mutex
+	cancel  context.CancelFunc
+	wg      sync.WaitGroup
+	started bool
+}
+
+// NeedsAdapter reports whether a validated config uses anything beyond the
+// legacy static list.
+func NeedsAdapter(v Validated) bool {
+	if !v.Enabled {
+		return false
+	}
+	for _, s := range v.Sources {
+		if s.Mode != "static" {
+			return true
+		}
+	}
+	return false
+}
+
+// NewAdapter builds the adapter from a validated config. Quarantined sources
+// were already removed by Validate.
+func NewAdapter(v Validated, o AdapterOptions) (*Adapter, error) {
+	if o.Stores == nil {
+		return nil, fmt.Errorf("address filter adapter needs a store")
+	}
+	if o.Now == nil {
+		o.Now = time.Now
+	}
+	if o.RecheckInterval <= 0 {
+		o.RecheckInterval = 30 * time.Second
+	}
+	m := o.Metrics
+	if m == nil {
+		m = NewMetrics()
+	}
+	a := &Adapter{
+		v: v, now: o.Now,
+		Metrics:         m,
+		inflight:        NewInflightCap(v.MaxInflight),
+		recheckInterval: o.RecheckInterval,
+		ackDir:          o.AckDir,
+		warn:            o.Warn,
+	}
+	guard, err := NewGuard(o.Stores, o.Chains)
+	if err != nil {
+		return nil, fmt.Errorf("vault guard: %w", err)
+	}
+	a.Guard = guard
+	warn := NewWarnLimiter(time.Minute, o.Now, o.Warn)
+
+	var sources []Source
+	var timeouts []time.Duration
+	specs := v.Sources
+	if len(o.Sources) > 0 {
+		sources, specs = o.Sources, nil
+	}
+	// Outbound static lists: the legacy address list always applies on every
+	// chain (as the legacy signer filter); each named static source keeps its
+	// own chains.
+	statics := NewStaticSet()
+	if o.StaticAddresses != "" {
+		statics.Add(New(o.StaticAddresses), nil)
+	}
+	for _, spec := range specs {
+		switch spec.Mode {
+		case "static":
+			addrs := spec.Raw.Addresses
+			if spec.Name == StaticSourceName && addrs == "" {
+				addrs = o.StaticAddresses // the legacy address_filter.addresses
+			}
+			st := NewNamedStaticSource(spec.Name, addrs, spec.Chains)
+			if spec.Name == StaticSourceName {
+				a.Static = st
+			}
+			if spec.Raw.Addresses != "" {
+				statics.Add(st.Filter(), spec.Chains)
+			}
+			sources = append(sources, st)
+		case "list":
+			b, client, err := buildTransport(spec)
+			if err != nil {
+				return nil, fmt.Errorf("source %s: %w", spec.Name, err)
+			}
+			name := spec.Name
+			ls, err := NewListSource(spec, ListSourceOptions{
+				Builder: b, Client: client, Now: o.Now,
+				OnPublish: func(*ListSnapshot) { a.publishLists() },
+				OnRefresh: func(err error, suspect bool) {
+					a.Metrics.setListSuspect(name, suspect)
+					if err != nil {
+						a.Metrics.sourceErrors(name, KindRefresh, 1)
+						warn.Warn("list_refresh", name, "list refresh failed (last good list kept until max_age): "+err.Error())
+					}
+				},
+			})
+			if err != nil {
+				return nil, fmt.Errorf("source %s: %w", spec.Name, err)
+			}
+			a.lists = append(a.lists, ls)
+			sources = append(sources, ls)
+		case "query":
+			b, client, err := buildTransport(spec)
+			if err != nil {
+				return nil, fmt.Errorf("source %s: %w", spec.Name, err)
+			}
+			r := spec.Raw
+			cred := spec.Name
+			budget, err := NewBudget(BudgetConfig{
+				Credential: spec.Name, Daily: r.DailyBudget, ChainShare: r.ChainShare,
+				HighValuePct: r.HighValueReserv, MinValue: r.MinValue, FreshAbove: r.FreshAbove,
+				Now:    o.Now,
+				OnUsed: func(pool string, used uint64) { a.Metrics.setBudgetUsed(cred, pool, used) },
+				Warn: func(pool string, used, limit uint64) {
+					warn.Warn("budget", cred, fmt.Sprintf("daily budget pool %s at %d of %d calls", pool, used, limit))
+				},
+			}, o.Stores)
+			if err != nil {
+				return nil, fmt.Errorf("source %s budget: %w", spec.Name, err)
+			}
+			var cache DecisionCache
+			if !spec.ContextDependent && r.Cache.MaxEntries > 0 {
+				cache = NewLRUCache(r.Cache.MaxEntries, r.Cache.ListedTTL, r.Cache.CleanTTL, guard)
+			}
+			qs, err := NewQuerySource(spec, QuerySourceOptions{
+				Builder: b, Client: client, Cache: cache, Budget: budget,
+				Guard: guard, Inflight: a.inflight, Now: o.Now,
+			})
+			if err != nil {
+				return nil, fmt.Errorf("source %s: %w", spec.Name, err)
+			}
+			sources = append(sources, qs)
+		default:
+			return nil, fmt.Errorf("source %s: unsupported mode %q", spec.Name, spec.Mode)
+		}
+		timeouts = append(timeouts, spec.Timeout)
+	}
+	// Under combine: all a quarantined source still covers its chains as a
+	// non-answer, so the remaining sources can't skip without it.
+	if v.Combine == CombineAll && len(o.Sources) == 0 {
+		for name := range v.Quarantined {
+			sources = append(sources, &quarantinedSource{name: name, chains: v.QuarantinedChains[name]})
+		}
+	}
+	for name := range v.Quarantined {
+		a.Metrics.SetQuarantined(name, true)
+	}
+	a.Outbound = NewOutboundSetFromStatic(statics, guard)
+	a.Ledger = NewSkipLedger(o.Stores, v.MaxRecords, a.Metrics, o.Now)
+	a.Ledger.SetChainCap(v.MaxRecordsPerChain)
+	a.Ledger.SetChainReserve(v.ReservedPerChain)
+	a.Ledger.SetSenderCap(v.MaxRecordsPerSender)
+	// A chain already over its cap (an upgrade lowered it) keeps its records;
+	// new skips there are observed until it drains below the cap.
+	chainNames := make([]string, 0, len(o.Chains))
+	for _, c := range o.Chains {
+		chainNames = append(chainNames, c.String())
+	}
+	for c, n := range a.Ledger.OverCap(chainNames) {
+		if o.Warn == nil {
+			break
+		}
+		o.Warn("ledger", "", fmt.Sprintf("chain %s holds %d skip records, over its cap %d: kept; new skips on %s are observed until it drains below the cap",
+			c, n, a.Ledger.ChainCap(), c))
+	}
+	a.Screener = NewScreener(ScreenerOptions{
+		Sources: sources, Guard: guard, Combine: v.Combine,
+		Deadline: v.ScreenDeadline, SourceTimeouts: timeouts,
+		ChainBudgetPct: v.ChainBudgetPct, Fingerprint: a.Fingerprint,
+		Metrics: a.Metrics, Warn: warn, Now: o.Now,
+	})
+	a.Rechecker = NewRechecker(RecheckerOptions{
+		Ledger: a.Ledger, Sources: sources, Guard: guard, Combine: v.Combine,
+		Page: v.RecheckPage, Retention: v.Retention, Deadline: v.ScreenDeadline,
+		Inflight: a.inflight, OnRelease: o.OnRelease, Metrics: a.Metrics,
+	})
+	return a, nil
+}
+
+// quarantinedSource stands in, under combine: all, for a source a config
+// error disabled: it covers that source's chains and never answers.
+type quarantinedSource struct {
+	name   string
+	chains []common.Chain // nil = every chain
+}
+
+func (q *quarantinedSource) Name() string { return q.name }
+
+// InMemory: it does no I/O, so it is never dropped by the breaker either.
+func (q *quarantinedSource) InMemory() bool { return true }
+
+func (q *quarantinedSource) Covers(chain common.Chain) bool {
+	if q.chains == nil {
+		return true
+	}
+	for _, c := range q.chains {
+		if c.Equals(chain) {
+			return true
+		}
+	}
+	return false
+}
+
+func (q *quarantinedSource) Check(_ context.Context, _ common.Chain, items []ItemDTO) []Answer {
+	return fill(len(items), Answer{State: Unknown, Reason: KindQuarantined})
+}
+
+func buildTransport(spec SourceSpec) (*RequestBuilder, *http.Client, error) {
+	auth, err := NewAuthenticator(spec, spec.SecretFiles)
+	if err != nil {
+		return nil, nil, err
+	}
+	b, err := NewRequestBuilder(spec, spec.SecretFiles, auth)
+	if err != nil {
+		return nil, nil, err
+	}
+	pol, err := PolicyFor(spec, auth != nil)
+	if err != nil {
+		return nil, nil, err
+	}
+	return b, NewHTTPClient(pol), nil
+}
+
+// publishLists swaps the outbound set to the current list snapshots.
+func (a *Adapter) publishLists() {
+	snaps := make([]*ListSnapshot, 0, len(a.lists))
+	for _, l := range a.lists {
+		if s := l.Snapshot(); s != nil {
+			snaps = append(snaps, s)
+		}
+	}
+	a.Outbound.SwapLists(snaps)
+}
+
+// Fingerprint is the union of the published list fingerprints, sorted.
+func (a *Adapter) Fingerprint() string {
+	var fps []string
+	for _, l := range a.lists {
+		if s := l.Snapshot(); s != nil && s.Fingerprint != "" {
+			fps = append(fps, s.Source+"="+s.Fingerprint)
+		}
+	}
+	sort.Strings(fps)
+	return strings.Join(fps, ",")
+}
+
+// ListSource returns the running list source by name (for list-ack).
+func (a *Adapter) ListSource(name string) *ListSource {
+	for _, l := range a.lists {
+		if l.Name() == name {
+			return l
+		}
+	}
+	return nil
+}
+
+// Start launches the list-refresh and recheck workers. Idempotent.
+func (a *Adapter) Start(parent context.Context) {
+	a.mu.Lock()
+	defer a.mu.Unlock()
+	if a.started {
+		return
+	}
+	a.started = true
+	ctx, cancel := context.WithCancel(parent)
+	a.cancel = cancel
+	for _, l := range a.lists {
+		l := l
+		a.wg.Add(1)
+		go func() {
+			defer a.wg.Done()
+			l.Run(ctx)
+		}()
+	}
+	if a.ackDir != "" && len(a.lists) > 0 {
+		a.wg.Add(1)
+		go func() {
+			defer a.wg.Done()
+			t := time.NewTicker(AckPollInterval)
+			defer t.Stop()
+			for {
+				select {
+				case <-ctx.Done():
+					return
+				case <-t.C:
+					a.ProcessAcks()
+				}
+			}
+		}()
+	}
+	a.wg.Add(1)
+	go func() {
+		defer a.wg.Done()
+		t := time.NewTicker(a.recheckInterval)
+		defer t.Stop()
+		for {
+			select {
+			case <-ctx.Done():
+				return
+			case <-t.C:
+				a.Rechecker.Tick(WithRecheck(ctx))
+			}
+		}
+	}()
+}
+
+// Stop cancels and joins every worker. The caller closes the store after.
+func (a *Adapter) Stop() {
+	a.mu.Lock()
+	cancel := a.cancel
+	a.mu.Unlock()
+	if cancel != nil {
+		cancel()
+	}
+	a.wg.Wait()
+}
+
+// Screen builds DTOs for eligible items and screens them once. The returned
+// map is keyed by ItemKey; items not in the map were not screened.
+func (a *Adapter) Screen(ctx context.Context, chain common.Chain, items []*stypes.TxInItem, blockTime int64) map[string]Verdict {
+	if len(items) == 0 {
+		return nil
+	}
+	dtos := make([]ItemDTO, 0, len(items))
+	for _, it := range items {
+		dtos = append(dtos, NewItemDTO(chain, it, blockTime))
+	}
+	return a.Screener.ScreenTxIn(ctx, chain, dtos)
+}
+
+// Key is the verdict-map key of one item.
+func (a *Adapter) Key(chain common.Chain, it *stypes.TxInItem, blockTime int64) string {
+	return ItemKey(NewItemDTO(chain, it, blockTime))
+}
+
+// RecordSkip writes the replayable envelope for a skipped item. The item may
+// be dropped only when this returns nil.
+func (a *Adapter) RecordSkip(chain common.Chain, it *stypes.TxInItem, blockTime int64, txCtx TxInContext, v Verdict) error {
+	env := &SkipEnvelope{
+		Occurrence: Occurrence{Chain: chain.String(), TxID: it.Tx, BlockHeight: it.BlockHeight, BlockHash: it.BlockHash},
+		Context:    txCtx,
+		Item:       *it,
+		Screening: Screening{
+			Inputs: NewItemDTO(chain, it, blockTime), Answers: v.Answers,
+			Combine: v.Combine, Fingerprint: v.Fingerprint, GuardEpoch: v.GuardEpoch,
+		},
+		Reason: TruncateReason(skipReason(v)),
+	}
+	return a.Ledger.Record(env)
+}
+
+func skipReason(v Verdict) string {
+	names := make([]string, 0, len(v.Answers))
+	for n, ans := range v.Answers {
+		if ans.State == Listed {
+			names = append(names, n)
+		}
+	}
+	sort.Strings(names)
+	return "listed by " + strings.Join(names, ",")
+}
+
+// AckPollInterval is how often the adapter looks for list-ack markers.
+const AckPollInterval = 10 * time.Second
+
+// AckMarkerPath is the marker file for source name under dir. It refuses
+// names that are not a single path element.
+func AckMarkerPath(dir, source string) (string, error) {
+	if source == "" || source != filepath.Base(source) || strings.ContainsAny(source, `/\`) || source == "." || source == ".." {
+		return "", fmt.Errorf("invalid source name %q", source)
+	}
+	return filepath.Join(dir, source), nil
+}
+
+// ProcessAcks acks every list source with a marker in the ack dir, then
+// removes the marker. It returns the sources whose held list was published.
+func (a *Adapter) ProcessAcks() []string {
+	var acked []string
+	for _, l := range a.lists {
+		p, err := AckMarkerPath(a.ackDir, l.Name())
+		if err != nil {
+			continue
+		}
+		if _, err := os.Stat(p); err != nil {
+			continue
+		}
+		held := l.ListAck()
+		if err := os.Remove(p); err != nil && a.warn != nil {
+			a.warn("list_ack", l.Name(), "list-ack marker not removed: "+err.Error())
+		}
+		if a.warn != nil {
+			if held {
+				a.warn("list_ack", l.Name(), "held list published by list-ack")
+			} else {
+				a.warn("list_ack", l.Name(), "list-ack: nothing held")
+			}
+		}
+		if held {
+			acked = append(acked, l.Name())
+		}
+	}
+	return acked
+}
diff --git a/bifrost/pkg/addressfilter/adapter_test.go b/bifrost/pkg/addressfilter/adapter_test.go
new file mode 100644
index 00000000000..f858a78c22a
--- /dev/null
+++ b/bifrost/pkg/addressfilter/adapter_test.go
@@ -0,0 +1,71 @@
+package addressfilter
+
+import (
+	"context"
+	"net/http"
+	"net/http/httptest"
+	"os"
+	"path/filepath"
+	"testing"
+	"time"
+)
+
+func TestAdapterListAckMarkerPublishesHeldList(t *testing.T) {
+	ls := &listServer{body: addrList(100)}
+	srv := httptest.NewServer(http.HandlerFunc(ls.handler))
+	defer srv.Close()
+	clk := &clock{t: time.Unix(1_800_000_000, 0)}
+	l := newList(t, srv, clk, nil)
+	if err := l.RefreshOnce(context.Background()); err != nil {
+		t.Fatal(err)
+	}
+	ls.set(`{"addresses":[]}`, "")
+	if err := l.RefreshOnce(context.Background()); err == nil || !l.Suspect() {
+		t.Fatalf("shrink must be held, err=%v", err)
+	}
+	dir := t.TempDir()
+	var msgs []string
+	a := &Adapter{lists: []*ListSource{l}, ackDir: dir, warn: func(_, _, m string) { msgs = append(msgs, m) }}
+
+	// No marker: nothing happens.
+	if got := a.ProcessAcks(); len(got) != 0 || !l.Suspect() {
+		t.Fatalf("no marker must not ack: %v", got)
+	}
+	p, err := AckMarkerPath(dir, "lst")
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(p, []byte("x"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if got := a.ProcessAcks(); len(got) != 1 || got[0] != "lst" {
+		t.Fatalf("marker must ack the held list: %v", got)
+	}
+	if l.Suspect() || l.Snapshot().Size != 0 {
+		t.Fatal("held list not published")
+	}
+	if _, err := os.Stat(p); !os.IsNotExist(err) {
+		t.Fatal("marker must be removed after processing")
+	}
+	// A second marker with nothing held is consumed and reports nothing.
+	if err := os.WriteFile(p, []byte("x"), 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if got := a.ProcessAcks(); len(got) != 0 {
+		t.Fatalf("nothing held: %v", got)
+	}
+	if len(msgs) != 2 {
+		t.Fatalf("each ack is logged: %v", msgs)
+	}
+}
+
+func TestAckMarkerPathRejectsTraversal(t *testing.T) {
+	for _, bad := range []string{"", ".", "..", "../x", "a/b", `a\b`, "/abs"} {
+		if _, err := AckMarkerPath("/d", bad); err == nil {
+			t.Fatalf("%q must be rejected", bad)
+		}
+	}
+	if p, err := AckMarkerPath("/d", "lst"); err != nil || p != filepath.Join("/d", "lst") {
+		t.Fatalf("good name: %q %v", p, err)
+	}
+}
diff --git a/bifrost/pkg/addressfilter/addressfilter.go b/bifrost/pkg/addressfilter/addressfilter.go
new file mode 100644
index 00000000000..727b3a1526c
--- /dev/null
+++ b/bifrost/pkg/addressfilter/addressfilter.go
@@ -0,0 +1,315 @@
+// Package addressfilter implements the opt-in static inbound address filter.
+//
+// Operators configure a comma-separated list of sanctioned addresses; the
+// observer drops any inbound observation whose sender is in the set, before
+// the observation is signed or gossiped. The filter only ever drops inbounds
+// — it never fabricates or rewrites observations — so a bad entry can
+// over-block but never corrupt state.
+//
+// The chain is inferred only from unambiguous, validated address shapes:
+//
+//	0x + 40 hex   -> all EVM chains (the same key controls a 0x address on
+//	                 every EVM chain, so one entry filters them all)
+//	bc1...        -> BTC segwit/taproot; must decode as a valid mainnet
+//	                 bech32/bech32m address (matched case-insensitively)
+//	1... / 3...   -> BTC legacy; must be valid base58check with the BTC
+//	                 mainnet P2PKH/P2SH version byte (exact match)
+//
+// Every other chain needs an explicit "CHAIN:address" entry (e.g. SOL:,
+// TRON:, DOGE:, LTC:). An unprefixed entry that matches none of the shapes
+// above is skipped and counted in Skipped, never guessed onto a chain: many
+// chains share base58 shapes, and a wrong guess would load an entry that can
+// never match.
+package addressfilter
+
+import (
+	"strings"
+
+	"github.com/btcsuite/btcd/chaincfg"
+	"github.com/btcsuite/btcutil"
+	"github.com/btcsuite/btcutil/base58"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+)
+
+// evmBucket is the set shared by all EVM chains.
+const evmBucket = "EVM"
+
+// Filter is a static set of listed addresses. It is read-only after New and
+// safe for concurrent use. A nil *Filter is valid and matches nothing, which
+// keeps the feature fully inert when disabled.
+type Filter struct {
+	sets    map[string]map[string]struct{}
+	loaded  int
+	skipped int
+}
+
+// New parses a comma-separated address list. Unparseable entries are skipped
+// (and counted) rather than failing startup: a typo must not take down the
+// observer, only narrow the filter.
+func New(addresses string) *Filter {
+	f := &Filter{sets: map[string]map[string]struct{}{}}
+	for _, entry := range strings.Split(addresses, ",") {
+		entry = strings.TrimSpace(entry)
+		if entry == "" {
+			continue
+		}
+		bucket, addr, ok := classify(entry)
+		if !ok {
+			f.skipped++
+			continue
+		}
+		set := f.sets[bucket]
+		if set == nil {
+			set = map[string]struct{}{}
+			f.sets[bucket] = set
+		}
+		if _, dup := set[addr]; !dup {
+			set[addr] = struct{}{}
+			f.loaded++
+		}
+	}
+	return f
+}
+
+// knownChains is the set of chain tickers accepted in explicit "CHAIN:"
+// prefixes; a typo'd ticker (e.g. ETC for ETH) is skipped rather than
+// silently creating an inert bucket.
+var knownChains = func() map[string]bool {
+	m := make(map[string]bool, len(common.AllChains))
+	for _, c := range common.AllChains {
+		m[c.String()] = true
+	}
+	return m
+}()
+
+// maxAddrLen bounds an address/entry length before decoding. Every supported
+// address encoding is well under this (bech32 caps at 90, base58check far less);
+// the bound also stops base58check's O(n²) big-int decode from doing unbounded
+// work on a pathological long config entry.
+const maxAddrLen = 128
+
+// isPrintableASCII reports whether s is non-empty, at most maxAddrLen bytes, and
+// every byte is printable ASCII (33..126). A real address is always printable
+// ASCII within that length; rejecting anything else up front keeps a stray
+// non-ASCII byte — a smart quote, en dash, ellipsis or zero-width space pasted
+// from a sanctions list — away from the base58 and bech32 decoders, some of
+// which index a 256-entry table by rune and panic on a rune ≥256, and caps the
+// decode cost. Upholds the contract that a bad entry only narrows the filter,
+// never takes down the observer.
+func isPrintableASCII(s string) bool {
+	if s == "" || len(s) > maxAddrLen {
+		return false
+	}
+	for i := 0; i < len(s); i++ {
+		if s[i] < 33 || s[i] > 126 {
+			return false
+		}
+	}
+	return true
+}
+
+// classify returns the set bucket and normalized form for one config entry.
+func classify(entry string) (bucket, addr string, ok bool) {
+	// Reject non-ASCII entries before any decoder runs (see isPrintableASCII).
+	if !isPrintableASCII(entry) {
+		return "", "", false
+	}
+	// explicit "CHAIN:address" override. An explicit chain scopes the entry to
+	// THAT chain's own bucket — including an EVM chain (e.g. "ETH:0x…" matches
+	// only ETH, not every EVM chain). A bare "0x…" (shape inference below) still
+	// lands in the shared EVM bucket and matches every EVM chain. This lets an
+	// operator choose cross-EVM (bare 0x) vs single-chain (CHAIN:0x) per entry.
+	//
+	// Note: BCH uses a ':' in cashaddr ("bitcoincash:q…"); only treat a prefix
+	// as a CHAIN ticker when it actually resolves to a known chain, so a BCH
+	// cashaddr with its coin prefix is not mistaken for "BITCOINCASH:" ticker.
+	if ticker, rest, found := strings.Cut(entry, ":"); found && ticker != "" && rest != "" {
+		if chain, err := common.NewChain(strings.ToUpper(ticker)); err == nil && knownChains[chain.String()] {
+			return chain.String(), normalize(chain, rest), true
+		}
+	}
+	// Shape inference for bare entries. Each stored form is run through the SAME
+	// normalize() the query side uses, so the match is symmetric by construction
+	// (a prior bug stored the legacy form raw while the query was normalized).
+	switch {
+	case len(entry) == 42 && strings.HasPrefix(entry, "0x") && isHex(entry[2:]):
+		return evmBucket, normalize(common.ETHChain, entry), true
+	case len(entry) >= 3 && strings.EqualFold(entry[:3], "bc1"):
+		lower := strings.ToLower(entry)
+		if !isBTCSegwit(lower) {
+			return "", "", false
+		}
+		return common.BTCChain.String(), normalize(common.BTCChain, lower), true
+	case len(entry) >= 26 && len(entry) <= 35 && (entry[0] == '1' || entry[0] == '3') && isBTCLegacy(entry):
+		return common.BTCChain.String(), normalize(common.BTCChain, entry), true
+	}
+	// anything else is ambiguous across chains and needs a "CHAIN:" prefix
+	return "", "", false
+}
+
+// isBTCSegwit reports whether s (lowercase) is a valid BTC mainnet segwit or
+// taproot address: correct "bc" HRP, bech32/bech32m checksum and witness
+// program. A typo fails the checksum and is skipped instead of loading an
+// entry that can never match.
+func isBTCSegwit(s string) bool {
+	addr, err := btcutil.DecodeAddress(s, &chaincfg.MainNetParams)
+	if err != nil || !addr.IsForNet(&chaincfg.MainNetParams) {
+		return false
+	}
+	switch addr.(type) {
+	case *btcutil.AddressWitnessPubKeyHash, *btcutil.AddressWitnessScriptHash, *btcutil.AddressTaproot:
+		return true
+	}
+	return false
+}
+
+// isBTCLegacy reports whether s is a valid base58check BTC mainnet P2PKH or
+// P2SH address. Other chains' base58 addresses (TRON, DOGE, LTC, SOL, ...)
+// fail the version-byte or checksum check.
+func isBTCLegacy(s string) bool {
+	addr, err := btcutil.DecodeAddress(s, &chaincfg.MainNetParams)
+	if err != nil || !addr.IsForNet(&chaincfg.MainNetParams) {
+		return false
+	}
+	switch addr.(type) {
+	case *btcutil.AddressPubKeyHash, *btcutil.AddressScriptHash:
+		return true
+	}
+	return false
+}
+
+// bech32Charset is the bech32/bech32m data charset (BIP173/350). It excludes
+// '1', 'b', 'i', 'o'.
+const bech32Charset = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"
+
+// isBech32 reports whether s should be treated as a case-insensitive bech32/
+// bech32m address (and therefore case-folded by normalize). It is used ONLY to
+// decide whether lowercasing is safe — bech32 is case-insensitive (canonical
+// lowercase), base58 is case-sensitive and must never be folded.
+//
+// Two gates, both required:
+//  1. s must NOT decode as a base58check string (any version byte). This
+//     excludes BTC/LTC/DOGE legacy, TRON and other base58check addresses — the
+//     structural check alone misfires on ~10% of them (a lowercased legacy
+//     address can satisfy the HRP+separator+charset shape), which previously
+//     folded a stored entry asymmetrically and silently bypassed the filter.
+//  2. s must match the bech32 structure: non-empty HRP, a '1' separator, and a
+//     data part of ≥6 chars from the bech32 charset.
+//
+// normalize is applied symmetrically in New (via classify) and Listed, so even
+// a residual misfire on a non-base58check scheme (SOL/XMR/XRP, which carry no
+// base58check checksum) folds both the entry and the query identically — a
+// queried address always matches itself. The only theoretical effect is
+// over-blocking a DISTINCT case-variant of a listed address on such a chain;
+// that is not an evasion (the sender can only reach it by grinding a key to a
+// cased variant, ~2^-190) and never lets a listed address slip through.
+func isBech32(s string) bool {
+	if !isPrintableASCII(s) {
+		return false // non-ASCII: never a bech32 address, and guards the decoder below
+	}
+	if _, _, err := base58.CheckDecode(s); err == nil {
+		return false // valid base58check — case-sensitive, never fold
+	}
+	s = strings.ToLower(s)
+	i := strings.LastIndexByte(s, '1')
+	if i < 1 || len(s)-(i+1) < 6 {
+		return false
+	}
+	for j := 0; j < i; j++ { // HRP: printable ASCII
+		if s[j] < 33 || s[j] > 126 {
+			return false
+		}
+	}
+	for j := i + 1; j < len(s); j++ { // data: bech32 charset only
+		if strings.IndexByte(bech32Charset, s[j]) < 0 {
+			return false
+		}
+	}
+	return true
+}
+
+// normalize applies the per-chain comparison form so the same destination
+// matches regardless of the (case-insensitive) spelling a user supplies:
+//   - EVM: hex, case-insensitive -> lowercase.
+//   - BCH: strip the "bitcoincash:"/"bchtest:" cashaddr prefix and lowercase
+//     the (case-insensitive) cashaddr body. Legacy base58 BCH is left exact —
+//     a documented residual; list BCH in cashaddr form.
+//   - Any valid bech32/bech32m address (bc1, ltc1, cosmos1, addr1, tex1, …) is
+//     case-insensitive -> lowercase.
+//   - Everything else (base58: DOGE/TRON/SOL/XRP/XMR/ZEC t-addr) is
+//     case-sensitive -> exact.
+//
+// Applied symmetrically in New (entries) and Listed (queries), so even a
+// mis-folded base58 string still matches itself; and distinct base58 addresses
+// that differ only in case are not both valid (base58check), so no collision.
+func normalize(chain common.Chain, addr string) string {
+	switch {
+	case chain.IsEVM():
+		return strings.ToLower(addr)
+	case chain.Equals(common.BCHChain):
+		body := addr
+		if idx := strings.LastIndexByte(body, ':'); idx >= 0 {
+			body = body[idx+1:]
+		}
+		// Only fold a cashaddr body, never a legacy base58 address (leading 1/3).
+		if len(body) > 0 && body[0] != '1' && body[0] != '3' {
+			return strings.ToLower(body)
+		}
+		return addr
+	case isBech32(addr):
+		return strings.ToLower(addr)
+	default:
+		return addr
+	}
+}
+
+// Listed reports whether address on chain is in the filter set. For an EVM
+// chain it checks BOTH the shared EVM bucket (bare "0x…" entries apply to every
+// EVM chain) and the chain's own bucket (scoped "ETH:0x…" entries). For a
+// non-EVM chain it checks only that chain's bucket.
+func (f *Filter) Listed(chain common.Chain, address string) bool {
+	if f == nil {
+		return false
+	}
+	norm := normalize(chain, address)
+	if chain.IsEVM() {
+		if set := f.sets[evmBucket]; set != nil {
+			if _, ok := set[norm]; ok {
+				return true
+			}
+		}
+	}
+	if set := f.sets[chain.String()]; set != nil {
+		if _, ok := set[norm]; ok {
+			return true
+		}
+	}
+	return false
+}
+
+// Loaded returns the number of deduplicated entries in the set.
+func (f *Filter) Loaded() int {
+	if f == nil {
+		return 0
+	}
+	return f.loaded
+}
+
+// Skipped returns the number of config entries dropped as unparseable.
+func (f *Filter) Skipped() int {
+	if f == nil {
+		return 0
+	}
+	return f.skipped
+}
+
+func isHex(s string) bool {
+	for i := 0; i < len(s); i++ {
+		c := s[i]
+		if (c < '0' || c > '9') && (c < 'a' || c > 'f') && (c < 'A' || c > 'F') {
+			return false
+		}
+	}
+	return len(s) > 0
+}
