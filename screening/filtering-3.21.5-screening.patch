@@ -0,0 +1,38 @@
+package addressfilter
+
+import (
+	"net/http"
+	"testing"
+	"time"
+
+	"gitlab.com/thorchain/thornode/v3/config"
+)
+
+func TestAuthenticatorModes(t *testing.T) {
+	secrets := map[string]string{"/tok": "T0K", "/sec": "S3C", "/ek": "key-1", "/es": "c3ludGhldGljLXNlY3JldC1mb3ItdGVzdHM="}
+	mk := func(r config.BifrostAddressFilterSource) *Authenticator {
+		a, err := NewAuthenticator(SourceSpec{Raw: r}, secrets)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return a
+	}
+	req, _ := http.NewRequest("GET", "https://v.example/x?a=1", nil)
+	sh, _, _ := mk(config.BifrostAddressFilterSource{Auth: "bearer", TokenFile: "/tok"}).Apply(req, nil, time.Now())
+	if req.Header.Get("Authorization") != "Bearer T0K" || sh[0] != "Authorization" {
+		t.Fatal("bearer")
+	}
+	req, _ = http.NewRequest("GET", "https://v.example/x?a=1", nil)
+	_, sp, _ := mk(config.BifrostAddressFilterSource{Auth: "query", QueryParam: "api_key", SecretFile: "/sec"}).Apply(req, nil, time.Now())
+	if req.URL.Query().Get("api_key") != "S3C" || sp[0] != "api_key" || req.URL.Query().Get("a") != "1" {
+		t.Fatal("query")
+	}
+	req, _ = http.NewRequest("POST", "https://v.example/v2/wallet/synchronous", nil)
+	sh, _, err := mk(config.BifrostAddressFilterSource{Auth: "signer:elliptic-hmac", KeyFile: "/ek", SecretFile: "/es"}).Apply(req, []byte(`{}`), time.UnixMilli(5))
+	if err != nil || req.Header.Get("x-access-sign") == "" || len(sh) != 2 {
+		t.Fatalf("signer %v %v", err, req.Header)
+	}
+	if mk(config.BifrostAddressFilterSource{}).Signed() {
+		t.Fatal("none must not be signed")
+	}
+}
diff --git a/bifrost/pkg/addressfilter/budget.go b/bifrost/pkg/addressfilter/budget.go
new file mode 100644
index 00000000000..b02a4773d2b
--- /dev/null
+++ b/bifrost/pkg/addressfilter/budget.go
@@ -0,0 +1,326 @@
+package addressfilter
+
+import (
+	"errors"
+	"fmt"
+	"math/big"
+	"strings"
+	"sync"
+	"time"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+)
+
+// Budget pools. Chains without a chain_share draw from the shared rest pool.
+const (
+	poolReserve  = "_reserve"
+	poolRest     = "_rest"
+	poolRecovery = "_recovery"
+	// DefaultRecoveryPct is the share of a daily budget kept for rechecks, so
+	// recovery work can't starve live screening (and the reverse).
+	DefaultRecoveryPct = 10
+	budgetWarnPct      = 80
+)
+
+// Budget reasons returned with a refused reservation.
+const (
+	BudgetBelowFloor = "below_floor"
+	BudgetExhausted  = "budget"
+	BudgetStoreError = "budget_store"
+)
+
+// Budget enforces one credential's daily call budget (R3-A11): sources that
+// share a secret file share one Budget. The day (UTC) is split into per-chain
+// shares, a high-value reserve and a recovery pool; items under min_value
+// never cost a call. Counters live in the BudgetStore, so a restart keeps the
+// day's spend. Any store failure answers "no call" (the item is Unknown).
+type Budget struct {
+	cred       string
+	store      BudgetStore
+	daily      uint64
+	shares     map[string]int
+	reservePct int
+	recovery   int
+	minValue   map[string]*big.Rat
+	freshAbove map[string]*big.Rat
+	now        func() time.Time
+	warn       func(pool string, used, limit uint64)
+	onUsed     func(pool string, used uint64)
+
+	mu     sync.Mutex
+	warned map[string]bool // day|pool
+}
+
+// BudgetConfig is the budget part of a source spec.
+type BudgetConfig struct {
+	Credential   string
+	Daily        uint64
+	ChainShare   map[string]int    // chain -> % of the non-reserved budget
+	HighValuePct int               // reserve, usable only at or above fresh_above
+	MinValue     map[string]string // chain -> decimal amount (DTO units)
+	FreshAbove   map[string]string // chain -> decimal amount (DTO units)
+	RecoveryPct  int               // 0 = DefaultRecoveryPct
+	Now          func() time.Time
+	Warn         func(pool string, used, limit uint64)
+	// OnUsed receives the pool's spend after each charge (budget_used gauge).
+	OnUsed func(pool string, used uint64)
+}
+
+func parseAmounts(m map[string]string) (map[string]*big.Rat, error) {
+	out := map[string]*big.Rat{}
+	for k, v := range m {
+		r, ok := new(big.Rat).SetString(strings.TrimSpace(v))
+		if !ok || r.Sign() < 0 {
+			return nil, fmt.Errorf("bad amount %q for %s", v, k)
+		}
+		out[asciiUpper(k)] = r
+	}
+	return out, nil
+}
+
+// NewBudget validates a budget config. Daily 0 means unlimited (no budget).
+func NewBudget(c BudgetConfig, store BudgetStore) (*Budget, error) {
+	b := &Budget{
+		cred: c.Credential, store: store, daily: c.Daily, shares: map[string]int{},
+		reservePct: c.HighValuePct, recovery: c.RecoveryPct, now: c.Now, warn: c.Warn,
+		onUsed: c.OnUsed, warned: map[string]bool{},
+	}
+	if b.recovery == 0 {
+		b.recovery = DefaultRecoveryPct
+	}
+	sum := 0
+	for k, v := range c.ChainShare {
+		if v < 0 || v > 100 {
+			return nil, fmt.Errorf("chain_share %s=%d", k, v)
+		}
+		b.shares[asciiUpper(k)] = v
+		sum += v
+	}
+	if sum > 100 || b.reservePct < 0 || b.recovery < 0 || b.reservePct+b.recovery >= 100 {
+		return nil, errors.New("budget shares exceed 100%")
+	}
+	var err error
+	if b.minValue, err = parseAmounts(c.MinValue); err != nil {
+		return nil, err
+	}
+	if b.freshAbove, err = parseAmounts(c.FreshAbove); err != nil {
+		return nil, err
+	}
+	if b.now == nil {
+		b.now = time.Now
+	}
+	if b.daily > 0 && store == nil {
+		return nil, errors.New("budget needs a store")
+	}
+	return b, nil
+}
+
+func pct(n uint64, p int) uint64 { return n * uint64(p) / 100 }
+
+func (b *Budget) general() uint64 {
+	return b.daily - pct(b.daily, b.reservePct) - pct(b.daily, b.recovery)
+}
+
+func (b *Budget) chainPool(chain string) (pool string, limit uint64) {
+	if s, ok := b.shares[chain]; ok {
+		return chain, pct(b.general(), s)
+	}
+	used := 0
+	for _, s := range b.shares {
+		used += s
+	}
+	return poolRest, pct(b.general(), 100-used)
+}
+
+func amountRat(value string) (*big.Rat, bool) {
+	if strings.TrimSpace(value) == "" {
+		return nil, false
+	}
+	return new(big.Rat).SetString(strings.TrimSpace(value))
+}
+
+// BelowFloor reports whether value is known and under chain's min_value: such
+// an item never costs a call.
+func (b *Budget) BelowFloor(chain common.Chain, value string) bool {
+	if b == nil {
+		return false
+	}
+	floor, ok := b.minValue[asciiUpper(chain.String())]
+	if !ok {
+		return false
+	}
+	v, known := amountRat(value)
+	return known && v.Cmp(floor) < 0
+}
+
+// Ticket is one reserved call. Dispatched confirms it; Retry reserves one more
+// call for another attempt; Release gives it back when nothing was sent.
+type Ticket struct {
+	b     *Budget
+	pool  string
+	day   string
+	limit uint64
+	n     uint64 // reserved calls not yet released
+	sent  bool
+}
+
+// Reserve takes one call for an item of chain with the given value (DTO
+// decimal amount, "" = unknown). ok=false carries a reason (no call made).
+func (b *Budget) Reserve(chain common.Chain, value string) (*Ticket, bool, string) {
+	return b.reserve(chain, value, false)
+}
+
+// ReserveRecheck takes one call from the recovery pool.
+func (b *Budget) ReserveRecheck(chain common.Chain, value string) (*Ticket, bool, string) {
+	return b.reserve(chain, value, true)
+}
+
+func (b *Budget) reserve(chain common.Chain, value string, recheck bool) (*Ticket, bool, string) {
+	if b == nil {
+		return &Ticket{}, true, ""
+	}
+	c := asciiUpper(chain.String())
+	v, known := amountRat(value)
+	if floor, ok := b.minValue[c]; ok && known && v.Cmp(floor) < 0 {
+		return nil, false, BudgetBelowFloor
+	}
+	if b.daily == 0 {
+		return &Ticket{}, true, ""
+	}
+	day := b.now().UTC().Format("2006-01-02")
+	try := func(pool string, limit uint64) (*Ticket, bool, string) {
+		ok, err := b.store.Reserve(b.cred, common.Chain(pool), day, 1, limit)
+		if err != nil {
+			return nil, false, BudgetStoreError
+		}
+		if !ok {
+			return nil, false, BudgetExhausted
+		}
+		b.maybeWarn(pool, day, limit)
+		return &Ticket{b: b, pool: pool, day: day, limit: limit, n: 1}, true, ""
+	}
+	if recheck {
+		return try(poolRecovery, pct(b.daily, b.recovery))
+	}
+	pool, limit := b.chainPool(c)
+	t, ok, why := try(pool, limit)
+	if ok || why == BudgetStoreError {
+		return t, ok, why
+	}
+	if fa, has := b.freshAbove[c]; has && known && v.Cmp(fa) >= 0 {
+		return try(poolReserve, pct(b.daily, b.reservePct))
+	}
+	return nil, false, why
+}
+
+func (b *Budget) maybeWarn(pool, day string, limit uint64) {
+	if (b.warn == nil && b.onUsed == nil) || limit == 0 {
+		return
+	}
+	used, err := b.store.Used(b.cred, common.Chain(pool), day)
+	if err != nil {
+		return
+	}
+	if b.onUsed != nil {
+		b.onUsed(pool, used)
+	}
+	if b.warn == nil || used*100 < limit*budgetWarnPct {
+		return
+	}
+	b.mu.Lock()
+	k := day + "|" + pool
+	first := !b.warned[k]
+	b.warned[k] = true
+	b.mu.Unlock()
+	if first {
+		b.warn(pool, used, limit)
+	}
+}
+
+// Dispatched marks the reserved call(s) as sent (charged).
+func (t *Ticket) Dispatched() {
+	if t != nil {
+		t.sent = true
+	}
+}
+
+// Retry reserves one more call for another attempt (each attempt is charged).
+func (t *Ticket) Retry() (bool, string) {
+	if t == nil || t.b == nil {
+		return true, ""
+	}
+	ok, err := t.b.store.Reserve(t.b.cred, common.Chain(t.pool), t.day, 1, t.limit)
+	if err != nil {
+		return false, BudgetStoreError
+	}
+	if !ok {
+		return false, BudgetExhausted
+	}
+	t.n++
+	return true, ""
+}
+
+// Release gives back the last reservation when it was never sent. It is a
+// no-op after Dispatched.
+func (t *Ticket) Release() {
+	if t == nil || t.b == nil || t.sent || t.n == 0 {
+		return
+	}
+	_ = t.b.store.Release(t.b.cred, common.Chain(t.pool), t.day, 1)
+	t.n--
+}
+
+// MemBudgetStore is an in-memory BudgetStore (tests, and nodes without a
+// persistent store: a restart then resets the day).
+type MemBudgetStore struct {
+	mu sync.Mutex
+	m  map[string]uint64
+	// Fail, when set, makes every call return this error.
+	Fail error
+}
+
+func NewMemBudgetStore() *MemBudgetStore { return &MemBudgetStore{m: map[string]uint64{}} }
+
+func budgetKey(cred string, chain common.Chain, day string) string {
+	return cred + "|" + chain.String() + "|" + day
+}
+
+func (s *MemBudgetStore) Reserve(cred string, chain common.Chain, day string, n, limit uint64) (bool, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.Fail != nil {
+		return false, s.Fail
+	}
+	k := budgetKey(cred, chain, day)
+	if s.m[k]+n > limit {
+		return false, nil
+	}
+	s.m[k] += n
+	return true, nil
+}
+
+func (s *MemBudgetStore) Release(cred string, chain common.Chain, day string, n uint64) error {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.Fail != nil {
+		return s.Fail
+	}
+	k := budgetKey(cred, chain, day)
+	if s.m[k] < n {
+		s.m[k] = 0
+	} else {
+		s.m[k] -= n
+	}
+	return nil
+}
+
+func (s *MemBudgetStore) Used(cred string, chain common.Chain, day string) (uint64, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.Fail != nil {
+		return 0, s.Fail
+	}
+	return s.m[budgetKey(cred, chain, day)], nil
+}
+
+var _ BudgetStore = (*MemBudgetStore)(nil)
diff --git a/bifrost/pkg/addressfilter/cache.go b/bifrost/pkg/addressfilter/cache.go
new file mode 100644
index 00000000000..f9e80a750de
--- /dev/null
+++ b/bifrost/pkg/addressfilter/cache.go
@@ -0,0 +1,148 @@
+package addressfilter
+
+import (
+	"container/list"
+	"sync"
+	"time"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+)
+
+// Cache TTL defaults.
+const (
+	DefaultListedTTL = 24 * time.Hour
+	DefaultCleanTTL  = 10 * time.Minute
+)
+
+type cacheEntry struct {
+	key     string
+	answer  Answer
+	expires time.Time
+	epoch   uint64
+}
+
+// LRUCache is a per-source decision cache keyed by (chain, canonical
+// address); an EVM account has one entry per EVM chain. It stores Listed and Clean only, never Unknown, and is used only
+// for address-only sources (R3-A7/A8). An entry whose address the guard now
+// contains is a miss (R3-A3 fence).
+type LRUCache struct {
+	mu        sync.Mutex
+	max       int
+	listedTTL time.Duration
+	cleanTTL  time.Duration
+	ll        *list.List
+	idx       map[string]*list.Element
+	guard     GuardView
+	now       func() time.Time
+}
+
+// NewLRUCache builds a cache; zero values take the defaults.
+func NewLRUCache(maxEntries int, listedTTL, cleanTTL time.Duration, guard GuardView) *LRUCache {
+	if maxEntries <= 0 {
+		maxEntries = DefaultCacheEntries
+	}
+	if listedTTL <= 0 {
+		listedTTL = DefaultListedTTL
+	}
+	if cleanTTL <= 0 {
+		cleanTTL = DefaultCleanTTL
+	}
+	return &LRUCache{
+		max: maxEntries, listedTTL: listedTTL, cleanTTL: cleanTTL,
+		ll: list.New(), idx: map[string]*list.Element{}, guard: guard, now: time.Now,
+	}
+}
+
+// cacheKey is chain-scoped: SetKey shares one key across EVM tickers, but a
+// query source is asked per chain and may answer differently on each.
+func cacheKey(chain common.Chain, addr string) string {
+	return asciiUpper(chain.String()) + "|" + SetKey(chain, addr)
+}
+
+// Get returns a cached answer. guardEpoch is the caller's view of the guard
+// epoch; an entry is rejected when the guard contains the address now.
+func (c *LRUCache) Get(chain common.Chain, addr string, guardEpoch uint64) (Answer, bool) {
+	if c.guard != nil && c.guard.Contains(chain, addr) {
+		c.Invalidate(chain, addr)
+		return Answer{}, false
+	}
+	k := cacheKey(chain, addr)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	el, ok := c.idx[k]
+	if !ok {
+		return Answer{}, false
+	}
+	e := el.Value.(*cacheEntry)
+	if !c.now().Before(e.expires) {
+		c.ll.Remove(el)
+		delete(c.idx, k)
+		return Answer{}, false
+	}
+	c.ll.MoveToFront(el)
+	return e.answer, true
+}
+
+// Put stores a Listed or Clean answer; Unknown is ignored.
+func (c *LRUCache) Put(chain common.Chain, addr string, a Answer, guardEpoch uint64) {
+	var ttl time.Duration
+	switch a.State {
+	case Listed:
+		ttl = c.listedTTL
+	case Clean:
+		ttl = c.cleanTTL
+	default:
+		return
+	}
+	if c.guard != nil && c.guard.Contains(chain, addr) {
+		return
+	}
+	a.RetryAfter = 0
+	k := cacheKey(chain, addr)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if el, ok := c.idx[k]; ok {
+		e := el.Value.(*cacheEntry)
+		e.answer, e.expires, e.epoch = a, c.now().Add(ttl), guardEpoch
+		c.ll.MoveToFront(el)
+		return
+	}
+	c.idx[k] = c.ll.PushFront(&cacheEntry{key: k, answer: a, expires: c.now().Add(ttl), epoch: guardEpoch})
+	for c.ll.Len() > c.max {
+		old := c.ll.Back()
+		c.ll.Remove(old)
+		delete(c.idx, old.Value.(*cacheEntry).key)
+	}
+}
+
+// Invalidate drops one address (every spelling).
+func (c *LRUCache) Invalidate(chain common.Chain, addr string) {
+	k := cacheKey(chain, addr)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if el, ok := c.idx[k]; ok {
+		c.ll.Remove(el)
+		delete(c.idx, k)
+	}
+}
+
+// BypassPositive drops a cached Listed answer so a recheck asks the source
+// again; a cached Clean stays.
+func (c *LRUCache) BypassPositive(chain common.Chain, addr string) {
+	k := cacheKey(chain, addr)
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	if el, ok := c.idx[k]; ok && el.Value.(*cacheEntry).answer.State == Listed {
+		c.ll.Remove(el)
+		delete(c.idx, k)
+	}
+}
+
+// Len returns the number of cached entries.
+func (c *LRUCache) Len() int {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	return c.ll.Len()
+}
+
+var _ DecisionCache = (*LRUCache)(nil)
diff --git a/bifrost/pkg/addressfilter/canon.go b/bifrost/pkg/addressfilter/canon.go
new file mode 100644
index 00000000000..f9fd339f2ff
--- /dev/null
+++ b/bifrost/pkg/addressfilter/canon.go
@@ -0,0 +1,462 @@
+package addressfilter
+
+import (
+	"bytes"
+	"crypto/sha256"
+	"encoding/hex"
+	"math/big"
+	"strings"
+
+	"github.com/btcsuite/btcd/btcutil/bech32"
+	"golang.org/x/crypto/blake2b"
+)
+
+// Payload canonicalization for fingerprint encoding v1. Every rule here
+// mirrors the list server's canonicalizer byte for byte (accepted forms,
+// rejected forms, key bytes): the shared golden vectors pin the behavior, and
+// any divergence makes the two sides disagree on list_fingerprint. When the
+// server is the reference and its behavior looks odd (an account address with
+// dropped padding bits still decodes), the odd behavior is copied, not fixed.
+
+const (
+	kindEVM        = 1 // 20-byte account, expanded to every EVM ticker
+	kindScript     = 2 // UTXO scriptPubKey
+	kindBech32Acct = 3 // cosmos-style account: bech32 data bytes
+	kindAcct32     = 4 // SOL, DOT/TAO: 32-byte account
+	kindAcct20     = 5 // TRON, XRP: 20-byte account
+	kindAda        = 6 // ADA payment credential (28 bytes)
+	kindRawAddr    = 7 // fallback: trimmed address bytes
+)
+
+// fpEVMChains is the server's EVM chain set; a wider set than
+// common.GetEVMChains (ARB and OP canonicalize as EVM accounts too).
+var fpEVMChains = map[string]bool{
+	"ETH": true, "BSC": true, "AVAX": true, "BASE": true, "POL": true, "ARB": true, "OP": true,
+}
+
+const (
+	b58Bitcoin = "123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz"
+	b58Ripple  = "rpshnaf39wBUDNEGHJKLM4PQRST7VWXYZ2bcdeCg65jkm8oFqi1tuvAxyz"
+	// bech32MaxTotal is the server decoder's limit on the whole string.
+	bech32MaxTotal = 1023
+)
+
+// fpMaxLen is the server's per-chain address length limit, checked before any
+// decoder runs (bounded decode work). Longer addresses are raw.
+func fpMaxLen(chain string) int {
+	if fpEVMChains[chain] {
+		return 42
+	}
+	switch chain {
+	case "BTC", "LTC", "ZEC":
+		return 90
+	case "DOGE":
+		return 35
+	case "BCH":
+		return 64
+	case "GAIA", "THOR", "MAYA", "NOBLE":
+		return 90
+	case "SOL", "TRON":
+		return 44
+	case "XRP":
+		return 48
+	case "DOT", "TAO":
+		return 50
+	}
+	return 128
+}
+
+// canonKey returns the payload-canonical key for a trimmed address on an
+// ASCII-uppercased chain, or ok=false when the address doesn't canonicalize
+// (the caller then uses the raw form).
+func canonKey(chain, a string) (kind byte, key []byte, ok bool) {
+	if a == "" || len(a) > fpMaxLen(chain) {
+		return 0, nil, false
+	}
+	if fpEVMChains[chain] {
+		return canonEVM(a)
+	}
+	switch chain {
+	case "BTC", "LTC", "DOGE", "ZEC":
+		return canonUTXO(chain, a)
+	case "BCH":
+		return canonBCH(a)
+	case "GAIA":
+		return canonBech32Account(a, "cosmos")
+	case "THOR":
+		return canonBech32Account(a, "thor")
+	case "MAYA":
+		return canonBech32Account(a, "maya")
+	case "NOBLE":
+		return canonBech32Account(a, "noble")
+	case "SOL":
+		b, ok := b58Decode(a, b58Bitcoin)
+		if !ok || len(b) != 32 {
+			return 0, nil, false
+		}
+		return kindAcct32, b, true
+	case "TRON":
+		return canonTRON(a)
+	case "XRP":
+		return canonXRP(a)
+	case "DOT", "TAO":
+		return canonSS58(a)
+	case "ADA":
+		return canonADA(a)
+	}
+	return 0, nil, false
+}
+
+func asciiUpper(s string) string {
+	b := []byte(s)
+	for i, c := range b {
+		if c >= 'a' && c <= 'z' {
+			b[i] = c - 32
+		}
+	}
+	return string(b)
+}
+
+func asciiLower(s string) string {
+	b := []byte(s)
+	for i, c := range b {
+		if c >= 'A' && c <= 'Z' {
+			b[i] = c + 32
+		}
+	}
+	return string(b)
+}
+
+func canonEVM(a string) (byte, []byte, bool) {
+	h := a
+	if strings.HasPrefix(a, "0x") || strings.HasPrefix(a, "0X") {
+		h = a[2:] // exactly one prefix
+	}
+	if len(h) != 40 {
+		return 0, nil, false
+	}
+	b, err := hex.DecodeString(h)
+	if err != nil {
+		return 0, nil, false
+	}
+	return kindEVM, b, true
+}
+
+// b58Decode decodes base58 with the given alphabet (no checksum). Each
+// leading zero digit is one zero byte.
+func b58Decode(s, alphabet string) ([]byte, bool) {
+	zero := alphabet[0]
+	zeros := 0
+	for zeros < len(s) && s[zeros] == zero {
+		zeros++
+	}
+	n := new(big.Int)
+	radix := big.NewInt(58)
+	for i := zeros; i < len(s); i++ {
+		d := strings.IndexByte(alphabet, s[i])
+		if d < 0 {
+			return nil, false
+		}
+		n.Mul(n, radix)
+		n.Add(n, big.NewInt(int64(d)))
+	}
+	return append(make([]byte, zeros), n.Bytes()...), true
+}
+
+// b58CheckDecode decodes base58check and returns the whole payload (version
+// bytes included) without the 4-byte double-sha256 checksum.
+func b58CheckDecode(s, alphabet string) ([]byte, bool) {
+	b, ok := b58Decode(s, alphabet)
+	if !ok || len(b) < 4 {
+		return nil, false
+	}
+	body, sum := b[:len(b)-4], b[len(b)-4:]
+	h1 := sha256.Sum256(body)
+	h2 := sha256.Sum256(h1[:])
+	if !bytes.Equal(h2[:4], sum) {
+		return nil, false
+	}
+	return body, true
+}
+
+// bech32DecodeBytes decodes bech32 or bech32m (either checksum) and converts
+// the data to bytes, dropping any leftover bits unchecked.
+func bech32DecodeBytes(a string) (hrp string, data []byte, ok bool) {
+	if len(a) > bech32MaxTotal {
+		return "", nil, false
+	}
+	hrp, fes, _, err := bech32.DecodeNoLimitWithVersion(a)
+	if err != nil {
+		return "", nil, false
+	}
+	var acc uint32
+	var bits uint
+	for _, fe := range fes {
+		acc = acc<<5 | uint32(fe&0x1f)
+		bits += 5
+		if bits >= 8 {
+			bits -= 8
+			data = append(data, byte(acc>>bits))
+			acc &= (1 << bits) - 1
+		}
+	}
+	return hrp, data, true
+}
+
+func canonBech32Account(a, wantHRP string) (byte, []byte, bool) {
+	hrp, data, ok := bech32DecodeBytes(a)
+	if !ok || hrp != wantHRP || len(data) == 0 {
+		return 0, nil, false
+	}
+	return kindBech32Acct, data, true
+}
+
+func canonADA(a string) (byte, []byte, bool) {
+	hrp, data, ok := bech32DecodeBytes(a)
+	if !ok || hrp != "addr" || len(data) < 29 || data[0]>>4 > 7 {
+		return 0, nil, false
+	}
+	return kindAda, data[1:29], true
+}
+
+// segwitScript is strict BIP-173/350 decoding: length limit, checksum
+// variant matching the witness version, zero padding, program length.
+func segwitScript(a, wantHRP string) ([]byte, bool) {
+	hrp, fes, ver, err := bech32.DecodeGeneric(a)
+	if err != nil || hrp != wantHRP || len(fes) < 1 {
+		return nil, false
+	}
+	v := fes[0]
+	if v > 16 {
+		return nil, false
+	}
+	if (v == 0 && ver != bech32.Version0) || (v != 0 && ver != bech32.VersionM) {
+		return nil, false
+	}
+	prog, err := bech32.ConvertBits(fes[1:], 5, 8, false)
+	if err != nil {
+		return nil, false
+	}
+	if v == 0 {
+		if len(prog) != 20 && len(prog) != 32 {
+			return nil, false
+		}
+	} else if len(prog) < 2 || len(prog) > 40 {
+		return nil, false
+	}
+	op := byte(0x00)
+	if v > 0 {
+		op = 0x50 + v
+	}
+	return append([]byte{op, byte(len(prog))}, prog...), true
+}
+
+func p2pkh(h []byte) []byte {
+	return append(append([]byte{0x76, 0xa9, 0x14}, h...), 0x88, 0xac)
+}
+
+func p2sh(h []byte) []byte {
+	return append(append([]byte{0xa9, 0x14}, h...), 0x87)
+}
+
+type utxoVersion struct {
+	prefix []byte
+	sh     bool
+}
+
+var utxoVersions = map[string][]utxoVersion{
+	"BTC":  {{[]byte{0x00}, false}, {[]byte{0x05}, true}},
+	"LTC":  {{[]byte{0x30}, false}, {[]byte{0x32}, true}, {[]byte{0x05}, true}},
+	"DOGE": {{[]byte{0x1e}, false}, {[]byte{0x16}, true}},
+	"ZEC":  {{[]byte{0x1c, 0xb8}, false}, {[]byte{0x1c, 0xbd}, true}},
+}
+
+var segwitHRP = map[string]string{"BTC": "bc", "LTC": "ltc"}
+
+// base58Script decodes a legacy base58check address for chain into its script.
+func base58Script(chain, a string) ([]byte, bool) {
+	payload, ok := b58CheckDecode(a, b58Bitcoin)
+	if !ok {
+		return nil, false
+	}
+	for _, v := range utxoVersions[chain] {
+		if len(payload) == len(v.prefix)+20 && bytes.HasPrefix(payload, v.prefix) {
+			h := payload[len(v.prefix):]
+			if v.sh {
+				return p2sh(h), true
+			}
+			return p2pkh(h), true
+		}
+	}
+	return nil, false
+}
+
+func canonUTXO(chain, a string) (byte, []byte, bool) {
+	lower := asciiLower(a)
+	// ZEC TEX (ZIP-320): bech32m "tex" carrying a P2PKH hash.
+	if chain == "ZEC" && strings.HasPrefix(lower, "tex1") {
+		hrp, data, ok := bech32DecodeBytes(a)
+		if !ok || hrp != "tex" || len(data) != 20 {
+			return 0, nil, false
+		}
+		return kindScript, p2pkh(data), true
+	}
+	if hrp, ok := segwitHRP[chain]; ok && strings.HasPrefix(lower, hrp+"1") {
+		s, ok := segwitScript(a, hrp)
+		if !ok {
+			return 0, nil, false
+		}
+		return kindScript, s, true
+	}
+	s, ok := base58Script(chain, a)
+	if !ok {
+		return 0, nil, false
+	}
+	return kindScript, s, true
+}
+
+func canonTRON(a string) (byte, []byte, bool) {
+	var p []byte
+	if strings.HasPrefix(a, "T") {
+		b, ok := b58CheckDecode(a, b58Bitcoin)
+		if !ok {
+			return 0, nil, false
+		}
+		p = b
+	} else {
+		b, err := hex.DecodeString(strings.TrimPrefix(a, "0x"))
+		if err != nil {
+			return 0, nil, false
+		}
+		p = b
+	}
+	if len(p) != 21 || p[0] != 0x41 {
+		return 0, nil, false
+	}
+	return kindAcct20, p[1:], true
+}
+
+func canonXRP(a string) (byte, []byte, bool) {
+	p, ok := b58CheckDecode(a, b58Ripple)
+	if !ok {
+		return 0, nil, false
+	}
+	switch {
+	case len(p) == 21 && p[0] == 0x00:
+		return kindAcct20, p[1:], true
+	case len(p) == 31 && p[0] == 0x05 && p[1] == 0x44: // mainnet X-address
+		return kindAcct20, p[2:22], true
+	}
+	return 0, nil, false
+}
+
+func canonSS58(a string) (byte, []byte, bool) {
+	b, ok := b58Decode(a, b58Bitcoin)
+	if !ok || len(b) == 0 {
+		return 0, nil, false
+	}
+	plen := 0
+	switch {
+	case b[0] < 64:
+		plen = 1
+	case b[0] < 128:
+		plen = 2
+	default:
+		return 0, nil, false
+	}
+	if len(b) != plen+32+2 {
+		return 0, nil, false
+	}
+	h, err := blake2b.New512(nil)
+	if err != nil {
+		return 0, nil, false
+	}
+	h.Write([]byte("SS58PRE"))
+	h.Write(b[:plen+32])
+	if !bytes.Equal(h.Sum(nil)[:2], b[plen+32:]) {
+		return 0, nil, false
+	}
+	return kindAcct32, b[plen : plen+32], true
+}
+
+// BCH: cashaddr (with or without the bitcoincash: prefix, any case) and
+// legacy base58 map to the same scriptPubKey.
+
+const cashCharset = "qpzry9x8gf2tvdw0s3jn54khce6mua7l"
+
+func cashPolymod(v []byte) uint64 {
+	c := uint64(1)
+	for _, d := range v {
+		c0 := byte(c >> 35)
+		c = ((c & 0x07ffffffff) << 5) ^ uint64(d)
+		if c0&0x01 != 0 {
+			c ^= 0x98f2bc8e61
+		}
+		if c0&0x02 != 0 {
+			c ^= 0x79b76d99e2
+		}
+		if c0&0x04 != 0 {
+			c ^= 0xf33e5fb3c4
+		}
+		if c0&0x08 != 0 {
+			c ^= 0xae2eabe2a8
+		}
+		if c0&0x10 != 0 {
+			c ^= 0x1e4f43e470
+		}
+	}
+	return c ^ 1
+}
+
+// cashDecode decodes a lowercase cashaddr body (no prefix) to (type, hash).
+func cashDecode(body string) (byte, []byte, bool) {
+	data := make([]byte, 0, len(body))
+	for i := 0; i < len(body); i++ {
+		d := strings.IndexByte(cashCharset, body[i])
+		if d < 0 {
+			return 0, nil, false
+		}
+		data = append(data, byte(d))
+	}
+	if len(data) < 8 {
+		return 0, nil, false
+	}
+	chk := make([]byte, 0, 12+len(data))
+	for _, c := range []byte("bitcoincash") {
+		chk = append(chk, c&0x1f)
+	}
+	chk = append(chk, 0)
+	chk = append(chk, data...)
+	if cashPolymod(chk) != 0 {
+		return 0, nil, false
+	}
+	payload, err := bech32.ConvertBits(data[:len(data)-8], 5, 8, false)
+	if err != nil || len(payload) < 1 {
+		return 0, nil, false
+	}
+	ver, hash := payload[0], payload[1:]
+	if ver&0x07 != 0 || len(hash) != 20 {
+		return 0, nil, false
+	}
+	return (ver >> 3) & 0x0f, hash, true
+}
+
+func canonBCH(a string) (byte, []byte, bool) {
+	lower := asciiLower(a)
+	body := strings.TrimPrefix(lower, "bitcoincash:")
+	ty, hash, ok := cashDecode(body)
+	if !ok {
+		s, ok := base58Script("BTC", a)
+		if !ok {
+			return 0, nil, false
+		}
+		return kindScript, s, true
+	}
+	switch ty {
+	case 0:
+		return kindScript, p2pkh(hash), true
+	case 1:
+		return kindScript, p2sh(hash), true
+	}
+	return 0, nil, false
+}
diff --git a/bifrost/pkg/addressfilter/combine.go b/bifrost/pkg/addressfilter/combine.go
new file mode 100644
index 00000000000..c5ba68400ec
--- /dev/null
+++ b/bifrost/pkg/addressfilter/combine.go
@@ -0,0 +1,39 @@
+package addressfilter
+
+// Combine modes.
+const (
+	CombineAny = "any"
+	CombineAll = "all"
+)
+
+// Combine applies the combine truth table to one item's answers.
+//
+//	any: Listed in >= 1 covering source -> skip; else observe.
+//	all: every covering source answered Listed -> skip; any Clean, Unknown or
+//	     missing answer -> observe.
+//
+// covering lists the sources that cover the item's chain; answers from other
+// sources are ignored. No covering source means observe. Admission and recheck
+// use the same table.
+func Combine(mode string, answers map[string]Answer, covering []string) (skip bool) {
+	if len(covering) == 0 {
+		return false
+	}
+	switch mode {
+	case CombineAll:
+		for _, name := range covering {
+			a, ok := answers[name]
+			if !ok || a.State != Listed {
+				return false
+			}
+		}
+		return true
+	default: // any (the validated default)
+		for _, name := range covering {
+			if a, ok := answers[name]; ok && a.State == Listed {
+				return true
+			}
+		}
+		return false
+	}
+}
diff --git a/bifrost/pkg/addressfilter/config.go b/bifrost/pkg/addressfilter/config.go
new file mode 100644
index 00000000000..0793941ea4f
--- /dev/null
+++ b/bifrost/pkg/addressfilter/config.go
@@ -0,0 +1,658 @@
+package addressfilter
+
+import (
+	"bytes"
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net"
+	"net/url"
+	"regexp"
+	"strings"
+	"time"
+
+	"github.com/mitchellh/mapstructure"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+	"gitlab.com/thorchain/thornode/v3/config"
+)
+
+// Defaults and hard limits for the screening stage (design Config schema, R3).
+const (
+	DefaultMaxInflight    = 64
+	DefaultChainBudgetPct = 20
+	DefaultSourceTimeout  = 2 * time.Second
+	MaxScreenDeadline     = 3 * time.Second
+	DefaultMaxRecords     = 50000
+	DefaultRecheckPage    = 100
+	DefaultRetention      = 7 * 24 * time.Hour
+	DefaultListMaxShrink  = 50
+	DefaultMaxBytes       = 4 << 20
+	DefaultCacheEntries   = 100000
+	StaticSourceName      = "static"
+	// MinListFetchTimeout is the shortest list fetch_timeout that doesn't warn.
+	MinListFetchTimeout = 10 * time.Second
+)
+
+// SourceSpec is one validated source.
+type SourceSpec struct {
+	Raw     config.BifrostAddressFilterSource
+	Name    string
+	Mode    string
+	Chains  []common.Chain
+	Timeout time.Duration
+	// Secrets holds every secret value loaded for this source (for redaction).
+	Secrets []string
+	// SecretFiles maps each secret file path to its loaded value.
+	SecretFiles map[string]string
+	// Exprs holds the compiled selectors by field name (listed, unknown, ...).
+	Exprs map[string]*Expr
+	// ContextDependent is true when a request or selector reads more than the
+	// address and chain, or the source batches, unless address_only is set; its
+	// answers are then never cached by address.
+	ContextDependent bool
+}
+
+// Validated is the outcome of Validate.
+type Validated struct {
+	Enabled        bool
+	FilterOutbound bool
+	Combine        string
+	ScreenDeadline time.Duration
+	MaxInflight    int
+	ChainBudgetPct int
+	ReplayEnabled  bool
+	MaxRecords     int
+	// MaxRecordsPerChain caps one chain's share of the skip ledger.
+	MaxRecordsPerChain int
+	// ReservedPerChain is every chain's guaranteed share (the even split of
+	// MaxRecords): the global cap can't take it away.
+	ReservedPerChain int
+	// MaxRecordsPerSender caps one sender's records on one chain.
+	MaxRecordsPerSender int
+	RecheckPage         int
+	Retention           time.Duration
+	Sources             []SourceSpec
+	// Quarantined maps a source name to the reason it was disabled.
+	Quarantined map[string]error
+	// QuarantinedChains maps a quarantined source to the chains it was
+	// configured for (nil = unknown, i.e. every chain). Under combine: all a
+	// quarantined source still counts as a non-answer for its chains.
+	QuarantinedChains map[string][]common.Chain
+	EvalSem           chan struct{}
+	// Warnings are non-fatal config notes the caller logs.
+	Warnings []string
+}
+
+// ErrFatalConfig wraps any config error that disables the whole filter.
+var ErrFatalConfig = errors.New("address filter config invalid; filter disabled")
+
+// CheckUnknownKeys decodes the raw address_filter map strictly and reports
+// unknown keys, which Validate treats as fatal.
+func CheckUnknownKeys(raw map[string]any) error {
+	var out config.BifrostAddressFilterConfiguration
+	d, err := mapstructure.NewDecoder(&mapstructure.DecoderConfig{
+		ErrorUnused:      true,
+		WeaklyTypedInput: true,
+		DecodeHook:       mapstructure.StringToTimeDurationHookFunc(),
+		Result:           &out,
+	})
+	if err != nil {
+		return err
+	}
+	if err := d.Decode(raw); err != nil {
+		return fmt.Errorf("%w: %v", ErrFatalConfig, err)
+	}
+	return nil
+}
+
+func isLoopbackHost(h string) bool {
+	if h == "localhost" {
+		return true
+	}
+	ip := net.ParseIP(h)
+	return ip != nil && ip.IsLoopback()
+}
+
+// Validate checks the configuration. A fatal error disables the whole filter
+// (the caller logs it and runs without screening); a source error quarantines
+// that source only. It never panics and never exits the process.
+func Validate(c config.BifrostAddressFilterConfiguration, chains []common.Chain, readFile func(string) ([]byte, error)) (v Validated, err error) {
+	defer func() {
+		if r := recover(); r != nil {
+			v, err = Validated{}, fmt.Errorf("%w: %v", ErrFatalConfig, r)
+		}
+	}()
+	v = Validated{
+		Enabled:             c.Enabled,
+		FilterOutbound:      c.FilterOutbound,
+		Combine:             strings.ToLower(strings.TrimSpace(c.Combine)),
+		ScreenDeadline:      c.ScreenDeadline,
+		MaxInflight:         c.MaxInflight,
+		ChainBudgetPct:      c.ChainBudgetPct,
+		ReplayEnabled:       c.ReplayEnabled,
+		MaxRecords:          c.MaxRecords,
+		MaxRecordsPerChain:  c.MaxRecordsPerChain,
+		MaxRecordsPerSender: c.MaxRecordsPerSender,
+		RecheckPage:         c.RecheckPage,
+		Retention:           c.Retention,
+		Quarantined:         map[string]error{},
+		QuarantinedChains:   map[string][]common.Chain{},
+		EvalSem:             NewEvalSemaphore(c.MaxEval),
+	}
+	fatal := func(f string, a ...any) (Validated, error) {
+		return Validated{}, fmt.Errorf("%w: %s", ErrFatalConfig, fmt.Sprintf(f, a...))
+	}
+	if c.AdapterErr != nil {
+		return fatal("%v", c.AdapterErr)
+	}
+	switch v.Combine {
+	case "":
+		v.Combine = "any"
+	case "any", "all":
+	default:
+		return fatal("combine %q (want any|all)", c.Combine)
+	}
+	if v.ScreenDeadline < 0 || v.ScreenDeadline > MaxScreenDeadline {
+		return fatal("screen_deadline %s (0..%s)", v.ScreenDeadline, MaxScreenDeadline)
+	}
+	if v.MaxInflight < 0 || c.MaxEval < 0 || v.ChainBudgetPct < 0 || v.ChainBudgetPct > 100 ||
+		v.MaxRecords < 0 || v.MaxRecordsPerChain < 0 || v.MaxRecordsPerSender < 0 || v.RecheckPage < 0 || v.Retention < 0 {
+		return fatal("negative or out-of-range global cap")
+	}
+	if v.MaxInflight == 0 {
+		v.MaxInflight = DefaultMaxInflight
+	}
+	if v.ChainBudgetPct == 0 {
+		v.ChainBudgetPct = DefaultChainBudgetPct
+	}
+	if v.MaxRecords == 0 {
+		v.MaxRecords = DefaultMaxRecords
+	}
+	// Per-chain skip-ledger share. Every chain is guaranteed its even share
+	// of max_records (the reserve: the global cap can't starve it). The
+	// per-chain cap is that share, raised to the floor (DefaultChainFloor,
+	// clamped to max_records) when the share is tiny; an explicit
+	// max_records_per_chain may go above it (the reserve still protects the
+	// other chains), never above max_records. One sender is capped at
+	// max_records_per_sender (default a 16th of the per-chain cap, at least
+	// 16), so a single listed sender can't fill its chain.
+	fair := FairPerChainRecords(v.MaxRecords, len(chains))
+	floor := DefaultChainFloor
+	if floor > v.MaxRecords {
+		floor = v.MaxRecords
+	}
+	if len(chains) > v.MaxRecords {
+		v.Warnings = append(v.Warnings, fmt.Sprintf(
+			"max_records %d is smaller than the %d configured chains: each chain is guaranteed only 1 skip record; raise max_records",
+			v.MaxRecords, len(chains)))
+	} else if fair < floor {
+		v.Warnings = append(v.Warnings, fmt.Sprintf(
+			"max_records %d over %d chains guarantees each chain only %d skip records (cap raised to the floor %d); raise max_records",
+			v.MaxRecords, len(chains), fair, floor))
+	}
+	v.ReservedPerChain = fair
+	switch {
+	case v.MaxRecordsPerChain == 0:
+		v.MaxRecordsPerChain = fair
+		if v.MaxRecordsPerChain < floor {
+			v.MaxRecordsPerChain = floor
+		}
+	case v.MaxRecordsPerChain > v.MaxRecords:
+		v.Warnings = append(v.Warnings, fmt.Sprintf(
+			"max_records_per_chain %d is above max_records; clamped to %d", v.MaxRecordsPerChain, v.MaxRecords))
+		v.MaxRecordsPerChain = v.MaxRecords
+	}
+	if v.ReservedPerChain > v.MaxRecordsPerChain {
+		v.ReservedPerChain = v.MaxRecordsPerChain
+	}
+	switch {
+	case v.MaxRecordsPerSender == 0:
+		v.MaxRecordsPerSender = DefaultPerSenderRecords(v.MaxRecordsPerChain)
+	case v.MaxRecordsPerSender > v.MaxRecordsPerChain:
+		v.Warnings = append(v.Warnings, fmt.Sprintf(
+			"max_records_per_sender %d is above the per-chain cap; clamped to %d", v.MaxRecordsPerSender, v.MaxRecordsPerChain))
+		v.MaxRecordsPerSender = v.MaxRecordsPerChain
+	}
+	if v.RecheckPage == 0 {
+		v.RecheckPage = DefaultRecheckPage
+	}
+	if v.Retention == 0 {
+		v.Retention = DefaultRetention
+	}
+	known := map[string]common.Chain{}
+	for _, ch := range chains {
+		known[ch.String()] = ch
+	}
+	seen := map[string]bool{}
+	if strings.TrimSpace(c.Addresses) != "" {
+		seen[StaticSourceName] = true
+		v.Sources = append(v.Sources, SourceSpec{
+			Raw:  config.BifrostAddressFilterSource{Name: StaticSourceName, Mode: "static"},
+			Name: StaticSourceName, Mode: "static", Chains: chains,
+		})
+	}
+	for _, s := range c.Sources {
+		name := strings.TrimSpace(s.Name)
+		if name == "" {
+			return fatal("source without a name")
+		}
+		if seen[name] {
+			return fatal("duplicate source name %q", name)
+		}
+		seen[name] = true
+		spec, qerr := validateSource(s, known, readFile, v.EvalSem)
+		if s.DecodeErr != nil {
+			qerr = fmt.Errorf("decode: %w", s.DecodeErr)
+		}
+		if qerr != nil {
+			v.Quarantined[name] = qerr
+			v.QuarantinedChains[name] = quarantinedChains(s.Chains, known)
+			continue
+		}
+		// Each mode has its own deadline key; the other one does nothing.
+		if spec.Mode == "list" && s.Timeout > 0 {
+			v.Warnings = append(v.Warnings, fmt.Sprintf(
+				"source %s: timeout does not bound a list fetch and is ignored; use fetch_timeout", name))
+		}
+		if spec.Mode == "query" && s.FetchTimeout > 0 {
+			v.Warnings = append(v.Warnings, fmt.Sprintf(
+				"source %s: fetch_timeout applies to list sources only and is ignored; use timeout", name))
+		}
+		if spec.Mode == "list" && s.FetchTimeout > 0 && s.FetchTimeout < MinListFetchTimeout {
+			v.Warnings = append(v.Warnings, fmt.Sprintf(
+				"source %s: fetch_timeout %s is under %s; a large list may never finish refreshing and go stale (fail-open)",
+				name, s.FetchTimeout, MinListFetchTimeout))
+		}
+		v.Sources = append(v.Sources, spec)
+	}
+	return v, nil
+}
+
+// DefaultChainFloor is the per-chain skip-ledger floor: the even share is
+// never set below it (clamped to max_records).
+const DefaultChainFloor = 100
+
+// DefaultPerSenderRecords is the per-sender cap for a per-chain cap: a 16th
+// of it, at least 16 (never above the per-chain cap). Filling one chain then
+// takes at least 16 distinct listed senders.
+func DefaultPerSenderRecords(perChain int) int {
+	n := perChain / 16
+	if n < 16 {
+		n = 16
+	}
+	if n > perChain {
+		n = perChain
+	}
+	if n < 1 {
+		n = 1
+	}
+	return n
+}
+
+// DefaultPerChainRecords is the per-chain skip-ledger cap for maxRecords when
+// the chain count is unknown: a quarter of it (at least 1).
+func DefaultPerChainRecords(maxRecords int) int {
+	return FairPerChainRecords(maxRecords, 4)
+}
+
+// FairPerChainRecords splits maxRecords evenly over nChains (at least 1 each;
+// nChains <= 0 means unknown, a quarter). The shares add up to at most
+// maxRecords, so every chain keeps its own room in the ledger.
+func FairPerChainRecords(maxRecords, nChains int) int {
+	if nChains <= 0 {
+		nChains = 4
+	}
+	n := maxRecords / nChains
+	if n < 1 {
+		n = 1
+	}
+	return n
+}
+
+// quarantinedChains resolves a quarantined source's chains; any unknown name
+// (or none at all) means every chain.
+func quarantinedChains(names []string, known map[string]common.Chain) []common.Chain {
+	if len(names) == 0 {
+		return nil
+	}
+	out := make([]common.Chain, 0, len(names))
+	for _, n := range names {
+		ch, ok := known[strings.ToUpper(strings.TrimSpace(n))]
+		if !ok {
+			return nil
+		}
+		out = append(out, ch)
+	}
+	return out
+}
+
+// bareVarRe matches a header/query value that is exactly one expression
+// variable ("$chain", "$address"): it is evaluated, not sent as text.
+var bareVarRe = regexp.MustCompile(`^\$[a-z_]+$`)
+
+func isBareVar(v string) bool {
+	if !bareVarRe.MatchString(v) {
+		return false
+	}
+	for _, n := range VarNames {
+		if n == v {
+			return true
+		}
+	}
+	return false
+}
+
+// normalizeValues rewrites bare-variable values to the jq: form.
+func normalizeValues(m map[string]string) map[string]string {
+	if m == nil {
+		return nil
+	}
+	out := make(map[string]string, len(m))
+	for k, v := range m {
+		if isBareVar(strings.TrimSpace(v)) {
+			v = ValueExprPrefix + strings.TrimSpace(v)
+		}
+		out[k] = v
+	}
+	return out
+}
+
+func validateSource(s config.BifrostAddressFilterSource, known map[string]common.Chain, readFile func(string) ([]byte, error), sem chan struct{}) (SourceSpec, error) {
+	s.Headers = normalizeValues(s.Headers)
+	s.Query = normalizeValues(s.Query)
+	spec := SourceSpec{Raw: s, Name: strings.TrimSpace(s.Name), Mode: strings.ToLower(s.Mode), Exprs: map[string]*Expr{}, SecretFiles: map[string]string{}}
+	switch spec.Mode {
+	case "static", "list", "query":
+	default:
+		return spec, fmt.Errorf("mode %q (want static|list|query)", s.Mode)
+	}
+	for _, cs := range s.Chains {
+		ch, ok := known[strings.ToUpper(strings.TrimSpace(cs))]
+		if !ok {
+			return spec, fmt.Errorf("unknown chain %q", cs)
+		}
+		spec.Chains = append(spec.Chains, ch)
+	}
+	// Viper lowercases map keys; per-chain maps are keyed by upper-case ticker.
+	var err error
+	if spec.Raw.ChainShare, err = upperIntKeys(s.ChainShare, known); err != nil {
+		return spec, err
+	}
+	for _, m := range []*map[string]string{&spec.Raw.MinValue, &spec.Raw.FreshAbove, &spec.Raw.ChainMap} {
+		if *m, err = upperKeys(*m, known); err != nil {
+			return spec, err
+		}
+	}
+	if s.Timeout < 0 || s.Refresh < 0 || s.MaxAge < 0 || s.FetchTimeout < 0 || s.Cache.ListedTTL < 0 || s.Cache.CleanTTL < 0 {
+		return spec, errors.New("negative duration")
+	}
+	spec.Timeout = s.Timeout
+	if spec.Timeout == 0 {
+		spec.Timeout = DefaultSourceTimeout
+	}
+	if spec.Mode == "static" {
+		if strings.TrimSpace(s.Addresses) == "" {
+			return spec, errors.New("static source needs addresses")
+		}
+		return spec, nil
+	}
+	if s.URL == "" {
+		return spec, errors.New("url required")
+	}
+	u, perr := url.Parse(s.URL)
+	err = perr
+	if err != nil || u.Host == "" {
+		return spec, errors.New("bad url")
+	}
+	loop := isLoopbackHost(u.Hostname())
+	if u.Scheme != "https" && !(u.Scheme == "http" && loop) {
+		return spec, errors.New("url must be https (plain http only on loopback)")
+	}
+	if !loop && s.ProxyURL == "" && !s.AllowDirectEgress {
+		return spec, errors.New("non-loopback source needs proxy_url or allow_direct_egress: true")
+	}
+	switch s.FollowRedirects {
+	case "", "none", "same-origin-https":
+	default:
+		return spec, fmt.Errorf("follow_redirects %q", s.FollowRedirects)
+	}
+	// Secrets: load once now, so an unreadable file quarantines at startup.
+	load := func(path string) error {
+		if path == "" {
+			return nil
+		}
+		b, err := readFile(path)
+		if err != nil {
+			return fmt.Errorf("secret file unreadable: %w", err)
+		}
+		sec := strings.TrimSpace(string(b))
+		if sec == "" {
+			return errors.New("secret file empty")
+		}
+		spec.Secrets = append(spec.Secrets, sec)
+		spec.SecretFiles[path] = sec
+		return nil
+	}
+	auth := strings.ToLower(s.Auth)
+	switch {
+	case auth == "" || auth == "none":
+	case auth == "bearer":
+		if s.TokenFile == "" {
+			return spec, errors.New("bearer auth needs token_file")
+		}
+		if err := load(s.TokenFile); err != nil {
+			return spec, err
+		}
+	case auth == "query":
+		if s.QueryParam == "" || s.SecretFile == "" {
+			return spec, errors.New("query auth needs query_param and secret_file")
+		}
+		if err := load(s.SecretFile); err != nil {
+			return spec, err
+		}
+	case strings.HasPrefix(auth, "signer:"):
+		if err := load(s.KeyFile); err != nil {
+			return spec, err
+		}
+		if err := load(s.SecretFile); err != nil {
+			return spec, err
+		}
+	default:
+		return spec, fmt.Errorf("auth %q", s.Auth)
+	}
+	for _, m := range []map[string]string{s.Headers, s.Query} {
+		for _, val := range m {
+			if strings.HasPrefix(val, "secret:") {
+				if err := load(strings.TrimPrefix(val, "secret:")); err != nil {
+					return spec, err
+				}
+			}
+		}
+	}
+	if s.Listed == "" && s.ResultsMap == "" {
+		return spec, errors.New("listed (or results_map) selector required")
+	}
+	if s.ResultsInOrder && s.ResultsMap == "" {
+		return spec, errors.New("results_in_order needs results_map")
+	}
+	// selectorReadsContext is true when a response-side selector (not the
+	// request body) names a context variable; address_only refuses it.
+	selectorReadsContext := false
+	for field, src := range map[string]string{
+		"listed": s.Listed, "unknown": s.Unknown, "reason": s.Reason,
+		"retry_after": s.RetryAfter, "source_backoff": s.SourceBackoff,
+		"results_map": s.ResultsMap, "body": s.Body,
+	} {
+		if src == "" {
+			continue
+		}
+		e, err := CompileExpr(src, VarNames, sem)
+		if err != nil {
+			return spec, fmt.Errorf("%s: %w", field, err)
+		}
+		spec.Exprs[field] = e
+		if referencesContext(e) {
+			spec.ContextDependent = true
+			if field != "body" {
+				selectorReadsContext = true
+			}
+		}
+	}
+	// $threshold must be configured when an expression uses it: an unset
+	// threshold would compare scores against null.
+	if s.Threshold == nil {
+		for field, e := range spec.Exprs {
+			if e.References("$threshold") {
+				return spec, fmt.Errorf("%s uses $threshold but threshold is not set", field)
+			}
+		}
+	}
+	// Header/query values: "jq:<expr>" is compiled like any selector and
+	// counts toward context dependence; literals and secrets never do.
+	for kind, m := range map[string]map[string]string{"header": s.Headers, "query": s.Query} {
+		for k, val := range m {
+			if !strings.HasPrefix(val, ValueExprPrefix) {
+				continue
+			}
+			e, err := CompileExpr(strings.TrimPrefix(val, ValueExprPrefix), VarNames, sem)
+			if err != nil {
+				return spec, fmt.Errorf("%s %q: %w", kind, k, err)
+			}
+			if s.Threshold == nil && e.References("$threshold") {
+				return spec, fmt.Errorf("%s %q uses $threshold but threshold is not set", kind, k)
+			}
+			spec.Exprs[kind+":"+k] = e
+			if referencesContext(e) {
+				spec.ContextDependent = true
+			}
+		}
+	}
+	if err := checkURLTemplate(s.URL); err != nil {
+		return spec, err
+	}
+	// Context dependence is decided fail-safe: a request can carry
+	// context through paths a variable scan cannot see ($items[] or .items[]
+	// in a batch body, the input "." in a per-item body). So every batch source
+	// counts as context-dependent, and a per-item request expression whose
+	// output changes when only the context fields change counts too.
+	// address_only: true is the operator's assertion that the provider answers
+	// by address alone; it turns caching back on, and is refused when a
+	// response selector reads context.
+	if spec.Mode == "query" {
+		if s.Batch > 1 || requestVariesWithContext(spec) {
+			spec.ContextDependent = true
+		}
+	}
+	if s.AddressOnly {
+		if spec.Mode != "query" {
+			return spec, errors.New("address_only applies to query sources only")
+		}
+		if selectorReadsContext {
+			return spec, errors.New("address_only, but a response selector reads context")
+		}
+		spec.ContextDependent = false
+	}
+	return spec, nil
+}
+
+// contextVars are the expression variables that carry more than the address
+// and chain. $items carries the whole batch, context fields included.
+var contextVars = []string{"$tx_id", "$height", "$block_time", "$coins", "$asset", "$amount", "$items"}
+
+func referencesContext(e *Expr) bool {
+	for _, n := range contextVars {
+		if e.References(n) {
+			return true
+		}
+	}
+	return false
+}
+
+// requestVariesWithContext evaluates the request-side expressions (the body
+// and jq header/query values) for items that share address and chain but
+// differ in every context field, plus one with no context at all. A changed
+// output, or an evaluation error, counts as context dependence.
+func requestVariesWithContext(spec SourceSpec) bool {
+	var exprs []*Expr
+	for k, e := range spec.Exprs {
+		if k == "body" || strings.HasPrefix(k, "header:") || strings.HasPrefix(k, "query:") {
+			exprs = append(exprs, e)
+		}
+	}
+	if len(exprs) == 0 {
+		return false
+	}
+	chain := "BTC"
+	if len(spec.Chains) > 0 {
+		chain = spec.Chains[0].String()
+	}
+	mapped := chain
+	if m, ok := spec.Raw.ChainMap[chain]; ok {
+		mapped = m
+	}
+	h1, h2, t1, t2 := uint64(1000001), uint64(2000002), uint64(1700000001), uint64(1800000002)
+	probes := []ItemDTO{
+		{ThorChain: chain, Chain: mapped, Address: "probe-address", TxID: strp("probe-tx-a"), Height: &h1, BlockTime: &t1,
+			Coins: []CoinDTO{{Asset: "PROBE.A", Amount: "1"}}, Asset: strp("PROBE.A"), Amount: strp("1")},
+		{ThorChain: chain, Chain: mapped, Address: "probe-address", TxID: strp("probe-tx-b"), Height: &h2, BlockTime: &t2,
+			Coins: []CoinDTO{{Asset: "PROBE.B", Amount: "2"}, {Asset: "PROBE.C", Amount: "3"}}, Asset: strp("PROBE.B"), Amount: strp("2")},
+		{ThorChain: chain, Chain: mapped, Address: "probe-address", Coins: []CoinDTO{}},
+	}
+	ctx, cancel := context.WithTimeout(context.Background(), time.Second)
+	defer cancel()
+	for _, e := range exprs {
+		var first []byte
+		for i, p := range probes {
+			in, vals := p.ToJQ()
+			v, err := e.Eval(ctx, in, vals...)
+			if err != nil {
+				return true
+			}
+			b, err := json.Marshal(v)
+			if err != nil {
+				return true
+			}
+			if i == 0 {
+				first = b
+			} else if !bytes.Equal(first, b) {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+func upperKeys(m map[string]string, known map[string]common.Chain) (map[string]string, error) {
+	if m == nil {
+		return nil, nil
+	}
+	out := make(map[string]string, len(m))
+	for k, v := range m {
+		u := strings.ToUpper(strings.TrimSpace(k))
+		if _, ok := known[u]; !ok {
+			return nil, fmt.Errorf("unknown chain %q in per-chain map", k)
+		}
+		out[u] = v
+	}
+	return out, nil
+}
+
+func upperIntKeys(m map[string]int, known map[string]common.Chain) (map[string]int, error) {
+	if m == nil {
+		return nil, nil
+	}
+	out := make(map[string]int, len(m))
+	for k, v := range m {
+		u := strings.ToUpper(strings.TrimSpace(k))
+		if _, ok := known[u]; !ok {
+			return nil, fmt.Errorf("unknown chain %q in chain_share", k)
+		}
+		if v < 0 || v > 100 {
+			return nil, fmt.Errorf("chain_share %s=%d (0..100)", u, v)
+		}
+		out[u] = v
+	}
+	return out, nil
+}
