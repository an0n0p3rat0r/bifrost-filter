+		t.Fatalf("snapshot %+v", s)
+	}
+	cfg := config.BifrostAddressFilterConfiguration{Enabled: true, Sources: []config.BifrostAddressFilterSource{{
+		Name: "lst", Mode: "list", Chains: []string{"ETH"}, URL: "https://lists.example/l.json",
+		Listed: ".addresses", AllowDirectEgress: true, FetchTimeout: 5 * time.Second,
+	}}}
+	v, err := Validate(cfg, []common.Chain{common.ETHChain}, nil)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if len(v.Quarantined) != 0 || len(v.Warnings) != 1 {
+		t.Fatalf("a short fetch_timeout must warn: quarantined=%v warnings=%v", v.Quarantined, v.Warnings)
+	}
