+// The ADR's Elliptic and MistTrack examples, as written, decode (auth map
+// form, threshold) and validate: none is quarantined.
+func TestADRVendorExamplesValidate(t *testing.T) {
+	files := map[string]string{
+		"/secrets/elliptic.key": "k", "/secrets/elliptic.secret": "c2VjcmV0", "/secrets/misttrack.key": "mt-key",
+	}
+	for _, f := range []string{"adr_elliptic_example.yaml", "adr_misttrack_example.yaml"} {
+		srcs := adrSources(t, f)
+		v, err := Validate(config.BifrostAddressFilterConfiguration{Enabled: true, Sources: srcs}, reviewChains, readFiles(files))
+		if err != nil {
+			t.Fatalf("%s: %v", f, err)
+		}
+		if len(v.Quarantined) != 0 {
+			t.Fatalf("%s quarantined: %v", f, v.Quarantined)
+		}
+	}
+	el := adrSources(t, "adr_elliptic_example.yaml")[0]
+	if el.Auth != "signer:elliptic-hmac" || el.KeyFile != "/secrets/elliptic.key" || el.SecretFile != "/secrets/elliptic.secret" {
+		t.Fatalf("elliptic auth map: %+v", el)
+	}
+	mt := adrSources(t, "adr_misttrack_example.yaml")[0]
+	if mt.Auth != "query" || mt.QueryParam != "api_key" || mt.Threshold == nil || *mt.Threshold != 91 {
+		t.Fatalf("misttrack auth/threshold: %+v", mt)
+	}
+}
