+)
+
+func (s *AddressFilterSuite) TestParseCounts(c *C) {
+	f := New(strings.Join([]string{
+		seedETH, seedBech32, "SOL:" + seedSOL, legacyBTC,
+		seedETH,                   // duplicate, not double-counted
+		"  SOL:" + seedSOL + " ",  // whitespace tolerated
+		"not-an-address", "0x123", // garbage skipped
+		seedSOL, // bare non-BTC base58 is ambiguous: skipped
+		"",
+	}, ","))
+	c.Assert(f.Loaded(), Equals, 4)
+	c.Assert(f.Skipped(), Equals, 3)
+}
+
+func (s *AddressFilterSuite) TestEVMEntryAppliesToAllEVMChains(c *C) {
+	f := New(seedETH)
+	for _, chain := range common.GetEVMChains() {
+		c.Assert(f.Listed(chain, seedETH), Equals, true, Commentf("chain %s", chain))
+		// case-insensitive: lowercased query against checksummed entry
+		c.Assert(f.Listed(chain, strings.ToLower(seedETH)), Equals, true, Commentf("chain %s lower", chain))
+	}
+	// but not on non-EVM chains
+	c.Assert(f.Listed(common.BTCChain, seedETH), Equals, false)
+	c.Assert(f.Listed(common.SOLChain, seedETH), Equals, false)
+	c.Assert(f.Listed(common.GAIAChain, seedETH), Equals, false)
+}
+
+func (s *AddressFilterSuite) TestBTCMatching(c *C) {
+	f := New(seedBech32 + "," + legacyBTC)
+	// bech32 matches case-insensitively
+	c.Assert(f.Listed(common.BTCChain, seedBech32), Equals, true)
+	c.Assert(f.Listed(common.BTCChain, strings.ToUpper(seedBech32)), Equals, true)
+	// legacy matches exactly, and base58 case flips must NOT match
+	c.Assert(f.Listed(common.BTCChain, legacyBTC), Equals, true)
+	c.Assert(f.Listed(common.BTCChain, strings.ToUpper(legacyBTC)), Equals, false)
+	// not on other chains
+	c.Assert(f.Listed(common.SOLChain, seedBech32), Equals, false)
+	c.Assert(f.Listed(common.ETHChain, seedBech32), Equals, false)
+}
+
+func (s *AddressFilterSuite) TestSOLMatching(c *C) {
+	f := New("SOL:" + seedSOL)
+	c.Assert(f.Listed(common.SOLChain, seedSOL), Equals, true)
+	// base58 is case-sensitive
+	c.Assert(f.Listed(common.SOLChain, strings.ToLower(seedSOL)), Equals, false)
+	c.Assert(f.Listed(common.BTCChain, seedSOL), Equals, false)
+}
+
+func (s *AddressFilterSuite) TestExplicitChainPrefix(c *C) {
+	// inference: a valid BTC legacy address infers BTC
+	f := New(legacyBTC)
+	c.Assert(f.Listed(common.BTCChain, legacyBTC), Equals, true)
+	c.Assert(f.Listed(common.SOLChain, legacyBTC), Equals, false)
+
+	// explicit prefix overrides inference
+	f = New("SOL:" + legacyBTC)
+	c.Assert(f.Listed(common.SOLChain, legacyBTC), Equals, true)
+	c.Assert(f.Listed(common.BTCChain, legacyBTC), Equals, false)
+
+	// explicit EVM prefix SCOPES to that one chain (not the shared EVM bucket),
+	// so an operator can list a chain-specific contract address.
+	f = New("AVAX:" + seedETH)
+	c.Assert(f.Listed(common.AVAXChain, seedETH), Equals, true)
+	for _, chain := range common.GetEVMChains() {
+		if chain.Equals(common.AVAXChain) {
+			continue
+		}
+		c.Assert(f.Listed(chain, seedETH), Equals, false, Commentf("chain %s", chain))
+	}
+
+	// a BARE 0x entry still applies to every EVM chain (cross-EVM).
+	f = New(seedETH)
+	for _, chain := range common.GetEVMChains() {
+		c.Assert(f.Listed(chain, seedETH), Equals, true, Commentf("bare evm chain %s", chain))
+	}
+
+	// unknown chain ticker is skipped, not fatal
+	f = New("FOO:" + seedETH)
+	c.Assert(f.Loaded(), Equals, 0)
+	c.Assert(f.Skipped(), Equals, 1)
+	c.Assert(f.Listed(common.ETHChain, seedETH), Equals, false)
+}
+
+func (s *AddressFilterSuite) TestBech32CaseInsensitive(c *C) {
+	// Non-BTC bech32 chains must match case-insensitively (canonical lowercase),
+	// else an uppercase spelling of a listed destination evades the filter.
+	const (
+		ltcB32    = "ltc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4"
+		cosmosB32 = "cosmos1qpzry9x8gf2tvdw0s3jn54khce6mua7lmqy0jx"
+	)
+	f := New("LTC:" + ltcB32 + ",GAIA:" + strings.ToUpper(cosmosB32))
+	// listed lowercase, queried uppercase -> still matched
+	c.Assert(f.Listed(common.LTCChain, strings.ToUpper(ltcB32)), Equals, true)
+	c.Assert(f.Listed(common.LTCChain, ltcB32), Equals, true)
+	// listed uppercase, queried lowercase -> still matched (symmetric fold)
+	c.Assert(f.Listed(common.GAIAChain, strings.ToLower(cosmosB32)), Equals, true)
+	c.Assert(f.Listed(common.GAIAChain, cosmosB32), Equals, true)
+	// not cross-chain
+	c.Assert(f.Listed(common.BTCChain, ltcB32), Equals, false)
+
+	// base58 (case-sensitive) must NOT be folded: an uppercase variant is a
+	// different (invalid) address and must not match.
+	f = New("SOL:" + seedSOL)
+	c.Assert(f.Listed(common.SOLChain, seedSOL), Equals, true)
+	c.Assert(f.Listed(common.SOLChain, strings.ToUpper(seedSOL)), Equals, false)
+}
+
+func (s *AddressFilterSuite) TestLegacyBTCNoBypass(c *C) {
+	// Regression: isBech32's structural check misfired on ~10% of legacy base58
+	// addresses; the bare-legacy classify branch then stored the entry raw while
+	// Listed normalized the query → asymmetric → silent filter bypass. A valid
+	// base58check address must never be folded, and bare/explicit must match.
+	for _, addr := range []string{
+		"1CP7TGhsD4fVB9sEXVWKVxnw1qnYExfSAU", // the reported bypass vector
+		legacyBTC,
+		altBase58(0x05), // P2SH "3..."
+	} {
+		c.Assert(New(addr).Listed(common.BTCChain, addr), Equals, true, Commentf("bare %s", addr))
+		c.Assert(New("BTC:"+addr).Listed(common.BTCChain, addr), Equals, true, Commentf("explicit %s", addr))
+		// stored canonical (not lowercased), so an uppercased variant does NOT match
+		c.Assert(New(addr).Listed(common.BTCChain, strings.ToUpper(addr)), Equals, false, Commentf("upper %s", addr))
+	}
+	// isBech32 must reject valid base58check outright
+	c.Assert(isBech32("1CP7TGhsD4fVB9sEXVWKVxnw1qnYExfSAU"), Equals, false)
+}
+
+func (s *AddressFilterSuite) TestNonASCIIEntryNoPanic(c *C) {
+	// A copy-pasted sanctions list may carry a zero-width space, en dash,
+	// ellipsis or BOM. Such entries must be skipped, never crash the decoder
+	// (which would take down the observer at startup).
+	zwsp := "\xe2\x80\x8b"     // U+200B zero-width space
+	endash := "\xe2\x80\x93"   // U+2013 en dash
+	bom := "\xef\xbb\xbf"      // U+FEFF byte-order mark
+	ellipsis := "\xe2\x80\xa6" // U+2026 ellipsis
+	f := New(strings.Join([]string{
+		"SOL:" + seedSOL + zwsp,
+		"DOGE:D" + endash,
+		bom + legacyBTC,
+		"BTC:" + legacyBTC + ellipsis,
+		legacyBTC, // one clean bare entry still loads
+	}, ","))
+	c.Assert(f.Loaded(), Equals, 1)
+	c.Assert(f.Skipped(), Equals, 4)
+	c.Assert(f.Listed(common.BTCChain, legacyBTC), Equals, true)
+	// a non-ASCII query must not panic and must not match
+	c.Assert(f.Listed(common.GAIAChain, "\xff\xfe\xfd"), Equals, false)
+	c.Assert(f.Listed(common.SOLChain, seedSOL+zwsp), Equals, false)
+}
+
+func (s *AddressFilterSuite) TestOverlongEntrySkipped(c *C) {
+	// A pathologically long entry must be skipped before decoding (bounds the
+	// base58check O(n^2) decode), and must not load or match.
+	huge := "SOL:" + strings.Repeat("2", 1<<16)
+	f := New(huge + "," + legacyBTC)
+	c.Assert(f.Loaded(), Equals, 1) // only the clean legacy entry
+	c.Assert(f.Skipped(), Equals, 1)
+	c.Assert(f.Listed(common.BTCChain, legacyBTC), Equals, true)
+	// an overlong query is rejected without decoding and never matches
+	c.Assert(f.Listed(common.SOLChain, strings.Repeat("2", 1<<16)), Equals, false)
+}
+
+func (s *AddressFilterSuite) TestInertFilter(c *C) {
+	// nil filter matches nothing (feature disabled)
+	var f *Filter
+	c.Assert(f.Listed(common.ETHChain, seedETH), Equals, false)
+	c.Assert(f.Loaded(), Equals, 0)
+	c.Assert(f.Skipped(), Equals, 0)
+
+	// empty config loads nothing
+	f = New("")
+	c.Assert(f.Loaded(), Equals, 0)
+	c.Assert(f.Listed(common.ETHChain, seedETH), Equals, false)
+}
+
+// base58check vectors for chains whose addresses share BTC's base58 alphabet
+// and lengths, built from a fixed 20-byte payload with each chain's mainnet
+// version byte.
+func altBase58(version byte) string {
+	payload := make([]byte, 20)
+	for i := range payload {
+		payload[i] = byte(i + 1)
+	}
+	return base58.CheckEncode(payload, version)
+}
+
+func (s *AddressFilterSuite) TestAmbiguousBase58Skipped(c *C) {
+	tron := altBase58(0x41) // T...
+	doge := altBase58(0x1e) // D...
+	ltc := altBase58(0x30)  // L...
+	c.Assert(tron[0], Equals, byte('T'))
+	c.Assert(doge[0], Equals, byte('D'))
+	c.Assert(ltc[0], Equals, byte('L'))
+
+	// bare: none is guessed onto any chain, all are counted as skipped
+	f := New(strings.Join([]string{tron, doge, ltc, seedSOL}, ","))
+	c.Assert(f.Loaded(), Equals, 0)
+	c.Assert(f.Skipped(), Equals, 4)
+	for _, addr := range []string{tron, doge, ltc, seedSOL} {
+		for _, chain := range []common.Chain{common.SOLChain, common.BTCChain, common.TRONChain, common.DOGEChain, common.LTCChain} {
+			c.Assert(f.Listed(chain, addr), Equals, false, Commentf("%s on %s", addr, chain))
+		}
+	}
+
+	// prefixed: loaded under the named chain only
