+// Finding 4 (quarantine): under combine: all a quarantined source still covers
+// its chains as a non-answer, so the static source alone can't skip.
+func TestCombineAllQuarantinedSourceCountsAsNonAnswer(t *testing.T) {
+	const listed = "bc1qjwdw6vrzq4vf6hckutvx4ucj86awwv99mxnz7w"
+	v, err := Validate(config.BifrostAddressFilterConfiguration{Enabled: true, Combine: "all", Addresses: listed,
+		Sources: []config.BifrostAddressFilterSource{
+			{Name: "broken", Mode: "query", Chains: []string{"BTC"}}, // no url: quarantined
+		}}, []common.Chain{common.BTCChain}, readFiles(nil))
+	if err != nil || v.Quarantined["broken"] == nil {
+		t.Fatalf("precondition: broken quarantined: %v %v", err, v.Quarantined)
+	}
+	a, err := NewAdapter(v, AdapterOptions{Chains: []common.Chain{common.BTCChain}, Stores: memAdapterStores(), StaticAddresses: listed})
+	if err != nil {
+		t.Fatal(err)
+	}
+	a.Guard.MarkReconciled(true)
+	it := &stypes.TxInItem{Tx: "t", Sender: listed, To: "bc1qvault", BlockHeight: 5,
+		Coins: common.NewCoins(common.NewCoin(common.BTCAsset, cosmos.NewUint(1)))}
+	vv := a.Screen(context.Background(), common.BTCChain, []*stypes.TxInItem{it}, 0)[a.Key(common.BTCChain, it, 0)]
+	if vv.Skip {
+		t.Fatalf("combine all skipped without the quarantined source: %+v", vv.Answers)
+	}
+	if got := vv.Answers["broken"]; got.State != Unknown || got.Reason != KindQuarantined {
+		t.Fatalf("quarantined source must be a non-answer: %+v", vv.Answers)
+	}
+	if testutilGauge(t, a.Metrics.SourceQuarantined.WithLabelValues("broken")) != 1 {
+		t.Fatal("source_quarantined gauge not set")
+	}
+}
