+	rel1, _ := c.Acquire(context.Background())
+	rel2, _ := c.Acquire(context.Background())
+	r := NewRechecker(RecheckerOptions{Ledger: f.l, Sources: []Source{src}, Guard: f.g, Now: f.clk.now, Inflight: c})
+	if st := r.Tick(context.Background()); !st.Paused || src.calls.Load() != 0 {
+		t.Fatal("recheck must pause while live in-flight > 50 % of the cap")
+	}
+	rel1()
+	rel2()
+	f.g.mu.Lock()
+	f.g.ready = false
+	f.g.mu.Unlock()
+	if st := r.Tick(context.Background()); !st.Paused {
+		t.Fatal("recheck must pause while the guard is not ready")
+	}
