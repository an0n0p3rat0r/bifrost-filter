@@ -0,0 +1,47 @@
+package addressfilter
+
+import (
+	"context"
+	"encoding/json"
+	"io"
+	"net/http"
+	"net/http/httptest"
+	"strings"
+	"testing"
+	"time"
+
+	"gitlab.com/thorchain/thornode/v3/common"
+	"gitlab.com/thorchain/thornode/v3/config"
+)
+
+func TestDryRunNeverPrintsSecrets(t *testing.T) {
+	const key = "api-key-0123456789"
+	srv := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		// A provider that echoes the key back in the body (worst case).
+		io.WriteString(w, `{"listed":true,"why":"key `+r.URL.Query().Get("apikey")+` saw `+r.URL.Path+`"}`)
+	}))
+	defer srv.Close()
+	spec := querySpec(t, config.BifrostAddressFilterSource{
+		Name: "q", Mode: "query", Chains: []string{"BTC"}, URL: srv.URL + "/c/{address}",
+		Auth: "query", QueryParam: "apikey", SecretFile: "/s", Listed: ".listed", Reason: ".why",
+	}, map[string]string{"/s": key})
+	pol, _ := PolicyFor(spec, true)
+	rep := DryRun(context.Background(), spec, NewHTTPClient(pol), common.BTCChain, "bc1qdryrun", true, time.Now())
+	out, _ := json.Marshal(rep)
+	if strings.Contains(string(out), key) {
+		t.Fatalf("dry-run output leaks the secret: %s", out)
+	}
+	if rep.Answer != "listed" || rep.Status != 200 || rep.Results["listed"] != "true" {
+		t.Fatalf("report %+v", rep)
+	}
+	if !strings.Contains(rep.Response, Redacted) || !strings.Contains(rep.URL, "/c/bc1qdryrun") {
+		t.Fatalf("expected a scrubbed response and the built url: %+v", rep)
+	}
+}
+
+func TestDryRunRefusesNonQuerySource(t *testing.T) {
+	rep := DryRun(context.Background(), SourceSpec{Name: "static", Mode: "static"}, nil, common.BTCChain, "x", false, time.Now())
+	if rep.Error == "" || rep.Answer != "unknown" {
+		t.Fatalf("%+v", rep)
+	}
+}
diff --git a/bifrost/pkg/addressfilter/dto.go b/bifrost/pkg/addressfilter/dto.go
new file mode 100644
index 00000000000..71e08aace8a
--- /dev/null
+++ b/bifrost/pkg/addressfilter/dto.go
@@ -0,0 +1,112 @@
+package addressfilter
+
+import (
+	"encoding/json"
+	"math"
+
+	stypes "gitlab.com/thorchain/thornode/v3/bifrost/thorclient/types"
+	"gitlab.com/thorchain/thornode/v3/common"
+)
+
+// CoinDTO is one coin of an item, amount as a decimal string.
+type CoinDTO struct {
+	Asset  string `json:"asset"`
+	Amount string `json:"amount"`
+}
+
+// ItemDTO is the wire/expression view of one inbound item. Unknown values are
+// null, never 0: a source must be able to tell "height unknown" from height 0.
+type ItemDTO struct {
+	ThorChain string    `json:"thor_chain"`
+	Chain     string    `json:"chain"`
+	Address   string    `json:"address"`
+	TxID      *string   `json:"tx_id"`
+	Height    *uint64   `json:"height"`
+	BlockTime *uint64   `json:"block_time"`
+	Coins     []CoinDTO `json:"coins"`
+	Asset     *string   `json:"asset"`
+	Amount    *string   `json:"amount"`
+}
+
+// u64 converts a signed value to *uint64; zero and negative mean unknown.
+func u64(v int64) *uint64 {
+	if v <= 0 || v == math.MinInt64 {
+		return nil
+	}
+	u := uint64(v)
+	return &u
+}
+
+func strp(s string) *string {
+	if s == "" {
+		return nil
+	}
+	return &s
+}
+
+// NewItemDTO builds the DTO for one TxIn item. blockTime is unix seconds (0 =
+// unknown). thor_chain is the THORChain chain ticker ("ETH", "BTC"); chain starts
+// as the same ticker and a source replaces it with its provider name after
+// chain_map (ForProvider) before evaluating anything.
+func NewItemDTO(chain common.Chain, it *stypes.TxInItem, blockTime int64) ItemDTO {
+	d := ItemDTO{
+		ThorChain: chain.String(),
+		Chain:     chain.String(),
+		Address:   it.Sender,
+		TxID:      strp(it.Tx),
+		Height:    u64(it.BlockHeight),
+		BlockTime: u64(blockTime),
+		Coins:     []CoinDTO{},
+	}
+	for _, c := range it.Coins {
+		d.Coins = append(d.Coins, CoinDTO{Asset: c.Asset.String(), Amount: c.Amount.String()})
+	}
+	if len(d.Coins) > 0 {
+		d.Asset = &d.Coins[0].Asset
+		d.Amount = &d.Coins[0].Amount
+	}
+	return d
+}
+
+// ForProvider returns the DTO as one source sees it: chain is the source's name
+// for the chain after chain_map; thor_chain stays the THORChain ticker.
+func (d ItemDTO) ForProvider(chain string) ItemDTO {
+	d.Chain = chain
+	return d
+}
+
+// VarNames are the gojq variable names bound for every expression, in order.
+// $items is bound only for a batch request body (the batch's item DTOs, the same
+// array as the .items input); it is null everywhere else. $threshold is the
+// source's configured threshold (null when not set).
+var VarNames = []string{"$thor_chain", "$chain", "$address", "$tx_id", "$height", "$block_time", "$coins", "$asset", "$amount", "$items", "$threshold"}
+
+// itemsVar and thresholdVar are the indexes of $items and $threshold in VarNames.
+const (
+	itemsVar     = 9
+	thresholdVar = 10
+)
+
+// ToJQ returns the DTO as a generic JSON value (the expression input) and the
+// variable values in VarNames order.
+func (d ItemDTO) ToJQ() (map[string]any, []any) {
+	b, _ := json.Marshal(d)
+	var m map[string]any
+	_ = json.Unmarshal(b, &m)
+	vals := make([]any, len(VarNames))
+	for i, n := range VarNames {
+		if i == thresholdVar {
+			continue // per source, set by the source (WithThreshold)
+		}
+		vals[i] = m[n[1:]]
+	}
+	return m, vals
+}
+
+// WithThreshold sets $threshold in vals (nil threshold leaves it null).
+func WithThreshold(vals []any, threshold *float64) []any {
+	if threshold != nil && len(vals) > thresholdVar {
+		vals[thresholdVar] = *threshold
+	}
+	return vals
+}
