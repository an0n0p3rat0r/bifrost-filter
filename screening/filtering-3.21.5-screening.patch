+// adrSources decodes an ADR example file exactly as Bifrost's config load does
+// (config.DecodeAddressFilter), so the map form of auth is exercised.
+func adrSources(t *testing.T, file string) []config.BifrostAddressFilterSource {
+	t.Helper()
+	b, err := os.ReadFile("testdata/providers/" + file)
+	if err != nil {
+		t.Fatal(err)
+	}
+	var list []any
+	if err := yaml.Unmarshal(b, &list); err != nil {
+		t.Fatal(err)
+	}
+	c, err := config.DecodeAddressFilter(map[string]any{"enabled": true, "sources": list})
+	if err != nil || c.AdapterErr != nil {
+		t.Fatalf("decode: %v / %v", err, c.AdapterErr)
+	}
+	for _, s := range c.Sources {
+		if s.DecodeErr != nil {
+			t.Fatalf("source %s: %v", s.Name, s.DecodeErr)
+		}
+	}
+	return c.Sources
+}
