+			Str("chain", tx.Chain.String()).
+			Str("to_address", tx.ToAddress.String()).
+			Str("coins", tx.Coins.String()).
+			Str("memo", tx.Memo).
+			Str("vault", tx.VaultPubKey.String()).
+			Int64("outbound_height", height).
+			Msg("declining keysign: outbound destination is address-filtered (policy decline, NOT a signing fault; TSS blame/slash accepted)")
+		return nil, nil, nil // abstain: do not sign this outbound
+	}
+
 	// The first proof does not reserve inputs or mutate scanner state. Run it
 	// before the chain vault lock so slow source RPCs do not block consolidation.
